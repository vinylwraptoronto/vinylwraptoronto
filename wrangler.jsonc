{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinylwraptoronto",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],

  // The adapter's generated entry. Every content page still carries
  // `export const prerender = true` and is served as a static file; this exists
  // so a later gate can add the on-demand contact-form route.
  "main": "./dist/_worker.js/index.js",

  // Both default to true when absent, which published the whole site at
  // vinylwraptoronto.ash-47a.workers.dev — a guessable public address serving
  // a byte-identical copy of the client's live site while it is still on
  // WordPress. That is duplicate content pointed at their own domain, and it
  // is reachable by anyone. The site is meant to be private until cutover, and
  // staging.vinylwraptoronto.com is the hostname for looking at it.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Workers does not infer 404 handling the way Pages did. Without this an
    // unknown path returns a bare 404 with no page around it.
    "not_found_handling": "404-page",
    // The default, set explicitly so nobody has to wonder.
    "html_handling": "auto-trailing-slash"
  },

  // Preview hostname: staging.vinylwraptoronto.com, attached to this Worker as
  // a Custom Domain. That binding is held server-side and survives deploys, so
  // it is deliberately NOT declared as a `routes` entry here — declaring it
  // makes wrangler reconcile zone routes on every deploy, which needs a
  // zone-level Workers Routes permission this token does not have, and the
  // whole deploy then fails after the assets have already uploaded.
  //
  // The cutover hostnames (apex and www) are recorded but NOT attached —
  // attaching the apex belongs to the domain-cutover gate, not here.

  // The blog database. Every current post is already in it; the authoring
  // feature reads and writes it from here rather than from src/data.
  "d1_databases": [
    {
      "binding": "BLOG",
      "database_name": "vinylwraptoronto-blog",
      "database_id": "ed3116e7-7699-4d4d-8785-2ea67f81aed1"
    }
  ],

  "observability": {
    "enabled": true
  }
}
