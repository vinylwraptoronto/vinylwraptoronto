{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinylwraptoronto",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],

  // The adapter's generated entry. Every content page still carries
  // `export const prerender = true` and is served as a static file; this exists
  // so a later gate can add the on-demand contact-form route.
  "main": "./worker-entry.mjs",

  // Both default to true when absent, which published the whole site at
  // vinylwraptoronto.ash-47a.workers.dev — a guessable public address serving
  // a byte-identical copy of the client's live site while it is still on
  // WordPress. That is duplicate content pointed at their own domain, and it
  // is reachable by anyone. The site is meant to be private until cutover, and
  // staging.vinylwraptoronto.com is the hostname for looking at it.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Workers does not infer 404 handling the way Pages did. Without this an
    // unknown path returns a bare 404 with no page around it.
    // "none", not "404-page": a path with no matching file must reach the
    // Worker rather than being answered by the asset server, because
    // worker-entry.mjs lowercases it and redirects when that address is real —
    // the original answers 200 for any capitalisation and a static host does
    // not. The adapter still renders the 404 page when nothing matches, so an
    // address that is genuinely gone looks exactly as it did before.
    "not_found_handling": "none",
    // The default, set explicitly so nobody has to wonder.
    "html_handling": "auto-trailing-slash",

    // Which requests the Worker sees before the asset server answers them.
    //
    // /admin and /api have to be here: neither exists as a file, and
    // /api/quote is a POST, which no asset lookup can answer.
    //
    // Documents are here for one reason — worker-entry.mjs stamps
    // X-Robots-Tag: noindex on anything served from the preview hostname, and
    // it cannot stamp a response the asset server returned without it. The
    // preview is a byte-identical copy of the client's site and was fully
    // indexable; a duplicate site in the index is worth a Worker invocation
    // per page view. Once the apex is attached and the preview retired, this
    // can go back to just /admin and /api.
    //
    // The pages themselves are still static files: the Worker reads them
    // through the ASSETS binding rather than rendering anything.
    "run_worker_first": [
      "/*",
      // The two big static trees stay on the fast path: hashed build output and
      // the self-hosted font files. Between them they are most of the requests
      // a page makes and none of them is a document anyone could index.
      "!/_astro/*",
      "!/fonts/*"
    ]
  },

  // Preview hostname: staging.vinylwraptoronto.com, attached to this Worker as
  // a Custom Domain. That binding is held server-side and survives deploys, so
  // it is deliberately NOT declared as a `routes` entry here — declaring it
  // makes wrangler reconcile zone routes on every deploy, which needs a
  // zone-level Workers Routes permission this token does not have, and the
  // whole deploy then fails after the assets have already uploaded.
  //
  // The cutover hostnames (apex and www) are recorded but NOT attached —
  // attaching the apex belongs to the domain-cutover gate, not here.

  // The blog database. Every current post is already in it; the authoring
  // feature reads and writes it from here rather than from src/data.
  "d1_databases": [
    {
      "binding": "BLOG",
      "database_name": "vinylwraptoronto-blog",
      "database_id": "ed3116e7-7699-4d4d-8785-2ea67f81aed1"
    }
  ],

  "observability": {
    "enabled": true
  }
}
