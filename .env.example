# Build-time variables. Copy to .env for local work; in CI set them as
# repository variables. None is required -- every one has a documented default.

# Image host. Default https://img.vinylwraptoronto.com; set to
# /wp-content/uploads to serve the copies under public/ (see src/lib/img.ts).
# PUBLIC_IMG_BASE=https://img.vinylwraptoronto.com

# Google Consent Mode v2. Unset = the original's posture: every tag fires and
# nothing is gated. "denied" = ad and analytics storage start denied and a
# consent platform must call window.vwtConsent(true) (see Analytics.astro).
# Do not set this to denied without a banner or CMP in place: every
# conversion the campaigns are measured on would stop being recorded.
# PUBLIC_CONSENT_DEFAULT=denied

# Worker SECRETS (never here, never in git): RESEND_API_KEY, QUOTE_TO_EMAIL,
# QUOTE_FROM_EMAIL, B2_*, GITHUB_DEPLOY_TOKEN. Set with `npx wrangler secret put`.
# Deploy: CLOUDFLARE_API_TOKEN or CF_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
