---
/**
 * See a post as the site will render it, before it is built.
 *
 * The site is static: a post saved in the database does not appear on
 * vinylwraptoronto.com until the next build. Without this there is no way to
 * check a draft except by deploying it, which is not a thing anyone should
 * have to do to read their own writing.
 *
 * The drawing is src/components/PostPreview.astro, shared with the 10XiD
 * portal's preview, through the real layout and renderer.
 */
import PostPreview from '../../../../components/PostPreview.astro';
import { applyAdminHeaders } from '../../../../lib/auth';
import { guardPage } from '../../../../lib/adminroute';

export const prerender = false;

applyAdminHeaders(Astro.response.headers);
const guard = await guardPage(Astro.locals, Astro.cookies, Astro.url);
if (!guard.ok) return guard.response;
const { db } = guard.ctx;

const id = Number(Astro.params.id ?? '');
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/admin/posts/', 302);

const post = await db
  .prepare(
    `SELECT p.*, m.path AS featured_path, a.name AS author
       FROM posts p
       LEFT JOIN media m ON m.id = p.featured_id
       LEFT JOIN authors a ON a.id = p.author_id
      WHERE p.id = ?`,
  )
  .bind(id)
  .first<Record<string, unknown>>();
if (!post) return Astro.redirect('/admin/posts/?e=gone', 302);
---

<PostPreview post={post} back={`/admin/posts/${id}/`} />
