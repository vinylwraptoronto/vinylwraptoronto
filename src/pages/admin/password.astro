---
/**
 * Change your own password. Also the wall a seeded account hits: an account
 * created by scripts/admin-user.mjs is flagged must_change_password, and the
 * dashboard sends it here until it has a password its holder chose rather than
 * one that was generated for them and passed along.
 */
import Admin from '../../layouts/Admin.astro';
import {
  applyAdminHeaders,
  readSession,
  sessionCookieName,
  type Db,
} from '../../lib/auth';

export const prerender = false;

const db = Astro.locals.runtime?.env?.BLOG as unknown as Db | undefined;
applyAdminHeaders(Astro.response.headers);

if (!db) return Astro.redirect('/admin/login/?e=config', 302);

const session = await readSession(db, Astro.cookies.get(sessionCookieName(Astro.url))?.value);
if (!session) return Astro.redirect('/admin/login/?e=expired&next=/admin/password/', 302);

const MESSAGES: Record<string, string> = {
  current: 'That is not your current password.',
  mismatch: 'The two new passwords do not match.',
  weak: 'Use at least 12 characters.',
  same: 'The new password is the same as the current one.',
  csrf: 'That form had expired. Please try again.',
  config: 'The admin database is not reachable from this deployment.',
};
const code = Astro.url.searchParams.get('e') ?? '';
const message = Object.prototype.hasOwnProperty.call(MESSAGES, code) ? MESSAGES[code] : null;
---

<Admin title="Change password" user={{ username: session.username, csrfToken: session.csrfToken }}>
  <h1>Change password</h1>
  <p class="lede">
    {session.mustChangePassword
      ? 'This account is still on the password it was created with. Choose your own before going on.'
      : 'Changing your password signs out every other browser you are signed in on.'}
  </p>

  {message && <p class="alert alert--error" role="alert">{message}</p>}

  <div class="card">
    <form method="post" action="/api/admin/password/">
      <input type="hidden" name="csrf" value={session.csrfToken} />

      <div class="field">
        <label for="current_password">Current password</label>
        <input
          id="current_password"
          name="current_password"
          type="password"
          autocomplete="current-password"
          required
          maxlength="200"
        />
      </div>

      <div class="field">
        <label for="new_password">New password</label>
        <input
          id="new_password"
          name="new_password"
          type="password"
          autocomplete="new-password"
          required
          minlength="12"
          maxlength="200"
        />
        <p class="hint">
          At least 12 characters. Length is what makes a password hard to guess,
          so a memorable phrase beats a short one with symbols in it.
        </p>
      </div>

      <div class="field">
        <label for="confirm_password">Repeat new password</label>
        <input
          id="confirm_password"
          name="confirm_password"
          type="password"
          autocomplete="new-password"
          required
          minlength="12"
          maxlength="200"
        />
      </div>

      <button type="submit" class="primary">Change password</button>
    </form>
  </div>
</Admin>
