---
/**
 * One route for every address on the site — 676 of them: pages, posts,
 * category and brand archives, the index listings, and the two web stories.
 *
 * Slugs match the live URLs exactly, so every address the old site serves keeps
 * working without a redirect.
 */
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import ArchiveList from '../components/ArchiveList.astro';
import type { Block, PageData } from '../types';
import posts from '../data/posts.json';
import additions from '../data/post-additions.json';
import pageSeo from '../data/page-seo.json';
import blogIndex from '../data/blog-index.json';
import { applyPageSeo, type PageSeoOverride } from '../lib/pageseo';
import { withGalleries } from '../lib/gallery';
import { authorSections, blogPageMeta, blogSections, categorySections, pageCount, PER_PAGE, type BlogEntry } from '../lib/bloglist';
/* Any one category listing: they are all Elementor archive template 18965,
   which the author archives share. See authorSections. */
import archiveTemplate from '../data/pages/blogs__ai-to-print.json';
import { categoryEntries, categoryPageCount, membersOf } from '../lib/archive';
import { applyPostTemplate, applyPostLayout } from '../lib/post-template';
import { img } from '../lib/img';
/* Author name -> archive slug, shared with scripts/pull-posts.mjs so a post
   written in /admin is filed under the same archive its byline links to. */
import authorArchives from '../data/author-archives.json';

export const prerender = true;

/* Posts come from the D1 blog database, pulled into src/data/posts.json by
   scripts/pull-posts.mjs before the build. Everything else -- pages, archives,
   the two web stories -- still comes from the extracted page data.

   The post entries under src/data/pages are the seed input for D1, not a
   render source; taking both would give two sources of truth for the same 478
   addresses, and they would drift the moment anyone edited a post. */
export async function getStaticPaths() {
  const files = import.meta.glob<PageData>('../data/pages/*.json', {
    eager: true,
    import: 'default',
  });
  /* Web stories are served whole, as the AMP documents they are, by
     src/pages/web-stories/[story].astro -- not drawn here as an article. */
  const notPosts = Object.values(files).filter((p) => p.kind !== 'post' && p.kind !== 'story');
  const fromDb = posts as unknown as PageData[];

  if (!fromDb.length) {
    throw new Error(
      'src/data/posts.json is empty — the build would ship without any blog ' +
      'posts. Run `npm run posts:pull` (it needs CLOUDFLARE_API_TOKEN).',
    );
  }

  const all = [...notPosts, ...fromDb];
  const paths = all.map((page) => ({
    params: { slug: page.slug === '' ? undefined : page.slug },
    props: { page, pageNum: 1 },
  }));

  /* /blog/page/2/ … /blog/page/34/.
     The ported page carries a frozen 13-card snapshot and no pagination, so
     every post past the first twelve was linked from nowhere. These are the
     rest of the index. */
  const blog = all.find((p) => p.slug === 'blog');
  if (blog) {
    const total = pageCount((blogIndex as BlogEntry[]).length);
    for (let n = 2; n <= total; n++) {
      paths.push({ params: { slug: `blog/page/${n}` }, props: { page: blog, pageNum: n } });
    }
  }

  /* /author/<name>/page/2/ …
     The two author archives are the only listings on the site that carry their
     membership as data, and they were rendering all of it at once: 347 entries
     on one page, 50,623px against the original's 3,755. The original paginates
     them twelve at a time like the blog, so they do too. */
  for (const page of notPosts) {
    if (page.kind !== 'archive') continue;
    /* A category archive pages through its live listing, to the original's
       five-page limit; the author archives through their members. */
    const listing = categoryEntries(page);
    const total = listing ? categoryPageCount(listing) : pageCount(membersOf(page).length);
    for (let n = 2; n <= total; n++) {
      paths.push({ params: { slug: `${page.slug}/page/${n}` }, props: { page, pageNum: n } });
    }
  }
  return paths;
}

const { page: raw, pageNum = 1 } = Astro.props as { page: PageData; pageNum?: number };

/* SEO set in /admin/pages/ wins over what the page was ported with. Applied
   here rather than in the layout because it rewrites the ported head tags in
   place — see src/lib/pageseo.ts for why adding tags beside them would leave
   the old values rendering. Empty until someone edits a page, so this is a
   no-op on a fresh checkout. */
/* Galleries come from D1 too, pulled into src/data/galleries.json before the
   build. Applied here rather than in the renderer so the block components never
   have to know where a picture came from, and only where the database actually
   has rows -- a gallery it does not know about keeps the pictures the page was
   ported with. Posts are unaffected: their galleries are already in D1, inside
   the post's own sections. */
const withSeo = applyPageSeo(
  withGalleries(raw),
  (pageSeo as Record<string, PageSeoOverride>)[raw.slug],
);

/* The blog index is the one page whose listing is generated rather than
   ported: see src/lib/bloglist.ts. Everything else renders exactly as before. */
const isBlogIndex = raw.slug === 'blog';
const blogTotal = pageCount((blogIndex as BlogEntry[]).length);

/* A paginated archive's later pages need the same head treatment the blog's
   do: their own title and canonical, noindex so the site does not offer Google
   thirty near-identical listings, and no structured data, because the ported
   graph describes page 1 by @id and every node in it references that id. */
const categoryListing = categoryEntries(raw);
const archivePages = categoryListing
  ? categoryPageCount(categoryListing)
  : pageCount(membersOf(raw).length);
const isPagedArchive = raw.kind === 'archive' && archivePages > 1;

const basePage = isBlogIndex
  ? {
      ...blogPageMeta(withSeo, pageNum, blogTotal),
      sections: blogSections(withSeo, pageNum, blogIndex as BlogEntry[]),
    }
  : isPagedArchive
    ? blogPageMeta(withSeo, pageNum, archivePages, `/${raw.slug}/`)
    : withSeo;

/* The author archives are drawn through the category template, with this
   author's posts in its grid -- see authorSections. */
const isAuthorArchive = raw.kind === 'archive' && raw.slug.startsWith('author/');
const authorName = (raw.sections?.[0]?.blocks?.[0] as { text?: string } | undefined)?.text ?? '';
/* A category archive: its own template, with the card grid refilled from the
   category's listing and the pager under it -- see categorySections. */
const page = categoryListing
  ? {
      ...basePage,
      sections: categorySections(basePage.sections, categoryListing, pageNum, `/${raw.slug}/`, archivePages),
    }
  : isAuthorArchive
  ? {
      ...basePage,
      sections: authorSections(
        (archiveTemplate as unknown as PageData).sections,
        authorName,
        membersOf(raw),
        pageNum,
        `/${raw.slug}/`,
        blogIndex as BlogEntry[],
      ),
    }
  : basePage;

/* Every post byline on the original links to that author's archive. Only these
   two archives exist and are linked there; a third author value, "Paolo Leone",
   appears on three pages but /author/paolo* redirects, so it stays plain text. */
const archiveSlug = page.author ? (authorArchives as Record<string, string>)[page.author] : undefined;
const authorHref = archiveSlug ? `/${archiveSlug}/` : undefined;

/* An archive lists the members extracted from the original site, plus any post
   written in /admin that belongs there. Nearly every archive on this site
   carries zero members and renders its listing from ported Elementor markup
   instead, so without this a newly written post would be live at its own
   address and linked from nowhere. The additions are empty until the first
   post is written here, so no existing page changes.

   Only the two author archives carry members at all, and they are paginated:
   the original serves twelve at a time, where this rendered the whole 347 in
   one column. */
const allMembers = membersOf(raw);
const archiveTotal = pageCount(allMembers.length);
/* A plain slice, not bloglist's pageSlice: that one lifts WordPress's sticky
   posts onto page 1, which is a property of the blog index and not of an
   author archive, and it takes entries rather than slugs. */
const archiveMembers = allMembers.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);

/* The Limited Time Offer popup (Elementor template 22055) is not site-wide on
   the original — it is emitted only on the addresses whose "Claim Now" button
   opens it, which is 402 posts and a single page. The port put its markup
   inside every page, so a hidden offer panel, and the 76 words in it, rode
   along on all 676 addresses. Buttons can sit inside a columns block, so the
   search has to descend into those. */
const opensPopup = (blocks: Block[], id: string): boolean =>
  blocks.some((b) =>
    b.type === 'columns'
      ? b.cols.some((c) => opensPopup(c.blocks, id))
      : b.type === 'button' && b.popup === id,
  );
const needsOffer = page.sections.some((s) => opensPopup(s.blocks, 'popup-limited-offer'));

/* The scrolling progress tracker is on exactly the pages that carry the
   Limited Time Offer panel, so it is decided from the page's own blocks rather
   than from a field that nothing else would set. */
const hasBlock = (blocks: Block[], type: string): boolean =>
  blocks.some((b) => (b.type === 'columns' ? b.cols.some((c) => hasBlock(c.blocks, type)) : b.type === type));
const needsProgress = page.sections.some((s) => hasBlock(s.blocks, 'countdown'));

/* Montserrat is requested only where the ported styles name it — four
   addresses, against 1,683 that would otherwise fetch a face they never use.
   Read off the page's own content rather than from a list, so a page edited in
   /admin to use it gets the font without anyone remembering to add it. */
const needsMontserrat =
  JSON.stringify(page.sections).includes('Montserrat') || (page.css ?? '').includes('Montserrat');

const dateLabel = page.published
  ? new Date(page.published).toLocaleDateString('en-CA', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

/* Art-directed hero: the first section of a page can carry three image
   blocks, one per breakpoint, each hiding the other two via the
   `[data-hide]` rules in global.css (see the comment there). Because the
   non-matching two never get a layout box, Blocks.astro's `loading="lazy"`
   on them is never triggered — but neither is the one that *does* show,
   until the browser's lazy-loading heuristic discovers it, which costs LCP
   time on the one image that actually paints.

   Preloading it by the same three media queries fixes that without
   touching Blocks.astro: the browser evaluates each `media` at parse time
   and fetches only the one that matches the current viewport, so this
   stays a single request per breakpoint — never all three. */
const HERO_MEDIA: Record<string, string> = {
  'mobile,tablet': '(min-width: 1025px)',
  'desktop,mobile': '(min-width: 768px) and (max-width: 1024px)',
  'desktop,tablet': '(max-width: 767px)',
};
const heroBlocks = (page.sections[0]?.blocks ?? []).filter(
  (b): b is Extract<Block, { type: 'image' }> =>
    b.type === 'image' && Array.isArray(b.hide) && b.hide.length === 2,
);
const heroCoversAllBreakpoints =
  heroBlocks.length === 3 &&
  new Set(heroBlocks.flatMap((b) => b.hide as string[])).size === 3;
/* CSS background-image hero: a different, non-art-directed pattern than the
   three-image case above. 38 of the 1684 pages (car-wraps and contact among
   them) draw their first section's background from `bgImage` -- rendered by
   Blocks.astro as an inline `background-image:url(...)` on the section --
   rather than from an `<img>`. Chrome's preload scanner cannot discover a CSS
   background-image at all (it only parses markup, not stylesheets/inline
   styles), so this image was never found until the section's own style was
   parsed and painted, measured as the dominant mobile LCP delay on
   /car-wraps/ (lcp-discovery-insight showed no discovery mechanism). No
   media query is needed here, unlike the three-image case: it is one image
   for every breakpoint, so a single unconditional preload is correct. */
const heroPreload = heroCoversAllBreakpoints
  ? heroBlocks
      .map((b) => ({ media: HERO_MEDIA[[...b.hide!].sort().join(',')], href: img(b.src) }))
      .filter((h): h is { media: string; href: string } => !!h.media)
  : page.sections[0]?.bgImage
    ? [{ media: undefined, href: img(page.sections[0].bgImage) }]
    : [];
---

<Base
  title={page.title}
  description={page.description}
  canonical={page.url || undefined}
  ogImage={page.ogImage}
  robots={page.robots}
  head={page.head}
  pageCss={page.css}
  heroPreload={heroPreload}
  offer={needsOffer}
  chrome={page.chrome ?? 'full'}
  progress={needsProgress}
  montserrat={needsMontserrat}
>

  {/* A post's body copy is #444, a page's is #333. Both are ported through the
      same rich-text renderer, so the distinction has to come from the page. */}
  {page.kind === 'post' ? (
    <div class="postbody"><Blocks sections={applyPostTemplate(applyPostLayout(page.slug, page.sections), { author: page.author, authorHref, date: dateLabel })} /></div>
  ) : (
    <Blocks sections={page.sections} />
  )}

  {/* Not on the blog index: its grid is already drawn from the live blog index,
      a post written in /admin included, so a listing under it printed that
      post a second time and added 469px the original does not have. */}
  {page.kind === 'archive' && !isAuthorArchive && raw.slug !== 'blog' && archiveMembers.length > 0 && (
    <ArchiveList members={archiveMembers} />
  )}

  {/* The pager goes after the listing, and only when there is more than one
      page of it. It reuses the blog's control, which is the same Elementor
      pagination the original renders on these archives. */}
  {isPagedArchive && !isAuthorArchive && archiveMembers.length > 0 && (
    <div class="container">
      <Blocks
        sections={[
          {
            id: 'archive-pager',
            blocks: [
              { type: 'pagination', current: pageNum, total: archivePages, base: `/${raw.slug}/` },
            ],
          },
        ]}
      />
    </div>
  )}

</Base>

<style>

  /* theme-post-content sets its own ink, a shade darker than the body's. */
  .postbody :global(.rt) { color: #444444; }

</style>
