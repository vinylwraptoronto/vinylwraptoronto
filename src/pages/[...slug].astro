---
/**
 * One route for every address on the site — 676 of them: pages, posts,
 * category and brand archives, the index listings, and the two web stories.
 *
 * Slugs match the live URLs exactly, so every address the old site serves keeps
 * working without a redirect.
 */
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import ArchiveList from '../components/ArchiveList.astro';
import type { PageData } from '../types';

export const prerender = true;

export async function getStaticPaths() {
  const files = import.meta.glob<PageData>('../data/pages/*.json', {
    eager: true,
    import: 'default',
  });
  return Object.values(files).map((page) => ({
    params: { slug: page.slug === '' ? undefined : page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: PageData };

/* Every post byline on the original links to that author's archive. Only these
   two archives exist and are linked there; a third author value, "Paolo Leone",
   appears on three pages but /author/paolo* redirects, so it stays plain text. */
const AUTHOR_ARCHIVES: Record<string, string> = {
  'Harjit Singh': '/author/harjitbrandingcentres-com/',
  masoud: '/author/masoud/',
};
const authorHref = page.author ? AUTHOR_ARCHIVES[page.author] : undefined;

const dateLabel = page.published
  ? new Date(page.published).toLocaleDateString('en-CA', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<Base
  title={page.title}
  description={page.description}
  canonical={page.url || undefined}
  ogImage={page.ogImage}
  robots={page.robots}
  head={page.head}
  pageCss={page.css}
>
  {page.kind === 'post' && dateLabel && (
    <div class="postmeta">
      <div class="container">
        <time datetime={page.published!}>{dateLabel}</time>
        {page.author && (
          <span class="by">
            by {authorHref ? <a href={authorHref}>{page.author}</a> : page.author}
          </span>
        )}
      </div>
    </div>
  )}

  {/* A post's body copy is #444, a page's is #333. Both are ported through the
      same rich-text renderer, so the distinction has to come from the page. */}
  {page.kind === 'post' ? (
    <div class="postbody"><Blocks sections={page.sections} /></div>
  ) : (
    <Blocks sections={page.sections} />
  )}

  {page.kind === 'archive' && page.members && page.members.length > 0 && (
    <ArchiveList members={page.members} />
  )}

  {/* The original's archive widget renders this in place of the grid when a
      term has no posts (elementor-posts-nothing-found). The port left those
      pages showing nothing at all. */}
  {page.kind === 'archive' && (!page.members || page.members.length === 0) && (
    <div class="nothing-found">
      <div class="container">
        <p>It seems we can't find what you're looking for.</p>
      </div>
    </div>
  )}
</Base>

<style>
  /* Measured on the live post against .elementor-post-info: 16px/24px in #444,
     and the byline link is the same ink, unlined — not the site's green link
     colour. The 13px/#767676 here was invented. */
  .postmeta {
    border-bottom: 1px solid #ececec;
    padding: 14px 0;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: #444444;
  }
  .postmeta .by { margin-left: 12px; }
  .postmeta a { color: inherit; text-decoration: none; }
  .postmeta a:hover { text-decoration: underline; }

  /* theme-post-content sets its own ink, a shade darker than the body's. */
  .postbody :global(.rt) { color: #444444; }

  .nothing-found {
    padding: 24px 0 48px;
    font-family: 'Poppins', sans-serif;
    color: #767676;
  }
</style>
