    {
     "type": "faq",
     "items": [
      {
       "q": "How much does a vehicle wrap cost in Toronto?",
       "a": "<p>Pricing depends on vehicle size, coverage, and finish. Full colour change wraps start at $2,500 for select vehicles/finishes—request a quote for exact pricing.</p>"
      },
      {
       "q": "How long does installation take?",
       "a": "<p>Timelines vary by job type and schedule. Commercial decals are often quicker once design is approved; full wraps are scheduled by vehicle and finish availability.</p>"
      },
      {
       "q": "Do you offer a warranty?",
       "a": "<p>Yes. We offer a 3-year warranty against peeling, bubbling, or fading.</p>"
      },
      {
       "q": "What vehicles do you wrap?",
       "a": "<p>Cars, vans, trucks, trailers, and many commercial vehicle types.</p>"
      }
     ],
     "eid": "2d41bb2",
     "openIndex": 0
    }
