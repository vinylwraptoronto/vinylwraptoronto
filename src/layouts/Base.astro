---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Popups from '../components/Popups.astro';
import StickyBar from '../components/StickyBar.astro';
import Interactions from '../components/Interactions.astro';
import { site } from '../data/site';
import { img, imgOrigin } from '../lib/img';
import '../styles/tokens.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string | null;
  /** Carried from the original: most taxonomy archives are noindex there. */
  robots?: string | null;
}

const { title, description = '', canonical, ogImage, robots } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = ogImage ? new URL(img(ogImage), site.url).href : undefined;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />

    {/* Every image on the page comes from the B2-backed image host, so open
        that connection alongside the document rather than on first <img>. */}
    {imgOrigin && <link rel="preconnect" href={imgOrigin} crossorigin="anonymous" />}
    {imgOrigin && <link rel="dns-prefetch" href={imgOrigin} />}

    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Self-hosted, exactly the faces the live site serves. "Roboto Slab" is
         declared in the Elementor kit but loads no face there, so it is not
         requested here either. -->
    <link rel="preconnect" href="/" />
    <link rel="stylesheet" href="/fonts/poppins.css" />
    <link rel="stylesheet" href="/fonts/roboto.css" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <Popups />
    <Interactions />

    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--e-global-color-d077a13);
        color: #fff;
        padding: 10px 16px;
        z-index: 999;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
