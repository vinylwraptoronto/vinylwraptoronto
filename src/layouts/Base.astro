---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Popups from '../components/Popups.astro';
import StickyBar from '../components/StickyBar.astro';
import Interactions from '../components/Interactions.astro';
import ClickSparks from '../components/ClickSparks.astro';
import { site } from '../data/site';
import { img, imgOrigin } from '../lib/img';
import type { HeadData } from '../types';
import '../styles/tokens.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string | null;
  /** Carried from the original: most taxonomy archives are noindex there. */
  robots?: string | null;
  /** The original's own head tags and Yoast JSON-LD graph for this page. */
  head?: HeadData;
  /** The page's own responsive rules, keyed by each block's data-eid. */
  pageCss?: string;
  /** Whether this address actually holds a button that opens the Limited Time
      Offer popup. The original emits that template only where it is used. */
  offer?: boolean;
  /** How much site chrome the original serves on this address.

      Four of the 678 are not served with the theme's header and footer at all.
      The two landing pages use Elementor's Canvas template: they carry their
      own logo bar and a one-line copyright as page content, and keep the
      sticky bar and the popups. The two web stories are AMP pages with no
      chrome of any kind — no header, footer, sticky bar or popup.

      Rendering the full header and the 856px footer on them put 904px on /lp/
      that the original does not have, which was most of its height gap. */
  chrome?: 'full' | 'bare' | 'none';
  /** Elementor's scrolling progress tracker: a 5px bar stuck to the top that
      fills as the reader moves down. It is on the same 402 post pages as the
      Limited Time Offer panel, so the caller decides from the page's own
      blocks rather than from a field nothing else would set. */
  progress?: boolean;
}

const {
  title, description = '', canonical, ogImage, robots, head, pageCss, offer = false,
  chrome = 'full', progress = false,
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = ogImage ? new URL(img(ogImage), site.url).href : undefined;

/*
 * The head is taken from the original rather than hand-written. The port used
 * to invent og:locale (en_CA against the original's en_US) and og:type
 * (website against article on all but two pages), and omitted the Twitter card,
 * the article dates, the image dimensions, the icons and the JSON-LD entirely.
 *
 * Tags arrive as an ordered [key, isProperty, value] list rather than a map,
 * because the original repeats keys: 254 pages carry several article:tag tags
 * (18 on one) and 77 carry two different description tags. Order and
 * repetition are reproduced as-is.
 */
type MetaTag = [key: string, isProperty: boolean, value: string];

const source = (head?.meta as MetaTag[] | undefined) ?? [];

// The landing pages use viewport-fit=cover and the web stories minimum-scale=1,
// where the port hardcoded one value for every page. It is emitted in its own
// slot near the top of the head, so it is pulled out of the generic run.
let viewport = 'width=device-width, initial-scale=1';
const carriedTags: MetaTag[] = [];

for (const [key, isProperty, value] of source) {
  if (!value) continue;
  if (key.toLowerCase() === 'viewport') {
    viewport = value;
    continue;
  }
  // Upload URLs were made root-relative upstream so they can be pointed at the
  // image host, which is where the files actually live now.
  carriedTags.push([
    key,
    isProperty,
    value.startsWith('/wp-content/uploads/') ? new URL(img(value), site.url).href : value,
  ]);
}

// 404 and anything else rendered without carried head data still needs a head.
if (!source.length) {
  if (description) carriedTags.push(['description', false, description]);
  if (robots) carriedTags.push(['robots', false, robots]);
  carriedTags.push(['og:title', true, title]);
  if (description) carriedTags.push(['og:description', true, description]);
  carriedTags.push(['og:url', true, canonicalUrl]);
  carriedTags.push(['og:site_name', true, site.name]);
  if (ogImageUrl) carriedTags.push(['og:image', true, ogImageUrl]);
  carriedTags.push(['twitter:card', false, 'summary_large_image']);
}

/* JSON.stringify does not escape "</script>", which would close the block early.

   An array means several blocks rather than one block holding a list: the two
   landing pages serve Yoast's @graph and a separate FAQPage, as the original
   does. Every other address carries a single object and renders exactly as
   before. */
const ldBlocks = (head?.ld == null ? [] : Array.isArray(head.ld) ? head.ld : [head.ld])
  .filter(Boolean)
  .map((block) => JSON.stringify(block).replace(/</g, '\\u003c'));

const iconHref = new URL(img(site.favicon), site.url).href;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewport} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    {/* Every image on the page comes from the B2-backed image host, so open
        that connection alongside the document rather than on first <img>. */}
    {imgOrigin && <link rel="preconnect" href={imgOrigin} crossorigin="anonymous" />}
    {imgOrigin && <link rel="dns-prefetch" href={imgOrigin} />}

    <link rel="icon" href={iconHref} sizes="32x32" />
    <link rel="icon" href={iconHref} sizes="192x192" />
    <link rel="apple-touch-icon" href={iconHref} />

    {carriedTags.map(([key, isProperty, value]) =>
      isProperty
        ? <meta property={key} content={value} />
        : <meta name={key} content={value} />)}

    {ldBlocks.map((block) => <script type="application/ld+json" set:html={block} />)}

    <!-- Self-hosted, exactly the faces the live site serves. "Roboto Slab" is
         declared in the Elementor kit but loads no face there, so it is not
         requested here either. -->
    <link rel="stylesheet" href="/fonts/poppins.css" />
    <link rel="stylesheet" href="/fonts/roboto.css" />
    {/* The original draws 66 icons on the homepage alone — in the nav carets,
        the icon lists, the icon boxes, the buttons and the footer social row —
        and the port shipped none of them. Same Font Awesome build the live site
        serves, so the glyphs are the ones the design was drawn with. */}
    <link rel="stylesheet" href="/fonts/fontawesome.css" />
    <link
      rel="preload"
      href="/fonts/files/fa-solid-900.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* Elementor keeps 19% of its per-widget CSS inside a breakpoint. The
        extractor used to drop all of it, so below 1440px every ported heading
        kept its desktop size while the original shrank it. */}
    {pageCss && <style is:inline set:html={pageCss} />}
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    {progress && (
      <div class="readbar" aria-hidden="true"><span class="readbar-fill"></span></div>
    )}
    {chrome === 'full' && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome === 'full' && <Footer />}
    {chrome !== 'none' && <StickyBar />}
    {chrome !== 'none' && <Popups offer={offer} />}
    <Interactions />
    <ClickSparks />

    <style is:global>
      /* The reading progress bar: 5px, stuck to the top, 3px radius, the fill
         in the kit's green over a transparent track — the values the widget
         declares. It sits above the sticky header, which is z-index 100. */
      .readbar {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        height: 5px;
        z-index: 120;
        pointer-events: none;
        background: transparent;
      }
      .readbar-fill {
        display: block;
        height: 100%;
        width: 0;
        border-radius: 3px;
        background: var(--e-global-color-a8178e9);
      }
      @media (prefers-reduced-motion: no-preference) {
        .readbar-fill { transition: width 0.1s linear; }
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--e-global-color-d077a13);
        color: #fff;
        padding: 10px 16px;
        z-index: 999;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
