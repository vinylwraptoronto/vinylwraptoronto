---
/**
 * Renders the block model produced from each live page's Elementor markup.
 *
 * Elementor's nesting is not reproduced — it is a builder artefact, not the
 * design. Each page is reduced to ordered sections of typed blocks and drawn
 * with the measured type scale and palette.
 */
import type { Block, Section } from '../types';
import categories from '../data/categories.json';
import QuoteForm from './QuoteForm.astro';
import { img, imgHtml } from '../lib/img';

export interface Props {
  /** Normal use: whole sections, each with its own padding and container. */
  sections?: Section[];
  /** Recursive use: the blocks of one column, rendered without a section
      wrapper. Elementor rows put blocks side by side and a column can hold
      almost any block type — including another row — so the renderer calls
      itself through Astro.self rather than special-casing a subset. */
  blocks?: Block[];
  /** The page's table-of-contents entries, threaded through the recursion.
      The TOC widget almost always sits inside a column, so a renderer that
      only looked at `sections` saw an empty list and drew nothing. */
  toc?: TocEntry[];
}

type TocEntry = { eid?: string; text: string; level: number; id: string };

const { sections, blocks, toc } = Astro.props;

const groups: { section?: Section; blocks: Block[]; bare: boolean }[] = blocks
  ? [{ blocks, bare: true }]
  : (sections ?? []).map((s) => ({ section: s, blocks: s.blocks, bare: false }));

const num = (v?: string | null) => (v && /^\d+$/.test(v) ? Number(v) : undefined);

/** Stable anchor id from heading text, so the table of contents can link to it. */
const slugify = (t: string) =>
  t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);

/* One line of the category dropdown, spelled the way the original spells it:
   three non-breaking spaces per level of nesting, then the name, then two more
   before the count. Built here rather than in the template so the escapes stay
   readable. */
function catOption(name: string, count: number, level: number): string {
  return `${' '.repeat(level * 3)}${name}  (${count})`;
}

/* The share widget's six networks, in the original's order, each with the
   icon it uses and its official brand colour (the colours live in the style
   block below).

   The original renders these as <div role="button"> and opens a popup from
   JavaScript. These are real links instead: same destinations, but they work
   with JS off, and can be middle-clicked, copied or opened in a new tab —
   which a div cannot. */
const SHARE_NETWORKS = [
  { id: 'facebook', label: 'Facebook', icon: 'fab fa-facebook',
    href: (u: string) => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(u)}` },
  { id: 'twitter', label: 'Twitter', icon: 'fab fa-twitter',
    href: (u: string) => `https://twitter.com/intent/tweet?url=${encodeURIComponent(u)}` },
  { id: 'linkedin', label: 'LinkedIn', icon: 'fab fa-linkedin',
    href: (u: string) => `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(u)}` },
  { id: 'whatsapp', label: 'WhatsApp', icon: 'fab fa-whatsapp',
    href: (u: string) => `https://api.whatsapp.com/send?text=${encodeURIComponent(u)}` },
  { id: 'pinterest', label: 'Pinterest', icon: 'fab fa-pinterest',
    href: (u: string) => `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(u)}` },
  { id: 'email', label: 'Email', icon: 'fas fa-envelope',
    href: (u: string) => `mailto:?body=${encodeURIComponent(u)}` },
];

/* Pagination for the blog index.
   Computed here rather than in the template: the block below renders inside a
   JSX expression, where statements and type annotations are a syntax error --
   an inline `for` loop there fails the build with a bare "Unexpected ;". */
function pagerHref(base: string, n: number): string {
  return n <= 1 ? base : `${base}page/${n}/`;
}

/* 1 … 15 16 17 18 19 … 34 — the exact window WordPress's paginate_links()
   produces for this widget: end_size 1 (first and last page always shown) and
   mid_size 2 (two either side of the current one). Read off the original's own
   markup on pages 1, 2, 17 and 34 rather than guessed; a ±1 window looked
   right on page 17 but showed "1 2 … 34" on page 1 where the original shows
   "1 2 3 … 34". */
function pagerSteps(current: number, total: number): (number | string)[] {
  const steps: (number | string)[] = [];
  for (let n = 1; n <= total; n++) {
    if (n === 1 || n === total || Math.abs(n - current) <= 2) steps.push(n);
    else if (steps[steps.length - 1] !== '…') steps.push('…');
  }
  return steps;
}

/* The live table of contents is built client-side from the page's own
   headings (the widget is configured for h2-h6). Rebuilt here from the same
   source so it lists the same entries.

   It has to walk the whole section tree: headings live inside columns, and a
   flat pass over the top-level blocks found none of them, so the panel came
   out empty on all 402 posts that carry the widget. */
function collectHeadings(node: unknown, into: TocEntry[]): void {
  if (Array.isArray(node)) {
    for (const v of node) collectHeadings(v, into);
    return;
  }
  if (!node || typeof node !== 'object') return;
  const b = node as Record<string, unknown>;
  // `tag` means the widget rendered as p or div, so it is not a heading.
  if (b.type === 'heading' && !b.tag && typeof b.level === 'number' &&
      b.level >= 2 && b.level <= 6 && typeof b.text === 'string') {
    into.push({ eid: b.eid as string | undefined, text: b.text, level: b.level, id: '' });
  }
  // Most of a post's headings are inside the rich-text body, not the block
  // model, so a walk over blocks alone listed only the few standalone heading
  // widgets. These are keyed `<eid>#<n>` so the renderer can inject the very
  // same id into the same tag.
  if (b.type === 'text' && typeof b.html === 'string') {
    let n = 0;
    for (const m of b.html.matchAll(/<h([2-6])\b[^>]*>([\s\S]*?)<\/h\1>/g)) {
      const text = m[2].replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').trim();
      if (text) {
        into.push({ eid: `${b.eid ?? 'rt'}#${n}`, text, level: Number(m[1]), id: '' });
      }
      n++;
    }
  }
  for (const v of Object.values(b)) collectHeadings(v, into);
}

const tocEntries: TocEntry[] =
  toc ??
  (() => {
    const found: TocEntry[] = [];
    collectHeadings(sections ?? [], found);
    // Headings repeat — several posts carry the same price twice — so ids are
    // suffixed on collision, and the heading uses the same id by eid lookup.
    const used = new Map<string, number>();
    return found
      .map((e) => {
        const base = slugify(e.text);
        if (!base) return { ...e, id: '' };
        const n = (used.get(base) ?? 0) + 1;
        used.set(base, n);
        return { ...e, id: n === 1 ? base : `${base}-${n}` };
      })
      .filter((e) => e.id);
  })();

/** eid -> anchor id, so a heading and its TOC entry always agree. */
const tocIds = new Map<string, string>();
for (const e of tocEntries) if (e.eid) tocIds.set(e.eid, e.id);

/* A gallery's grid comes from the widget, not from one site-wide rule: the
   column count per breakpoint, the tile crop and the gutter are all declared
   per instance. Each becomes a custom property on the grid element, and the
   stylesheet falls back to the old fixed values where a gallery declares
   nothing. The whole track list travels in one property so the fallback can
   stay an auto-fill rule rather than a column count. */
const track = (n?: number | null) => (n && n > 0 ? `repeat(${n}, minmax(0, 1fr))` : null);

const galleryStyle = (b: {
  cols?: number | null; colsTablet?: number | null; colsMobile?: number | null;
  aspect?: string | null;
  gap?: number | null; gapTablet?: number | null; gapMobile?: number | null;
}) => {
  const parts: string[] = [];
  const put = (k: string, v: string | null) => v && parts.push(`${k}:${v}`);
  put('--fg-track', track(b.cols));
  put('--fg-track-t', track(b.colsTablet));
  put('--fg-track-m', track(b.colsMobile));
  /* Masonry is laid out with CSS columns, which want the count itself rather
     than a grid track list. */
  put('--fg-cols', b.cols ? String(b.cols) : null);
  put('--fg-cols-t', b.colsTablet ? String(b.colsTablet) : null);
  put('--fg-cols-m', b.colsMobile ? String(b.colsMobile) : null);
  // Elementor writes the ratio as "16:9"; CSS wants "16 / 9".
  put('--fg-aspect', b.aspect ? b.aspect.replace(':', ' / ') : null);
  put('--fg-gap', typeof b.gap === 'number' ? `${b.gap}px` : null);
  put('--fg-gap-t', typeof b.gapTablet === 'number' ? `${b.gapTablet}px` : null);
  put('--fg-gap-m', typeof b.gapMobile === 'number' ? `${b.gapMobile}px` : null);
  return parts.length ? parts.join(';') : undefined;
};
---

{groups.map((group) => {
  const section = group.section;
  const blocksArr = group.blocks;
  const inner = blocksArr.map((b, i) => {
        if (b.type === 'heading') {
          const Tag = (b.tag ?? `h${Math.min(Math.max(b.level, 1), 6)}`) as 'h1';
          const id = b.eid ? tocIds.get(b.eid) : undefined;
          return (
            <Tag id={id} data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
              {b.href ? <a class="hlink" href={img(b.href)}>{b.text}</a> : b.text}
            </Tag>
          );
        }

        if (b.type === 'toc') {
          return tocEntries.length > 0 ? (
            <nav class="toc" aria-label={b.title}>
              <h4 class="toc-title">{b.title}</h4>
              <ol>
                {tocEntries.map((e) => (
                  <li class={e.level === 3 ? 'lvl3' : 'lvl2'}>
                    <a href={`#${e.id}`}>{e.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : null;
        }

        if (b.type === 'categories') {
          return (
            <div class="catlist">
              <h5 class="cat-title">{b.title}</h5>
              <form class="catform">
                <label class="elementor-screen-only" for="cat">{b.title}</label>
                <select name="cat" id="cat" class="postform" data-catnav>
                  <option value="">Select Category</option>
                  {categories.map((c) => (
                    <option value={c.href}>{catOption(c.name, c.count, c.level ?? 0)}</option>
                  ))}
                </select>
              </form>
              {/* The original's widget is JS-driven too: WordPress attaches a
                  change handler that submits the form to ?cat=<term id>. There
                  is no query handler on a static site, so the option value is
                  the archive address itself and the handler navigates to it —
                  same control, same options, same destination. */}
              <script is:inline>
                document.querySelectorAll('select[data-catnav]').forEach((s) => {
                  s.addEventListener('change', () => {
                    if (s.value) window.location.href = s.value;
                  });
                });
              </script>
            </div>
          );
        }

        if (b.type === 'text') {
          // Give each body heading the id its table-of-contents entry links to.
          let n = 0;
          const withIds = imgHtml(b.html).replace(
            /<h([2-6])\b([^>]*)>/g,
            (whole, lvl, attrs) => {
              const key = `${b.eid ?? 'rt'}#${n++}`;
              const id = tocIds.get(key);
              return id && !/\bid=/.test(attrs) ? `<h${lvl}${attrs} id="${id}">` : whole;
            },
          );
          return <div class="rt" data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined} set:html={withIds} />;
        }

        if (b.type === 'image') {
          const pic = (
            <img
              src={img(b.src)}
              alt={b.alt}
              width={num(b.width)}
              height={num(b.height)}
              loading="lazy"
              decoding="async"
            />
          );
          return (
            <figure class={b.full ? 'fig fig--full' : 'fig'} data-eid={b.eid} data-hide={b.hide?.join(" ")}>
              {b.href ? <a href={img(b.href)}>{pic}</a> : pic}
            </figure>
          );
        }

        if (b.type === 'button') {
          // The live buttons are 50%-width siblings, so a run of them sits on
          // one centred row rather than stacking.
          const prev = blocksArr[i - 1];
          if (prev && prev.type === 'button') return null;
          const run = [];
          for (let k = i; k < blocksArr.length; k++) {
            const nb = blocksArr[k];
            if (nb.type !== 'button') break;
            run.push(nb);
          }
          return (
            <p class="btnrow" data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
              {run.map((rb) => (
                rb.popup ? (
                  <button class="btn" type="button" data-popup={rb.popup} style={rb.style ?? undefined}>
                    {rb.icon && <i class:list={['btn-ic', rb.icon]} aria-hidden="true"></i>}
                    {rb.text}
                  </button>
                ) : (
                  <a class="btn" href={img(rb.href!)} style={rb.style ?? undefined}>
                    {rb.icon && <i class:list={['btn-ic', rb.icon]} aria-hidden="true"></i>}
                    {rb.text}
                  </a>
                )
              ))}
            </p>
          );
        }

        if (b.type === 'list') {
          return (
            <ul class="ilist" data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
              {b.items.map((i) => (
                <li class:list={{ 'has-ic': !!i.icon }} style={b.itemStyle ?? undefined}>
                  {i.icon && <i class:list={['li-ic', i.icon]} aria-hidden="true"></i>}
                  {i.href ? <a href={img(i.href)}>{i.text}</a> : i.text}
                </li>
              ))}
            </ul>
          );
        }

        if (b.type === 'feature') {
          const T = `h${Math.min(Math.max(b.level ?? 3, 1), 6)}` as 'h3';
          return (
            <div class="feature" data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
              {b.icon && (
                b.iconHref
                  ? <a class="feature-ic" href={img(b.iconHref)} tabindex="-1" aria-hidden="true"><i class={b.icon}></i></a>
                  : <span class="feature-ic" aria-hidden="true"><i class={b.icon}></i></span>
              )}
              {b.image && <img src={img(b.image)} alt={b.alt ?? ''} loading="lazy" decoding="async" />}
              {b.title && <T style={b.titleStyle ?? undefined}>{b.title}</T>}
              {b.text && <p style={b.textStyle ?? undefined}>{b.text}</p>}
            </div>
          );
        }

        if (b.type === 'pagination') {
          return (
            <nav class="elementor-pagination" aria-label="Pagination" data-eid={b.eid}>
              {b.current > 1 ? (
                <a class="page-numbers prev" href={pagerHref(b.base, b.current - 1)} rel="prev">« Previous</a>
              ) : (
                <span class="page-numbers prev">« Previous</span>
              )}
              {pagerSteps(b.current, b.total).map((n) =>
                n === '…' ? (
                  <span class="page-numbers dots">…</span>
                ) : n === b.current ? (
                  <span class="page-numbers current" aria-current="page">
                    <span class="elementor-screen-only">Page</span>{n}
                  </span>
                ) : (
                  <a class="page-numbers" href={pagerHref(b.base, n as number)}>
                    <span class="elementor-screen-only">Page</span>{n}
                  </a>
                ),
              )}
              {b.current < b.total ? (
                <a class="page-numbers next" href={pagerHref(b.base, b.current + 1)} rel="next">Next »</a>
              ) : (
                <span class="page-numbers next">Next »</span>
              )}
            </nav>
          );
        }

        /* The theme's archive template, not Elementor's posts widget: entries
           stacked full width, each an h2 title link over the featured image
           over the excerpt. Measured on the original at 1440: main 1140px,
           .page-content display:block, h2 28px/33.6 Poppins 600 capitalize
           with a #FF0099 link, the image at the container's width and its own
           ratio, the excerpt 16px/24. */
        if (b.type === 'cards' && b.stacked) {
          return (
            <div class="arch" data-eid={b.eid} data-hide={b.hide?.join(' ')}>
              {b.cards.map((c) => (
                <article class="arch-post">
                  <h2><a href={c.href}>{c.title}</a></h2>
                  {c.image && (
                    <a
                      class:list={['arch-thumb', { 'arch-thumb--natural': c.natural }]}
                      href={c.href}
                      tabindex="-1"
                    >
                      <img
                        src={img(c.image)}
                        alt={c.alt ?? c.title}
                        width={c.natural ? c.w : undefined}
                        height={c.natural ? c.h : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  {/* The story player. It is an AMP component on the original;
                      what it shows at rest is the story's poster at the box it
                      declares, so that is what is drawn, as a link into the
                      story rather than a dead frame. */}
                  {c.story && c.image && (
                    <a
                      class="arch-story"
                      href={c.href}
                      style={`width:${c.story.w}px;height:${c.story.h}px`}
                      aria-label={`Open the story: ${c.title}`}
                    >
                      <img src={img(c.image)} alt="" loading="lazy" decoding="async" />
                    </a>
                  )}
                  {c.desc && <p class="arch-excerpt">{c.desc}</p>}
                </article>
              ))}
            </div>
          );
        }

        if (b.type === 'cards') {
          return (
            <ul
              class="cards"
              data-eid={b.eid}
              data-hide={b.hide?.join(" ")}
              style={[
                b.cols ? `--cards-d:${b.cols}` : '',
                b.colsTablet ? `--cards-t:${b.colsTablet}` : '',
                b.colsMobile ? `--cards-m:${b.colsMobile}` : '',
                typeof b.gapCol === 'number' ? `--cards-gap-c:${b.gapCol}px` : '',
                typeof b.gapRow === 'number' ? `--cards-gap-r:${b.gapRow}px` : '',
              ].filter(Boolean).join(';') || undefined}
            >
              {b.cards.map((c) => (
                <li>
                  {c.badge && <span class="card-badge" style={b.badgeStyle ?? undefined}>{c.badge}</span>}
                  {c.image && (
                    <a class="card-thumb" href={c.href} tabindex="-1">
                      <img
                        src={img(c.image)}
                        alt={c.alt ?? c.title}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div class="card-text">
                    {/* The original titles each card with
                        <h3 class="elementor-post__title">; a span instead took
                        1,223 headings out of the document outline. */}
                    <h3 style={b.titleStyle ?? undefined}><a href={c.href}>{c.title}</a></h3>
                    {c.desc && <p class="card-desc" style={b.descStyle ?? undefined}>{c.desc}</p>}
                    {c.more && (
                      <a
                        class="card-more"
                        style={b.moreStyle ?? undefined}
                        href={c.href}
                        aria-label={`Read more about ${c.title}`}
                        tabindex="-1"
                      >{c.more}</a>
                    )}
                  </div>
                  {(c.author || c.date) && (
                    <div class="card-meta" style={b.metaStyle ?? undefined}>
                      {c.author && <span class="card-author">{c.author}</span>}
                      {c.date && <span class="card-date">{c.date}</span>}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          );
        }

        if (b.type === 'postnav') {
          return (
            <nav class="postnav" aria-label="Post navigation">
              {b.prev && (
                <a class="postnav-prev" href={b.prev.href} rel="prev">
                  <span class="dir">Previous</span>
                  <span class="t">{b.prev.text}</span>
                </a>
              )}
              {b.next && (
                <a class="postnav-next" href={b.next.href} rel="next">
                  <span class="dir">Next</span>
                  <span class="t">{b.next.text}</span>
                </a>
              )}
            </nav>
          );
        }

        if (b.type === 'carousel') {
          return (
            <div
              class="carou"
              data-carousel
              data-per={b.perView}
              data-per-mobile={b.perViewMobile}
              data-autoplay={b.autoplay ? 'yes' : 'no'}
              data-delay={b.delay}
              data-speed={b.speed}
              data-pause={b.pauseOnHover ? 'yes' : 'no'}
              data-infinite={b.infinite ? 'yes' : 'no'}
              style={`--carou-gap:${b.gap}px`}
            >
              <div class="carou-track">
                {b.images.map((i) => (
                  <figure class="carou-slide">
                    <img src={img(i.src)} alt={i.alt} loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
              {b.dots && <div class="carou-dots" role="tablist" aria-label="Slide"></div>}
            </div>
          );
        }

        if (b.type === 'gallery') {
          return (
            <div class="gallery">
              {b.images.map((i) => (
                <a class="lb-link" href={img(i.src)}>
                  <img src={img(i.src)} alt={i.alt} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          );
        }

        if (b.type === 'faq') {
          return (
            <div class="faq">
              {b.items.map((qa) => (
                <details>
                  <summary>{qa.q}</summary>
                  <div class="rt" set:html={imgHtml(qa.a)} />
                </details>
              ))}
            </div>
          );
        }

        if (b.type === 'divider') {
          return <hr class="wdivider" data-eid={b.eid} />;
        }

        if (b.type === 'countdown') {
          /* Rendered with the digits blank and the whole thing hidden until the
             script fills it in: an evergreen countdown has no server-side value,
             and four zeroes flashing before it starts would read as expired. */
          return (
            <div class="cdown" data-eid={b.eid} data-countdown={b.interval} hidden>
              {[['days', 'Days'], ['hours', 'Hours'], ['minutes', 'Minutes'], ['seconds', 'Seconds']].map(
                ([k, label]) => (
                  <div class="cdown-item">
                    <span class="cdown-digits" data-unit={k}>&nbsp;</span>
                    <span class="cdown-label">{label}</span>
                  </div>
                ),
              )}
            </div>
          );
        }

        if (b.type === 'share') {
          return (
            <div class="share" role="list">
              {SHARE_NETWORKS.map((n) => (
                <a
                  class={`share-btn share-btn--${n.id}`}
                  role="listitem"
                  href={n.href(b.url)}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Share on ${n.label}`}
                >
                  <span class="share-ic"><i class={n.icon} aria-hidden="true"></i></span>
                  <span class="share-tx">{n.label}</span>
                </a>
              ))}
            </div>
          );
        }

        if (b.type === 'compare') {
          return (
            <div class="compare">
              {b.pairs.map((p) => (
                <div class="compare-pair">
                  <figure>
                    <img src={img(p.before.src)} alt={p.before.alt} loading="lazy" decoding="async" />
                    <figcaption>{p.beforeLabel}</figcaption>
                  </figure>
                  <figure>
                    <img src={img(p.after.src)} alt={p.after.alt} loading="lazy" decoding="async" />
                    <figcaption>{p.afterLabel}</figcaption>
                  </figure>
                </div>
              ))}
            </div>
          );
        }

        if (b.type === 'filtergallery') {
          return (
            <div class="fgal" data-filtergallery>
              {b.filters.length > 0 && (
                <div class="fgal-tabs" role="tablist" aria-label="Gallery filter">
                  {b.filters.map((f, i) => (
                    <button
                      type="button"
                      role="tab"
                      class="fgal-tab"
                      data-index={f.index}
                      aria-selected={i === 0 ? 'true' : 'false'}
                    >
                      {f.label}
                    </button>
                  ))}
                </div>
              )}
              <div class:list={['fgal-grid', { 'fgal-grid--masonry': b.masonry }]} style={galleryStyle(b)}>
                {b.items.map((it) => (
                  <figure class="fgal-item" data-tag={it.tag}>
                    {/* The original wraps every gallery item in a link to the
                        full-size file and opens its lightbox from there. The
                        link is what makes the picture reachable with JS off. */}
                    <a class="lb-link" href={img(it.src)} title={it.title}>
                      <img src={img(it.src)} alt={it.alt ?? it.title} loading="lazy" decoding="async" />
                    </a>
                  </figure>
                ))}
              </div>
            </div>
          );
        }

        if (b.type === 'form') {
          const form = (
            <QuoteForm
              id={`f-${section?.id ?? 's'}`}
              fields={b.fields}
              placeholders={b.placeholders}
              submit={b.submit}
            />
          );
          return b.style ? <div class="formwrap" style={b.style}>{form}</div> : form;
        }

        if (b.type === 'map') {
          return (
            <div class="mapembed">
              <iframe
                src={b.src}
                title="Map"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          );
        }

        if (b.type === 'video') {
          return (
            <div class="video">
              <iframe
                src={b.src}
                title="Video"
                loading="lazy"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
          );
        }

        if (b.type === 'columns') {
          return (
            <div class="cols" style={b.margin ? `margin:${b.margin}` : undefined}>
              {b.cols.map((c) => {
                /* Only a column that sits on a colour of its own gets one; a
                   declared #ffffff is the page background already. */
                const tinted = c.background && c.background.toLowerCase() !== '#ffffff';
                const style = [
                  `--col-w:${c.width}%`,
                  tinted ? `background-color:${c.background}` : '',
                  tinted && c.padding ? `padding:${c.padding}` : '',
                  /* Not gated on `tinted`: a border or shadow is drawn whether
                     or not the column sits on a colour of its own. */
                  c.border ? c.border : '',
                  c.shadow ? `box-shadow:${c.shadow}` : '',
                  c.radius ? `border-radius:${c.radius}` : '',
                ].filter(Boolean).join(';');
                return (
                  <div class:list={['col', { 'col--tinted': tinted }]} style={style}>
                    <Astro.self blocks={c.blocks} toc={tocEntries} />
                  </div>
                );
              })}
            </div>
          );
        }

        return null;
  });

  /* #ffffff is the page's own background, so declaring it changes nothing;
     skipping it keeps the emitted style attribute to the sections that
     actually sit on a colour. */
  const secStyle = [
    section?.padding ? `padding:${section.padding}` : '',
    section?.background && section.background.toLowerCase() !== '#ffffff'
      ? `background-color:${section.background}`
      : '',
    section?.bgImage ? `background-image:url(${img(section.bgImage)})` : '',
    section?.bgImage ? `background-size:${section.bgSize ?? 'cover'}` : '',
    section?.bgImage ? `background-position:${section.bgPosition ?? 'center center'}` : '',
    section?.bgImage ? `background-repeat:${section.bgRepeat ?? 'no-repeat'}` : '',
  ].filter(Boolean).join(';');

  return group.bare ? inner : (
    <section
      class:list={[
        'sec',
        section?.contentAlign ? `sec--${section.contentAlign}` : null,
        { 'sec--overlaid': section?.overlay },
      ]}
      data-eid={section?.id ?? undefined}
      style={secStyle || undefined}
    >
      {section?.overlay && (
        <div
          class="sec-ovl"
          aria-hidden="true"
          style={[
            section.overlay.color ? `background-color:${section.overlay.color}` : '',
            section.overlay.image ? `background-image:${section.overlay.image}` : '',
            section.overlay.opacity ? `opacity:${section.overlay.opacity}` : '',
          ].filter(Boolean).join(';') || undefined}
        />
      )}
      <div
        class:list={['container', 'stack', { 'container--full': section?.fullWidth }]}
        style={[
          section?.maxWidth ? `max-width:${section.maxWidth}` : '',
          section?.minHeight ? `min-height:${section.minHeight}` : '',
        ].filter(Boolean).join(';') || undefined}
      >
        {inner}
      </div>
    </section>
  );
})}

<style>
  .sec { padding: 34px 0; }
  /* elementor-section-full_width: edge to edge, and no gutter on the inner
     wrapper — the section's own padding is the only inset. */
  .container--full { max-width: none; padding-inline: 0; }

  /* Elementor's background overlay sits between the section's own background
     and its content, so the content has to be lifted above it. */
  .sec--overlaid { position: relative; }
  .sec-ovl { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .sec--overlaid > .container { position: relative; z-index: 1; }
  .sec:first-child { padding-top: 26px; }

  /* Blog pagination.
     Values taken from the original's own inline Elementor CSS for this widget
     (.elementor-18950 .elementor-element-7b1f0d7f .elementor-pagination), not
     estimated: 18px Poppins 400, centred, 30px above, and 5px of margin either
     side of each entry — Elementor writes that as calc(10px/2) on
     :not(:first-child) and :not(:last-child), which is 5px everywhere except
     the two ends. The three colours are the site's own global palette tokens,
     so they follow any later change to them. */
  .elementor-pagination {
    margin-top: 30px;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 400;
  }
  .elementor-pagination .page-numbers:not(:first-child) { margin-left: 5px; }
  .elementor-pagination .page-numbers:not(:last-child) { margin-right: 5px; }
  .elementor-pagination .page-numbers:not(.dots) {
    color: var(--e-global-color-d077a13);
    text-decoration: none;
  }
  .elementor-pagination a.page-numbers:hover { color: var(--e-global-color-8c22d81); }
  .elementor-pagination .page-numbers.current { color: var(--e-global-color-f32bb28); }
  /* On page 1 "« Previous" and on page 34 "Next »" are spans, not links — the
     same thing the original renders. Dimming them says so without moving
     anything, which a display:none would. */
  .elementor-pagination span.prev,
  .elementor-pagination span.next { opacity: 0.45; }

  /* "Page" before each number, for screen readers only. Same rule Elementor
     ships; the numbers alone read as a bare list of digits. */
  .elementor-screen-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Elementor rows. Columns carry their own percentage width, so the row is a
     flex line rather than a fixed grid — 50+50, 33+33+33 and 25x4 all fall out
     of the same rule. Without this the columns stacked, which made a section
     that is 440px tall on the live site render at 1642px. */
  /* Columns stretch to the row's height, which is Elementor's default:
     frontend.min.css sets `.elementor-section .elementor-container{display:flex}`
     with no align-items, and a section only opts out by carrying
     elementor-section-items-top / -middle / -bottom. Across every original page
     captured for this port — 23 sections — not one does.

     This said flex-start, so a column was only ever as tall as its content: on
     /car-wrap-faqs/ the navy panel beside the diagram stopped after its two
     lines of heading instead of filling the row. */
  .cols {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    /* A row gap, not just a column gap. It is inert for a row that fits on one
       line, which is most of them, and only shows where columns wrap: the
       69-item grid on /our-work/, and the five-across rows the Tesla pages
       declare at 30% each. Elementor gives those a gap too, so rows touching
       was the port's own doing. */
    gap: 20px;
    width: 100%;
  }
  /* A column is Elementor's `.elementor-widget-wrap`, which frontend.min.css
     makes display:flex, with each widget carrying margin-block-end:20px. The
     same gap the section stack uses, and for the same reason: a widget's own
     ported margin (its `box`) is merged into one inline style attribute, so a
     margin-based rule here would be overridden outright and the spacing would
     vanish. It had no rule at all, which is why the sidebar's PDF captions sat
     flush against their logos — their box sets margin:-3px, and -3px was the
     whole of the gap. */
  .cols > .col {
    flex: 1 1 calc(var(--col-w, 100%) - 20px);
    max-width: calc(var(--col-w, 100%) - 20px);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--widget-gap);
  }
  /* The first widget in a column takes no gap above it, and must not re-inherit
     the section's own vertical rhythm either. */
  .cols > .col > :global(:first-child) { margin-top: 0; }

  /* Where the widgets sit in a column taller than they are. Elementor puts this
     on the section (elementor-section-content-middle and friends) and, in the
     bc-flex-widget mode this site runs in, it becomes align-items on each
     column's widget wrap. A column here IS that wrap and is a flex column, so
     the vertical axis is the main one and justify-content is what moves them.

     Only a section's own columns, never a nested row's — the original's rule is
     `> .elementor-container > .elementor-column > .elementor-widget-wrap`.

     Without this the FAQ hero's heading sat at the top of its navy panel
     instead of centred in it. It is not a rare setting: 4 of the 6 sections on
     that page use middle, and 2 or 3 on every other page captured. */
  .sec--middle > .container > .cols > .col { justify-content: center; }
  .sec--bottom > .container > .cols > .col { justify-content: flex-end; }

  /* Elementor collapses rows to full width at its tablet breakpoint. */
  /* Elementor stacks columns at its mobile breakpoint, not its tablet one:
     04-frontend.min.css puts `.elementor-column{width:100%}` inside
     @media(max-width:767px). Collapsing at 1024 here meant every multi-column
     row on the site stacked from 1024px down, where the original still shows
     them side by side — a three-across row of truck photos became one column
     of full-bleed images at 990px. */
  @media (max-width: 767px) {
    .cols > .col { flex-basis: 100%; max-width: 100%; }
  }

  /* Ported post bodies are a different type scale from the page chrome: 17px
     on 25.5px, not the 16/24 the body inherits. Headings inside them are
     smaller than the standalone heading blocks and navy rather than body ink —
     and the h3 weight is 700, which is what makes <strong> inside one resolve
     to 900 as it does on the live site. */
  /* Rich text is a second, separate type scale from the heading widgets in
     global.css, and mixing the two was wrong in both directions. Probed by
     injecting this markup into a mirrored page inside
     .elementor-widget-text-editor: the leading here is 1.2x the size (not the
     kit's 1.0), h2-h4 are weight 600 (not 500), and h3/h4 are navy while
     h1/h2 stay body ink. A text widget that declares its own size still wins —
     the extractor carries that inline. */
  .rt {
    font-size: 16px;
    line-height: 1.5;
  }
  .rt :global(h1) {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--ink);
    text-transform: none;
  }
  .rt :global(h2) {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink);
    text-transform: capitalize;
  }
  .rt :global(h3) {
    font-size: 22px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--brand-navy);
    text-transform: capitalize;
  }
  /* h4 had no rule at all, so it fell through to the heading-widget default and
     took every <strong> inside it down with it: `bolder` resolves against the
     parent, so a 500 parent yielded 700 where the original yields 900. */
  .rt :global(h4) {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--brand-navy);
    text-transform: none;
  }
  .rt :global(h5) {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    color: #444444;
    text-transform: none;
  }
  .rt :global(h6) {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--ink);
    text-transform: none;
  }

  .rt :global(p) { margin: 0 0 16px; }
  .rt :global(p:last-child) { margin-bottom: 0; }
  .rt :global(ul),
  .rt :global(ol) { margin: 0 0 16px; padding-inline-start: 22px; }
  /* The original puts no margin on a list item — checked on its rich-text
     lists across several pages and on the sitemap's 400-item list, all
     margin-top and margin-bottom 0. The 6px invented here added six pixels per
     item, which on /sitemap/ alone was 2,394px. */
  .rt :global(li) { margin-bottom: 0; }
  /* A WordPress gallery block inside post copy.
     The original nests its images in a figure.wp-block-gallery and lays them
     out with flex — measured on the original at 1440, the container is
     flex/wrap with a 24px gap and each child 270px, three across, with a
     trailing short row growing to fill. The sanitiser strips the classes but
     keeps the nesting, so the gallery survives as a bare <figure> holding the
     image figures, and every one of them stacked full width: eight images on
     /custom-helmet-wraps-toronto-savio/ came to a single 4,972px column.
     A figure that directly holds other figures is that gallery — no other
     construct in this copy nests figures — so it needs no class of its own and
     no change to the stored content. */
  .rt :global(figure:has(> figure)) {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0 0 16px;
  }
  .rt :global(figure:has(> figure) > figure) {
    /* A third of the row, growing to fill a short last row, which is what puts
       two on the final line at 417px where three sit at 270px above it. */
    flex: 1 1 calc(33.333% - 16px);
    min-width: 0;
    margin: 0;
  }
  .rt :global(figure:has(> figure) > figure img) { width: 100%; height: auto; display: block; }
  @media (max-width: 767px) {
    .rt :global(figure:has(> figure) > figure) { flex-basis: calc(50% - 12px); }
  }

  /* Gutenberg's columns block (div.wp-block-columns), which three posts use to
     put a pair of images side by side. The extractor kept the figures and
     dropped the wrapper, so they stacked at full width — 566px each where the
     original's pair is 278px. The wrapper is restored in the stored content as
     .wpcols; the geometry here is read off the original: flex, 24px gap, and
     each column flex: 1 1 0, which divides its 857px into two at 416.7px.

     A column can hold more than its image — one of the three has a
     "Before & After" line above it — so the child is a column, not a figure. */
  .rt :global(.wpcols) { display: flex; gap: 24px; margin: 0 0 16px; }
  .rt :global(.wpcols > .wpcol) { flex: 1 1 0; min-width: 0; }
  .rt :global(.wpcols > .wpcol > figure) { margin: 0; }
  .rt :global(.wpcols > .wpcol > figure img) { width: 100%; }
  /* WordPress stacks a columns block below 782px. */
  @media (max-width: 781px) {
    .rt :global(.wpcols) { flex-wrap: wrap; }
    .rt :global(.wpcols > .wpcol) { flex-basis: 100%; }
  }

  /* Gutenberg in-body images (figure.wp-block-image) inside post content. */
  .rt :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  /* Measured on the original's in-body figures across several posts: margin-top
     0, margin-bottom 18px. The 20px on both sides invented here added 22px to
     every figure on the page — 286px on a post carrying thirteen of them. */
  .rt :global(figure) { margin: 0 0 18px; }

