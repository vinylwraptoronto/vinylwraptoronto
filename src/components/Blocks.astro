---
/**
 * Renders the block model produced from each live page's Elementor markup.
 *
 * Elementor's nesting is not reproduced — it is a builder artefact, not the
 * design. Each page is reduced to ordered sections of typed blocks and drawn
 * with the measured type scale and palette.
 */
import type { Block, Section } from '../types';
import posts from '../data/posts.json';
import categories from '../data/categories.json';
import imgDims from '../data/img-dims.json';
import galleryThumbs from '../data/gallery-thumbs.json';
import IMG_OPT from '../data/img-opt.json';
const optOf = (s: string): { 384: string; 768: string } | undefined => (IMG_OPT as Record<string, { 384: string; 768: string }>)[s];
import widgetCss from '../data/widget-css.json';
import sectionCss from '../data/section-css.json';
import spacers from '../data/spacers.json';
import rowCss from '../data/row-css.json';
import listSpace from '../data/list-space.json';
import colCss from '../data/col-css.json';
import iconSize from '../data/icon-size.json';
import iconBox from '../data/icon-box.json';
import QuoteForm from './QuoteForm.astro';
import { img, imgHtml } from '../lib/img';
import { mailtoHrefs } from '../lib/postdoc';
import { describe, LINKED } from '../lib/image-desc';
import { withoutWarranty, withoutWarrantyBlocks } from '../lib/warranty';

export interface Props {
  /** Normal use: whole sections, each with its own padding and container. */
  sections?: Section[];
  /** Recursive use: the blocks of one column, rendered without a section
      wrapper. Elementor rows put blocks side by side and a column can hold
      almost any block type — including another row — so the renderer calls
      itself through Astro.self rather than special-casing a subset. */
  blocks?: Block[];
  /** The page's table-of-contents entries, threaded through the recursion.
      The TOC widget almost always sits inside a column, so a renderer that
      only looked at `sections` saw an empty list and drew nothing. */
  toc?: TocEntry[];
  /** The one heading promoted to the document H1, threaded through columns. */
  primaryHeadingEid?: string;
  /** The categories widget's hardcoded `<h5 class="cat-title">` label,
      clamped like every other heading (see `collectHeadings`) so it never
      skips past the document's heading sequence so far -- computed once at
      the top-level call (where `toc` is undefined) and threaded through
      columns the same way `toc`/`primaryHeadingEid` already are, since the
      widget almost always sits inside a column and a recursive call has no
      other way to see where the running heading count had reached. */
  categoriesLevel?: number;
  /** The non-stacked `cards` loop widget's hardcoded `<h3 class="elementor-
      post__title">` card titles, clamped the same way and for the same
      reason as `categoriesLevel` just above -- at most one non-stacked
      `cards` block exists per page (confirmed across src/data/pages), so
      one threaded value is enough. Computed once at the top-level call and
      threaded through columns the same way. */
  cardsLevel?: number;
}

/** `renderLevel` is `level` unless a heading — structured `heading`-type
 *  block or one embedded in a rich-text body (`<h3>`/`<h4>`...) — would
 *  otherwise skip a level, e.g. a standalone `<h4>` card-title widget placed
 *  directly under an `<h2>` section heading with no `<h3>` in between, or an
 *  FAQ question hand-authored as `<h4>` the same way inside the rich text.
 *  Both kinds of block get the same clamp (see `collectHeadings` below);
 *  neither is pre-audited, since both are carried verbatim from the
 *  Elementor/WordPress export. */
type TocEntry = { eid?: string; text: string; level: number; renderLevel: number; id: string };

const { sections: rawSections, blocks: rawBlocks, toc, primaryHeadingEid: suppliedPrimaryHeadingEid, categoriesLevel: suppliedCategoriesLevel, cardsLevel: suppliedCardsLevel } = Astro.props;
/* The 3-year warranty panels are dropped before anything else reads the page:
   see src/lib/warranty.ts. */
const sections = rawSections && withoutWarranty(rawSections);
const blocks = rawBlocks && withoutWarrantyBlocks(rawBlocks);

/** True when this call is rendering the inside of a column rather than whole
 *  sections. A before/after pair in a column is drawn at half the content
 *  width and one at section level at the full width, which is the difference
 *  between a 768-wide file being ample and it being an upscale. */
/* "Learn More" / "More" say nothing out of context. Where a generic heading
   link shares its address with an earlier heading link on the same card
   ("Full Car Wraps"), its context is appended as real (not aria-label-only)
   text, visually hidden with .elementor-screen-only. Lighthouse's SEO
   link-text audit — unlike the accessible-name computation — reads each
   link's textContent, not its aria-label, because it is checking what a
   search-engine crawler sees rather than what a screen reader announces; an
   aria-label alone leaves the crawler-visible text exactly "Learn More" and
   still fails that audit. Putting the service name in the DOM (hidden only
   visually) fixes both the SEO text and the accessible name at once, and the
   visible "Learn More" wording is unchanged. */
const GENERIC_LINK = /^(learn more|read more|more|view more|see more|click here|here)$/i;
const genericLinkContext = (arr: Block[], i: number, b: any): string | undefined => {
  if (!GENERIC_LINK.test((b.text ?? '').trim())) return undefined;
  for (let j = i - 1; j >= 0; j--) {
    const p = arr[j] as any;
    if (p.type === 'heading' && p.href === b.href && p.text && !GENERIC_LINK.test(p.text.trim())) {
      return p.text.trim();
    }
  }
  return undefined;
};

/** An inner section's own margin, per breakpoint (src/data/row-css.json, from
 *  scripts/pull-row-margins.py), keyed by the first widget in the row. */
type RowMargins = Record<string, Partial<Record<'d' | 't' | 'm', [string, string]>>>;
const firstEid = (bs?: Block[]): string | undefined => {
  for (const x of bs ?? []) {
    const y = x as any;
    if (y?.eid) return y.eid;
    for (const c of Array.isArray(y?.cols) ? y.cols : []) { const e = firstEid(c?.blocks); if (e) return e; }
    const e = firstEid(y?.blocks); if (e) return e;
  }
  return undefined;
};
const rowMarginVars = (b: any): string | undefined => {
  const eid = firstEid((b.cols ?? []).flatMap((c: any) => c?.blocks ?? []));
  const m = eid ? (rowCss as unknown as RowMargins)[eid] : undefined;
  if (!m) return undefined;
  const v: string[] = [];
  for (const [bp, suf] of [['d', ''], ['t', '-t'], ['m', '-m']] as const) {
    const x = m[bp];
    if (x) v.push(`--row-mt${suf}:${x[0]}`, `--row-mb${suf}:${x[1]}`);
  }
  return v.join(';');
};

/** An icon list's Space Between, per breakpoint (src/data/list-space.json). */
type ListSpace = Partial<Record<'d' | 't' | 'm', number>>;
const listSpaceOf = (eid?: string): ListSpace | undefined =>
  eid ? (listSpace as unknown as Record<string, ListSpace>)[eid] : undefined;

/** An icon box's own colour and title spacing, where they differ from the
 *  defaults (src/data/icon-box.json). */
const iconBoxOf = (eid: string) =>
  (iconBox as Record<string, { color?: string; titleGap?: string }>)[eid];

/** An icon box's own icon size, per breakpoint (src/data/icon-size.json). */
const iconSizeVars = (eid?: string): string | undefined => {
  const m = eid ? (iconSize as unknown as Record<string, Partial<Record<'d' | 't' | 'm', string>>>)[eid] : undefined;
  /* And its own colour (src/data/icon-box.json, scripts/pull-icon-box.mjs):
     most of the original's icon boxes are pink, navy or lime, not green. */
  const c = eid ? iconBoxOf(eid)?.color : undefined;
  if (!m && !c) return undefined;
  return [m?.d && `--ic:${m.d}`, m?.t && `--ic-t:${m.t}`, m?.m && `--ic-m:${m.m}`, c && `--ic-c:${c}`]
    .filter(Boolean).join(';') || undefined;
};

/** A column's own vertical margin, per breakpoint (src/data/col-css.json,
 *  from scripts/pull-col-margins.py), keyed by the column's first widget. */
const colMarginVars = (c: any): string[] => {
  const eid = firstEid(c?.blocks);
  const m = eid ? (colCss as unknown as RowMargins)[eid] : undefined;
  if (!m) return [];
  const v: string[] = [];
  for (const [bp, suf] of [['d', ''], ['t', '-t'], ['m', '-m']] as const) {
    const x = m[bp];
    if (x) v.push(`--cm-t${suf}:${x[0]}`, `--cm-b${suf}:${x[1]}`);
  }
  return v;
};

/** A row margin's left and right, summed for calc(), or null where both are 0. */
const rowSideMargins = (m?: string | null): string | null => {
  const v = (m ?? '').trim().split(/\s+/).filter(Boolean);
  if (!v.length) return null;
  const right = v[1] ?? v[0];
  const left = v[3] ?? right;
  const side = [left, right].filter((x) => parseFloat(x) !== 0);
  return side.length ? side.join(' + ') : null;
};

/** The image widget's Width control as custom properties, read by `.fig--iw img`. */
const imgWidthVars = (w?: { d?: string; t?: string; m?: string }): string | undefined => {
  if (!w) return undefined;
  const v = [w.d && `--iw:${w.d}`, w.t && `--iw-t:${w.t}`, w.m && `--iw-m:${w.m}`].filter(Boolean).join(';');
  return v || undefined;
};

const inColumn = !!blocks;

const groups: { section?: Section; blocks: Block[]; bare: boolean }[] = blocks
  ? [{ blocks, bare: true }]
  : (sections ?? []).map((s) => ({ section: s, blocks: s.blocks, bare: false }));

const headingBlocks = (items: Block[], into: Extract<Block, { type: 'heading' }>[] = []) => {
  for (const block of items) {
    if (block.type === 'heading' && !block.tag) into.push(block);
    if (block.type === 'columns') for (const col of block.cols) headingBlocks(col.blocks, into);
  }
  return into;
};
const pageHeadings = blocks ? [] : headingBlocks((sections ?? []).flatMap((section) => section.blocks));
const primaryHeadingEid = suppliedPrimaryHeadingEid ??
  (pageHeadings.find((heading) => heading.level === 1) ??
   pageHeadings.find((heading) => heading.level === 2) ?? pageHeadings[0])?.eid;

const num = (v?: string | null) => (v && /^\d+$/.test(v) ? Number(v) : undefined);

/** The pixel size of an uploaded image, from src/data/img-dims.json.
 *
 *  A masonry gallery shows every photograph at its own shape, so no stylesheet
 *  can state one ratio that reserves the tiles' boxes. Without a reserved box a
 *  picture that has not decoded yet — or that the image host fails to serve —
 *  is zero pixels tall, which collapses the column and stacks the alt text on
 *  top of itself. Giving each tile the ratio of its own file fixes that, and
 *  the ratio has to come from the file because neither our page data nor the
 *  original's script-rendered markup carries it.
 *
 *  Run `node scripts/img-dims.mjs --write` after adding uploads. */
const dimsOf = (src: string): [number, number] | undefined =>
  (imgDims as unknown as Record<string, [number, number]>)[src.split('?')[0]];

/** What a gallery tile should actually request, and at what size.
 *
 *  The original never puts a full photograph in its grid: Elementor's Gallery
 *  widget asks for WordPress's "medium" (inside 300x300) in a masonry gallery
 *  and "medium_large" (768 wide) in a grid one, and keeps the upload for the
 *  lightbox the tile links to. The port asked for the upload in both places,
 *  which on the portfolio meant fetching 341 full photographs to draw 341
 *  thumbnails.
 *
 *  src/data/gallery-thumbs.json holds the resized name for every tile, each one
 *  fetched from the image host before being recorded. A tile with no entry --
 *  an image already smaller than the target, or one added since the manifest
 *  was built -- falls back to the upload, which is what happened before.
 *
 *  Run `node scripts/gallery-thumbs.mjs --write` after adding gallery images. */
const tileOf = (src: string, masonry?: boolean): { src: string; w?: number; h?: number } => {
  const box = masonry ? 300 : 768;
  const hit = (galleryThumbs as unknown as Record<string, [string, number, number]>)[`${box}:${src}`];
  if (hit) return { src: hit[0], w: hit[1], h: hit[2] };
  const d = dimsOf(src);
  if (d) return { src, w: d[0], h: d[1] };
  /* Last, the size WordPress writes into a resized file's own name, as
     thumbBox reads it for cards. /personal-branding/'s top gallery serves
     `...-768x461.webp` files with no entry in either manifest, so its tiles
     had no width or height at all; the masonry then assumed 4:3 and left a
     60px empty band under each of the three pictures. */
  const m = /-(\d{2,4})x(\d{2,4})\.[a-z0-9]{2,5}(?:\.[a-z0-9]{2,5})?$/i.exec(src);
  return { src, w: m ? Number(m[1]) : undefined, h: m ? Number(m[2]) : undefined };
};

/** The previous/next link's title, without the words that are not meant to be
 *  seen.
 *
 *  Elementor puts a screen-reader-only word inside each arrow -- "Prev" before
 *  the prev link's label, "Next" after the next link's title -- as
 *  `<span class="elementor-screen-only">`. The extractor took the whole
 *  anchor's text, so every one of the 471 navigations rendered
 *  "Prev Previous <title>" and "Next <title> Next" on the page, with the label
 *  word doubled beside its own label.
 *
 *  Stripped here rather than in the data because the same 471 blocks exist in
 *  both the page JSON and posts.json, and posts.json is rebuilt from D1 on
 *  every build -- a fix written into the file would be overwritten by the next
 *  pull.
 *
 *  Checked, not assumed: every prev/next link points at a page this build also
 *  holds, so each stripped title was compared against that page's own H1. 936
 *  of 936 agree -- 928 exactly, and the other 8 differ only by a non-breaking
 *  space or a doubled space inside the heading. */
const navTitle = (text: string, dir: 'prev' | 'next'): string =>
  (dir === 'prev'
    ? text.replace(/^Prev\s+Previous\s+/, '')
    : text.replace(/^Next\s+/, '').replace(/\s+Next$/, '')
  ).trim();

/** A button's inline style: its own declarations, its resting background, and
 *  its hover colours as custom properties the `.btn:hover` rule reads.
 *
 *  Custom properties rather than a generated class per button because the
 *  colours are per element -- 545 buttons across the site in thirteen
 *  different rest/hover pairings -- and a static rule cannot carry that. The
 *  fallbacks in `.btn:hover` keep a button without harvested colours looking
 *  the way it did before. */
const btnStyle = (b: { style?: string | null; bg?: string; hoverBg?: string;
                       hoverColor?: string; hoverBorder?: string;
                       radius?: string; pad?: string; padT?: string;
                       padM?: string }): string | undefined =>
  [
    b.style,
    /* As a custom property, not `background-color` itself. Set directly it
       would be an inline declaration, and an inline declaration outranks every
       stylesheet rule -- including `.btn:hover`, which then had no effect at
       all and left the site with rest colours right and no hover anywhere. */
    b.bg && `--btn-bg:${b.bg}`,
    b.hoverBg && `--btn-hover-bg:${b.hoverBg}`,
    b.hoverColor && `--btn-hover-color:${b.hoverColor}`,
    b.hoverBorder && `--btn-hover-border:${b.hoverBorder}`,
    b.radius && `--btn-radius:${b.radius}`,
    b.pad && `--btn-pad:${b.pad}`,
    b.padT && `--btn-pad-t:${b.padT}`,
    b.padM && `--btn-pad-m:${b.padM}`,
  ].filter(Boolean).join(';') || undefined;

/** The upload's own dimensions, shaped like tileOf's result so the two are
 *  interchangeable at the call site. */
const dimsPair = (src: string): { w?: number; h?: number } => {
  const d = dimsOf(src);
  return { w: d?.[0], h: d?.[1] };
};


const byNewest = [...(posts as any[])]
  .filter((p) => p.published)
  .sort((a, b) => String(b.published).localeCompare(String(a.published)));

const metaOf = (p: any, key: string) =>
  ((p.head?.meta ?? []) as [string, boolean, string][])
    .find(([k]) => k.toLowerCase() === key)?.[2];

/** The post's own H1, which is not the same as its SEO title. */
const headlineOf = (p: any): string => {
  const find = (blocks: any[]): string | undefined => {
    for (const b of blocks ?? []) {
      if (b.type === 'heading' && b.level === 1 && b.text) return b.text;
      if (b.type === 'columns') {
        for (const c of b.cols ?? []) {
          const hit = find(c.blocks);
          if (hit) return hit;
        }
      }
    }
  };
  for (const s of p.sections ?? []) {
    const hit = find(s.blocks);
    if (hit) return hit;
  }
  return p.title;
};

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'];

/** A card thumbnail's intrinsic size.
 *
 *  Card images are lazy, and since the grid stopped forcing `aspect-ratio`
 *  (the original does not crop them) nothing reserves their box until they
 *  load. On a 55-card listing that is thousands of pixels of layout shift.
 *
 *  The original avoids it the way WordPress always does -- `width` and
 *  `height` on the img -- and the variant WordPress serves carries them in its
 *  own filename (`...-768x403.webp`). That is exact and needs no lookup; the
 *  card's recorded dimensions are the fallback.
 */
const thumbBox = (src: string, c: any): { w?: number; h?: number } => {
  const m = /-(\d{2,4})x(\d{2,4})\.[a-z0-9]{2,5}(?:\.[a-z0-9]{2,5})?$/i.exec(String(src));
  if (m) return { w: Number(m[1]), h: Number(m[2]) };
  if (c?.w && c?.h) return { w: c.w, h: c.h };
  const d = dimsOf(src);
  return { w: d?.[0], h: d?.[1] };
};

/** The widget ids whose loop really is "the newest posts, site-wide".
 *
 *  This was a heuristic -- treat a block as live if the cards it FROZE are the
 *  newest N as of its own most recent card -- and the heuristic is not safe.
 *  A filtered loop passes it whenever its posts happen to have been the newest
 *  when the page was scraped, and two of the site's five candidates did:
 *
 *    100f1ef    400 blocks   original lists the newest 3   LIVE
 *    d09f711      7 blocks   original lists the newest 3   LIVE
 *    31cc265a     1 block    original lists the newest 3   LIVE
 *    648055be     1 block    carbon-fibre posts only       FILTERED
 *    7536db10   363 blocks   the page's own topic only     FILTERED
 *
 *  The last two were being rewritten to the three newest posts on the site:
 *  /carbon-fibre-wraps-vinyl-wrap-toronto/ showed "Vehicle Photos for AI Wrap
 *  Design" where the original shows a Kawasaki Ninja, and the same on 363
 *  blogs pages. Read off the original, per widget, rather than inferred.
 *
 *  A new id belongs here only after the same check: load a page carrying it
 *  and confirm the original's own loop lists the newest posts.
 */
/** The share-buttons widget's networks: icon, and the share address for a
 *  page URL (already encoded). */
const SHARE: Record<string, { icon: string; href: (u: string) => string }> = {
  facebook: { icon: 'fab fa-facebook', href: (u) => `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  twitter: { icon: 'fab fa-twitter', href: (u) => `https://twitter.com/intent/tweet?url=${u}` },
  linkedin: { icon: 'fab fa-linkedin', href: (u) => `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  whatsapp: { icon: 'fab fa-whatsapp', href: (u) => `https://api.whatsapp.com/send?text=${u}` },
};

/** The original's Gutenberg spacers, put back in front of the element each
 *  one preceded (src/data/spacers.json, from scripts/pull-spacers.py). Matched
 *  on the element's tag and the start of its text, so an element that has
 *  since been edited simply gets none. */
const decode = (t: string) =>
  t.replace(/&amp;/g, '&').replace(/&#8217;|&rsquo;/g, '\u2019').replace(/&#8211;|&ndash;/g, '\u2013')
   .replace(/&nbsp;|&#160;/g, ' ').replace(/&quot;/g, '"').replace(/&#039;|&#39;/g, "'");
const withSpacers = (html: string, path: string): string => {
  const rows = (spacers as unknown as Record<string, [string, string, number][]>)[path];
  if (!rows?.length) return html;
  let out = html;
  for (const [tag, text, h] of rows) {
    if (!h) continue;
    const open = new RegExp(`<${tag}(\\s[^>]*)?>`, 'gi');
    let m: RegExpExecArray | null;
    while ((m = open.exec(out))) {
      const after = decode(out.slice(m.index + m[0].length, m.index + m[0].length + 400).replace(/<[^>]+>/g, ''))
        .replace(/\s+/g, ' ').trim();
      const before = out.slice(Math.max(0, m.index - 80), m.index);
      if (after.startsWith(text) && !/wp-block-spacer[^>]*>\s*<\/div>\s*$/.test(before)) {
        const div = `<div class="wp-block-spacer" style="height:${h}px" aria-hidden="true"></div>`;
        out = out.slice(0, m.index) + div + out.slice(m.index);
        break;
      }
    }
  }
  return out;
};

/** Instagram's own embed, as the original serves it.
 *
 *  Two posts embed an Instagram post. The original's markup is Instagram's
 *  blockquote.instagram-media, which Instagram's embed.js swaps for the post
 *  itself (a 540px-wide iframe, ~1,077px tall). The extractor stripped the
 *  class and data attributes, leaving only the fallback text "View this post
 *  on Instagram / A post shared by ...". This puts back the class, the
 *  permalink and Instagram's own box style on any such fallback blockquote,
 *  so embed.js -- loaded only on a page that has one -- can do the swap. The
 *  fallback text stays inside, which is what shows if the script is blocked. */
const IG_STYLE = 'background:#FFF;border:0;border-radius:3px;box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15);margin:1px;max-width:540px;min-width:326px;padding:0;width:calc(100% - 2px)';
const instagramEmbeds = (html: string): { html: string; found: boolean } => {
  let found = false;
  const out = html.replace(
    /<blockquote(\s[^>]*)?>((?:(?!<\/blockquote>)[\s\S])*?href="(https:\/\/www\.instagram\.com\/(?:p|reel|tv)\/[^"]+)"[\s\S]*?)<\/blockquote>/g,
    (whole, attrs = '', inner: string, href: string) => {
      if (/instagram-media/.test(attrs) || !/on Instagram|shared by/i.test(inner)) return whole;
      found = true;
      return `<blockquote class="instagram-media" data-instgrm-captioned data-instgrm-permalink="${href}" data-instgrm-version="14" style="${IG_STYLE}">${inner}</blockquote>`;
    },
  );
  return { html: out, found: found || /class="instagram-media"/.test(html) };
};

const LIVE_LOOPS = new Set(['100f1ef', 'd09f711', '31cc265a']);

/** A posts widget's own per-element rules, at every breakpoint, as CSS on the
 *  port's card markup (src/data/widget-css.json, from scripts/pull-card-css.py).
 *
 *  The extractor kept the desktop title / meta / read-more type inline and
 *  nothing else, so the archive template's 15px text inset, the 5px under its
 *  title and read-more, its 16px title from 1024 down and the 2:1 thumbnail
 *  crop it applies on a phone were all missing -- on 577 archives at once,
 *  since they share the one widget. Declarations are !important because the
 *  desktop values they restate, or override per breakpoint, sit inline. */
const CARD_PART: Record<string, string> = {
  title: '> li h3, %P > li h3 a',
  text: ' .card-text',
  more: ' a.card-more',
  meta: ' .card-meta',
  badge: ' .card-badge',
  card: ' > li',
  desc: ' .card-desc',
};
const cardCss = (eid: string): string => {
  const rows = (widgetCss as unknown as Record<string, [string, string, string][]>)[eid];
  if (!rows) return '';
  const P = `ul.cards[data-eid="${eid}"]`;
  const imp = (d: string) => d.split(';').filter(Boolean).map((x) => `${x} !important`).join(';');
  const by: Record<string, string[]> = { d: [], t: [], m: [] };
  for (const [bp, part, d] of rows) {
    if (part === 'grid') {
      const v = d.replace('--grid-row-gap', '--cards-gap-r').replace('--grid-column-gap', '--cards-gap-c');
      by[bp].push(`${P}{${imp(v)}}`);
    } else if (part === 'thumb') {
      /* Elementor's item ratio: the thumbnail box takes padding-bottom R*100%
         and the image covers it. Where no breakpoint sets one, the box keeps
         the image's own ratio (elementor-fit-height). */
      const r = d.replace(/^padding-bottom:/, '');
      by[bp].push(`${P} .card-thumb{position:relative;display:block;height:0;overflow:hidden;padding-bottom:${r}}` +
        `${P} .card-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}`);
    } else if (CARD_PART[part]) {
      const sel = (P + (CARD_PART[part].startsWith(' ') ? '' : ' ') + CARD_PART[part]).replace('%P', P);
      const extra = part === 'badge' && /(^|;)right:/.test(d) ? ';inset-inline-start:auto !important' : '';
      by[bp].push(`${sel}{${imp(d)}${extra}}`);
    }
  }
  return by.d.join('') +
    (by.t.length ? `@media (max-width:1024px){${by.t.join('')}}` : '') +
    (by.m.length ? `@media (max-width:767px){${by.m.join('')}}` : '');
};

const recentCards = (exclude: string, n: number, like?: any) =>
  byNewest
    .filter((p) => `/${String(p.slug).replace(/^\/|\/$/g, '')}/` !== exclude)
    .slice(0, n)
    .map((p) => {
      const t = headlineOf(p);
      const d = String(p.published).slice(0, 10).split('-');
      const thumb = p.ogImage ? tileOf(p.ogImage, true).src : null;
      return {
        title: t,
        href: `/${String(p.slug).replace(/^\/|\/$/g, '')}/`,
        image: thumb,
        badge: like && !like.badge ? null : metaOf(p, 'article:section') ?? null,
        alt: t,
        author: like && !like.author ? null : p.author ?? null,
        date: like && !like.date ? null
          : d.length === 3 ? `${Number(d[2])} ${MONTHS[Number(d[1]) - 1]} ${d[0]}` : null,
        more: like?.more ?? 'Read More »',
      };
    });

/** The pages whose before/after pairs are stamped from the loop template, and
 *  so are drawn as bordered cards. See the `isCard` comment below. */
const LOOP_GRID_PAGES = new Set(['/our-work/', '/tesla-vinyl-wraps/']);

/** Stable anchor id from heading text, so the table of contents can link to it. */
const slugify = (t: string) =>
  t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);

/* One line of the category dropdown, spelled the way the original spells it:
   three non-breaking spaces per level of nesting, then the name, then two more
   before the count. Built here rather than in the template so the escapes stay
   readable. */
function catOption(name: string, count: number, level: number): string {
  return `${' '.repeat(level * 3)}${name}  (${count})`;
}

/* The share widget's six networks, in the original's order, each with the
   icon it uses and its official brand colour (the colours live in the style
   block below).

   The original renders these as <div role="button"> and opens a popup from
   JavaScript. These are real links instead: same destinations, but they work
   with JS off, and can be middle-clicked, copied or opened in a new tab —
   which a div cannot. */
const SHARE_NETWORKS = [
  { id: 'facebook', label: 'Facebook', icon: 'fab fa-facebook',
    href: (u: string) => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(u)}` },
  { id: 'twitter', label: 'Twitter', icon: 'fab fa-twitter',
    href: (u: string) => `https://twitter.com/intent/tweet?url=${encodeURIComponent(u)}` },
  { id: 'linkedin', label: 'LinkedIn', icon: 'fab fa-linkedin',
    href: (u: string) => `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(u)}` },
  { id: 'whatsapp', label: 'WhatsApp', icon: 'fab fa-whatsapp',
    href: (u: string) => `https://api.whatsapp.com/send?text=${encodeURIComponent(u)}` },
  { id: 'pinterest', label: 'Pinterest', icon: 'fab fa-pinterest',
    href: (u: string) => `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(u)}` },
  { id: 'email', label: 'Email', icon: 'fas fa-envelope',
    href: (u: string) => `mailto:?body=${encodeURIComponent(u)}` },
];

/* Pagination for the blog index.
   Computed here rather than in the template: the block below renders inside a
   JSX expression, where statements and type annotations are a syntax error --
   an inline `for` loop there fails the build with a bare "Unexpected ;". */
function pagerHref(base: string, n: number): string {
  return n <= 1 ? base : `${base}page/${n}/`;
}

/* 1 … 15 16 17 18 19 … 34 — the exact window WordPress's paginate_links()
   produces for this widget: end_size 1 (first and last page always shown) and
   mid_size 2 (two either side of the current one). Read off the original's own
   markup on pages 1, 2, 17 and 34 rather than guessed; a ±1 window looked
   right on page 17 but showed "1 2 … 34" on page 1 where the original shows
   "1 2 3 … 34". */
function pagerSteps(current: number, total: number): (number | string)[] {
  const steps: (number | string)[] = [];
  for (let n = 1; n <= total; n++) {
    if (n === 1 || n === total || Math.abs(n - current) <= 2) steps.push(n);
    else if (steps[steps.length - 1] !== '…') steps.push('…');
  }
  return steps;
}

/* The live table of contents is built client-side from the page's own
   headings (the widget is configured for h2-h6). Rebuilt here from the same
   source so it lists the same entries.

   It has to walk the whole section tree: headings live inside columns, and a
   flat pass over the top-level blocks found none of them, so the panel came
   out empty on all 402 posts that carry the widget. */
function collectHeadings(
  node: unknown,
  into: TocEntry[],
  runningMax: { v: number },
  extra: { categoriesLevel?: number; cardsLevel?: number },
): void {
  if (Array.isArray(node)) {
    for (const v of node) collectHeadings(v, into, runningMax, extra);
    return;
  }
  if (!node || typeof node !== 'object') return;
  const b = node as Record<string, unknown>;
  /* What the TOC widget's own exclude_headings_by_selector leaves out: on the
     blog template, the sidebar column and the related-posts section. Their
     headings -- the offer's price, "Get an Estimate", "Read More Blogs" --
     were listed under every post's own and made each TOC four lines longer. */
  if (b.tocSkip) return;
  // The categories widget's own hardcoded <h5> label (see the render branch
  // below) is not a TOC-eligible heading -- it names the dropdown next to
  // it, not a document section -- so it is clamped here (same running-count
  // mechanism as every other heading) but deliberately NOT pushed into
  // `into`: the sidebar TOC must keep listing exactly the same entries it
  // always has. Confirmed sitewide: at most one `categories` block per page,
  // so there is never more than one value to compute or thread.
  if (b.type === 'categories' && typeof b.title === 'string') {
    const renderLevel = Math.min(5, runningMax.v + 1);
    // Tracks the level of the MOST RECENT heading (not the deepest one ever
    // seen) — a plain max() ratchet never decreases, so one early H3 (e.g. a
    // price box) would permanently suppress the skip-detection clamp for
    // every later heading on the page, even after the document had returned
    // to H2 (reproduced on /tesla-vinyl-wraps/: H3 "$4,500" then H2 "See The
    // Results" then gallery H4 cards rendered unclamped as H4, a real
    // heading-order violation axe caught). Never letting the tracked level
    // fall below 1 keeps the very first clamp call (right after the H1) safe.
    runningMax.v = Math.max(1, renderLevel);
    extra.categoriesLevel = renderLevel;
  }
  // The `cards` loop widget's own hardcoded <h3> card titles (see the render
  // branch below) are, like the categories label just above, not TOC-eligible
  // section headings -- they are repeated per-card and name the linked post,
  // not a section of this page -- so they are clamped here (same running-
  // count mechanism) but not pushed into `into`. On archive/tag/brand
  // listing templates the cards widget is the first thing after the H1, with
  // no H2 yet reached, which produced an H1->H3 skip on 613 pages.
  if (b.type === 'cards' && !b.stacked) {
    const renderLevel = Math.min(3, runningMax.v + 1);
    // Tracks the level of the MOST RECENT heading (not the deepest one ever
    // seen) — a plain max() ratchet never decreases, so one early H3 (e.g. a
    // price box) would permanently suppress the skip-detection clamp for
    // every later heading on the page, even after the document had returned
    // to H2 (reproduced on /tesla-vinyl-wraps/: H3 "$4,500" then H2 "See The
    // Results" then gallery H4 cards rendered unclamped as H4, a real
    // heading-order violation axe caught). Never letting the tracked level
    // fall below 1 keeps the very first clamp call (right after the H1) safe.
    runningMax.v = Math.max(1, renderLevel);
    extra.cardsLevel = renderLevel;
  }
  // `tag` means the widget rendered as p or div, so it is not a heading.
  if (b.type === 'heading' && !b.tag && typeof b.level === 'number' &&
      b.level >= 2 && b.level <= 6 && typeof b.text === 'string') {
    // Not pre-audited: on some pages a standalone heading WIDGET (not rich
    // text) skips a level the same way an embedded <h4> can -- e.g.
    // car-lettering-and-decals-gta's H1 followed directly by an H3 card
    // subheading, or trailer-wrap-toronto's chosen H1 followed by three H4
    // card titles with no H2/H3 between. `eid === primaryHeadingEid` mirrors
    // the promotion the render branch below applies (the page's chosen H1,
    // whatever its authored level, always renders as <h1>); every other
    // heading-type block is clamped exactly like a rich-text one: never
    // raised, only lowered enough to not skip past `runningMax + 1`. The
    // entry's own `level` stays the AUTHORED one (unclamped) because the
    // table-of-contents sidebar nesting below reads it, and TOC indentation
    // must not move just because the on-page tag did.
    const promoted = b.eid === primaryHeadingEid ? 1 : b.level === 1 ? 2 : b.level;
    const renderLevel = Math.min(promoted, runningMax.v + 1);
    // Tracks the level of the MOST RECENT heading (not the deepest one ever
    // seen) — a plain max() ratchet never decreases, so one early H3 (e.g. a
    // price box) would permanently suppress the skip-detection clamp for
    // every later heading on the page, even after the document had returned
    // to H2 (reproduced on /tesla-vinyl-wraps/: H3 "$4,500" then H2 "See The
    // Results" then gallery H4 cards rendered unclamped as H4, a real
    // heading-order violation axe caught). Never letting the tracked level
    // fall below 1 keeps the very first clamp call (right after the H1) safe.
    runningMax.v = Math.max(1, renderLevel);
    into.push({ eid: b.eid as string | undefined, text: b.text, level: b.level, renderLevel, id: '' });
  }
  // Most of a post's headings are inside the rich-text body, not the block
  // model, so a walk over blocks alone listed only the few standalone heading
  // widgets. These are keyed `<eid>#<n>` so the renderer can inject the very
  // same id into the same tag.
  if (b.type === 'text' && typeof b.html === 'string') {
    let n = 0;
    for (const m of b.html.matchAll(/<h([2-6])\b[^>]*>([\s\S]*?)<\/h\1>/g)) {
      const text = m[2].replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').trim();
      if (text) {
        const level = Number(m[1]);
        // The WordPress export carries these tags verbatim, and on ~213
        // posts the body jumps straight from the H1 (or an H2 section
        // heading) to an H3/H4 with nothing in between -- e.g. an FAQ
        // question hand-authored as <h4> directly under its <h2>. Clamp to
        // one past whatever the document has reached so far; never raises a
        // level, only prevents a skip. Visual size/weight is preserved
        // separately via an `rt-lvl*` class keyed on the *authored* level,
        // so this only changes the tag a screen reader/crawler sees.
        const renderLevel = Math.min(level, runningMax.v + 1);
        // Tracks the level of the MOST RECENT heading (not the deepest one ever
    // seen) — a plain max() ratchet never decreases, so one early H3 (e.g. a
    // price box) would permanently suppress the skip-detection clamp for
    // every later heading on the page, even after the document had returned
    // to H2 (reproduced on /tesla-vinyl-wraps/: H3 "$4,500" then H2 "See The
    // Results" then gallery H4 cards rendered unclamped as H4, a real
    // heading-order violation axe caught). Never letting the tracked level
    // fall below 1 keeps the very first clamp call (right after the H1) safe.
    runningMax.v = Math.max(1, renderLevel);
        into.push({ eid: `${b.eid ?? 'rt'}#${n}`, text, level, renderLevel, id: '' });
      }
      n++;
    }
  }
  for (const v of Object.values(b)) collectHeadings(v, into, runningMax, extra);
}

/** Populated only by the top-level collectHeadings walk below (where `toc`
 *  is undefined); a nested `<Astro.self>` call for a column receives the
 *  already-computed value as the `categoriesLevel` prop instead, exactly
 *  like `toc`/`primaryHeadingEid`, since recursing into collectHeadings
 *  again from a column would only see that column's own subtree and could
 *  not know the running heading count that came before it. */
const headingExtra: { categoriesLevel?: number; cardsLevel?: number } = {};

const tocEntries: TocEntry[] =
  toc ??
  (() => {
    const found: TocEntry[] = [];
    // Seeded at 1: every page has exactly one H1 (verified sitewide), always
    // ahead of everything collectHeadings walks (which only sees level 2-6).
    collectHeadings(sections ?? [], found, { v: 1 }, headingExtra);
    // Headings repeat — several posts carry the same price twice — so ids are
    // suffixed on collision, and the heading uses the same id by eid lookup.
    const used = new Map<string, number>();
    return found
      .map((e) => {
        const base = slugify(e.text);
        if (!base) return { ...e, id: '' };
        const n = (used.get(base) ?? 0) + 1;
        used.set(base, n);
        return { ...e, id: n === 1 ? base : `${base}-${n}` };
      })
      .filter((e) => e.id);
  })();

/** The clamped render level for this page's single `categories`-block
 *  `<h5 class="cat-title">` (see `collectHeadings`), falling back to the
 *  authored 5 if somehow absent (no categories block on this page, or this
 *  call is nested without the prop threaded -- never observed, since every
 *  page with the widget has exactly one and the prop is threaded through
 *  every recursive call). Never raised above 5, only ever lowered. */
const categoriesLevel = suppliedCategoriesLevel ?? headingExtra.categoriesLevel ?? 5;

/** The clamped render level for this page's single non-stacked `cards`-block
 *  `<h3 class="elementor-post__title">` card titles (see `collectHeadings`),
 *  falling back to the authored 3 if absent. Never raised above 3, only
 *  ever lowered. */
const cardsLevel = suppliedCardsLevel ?? headingExtra.cardsLevel ?? 3;

/** eid -> anchor id, so a heading and its TOC entry always agree. */
const tocIds = new Map<string, string>();
for (const e of tocEntries) if (e.eid) tocIds.set(e.eid, e.id);

/** eid -> corrected heading level, for the rich-text H1→H3/H4 skip fix. Only
 *  ever lower than the authored level (see `collectHeadings`), and absent
 *  (falls through unchanged) for the near-all headings that were already
 *  in order. */
const tocRenderLevel = new Map<string, number>();
for (const e of tocEntries) if (e.eid && e.renderLevel !== e.level) tocRenderLevel.set(e.eid, e.renderLevel);

/** eid -> corrected heading level, for structured `heading`-type blocks (the
 *  same skip-prevention clamp `collectHeadings` already computed, re-exposed
 *  here keyed by eid so the render branch below can apply it). Compared
 *  against the SAME primary-heading promotion the render branch itself
 *  applies, so this only has an entry when the clamp actually lowered the
 *  level the render branch would otherwise have used. */
const tocHeadingRenderLevel = new Map<string, number>();
for (const e of tocEntries) {
  if (!e.eid || e.eid.includes('#')) continue;
  const promoted = e.eid === primaryHeadingEid ? 1 : e.level === 1 ? 2 : e.level;
  if (e.renderLevel !== promoted) tocHeadingRenderLevel.set(e.eid, e.renderLevel);
}

/* A gallery's grid comes from the widget, not from one site-wide rule: the
   column count per breakpoint, the tile crop and the gutter are all declared
   per instance. Each becomes a custom property on the grid element, and the
   stylesheet falls back to the old fixed values where a gallery declares
   nothing. The whole track list travels in one property so the fallback can
   stay an auto-fill rule rather than a column count. */
const track = (n?: number | null) => (n && n > 0 ? `repeat(${n}, minmax(0, 1fr))` : null);

const galleryStyle = (b: {
  cols?: number | null; colsTablet?: number | null; colsMobile?: number | null;
  aspect?: string | null;
  gap?: number | null; gapTablet?: number | null; gapMobile?: number | null;
}) => {
  const parts: string[] = [];
  const put = (k: string, v: string | null) => v && parts.push(`${k}:${v}`);
  put('--fg-track', track(b.cols));
  put('--fg-track-t', track(b.colsTablet));
  put('--fg-track-m', track(b.colsMobile));
  /* Masonry is laid out with CSS columns, which want the count itself rather
     than a grid track list. */
  put('--fg-cols', b.cols ? String(b.cols) : null);
  put('--fg-cols-t', b.colsTablet ? String(b.colsTablet) : null);
  put('--fg-cols-m', b.colsMobile ? String(b.colsMobile) : null);
  // Elementor writes the ratio as "16:9"; CSS wants "16 / 9".
  put('--fg-aspect', b.aspect ? b.aspect.replace(':', ' / ') : null);
  put('--fg-gap', typeof b.gap === 'number' ? `${b.gap}px` : null);
  put('--fg-gap-t', typeof b.gapTablet === 'number' ? `${b.gapTablet}px` : null);
  put('--fg-gap-m', typeof b.gapMobile === 'number' ? `${b.gapMobile}px` : null);
  return parts.length ? parts.join(';') : undefined;
};

/* Each top-level section's own outer margin, per breakpoint
   (src/data/section-css.json, from scripts/pull-section-margins.py). The port's
   Section never carried one: the before/after template's 50px above and below
   its one section, the location pages' 50px between theirs, and the 25px a
   service page opens between stacked sections on a phone were all missing.
   Keyed by section id so the template sections of D1-rendered posts get theirs
   too. */
const secMargins = (() => {
  const map = sectionCss as Record<string, { d?: string; t?: string; m?: string }>;
  const by = { d: [] as string[], t: [] as string[], m: [] as string[] };
  for (const s of sections ?? []) {
    const e = s?.id ? map[s.id] : undefined;
    if (!e) continue;
    for (const bp of ['d', 't', 'm'] as const) {
      if (e[bp]) by[bp].push(`section.sec[data-eid="${s.id}"]{${e[bp]}}`);
    }
  }
  return by.d.join('') +
    (by.t.length ? `@media (max-width:1024px){${by.t.join('')}}` : '') +
    (by.m.length ? `@media (max-width:767px){${by.m.join('')}}` : '');
})();
---

{secMargins && <style is:inline set:html={secMargins} />}
{groups.map((group, gi) => {
  const section = group.section;
  const blocksArr = group.blocks;
  const inner = blocksArr.map((b, i) => {
        if (b.type === 'heading') {
          const promoted = b.eid === primaryHeadingEid ? 1 : b.level === 1 ? 2 : b.level;
          // Clamped to never skip a level (see collectHeadings/tocHeadingRenderLevel);
          // only ever lower than `promoted`, never higher.
          const level = (b.eid ? tocHeadingRenderLevel.get(b.eid) : undefined) ?? promoted;
          const Tag = (b.tag ?? `h${Math.min(Math.max(level, 1), 6)}`) as 'h1';
          const id = b.eid ? tocIds.get(b.eid) : undefined;
          // When the clamp lowered the tag, apply a parallel class carrying the
          // ORIGINAL (authored) level's typography, mirroring `.rt-lvl*` for
          // rich-text headings -- the visual size/weight/transform must not
          // move just because the tag did.
          const hlvlClass = !b.tag && level !== promoted ? `hlvl${b.level}` : undefined;

          /* The offer price, on 403 pages, and the one place where flattening a
             widget into plain text changed what a customer is told.

             Keyed on the TEXT rather than on one element id. 403 headings on
             the site match this shape; 402 are a36b238 and the 403rd, on
             /tesla-vinyl-wraps/, is 19b01ef -- so the id test left exactly one
             page rendering "$4,500 $3,500" as a single run.

             The widget is Elementor's animated-headline with
             marker:strikethrough — the old price struck through in the brand
             pink at 22px, then the price you actually pay at 35px underneath.
             The scrape kept only its text, so both numbers arrived as one
             string and rendered as "$4,500 $3,500" at a single size with
             nothing saying which is which.

             Split at render rather than in the data: 402 of the 403 records
             also live in src/data/posts.json, which is rebuilt from D1 on every
             build. b.text is left whole so the table-of-contents anchor on all
             403 pages ("#4-500-3-500") still resolves. */
          if (/^\$[\d,]+\s+\$[\d,]+$/.test(b.text.trim())) {
            const [was, now] = b.text.trim().split(/\s+/);
            return (
              <Tag class:list={["price", { hd: !!b.tag }, hlvlClass]} id={id} data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
                <span class="ah-was">{was}</span><br /><span class="ah-now">{now}</span>
              </Tag>
            );
          }
          /* `hd` carries the heading widget's leading to the blocks that are
             not rendered as h1..h6. Elementor lets a heading choose its tag,
             and "Share This Post" is one of 402 that pick <p> — which then took
             the paragraph's 1.5 instead of the heading's 1, so it set 18px text
             on 27px leading against the original's 18. */
          return (
            <Tag class:list={[{ hd: !!b.tag }, hlvlClass]} id={id} data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
              {/* `textHtml` where the heading's content is markup rather than a
                  line of text. Elementor writes a heading as HTML, and the port
                  took its textContent -- so "Colour change wraps start at
                  <strong>$2,500</strong> for select vehicles" rendered with
                  nothing emphasised, on the one heading of these pages whose
                  emphasis is the price. `text` stays as it is, because the
                  table-of-contents anchors are built from it.

                  Only inline emphasis reaches here: the harvester refuses a
                  heading containing anything else, and an <a> is already
                  carried as `href` below. */}
              {/* textHtml wins over href. A heading whose anchor covers only
                  PART of its text -- "Give us a <a>call</a> or fill out the
                  form below." -- was extracted as a whole-heading link, so the
                  port made the entire sentence dial the phone. Where the
                  markup is carried, it says where the link starts and stops. */}
              {b.textHtml
                ? <Fragment set:html={b.textHtml} />
                : b.href
                  ? <a class="hlink" href={img(b.href)}>{b.text}{genericLinkContext(blocksArr, i, b) && <span class="elementor-screen-only"> – {genericLinkContext(blocksArr, i, b)}</span>}</a>
                  : b.text}
            </Tag>
          );
        }

        if (b.type === 'shareicons') {
          /* Real share links rather than the original's script-driven
             buttons: the same four networks, the same round navy icons on the
             widget's green panel, and they work without JavaScript. */
          const u = encodeURIComponent(new URL(Astro.url.pathname, Astro.site ?? 'https://vinylwraptoronto.com').href);
          return (
            <ul class="shareicons" data-eid={b.eid}>
              {b.networks.map((n) => (
                <li>
                  <a href={SHARE[n].href(u)} target="_blank" rel="noopener" aria-label={`Share on ${n}`}>
                    <i class={SHARE[n].icon} aria-hidden="true"></i>
                  </a>
                </li>
              ))}
            </ul>
          );
        }

        if (b.type === 'toc') {
          /* The widget is set to minimise (`minimize_box: yes`) and to start
             minimised from the tablet breakpoint down (`minimized_on:
             tablet`): open with a chevron-up on desktop, a 42px bar with a
             chevron-down at 1024 and below. The port drew it open at every
             width, which on a phone put a 900px list in the middle of the
             sidebar where the original has one line. Collapsed by CSS until
             the script runs, so there is no flash of the open list. */
          const tocId = `toc-${b.eid ?? 'list'}`;
          /* With nothing to list, the widget still draws its box and says so:
             a post whose copy has no headings of its own carries a 112px
             panel in the original's sidebar, not nothing. */
          return (
            <nav class="toc" aria-label={b.title} data-toc>
              <div class="toc-head">
                <h4 class="toc-title">{b.title}</h4>
                <button type="button" class="toc-toggle" aria-controls={tocId} aria-expanded="true" aria-label="Close table of contents">
                  <i class="fas fa-chevron-up" aria-hidden="true"></i>
                </button>
              </div>
              {tocEntries.length > 0 ? (
                <ol id={tocId}>
                  {tocEntries.map((e) => (
                    <li class={e.level === 3 ? 'lvl3' : 'lvl2'}>
                      <a href={`#${e.id}`}>{e.text}</a>
                    </li>
                  ))}
                </ol>
              ) : (
                <div id={tocId} class="toc-none">No headings were found on this page.</div>
              )}
              <script is:inline set:html={`
                (function () {
                  var nav = document.currentScript.closest('[data-toc]');
                  var btn = nav.querySelector('.toc-toggle'), icon = btn.querySelector('i');
                  var set = function (open) {
                    nav.setAttribute('data-state', open ? 'open' : 'closed');
                    btn.setAttribute('aria-expanded', String(open));
                    btn.setAttribute('aria-label', (open ? 'Close' : 'Open') + ' table of contents');
                    icon.className = 'fas fa-chevron-' + (open ? 'up' : 'down');
                  };
                  /* Like Elementor's, the default follows the breakpoint as the
                     window crosses it -- until the visitor opens or closes it
                     themselves, after which their choice stands. */
                  var mq = window.matchMedia('(max-width: 1024px)'), touched = false;
                  set(!mq.matches);
                  mq.addEventListener('change', function () { if (!touched) set(!mq.matches); });
                  btn.addEventListener('click', function () { touched = true; set(nav.getAttribute('data-state') !== 'open'); });
                })();
              `} />
            </nav>
          );
        }

        if (b.type === 'categories') {
          // The widget's own label, not a category name (those are the
          // <option> entries below, correctly non-headings already) -- a
          // genuine section heading for the dropdown next to it, so it is
          // clamped the same way every other heading-skip fix in this file
          // clamps, never turned into a link/non-heading. `.cat-title`'s
          // declarations are a class selector (see global styles below),
          // which beats a bare element rule regardless of which tag this
          // renders as, so appearance is identical at every clamped level.
          const CatTag = `h${Math.min(Math.max(categoriesLevel, 1), 6)}` as 'h5';
          return (
            <div class="catlist">
              <CatTag class="cat-title">{b.title}</CatTag>
              <form class="catform">
                <label class="elementor-screen-only" for="cat">{b.title}</label>
                <select name="cat" id="cat" class="postform" data-catnav>
                  <option value="">Select Category</option>
                  {categories.map((c) => (
                    <option value={c.href}>{catOption(c.name, c.count, c.level ?? 0)}</option>
                  ))}
                </select>
              </form>
              {/* The original's widget is JS-driven too: WordPress attaches a
                  change handler that submits the form to ?cat=<term id>. There
                  is no query handler on a static site, so the option value is
                  the archive address itself and the handler navigates to it —
                  same control, same options, same destination. */}
              <script is:inline set:html={`
                document.querySelectorAll('select[data-catnav]').forEach(function (select) {
                  select.addEventListener('change', function () {
                    if (select.value) window.location.href = select.value;
                  });
                });
              `} />
            </div>
          );
        }

        if (b.type === 'text') {
          // Give each body heading the id its table-of-contents entry links
          // to, and -- on the ~213 posts where the WordPress export carries
          // an H3/H4 straight after an H1/H2 with nothing between -- retag
          // it to close that gap (see `collectHeadings`). The closing tag is
          // rewritten in lockstep by a second pass keyed on the same opening
          // order, since headings here never nest. `rt-lvl{authored}` keeps
          // the original font-size/weight/colour exactly as scraped; only
          // the tag the DOM/crawler/AT sees changes.
          let openN = 0;
          let closeN = 0;
          const tagNums: number[] = [];
          const withIds = imgHtml(mailtoHrefs(b.html))
            .replace(
              /<h([2-6])\b([^>]*)>/g,
              (whole, lvl, attrs) => {
                const key = `${b.eid ?? 'rt'}#${openN++}`;
                const id = tocIds.get(key);
                const renderLevel = tocRenderLevel.get(key);
                const tagNum = renderLevel ?? Number(lvl);
                tagNums.push(tagNum);
                const idAttr = id && !/\bid=/.test(attrs) ? ` id="${id}"` : '';
                const classAttr = renderLevel ? ` class="rt-lvl${lvl}"` : '';
                return `<h${tagNum}${attrs}${classAttr}${idAttr}>`;
              },
            )
            .replace(/<\/h[2-6]>/g, () => `</h${tagNums[closeN++]}>`);
          const ig = instagramEmbeds(withSpacers(withIds, Astro.url.pathname));
          return (
            <>
              <div class="rt" data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined} set:html={ig.html} />
              {ig.found && <script is:inline async src="https://www.instagram.com/embed.js"></script>}
            </>
          );
        }

        if (b.type === 'image') {
          /* Phase 8A: on Home the LCP element is this exact figure -- the
             page's first section, first block -- and it was marked
             loading="lazy" with no fetchpriority, so the browser deferred
             its own largest paint. Every other `image` block (mid-page,
             gallery, or nested inside a column via the recursive
             `Astro.self blocks={c.blocks}` call) is unaffected: this only
             matches the very first block of the very first top-level
             section on the page.
             Phase 8C follow-up: `b.hide` marks one of a set of
             art-directed, breakpoint-specific images (see
             `[data-hide~=...]{display:none}` in global.css). `display:none`
             does not stop an eager/high-priority fetch, so blindly matching
             i===0 here would force-load the desktop-only variant even on
             mobile/tablet where it's hidden and a *different* block is the
             one actually visible. Those pages already get a targeted
             per-breakpoint `<link rel="preload">` from [...slug].astro, so
             we exclude any hide-tagged block here and only eager-load a
             true single, unconditional first image (e.g. web-story
             covers). */
          const isLcpCandidate = !inColumn && gi === 0 && i === 0 && !b.hide?.length;
          const imgName = b.alt ? describe(b.src, b.alt) : (b.href ? describe(b.src, b.alt, LINKED) : b.alt);
          const opt = optOf(b.src);
          const imgEl = (
            <img
              src={img(b.src)}
              alt={imgName}
              width={num(b.width)}
              height={num(b.height)}
              loading={isLcpCandidate ? 'eager' : 'lazy'}
              fetchpriority={isLcpCandidate ? 'high' : undefined}
              decoding="async"
            />
          );
          /* Offline-generated webp siblings (prebuilt, see docs/img-opt-provenance.md) for the
             home gallery thumbnails; the original jpg stays as the fallback
             <img>, so non-webp browsers and the img/alt/size markup are
             unchanged. 768w is the source's full width, so DPR2 keeps full
             detail; 384w serves DPR1. */
          const pic = opt ? (
            <picture>
              <source type="image/webp" srcset={`${opt[384]} 384w, ${opt[768]} 768w`} sizes="(max-width: 767px) calc(100vw - 20px), 384px" />
              {imgEl}
            </picture>
          ) : imgEl;
          return (
            <figure class={`${b.full ? 'fig fig--full' : 'fig'}${b.imgWidth ? ' fig--iw' : ''}`} data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[imgWidthVars(b.imgWidth), b.href && b.imgWidth && num(b.width) ? `--iw-cap:${num(b.width)}px` : ''].filter(Boolean).join(';') || undefined}>
              {b.href ? <a href={img(b.href)} aria-label={imgName || 'View image details'}>{pic}</a> : pic}
            </figure>
          );
        }

        if (b.type === 'button') {
          // The live buttons are 50%-width siblings, so a run of them sits on
          // one centred row rather than stacking.
          const prev = blocksArr[i - 1];
          if (prev && prev.type === 'button') return null;
          const run = [];
          for (let k = i; k < blocksArr.length; k++) {
            const nb = blocksArr[k];
            if (nb.type !== 'button') break;
            run.push(nb);
          }
          return (
            <p class="btnrow" data-eid={b.eid} data-hide={b.hide?.join(" ")} style={[b.box, b.style].filter(Boolean).join(";") || undefined}>
              {run.map((rb) => (
                rb.popup ? (
                  <button class:list={['btn', { 'btn--icon-right': rb.iconRight }]} type="button" data-popup={rb.popup} style={btnStyle(rb)}>
                    {rb.icon && <i class:list={['btn-ic', rb.icon]} aria-hidden="true"></i>}
                    {rb.textHtml ? <span set:html={rb.textHtml} /> : rb.text}
                  </button>
                ) : (
                  <a class:list={['btn', { 'btn--icon-right': rb.iconRight }]} href={img(rb.href!)} style={btnStyle(rb)}>
                    {rb.icon && <i class:list={['btn-ic', rb.icon]} aria-hidden="true"></i>}
                    {rb.textHtml ? <span set:html={rb.textHtml} /> : rb.text}
                  </a>
                )
              ))}
            </p>
          );
        }

        if (b.type === 'list') {
          /* The list's own Space Between, per breakpoint (list-space.json). */
          const sp = listSpaceOf(b.eid);
          const spVars = sp ? [sp.d != null ? `--lsp:${sp.d}px` : '', sp.t != null ? `--lsp-t:${sp.t}px` : '', sp.m != null ? `--lsp-m:${sp.m}px` : ''] : [];
          return (
            <ul class="ilist" data-eid={b.eid} data-hide={b.hide?.join(" ")} data-sp={sp ? '' : undefined} data-div={b.divider ? '' : undefined} style={[b.box, b.style, ...spVars, b.divider ? `--ldiv:${b.divider}` : ''].filter(Boolean).join(";") || undefined}>
              {b.items.map((i) => (
                <li class:list={{ 'has-ic': !!i.icon }} style={b.itemStyle ?? undefined}>
                  {i.icon && <i class:list={['li-ic', i.icon]} aria-hidden="true"></i>}
                  {/* `textHtml` where the item's text is markup rather than a
                      plain line -- the original emphasises the lead-in of a
                      benefit item, `<strong>Protects Original Paint</strong> -
                      Shields against...`, and the port took its textContent so
                      the title and its explanation ran together unemphasised.
                      Inline emphasis only; an <a> is carried as `href`. */}
                  {i.href
                    ? <a href={img(i.href)}>{i.text}</a>
                    : i.textHtml
                      ? <Fragment set:html={i.textHtml} />
                      : i.text}
                </li>
              ))}
            </ul>
          );
        }

        if (b.type === 'feature') {
          const T = `h${Math.min(Math.max(b.level ?? 3, 1), 6)}` as 'h3';
          /* An image-box carrying its own layout is drawn as Elementor draws
             it: the picture in its own box beside or above a text column. */
          const fi = !!(b.image && b.imagePos);
          const side = fi && b.imagePos !== 'top';
          /* An image-box's Link setting: Elementor puts the same <a> round the
             picture and round the title's text, so both open it. */
          const boxHref = fi && b.href ? img(b.href) : undefined;
          /* An icon-box's Link does the same for its icon and its title. */
          const titleHref = boxHref ?? (!fi && b.icon && b.iconHref ? img(b.iconHref) : undefined);
          const titleInner = b.titleHtml ? <Fragment set:html={b.titleHtml} /> : b.title;
          const title = b.title && (
            <T style={b.titleStyle ?? undefined}>
              {titleHref ? <a class="feature-link" href={titleHref}>{titleInner}</a> : titleInner}
            </T>
          );
          const text = b.text && <p style={b.textStyle ?? undefined}>{b.text}</p>;
          if (fi) {
            return (
              <div
                class:list={['feature', 'feature--fi', `feature--${b.imagePos}`,
                  b.vAlign ? `feature--va-${b.vAlign}` : null]}
                data-eid={b.eid}
                data-hide={b.hide?.join(" ")}
                style={[
                  b.box,
                  b.style,
                  b.align ? `--feat-align:${b.align}` : '',
                  b.imgW ? `--fi-w:${b.imgW}` : '',
                  b.imgWT ? `--fi-w-t:${b.imgWT}` : '',
                  b.imgWM ? `--fi-w-m:${b.imgWM}` : '',
                  b.imgGap ? `--fi-gap:${b.imgGap}` : '',
                ].filter(Boolean).join(";") || undefined}
              >
                <figure class="feature-img">
                  {boxHref ? (
                    <a class="feature-link" href={boxHref}>
                      <img src={img(b.image!)} alt={b.alt ?? ''} loading="lazy" decoding="async" />
                    </a>
                  ) : (
                    <img src={img(b.image!)} alt={b.alt ?? ''} loading="lazy" decoding="async" />
                  )}
                </figure>
                {side ? <div class="feature-body">{title}{text}</div> : <>{title}{text}</>}
              </div>
            );
          }
          const icLeft = b.iconPos === 'left' && !!b.icon && !b.image;
          return (
            <div
              class:list={['feature', { 'feature--ic-left': icLeft }]}
              data-eid={b.eid}
              data-hide={b.hide?.join(" ")}
              style={[
                b.box,
                b.style,
                /* Harvested per widget from the original's own inline rule,
                   `.elementor-element-<eid> .elementor-icon-box-wrapper
                    { text-align: ...; gap: ... }`. Custom properties rather
                   than direct declarations so the stylesheet keeps its say
                   over anything these do not set. */
                b.align ? `--feat-align:${b.align}` : '',
                b.iconGap ? `--feat-gap:${b.iconGap}` : '',
                /* Elementor's Title Bottom Space, where the widget sets one. */
                b.eid && iconBoxOf(b.eid)?.titleGap ? `--feat-tgap:${iconBoxOf(b.eid)!.titleGap}` : '',
              ].filter(Boolean).join(";") || undefined}
            >
              {b.icon && (
                b.iconHref
                  ? <a class="feature-ic" href={img(b.iconHref)} tabindex="-1" aria-hidden="true" style={iconSizeVars(b.eid)}><i class={b.icon}></i></a>
                  : <span class="feature-ic" aria-hidden="true" style={iconSizeVars(b.eid)}><i class={b.icon}></i></span>
              )}
              {b.image && <img src={img(b.image)} alt={describe(b.image, b.alt ?? '')} width={dimsOf(b.image)?.[0]} height={dimsOf(b.image)?.[1]} loading="lazy" decoding="async" />}
              {/* `titleHtml` where the title carries emphasis. The warranty
                  box is "3 Year Warranty<sup>*</sup>" and the port took its
                  textContent, so the footnote marker dropped to the baseline
                  with a space in front of it and read as part of the name.
                  `title` and `text` are the same nodes built above. */}
              {icLeft ? <div class="feature-body">{title}{text}</div> : <>{title}{text}</>}
            </div>
          );
        }

        if (b.type === 'pagination' && b.variant === 'theme') {
          /* Hello Elementor's archive pager, as the theme template prints it:
             an empty slot where there is no previous page, then Next. */
          return (
            <nav class="pagination" aria-label="Pagination">
              <div class="nav-previous">
                {b.current > 1 && (
                  <a href={pagerHref(b.base, b.current - 1)} rel="prev"><span class="meta-nav" aria-hidden="true">&larr;</span> Previous</a>
                )}
              </div>
              <div class="nav-next">
                {b.current < b.total && (
                  <a href={pagerHref(b.base, b.current + 1)} rel="next">Next <span class="meta-nav" aria-hidden="true">&rarr;</span></a>
                )}
              </div>
            </nav>
          );
        }

        if (b.type === 'pagination') {
          return (
            <nav class="elementor-pagination" aria-label={`Pagination ${i + 1}`} data-eid={b.eid}>
              {b.current > 1 ? (
                <a class="page-numbers prev" href={pagerHref(b.base, b.current - 1)} rel="prev">« Previous</a>
              ) : (
                <span class="page-numbers prev">« Previous</span>
              )}
              {(b.showAll ? Array.from({ length: b.total }, (_, i) => i + 1) : pagerSteps(b.current, b.total)).map((n) =>
                n === '…' ? (
                  <span class="page-numbers dots">…</span>
                ) : n === b.current ? (
                  <span class="page-numbers current" aria-current="page">
                    <span class="elementor-screen-only">Page</span>{n}
                  </span>
                ) : (
                  <a class="page-numbers" href={pagerHref(b.base, n as number)}>
                    <span class="elementor-screen-only">Page</span>{n}
                  </a>
                ),
              )}
              {b.current < b.total ? (
                <a class="page-numbers next" href={pagerHref(b.base, b.current + 1)} rel="next">Next »</a>
              ) : (
                <span class="page-numbers next">Next »</span>
              )}
            </nav>
          );
        }

        /* The theme's archive template, not Elementor's posts widget: entries
           stacked full width, each an h2 title link over the featured image
           over the excerpt. Measured on the original at 1440: main 1140px,
           .page-content display:block, h2 28px/33.6 Poppins 600 capitalize
           with a #FF0099 link, the image at the container's width and its own
           ratio, the excerpt 16px/24. */
        if (b.type === 'cards' && b.stacked) {
          return (
            <div class="arch" data-eid={b.eid} data-hide={b.hide?.join(' ')}>
              {b.cards.map((c) => (
                <article class="arch-post">
                  <h2><a href={c.href}>{c.title}</a></h2>
                  {c.image && (
                    <a
                      class:list={['arch-thumb', { 'arch-thumb--natural': c.natural }]}
                      href={c.href}
                      tabindex="-1"
                    >
                      <img
                        src={img(c.image)}
                        alt={describe(c.image, c.alt || c.title)}
                        width={c.natural ? c.w : undefined}
                        height={c.natural ? c.h : undefined}
                        style={c.natural && c.w ? `--nw:${c.w}px` : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  {/* The story player. It is an AMP component on the original;
                      what it shows at rest is the story's poster at the box it
                      declares, so that is what is drawn, as a link into the
                      story rather than a dead frame. */}
                  {c.story && c.image && (
                    <a
                      class="arch-story"
                      href={c.href}
                      style={`width:${c.story.w}px;height:${c.story.h}px`}
                      aria-label={`Open the story: ${c.title}`}
                    >
                      <img src={img(c.image)} alt="" loading="lazy" decoding="async" />
                    </a>
                  )}
                  {c.desc && <p class="arch-excerpt">{c.desc}</p>}
                </article>
              ))}
            </div>
          );
        }

        if (b.type === 'cards') {
          /* The one loop widget on the blog template. Its cards are recomputed
             from the current posts; every other cards block is page content and
             is rendered as captured. */
          const cards =
            LIVE_LOOPS.has(b.eid as string)
              ? recentCards(Astro.url.pathname, b.cards.length || 2, b.cards?.[0])
              : b.cards;
          const ownCss = b.eid ? cardCss(b.eid) : '';
          return (
            <>
            {ownCss && <style is:inline set:html={ownCss} />}
            <ul
              class="cards"
              data-eid={b.eid}
              data-hide={b.hide?.join(" ")}
              style={[
                b.cols ? `--cards-d:${b.cols}` : '',
                b.colsTablet ? `--cards-t:${b.colsTablet}` : '',
                b.colsMobile ? `--cards-m:${b.colsMobile}` : '',
                typeof b.gapCol === 'number' ? `--cards-gap-c:${b.gapCol}px` : '',
                typeof b.gapRow === 'number' ? `--cards-gap-r:${b.gapRow}px` : '',
              ].filter(Boolean).join(';') || undefined}
            >
              {cards.map((c) => (
                <li>
                  {c.badge && <span class="card-badge" style={b.badgeStyle ?? undefined}>{c.badge}</span>}
                  {c.image && (
                    <a class="card-thumb" href={c.href} tabindex="-1">
                      <img
                        src={img(c.image)}
                        alt={describe(c.image, c.alt || c.title)}
                        width={thumbBox(c.image, c).w}
                        height={thumbBox(c.image, c).h}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div class="card-text">
                    {/* The original titles each card with
                        <h3 class="elementor-post__title">; a span instead took
                        1,223 headings out of the document outline. On
                        archive/tag/brand listing templates this widget sits
                        directly under the H1 with no H2 yet, so the tag is
                        clamped (never raised) the same way every other
                        heading is -- see `collectHeadings`/`cardsLevel`.
                        `.card-title` (not the tag) now carries the typography
                        below so it stays put no matter which tag is chosen. */}
                    {(() => {
                      const CardTitleTag = `h${cardsLevel}` as 'h3';
                      return (
                        <CardTitleTag class="card-title" style={b.titleStyle ?? undefined}>
                          <a href={c.href}>{c.title}</a>
                        </CardTitleTag>
                      );
                    })()}
                    {'desc' in c && c.desc && <p class="card-desc" style={b.descStyle ?? undefined}>{c.desc}</p>}
                    {/* `card-more` duplicates the title/thumbnail link's own
                        `href` purely as decorative "Read More" text -- it was
                        already pulled out of the tab order (tabindex="-1")
                        since clicking it reached nothing new. On narrow
                        viewports a wrapped 2-line title sits close enough
                        above it (raw node: `li:nth-child(3) > .card-text >
                        .card-title > a` on mobile /blog/, ~4.6px of gap)
                        that axe's WCAG 2.5.8 target-size check flags the
                        pair as two separate, too-closely-spaced interactive
                        targets. `aria-hidden` alone does not satisfy axe's
                        check here -- target-size evaluates paintable/
                        clickable geometry, not the accessibility tree, so a
                        hidden-but-still-`href`-bearing anchor is still
                        counted as a second target. Rendering it as a plain
                        `<span>` (no `href`, not a link) removes it as an
                        interactive target entirely; the title and
                        thumbnail links still reach the same destination, so
                        no destination becomes unreachable. */}
                    {c.more && (
                      <span class="card-more" style={b.moreStyle ?? undefined}>{c.more}</span>
                    )}
                  </div>
                  {(c.author || c.date) && (
                    <div class="card-meta" style={b.metaStyle ?? undefined}>
                      {c.author && <span class="card-author">{c.author}</span>}
                      {c.date && <span class="card-date">{c.date}</span>}
                    </div>
                  )}
                </li>
              ))}
            </ul>
            </>
          );
        }

        if (b.type === 'postnav') {
          return (
            <nav
              class="postnav"
              aria-label="Post navigation"
              data-eid={b.eid}
              style={b.box ?? undefined}
            >
              {b.prev && (
                <a class="postnav-prev" href={b.prev.href} rel="prev">
                  <span class="postnav-arrow"><i class="fas fa-angle-left" aria-hidden="true" /></span>
                  <span class="postnav-text">
                    <span class="dir">Previous</span>
                    <span class="t">{navTitle(b.prev.text, 'prev')}</span>
                  </span>
                </a>
              )}
              {b.prev && b.next && <span class="postnav-sep" aria-hidden="true" />}
              {b.next && (
                <a class="postnav-next" href={b.next.href} rel="next">
                  <span class="postnav-text">
                    <span class="dir">Next</span>
                    <span class="t">{navTitle(b.next.text, 'next')}</span>
                  </span>
                  <span class="postnav-arrow"><i class="fas fa-angle-right" aria-hidden="true" /></span>
                </a>
              )}
            </nav>
          );
        }

        if (b.type === 'testimonials') {
          /* The landing pages' review carousel, measured on /lp/ at 1440 and
             390: one review at a time in a navy speech bubble, the slider 95%
             of the widget and centred, 40px held under it for the bullets;
             20px pink arrows 10px in from the widget's edges. */
          return (
            <div
              class="carou carou--testi"
              data-eid={b.eid}
              data-carousel
              data-per="1"
              data-per-tablet="1"
              data-per-mobile="1"
              data-autoplay={b.autoplay ? 'yes' : 'no'}
              data-delay={b.delay}
              data-speed={b.speed}
              data-pause={b.pauseOnHover ? 'yes' : 'no'}
              data-infinite={b.infinite ? 'yes' : 'no'}
              style={[b.box, `--carou-gap:${b.gap}px`].filter(Boolean).join(';')}
            >
              <div class="carou-track">
                {b.items.map((t) => (
                  <figure class="carou-slide testi">
                    <blockquote class="testi-bubble"><p>{t.text}</p></blockquote>
                    <figcaption class="testi-foot">
                      <cite><span class="testi-name">{t.name}</span><span class="testi-title">{t.title}</span></cite>
                    </figcaption>
                  </figure>
                ))}
              </div>
              {b.arrows && (
                <>
                  <button type="button" class="carou-arrow carou-arrow--prev" aria-label="Previous review">
                    <svg viewBox="0 0 1000 1000" aria-hidden="true"><path d="M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z"/></svg>
                  </button>
                  <button type="button" class="carou-arrow carou-arrow--next" aria-label="Next review">
                    <svg viewBox="0 0 1000 1000" aria-hidden="true"><path d="M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z"/></svg>
                  </button>
                </>
              )}
              {b.dots && <div class="carou-dots" role="tablist" aria-label="Review" />}
            </div>
          );
        }

        if (b.type === 'carousel') {
          return (
            /* `box` belongs on the carousel container; the image style is a
               separate per-slide rule. */
            <div
              class:list={['carou', { 'carou--dots': b.dots }]}
              data-eid={b.eid}
              data-carousel
              data-per={b.perView}
              data-per-tablet={b.perViewTablet}
              data-per-mobile={b.perViewMobile}
              data-autoplay={b.autoplay ? 'yes' : 'no'}
              data-delay={b.delay}
              data-speed={b.speed}
              data-pause={b.pauseOnHover ? 'yes' : 'no'}
              data-infinite={b.infinite ? 'yes' : 'no'}
              data-scroll={b.scroll ?? 1}
              style={[b.box, `--carou-gap:${b.gap}px`].filter(Boolean).join(';')}
            >
              <div class="carou-track">
                {b.images.map((i) => (
                  <figure class="carou-slide">
                    {/* width/height so the browser reserves the slide's aspect
                        ratio before the image loads -- the UA stylesheet derives
                        `aspect-ratio` from these attributes even though the CSS
                        only constrains width, which is what keeps a lazy-loaded
                        slide from shifting layout in behind it. */}
                    <img src={img(i.src)} alt={describe(i.src, i.alt)} loading="lazy" decoding="async"
                         width={i.width ?? undefined} height={i.height ?? undefined}
                         style={b.imgStyle ?? undefined} />
                  </figure>
                ))}
              </div>
              {b.arrows && (
                <>
                  {/* Elementor's eicon-chevron-left/right: 25px, inside the
                      slide 10px from its edge, centred on its height. */}
                  <button type="button" class="carou-arrow carou-arrow--prev" aria-label="Previous slide"
                          style={b.arrowColor ? `color:${b.arrowColor}` : undefined}>
                    <svg viewBox="0 0 1000 1000" aria-hidden="true"><path d="M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z"/></svg>
                  </button>
                  <button type="button" class="carou-arrow carou-arrow--next" aria-label="Next slide"
                          style={b.arrowColor ? `color:${b.arrowColor}` : undefined}>
                    <svg viewBox="0 0 1000 1000" aria-hidden="true"><path d="M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z"/></svg>
                  </button>
                </>
              )}
              {b.dots && (
                <div
                  class="carou-dots"
                  role="tablist"
                  aria-label="Slide"
                  style={[
                    b.dotColor ? `--dot:${b.dotColor}` : '',
                    b.dotActive ? `--dot-on:${b.dotActive}` : '',
                  ].filter(Boolean).join(';') || undefined}
                />
              )}
            </div>
          );
        }

        if (b.type === 'gallery') {
          return (
            <div class="gallery">
              {/* Dimensions so the browser can reserve each tile's box: this
                  grid states no ratio of its own, so without them a lazy tile
                  that has not decoded is zero pixels tall. Nothing overrides
                  aspect-ratio here, so the attributes alone are enough. */}
              {b.images.map((i) => {
                const d = dimsOf(i.src);
                return (
                  <a class="lb-link" href={img(i.src)}>
                    <img src={img(i.src)} alt={describe(i.src, i.alt)} width={d?.[0]} height={d?.[1]} loading="lazy" decoding="async" />
                  </a>
                );
              })}
            </div>
          );
        }

        if (b.type === 'faq') {
          /* One answer open at a time, as on the original: all three FAQs are
             Elementor accordions (max_items_expended "one"), and the port's
             independent <details> left every answer opened still open. A shared
             `name` makes them an exclusive group natively, keyboard included;
             Interactions.astro closes the others where `name` is unsupported. */
          const group = `faq-${(b.items[0]?.q ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40)}`;
          return (
            <div class="faq" data-single>
              {b.items.map((qa, i) => (
                <details name={group} open={b.openIndex === i ? true : undefined}>
                  <summary>{qa.q}</summary>
                  <div class="rt" set:html={imgHtml(qa.a)} />
                </details>
              ))}
            </div>
          );
        }

        if (b.type === 'divider') {
          return <hr class="wdivider" data-eid={b.eid} />;
        }

        if (b.type === 'countdown') {
          /* Rendered with the digits blank and the whole thing hidden until the
             script fills it in: an evergreen countdown has no server-side value,
             and four zeroes flashing before it starts would read as expired. */
          return (
            <div
              class="cdown"
              data-eid={b.eid}
              data-countdown={b.interval}
              hidden
              style={[
                b.pad ? `--cd-pad:${b.pad}` : '',
                b.bg ? `--cd-bg:${b.bg}` : '',
                b.digitSize ? `--cd-digit:${b.digitSize}` : '',
                b.labelSize ? `--cd-label:${b.labelSize}` : '',
              ].filter(Boolean).join(';') || undefined}
            >
              {[['days', 'Days'], ['hours', 'Hours'], ['minutes', 'Minutes'], ['seconds', 'Seconds']].map(
                ([k, label]) => (
                  <div class="cdown-item">
                    <span class="cdown-digits" data-unit={k}>&nbsp;</span>
                    <span class="cdown-label">{label}</span>
                  </div>
                ),
              )}
            </div>
          );
        }

        if (b.type === 'share') {
          return (
            <div class="share" role="list">
              {SHARE_NETWORKS.map((n) => (
                <a
                  class={`share-btn share-btn--${n.id}`}
                  role="listitem"
                  href={n.href(b.url)}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Share on ${n.label}`}
                >
                  <span class="share-ic"><i class={n.icon} aria-hidden="true"></i></span>
                  <span class="share-tx">{n.label}</span>
                </a>
              ))}
            </div>
          );
        }

        if (b.type === 'compare') {
          return (
            /* Its own box: the project pages put the slider 35px under the
               title, which the port dropped to the 20px widget gap. */
            <div class="compare" style={b.box ?? undefined}>
              {/* Dimensions so each picture reserves its box before it arrives.
                  Without them these were the last images on the site with
                  nothing holding their shape, and it shows worst here: the
                  slider lays the "after" picture over the "before" one and
                  reveals it by clipping, so a picture that has not loaded has
                  no size to be clipped against and the pair renders wrong.
                  /our-work/ puts 69 of these on one page.

                  It is also why the original turns lazy loading off on them
                  (its markup carries a3-notlazy, and none of its 140 images is
                  lazy). It had to: it reserves nothing either. With a real box
                  held for each picture, lazy loading is safe, so the page keeps
                  that saving rather than fetching all 69 pairs up front. */}
              {b.pairs.map((p) => {
                /* In a column, 768 wide -- the same "medium_large" the grid
                   galleries ask for. A pair in a column is drawn at 536-628px,
                   so the upload is wasted: /our-work/ carries 69 of them, which
                   at full size is 138 photographs and 13.4MB on one page, every
                   one of which the browser must also decode and hold.

                   At section level it keeps the upload. Those are the single
                   project pages, where the pair is drawn at 1160px and a
                   768-wide file would be visibly upscaled -- and where there
                   are two images on the page, so there is nothing to save.

                   Either way the upload stays reachable: data-full is what the
                   lightbox opens. */
                const bt = inColumn ? tileOf(p.before.src) : { src: p.before.src, ...dimsPair(p.before.src) };
                const at = inColumn ? tileOf(p.after.src) : { src: p.after.src, ...dimsPair(p.after.src) };
                return (
                <div class="compare-pair">
                  <figure>
                    <img src={img(bt.src)} data-full={img(p.before.src)} alt={describe(p.before.src, p.before.alt)}
                      width={bt.w} height={bt.h} loading="lazy" decoding="async" />
                    <figcaption>{p.beforeLabel}</figcaption>
                  </figure>
                  <figure>
                    <img src={img(at.src)} data-full={img(p.after.src)} alt={describe(p.after.src, p.after.alt)}
                      width={at.w} height={at.h} loading="lazy" decoding="async" />
                    <figcaption>{p.afterLabel}</figcaption>
                  </figure>
                </div>
                );
              })}
            </div>
          );
        }

        if (b.type === 'filtergallery') {
          return (
            /* The widget's own box: the service pages put their gallery 75px
               below the button above it, the project pages 35px. */
            <div class="fgal" data-filtergallery style={b.box ?? undefined}>
              {b.filters.length > 0 && (
                <div class="fgal-tabs" role="tablist" aria-label="Gallery filter">
                  {b.filters.map((f, i) => (
                    <button
                      type="button"
                      role="tab"
                      class="fgal-tab"
                      data-index={f.index}
                      aria-selected={i === 0 ? 'true' : 'false'}
                    >
                      {f.label}
                    </button>
                  ))}
                </div>
              )}
              <div
                class:list={['fgal-grid', { 'fgal-grid--masonry': b.masonry && !b.rowHeight, 'fgal-grid--justified': !!b.rowHeight }]}
                style={[galleryStyle(b), b.rowHeight ? `--fg-rh:${b.rowHeight.d}px` : ''].filter(Boolean).join(';') || undefined}
                data-rh={b.rowHeight?.d}
                data-rh-t={b.rowHeight?.t}
                data-rh-m={b.rowHeight?.m}
              >
                {b.items.map((it) => {
                  const t = tileOf(it.src, b.masonry || !!b.rowHeight);
                  return (
                  <figure class="fgal-item" data-tag={it.tag}>
                    {/* The link carries the full-size upload, as the original's
                        does: it is what the lightbox opens, and what makes the
                        picture reachable with JS off. Only the tile itself is
                        served at thumbnail size. */}
                    <a class="lb-link" href={img(it.src)} title={it.title}>
                      {/* The ratio has to be inline: the masonry rule sets
                          `aspect-ratio: auto`, which also discards the ratio a
                          browser would otherwise infer from width/height. The
                          plain grid crops every tile to one ratio on purpose,
                          so it keeps that and only the shape-preserving
                          masonry variant gets the file's own. */}
                      <img
                        src={img(t.src)}
                        alt={describe(it.src, it.alt ?? it.title)}
                        width={t.w}
                        height={t.h}
                        style={(b.masonry || b.rowHeight) && t.w && t.h ? `aspect-ratio:${t.w}/${t.h}` : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </figure>
                  );
                })}
              </div>
            </div>
          );
        }

        if (b.type === 'form') {
          const form = (
            <QuoteForm
              id={`f-${section?.id ?? 's'}`}
              fields={b.fields}
              placeholders={b.placeholders}
              submit={b.submit}
              photoNote={b.photoNote}
              radius={b.radius}
              submitSize={b.submitSize}
              rows={b.rows}
              submitAlign={b.submitAlign}
              half={b.half}
              submitCase={b.submitCase}
              tone={b.tone}
            />
          );
          /* The form widget's own box (a panel colour, padding) and its
             per-breakpoint visibility, as on every other block. Neither was
             carried: the landing page's hero form, hidden on a phone on the
             original, showed there and pushed the hero 239px taller. */
          const wrapStyle = [b.box, b.style].filter(Boolean).join(';');
          return wrapStyle || b.hide?.length
            ? <div class="formwrap" style={wrapStyle || undefined} data-hide={b.hide?.join(' ')}>{form}</div>
            : form;
        }

        if (b.type === 'map') {
          return (
            <div class="mapembed">
              <iframe
                src={b.src}
                title="Map"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          );
        }

        if (b.type === 'video') {
          return (
            <div class="video">
              <iframe
                src={b.src}
                title="Video"
                loading="lazy"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
          );
        }

        if (b.type === 'columns') {
          return (
            <div
              class="cols"
              id={b.anchor ?? undefined}
              style={[
                b.margin ? `margin:${b.margin}` : '',
                /* `.cols` is width:100%, so a side margin would push the row
                   out past its column by that much; take it off the width. */
                rowSideMargins(b.margin) ? `width:calc(100% - (${rowSideMargins(b.margin)}))` : '',
                rowMarginVars(b) ?? '',
                b.minHeight ? `--row-mh:${b.minHeight}` : '',
                b.minHeightT ? `--row-mh-t:${b.minHeightT}` : '',
                b.minHeightM ? `--row-mh-m:${b.minHeightM}` : '',
                /* Elementor's own row gap. The port used a flat 20px; the hero
                   rows are flush, and the 20px was coming out of the columns'
                   widths. */
                b.gap != null ? `--cols-gap:${b.gap}px` : '',
                b.flex?.justify ? `justify-content:${b.flex.justify}` : '',
                b.flex?.align ? `align-items:${b.flex.align}` : '',
                b.equalRows ? `--eq-n:${Math.max(1, Math.round(100 / (b.cols?.[0]?.width || 100)))}` : '',
                b.equalRows && b.cols?.[0]?.tabletWidth ? `--eq-n-t:${Math.max(1, Math.round(100 / b.cols[0].tabletWidth))}` : '',
                b.equalRows ? `--eq-n-m:${Math.max(1, Math.round(100 / (b.cols?.[0]?.mobileWidth || 100)))}` : '',
              ].filter(Boolean).join(';') || undefined}
              data-eqrows={b.equalRows ? '' : undefined}
              data-rowmh={b.minHeight || b.minHeightT || b.minHeightM ? '' : undefined}
              data-rowm={rowMarginVars(b) ? '' : undefined}
              data-stack={!b.flex && !b.equalRows && (b.cols ?? []).reduce((t, c) => t + (c.width ?? 100), 0) <= 101 && !(b.cols ?? []).some((c) => c.mobileWidth != null) ? '' : undefined}
              data-valign={b.valign ?? undefined}
              data-flexrow={b.flex ? '' : undefined}
              data-reverse={b.reverse?.length ? b.reverse.join(' ') : undefined}
            >
              {b.cols.map((c) => {
                /* Only a column that sits on a colour of its own gets one; a
                   declared #ffffff is the page background already. */
                const tinted = c.background && c.background.toLowerCase() !== '#ffffff';
                const style = [
                  `--col-w:${c.width}%`,
                  c.tabletWidth != null ? `--col-tw:${c.tabletWidth}%` : '',
                  c.tabletWidth != null
                    ? `--col-tgutter:${((b.gap ?? 20) * (1 - Math.min(c.tabletWidth, 100) / 100)).toFixed(2)}px` : '',
                  c.mobileWidth != null ? `--col-mw:${c.mobileWidth}%` : '',
                  c.mobileWidth != null
                    ? `--col-mgutter:${((b.gap ?? 20) * (1 - Math.min(c.mobileWidth, 100) / 100)).toFixed(2)}px` : '',
                  c.padT ? `--col-pad-t:${c.padT}` : '',
                  c.padM ? `--col-pad-m:${c.padM}` : '',
                  /* The share of the row's gutter this column has to give up so
                     that a full row still fits on one line.

                     A flex row that wraps sizes its items from their basis and
                     only shrinks what is already on the line, so a 50% column
                     in a row with a 30px gap has to ask for 50% - 15px or the
                     second one wraps. Subtracting the WHOLE gutter from every
                     column, which the port did, keeps the wrap right and makes
                     every row narrower than the original's: two columns came
                     out 20px short of the container, three came out 40. It is
                     the gutter times the share of the row this column is NOT:
                     15px of a 30px gutter at 50%, 13.3px of a 20px gutter at a
                     third, nothing at all where the row has no gutter. */
                  `--col-gutter:${(((b.gap ?? 20) * (1 - Math.min(c.width ?? 100, 100) / 100))).toFixed(2)}px`,
                  tinted ? `background-color:${c.background}` : '',
                  /* A column's padding is its own, tinted or not. Gating it on
                     the background dropped the hero's left column inset --
                     the original insets that column 50px, which is why its
                     heading starts 30px further in than the port's did. Only
                     one other column site-wide declares padding without a
                     colour, so ungating this moves nothing else. */
                  /* As a property, so a breakpoint value can replace it. */
                  c.padding ? `--col-pad:${c.padding}` : '',
                  /* Not gated on `tinted`: a border or shadow is drawn whether
                     or not the column sits on a colour of its own. */
                  c.border ? c.border : '',
                  c.shadow ? `box-shadow:${c.shadow}` : '',
                  c.radius ? `border-radius:${c.radius}` : '',
                  c.minHeight ? `--col-mh:${c.minHeight}` : '',
                  c.minHeightT ? `--col-mh-t:${c.minHeightT}` : '',
                  c.minHeightM ? `--col-mh-m:${c.minHeightM}` : '',
                  c.widgetGap != null ? `--widget-gap:${c.widgetGap}px` : '',
                  ...colMarginVars(c),
                ].filter(Boolean).join(';');
                /* A loop-grid card: its own 1px border, padding and radius,
                   with the title and the View Pictures button centred inside
                   it. Ours drew no card, which is why a button looked like it
                   belonged to the pair below rather than the one above -- and
                   why the ones on the 52 columns that have a button read as
                   stray.

                   Scoped to the two pages that render the loop, because the
                   border is not a property of a comparison. It comes from the
                   loop template: the rule is
                   `.elementor-20599 .elementor-element.elementor-element-fc2d502
                    { border-width: 1px; border-color: #F3F3F3; padding: 15px }`,
                   and that element appears in the original's markup only on
                   /our-work/ (69) and /tesla-vinyl-wraps/ (12). Checked on
                   /lp/, /lp-truck-wraps/ and three /wraps-before-after/ pages,
                   which all hold comparisons and none of which draws a card. */
                const isCard =
                  LOOP_GRID_PAGES.has(Astro.url.pathname) &&
                  (c.blocks ?? []).some((x) => x.type === 'compare');
                return (
                  <div
                    data-cm={colMarginVars(c).length ? '' : undefined}
                    class:list={['col', { 'col--tinted': tinted, 'col--card': isCard, 'col--show': !!c.slideshow?.images?.length, 'col--mh': !!(c.minHeight || c.minHeightT || c.minHeightM) }]}
                    style={style}
                    data-hide={c.hide?.length ? c.hide.join(' ') : undefined}
                  >
                    {c.slideshow && c.slideshow.images.length > 0 && (
                      /* A flex child's own background slideshow -- the Tesla
                         pages' photograph half -- drawn with the same layers
                         and timer as a section's. */
                      <div
                        class:list={['sec-slides', { 'sec-slides--kb': c.slideshow.kenBurns }]}
                        aria-hidden="true"
                        data-slideshow
                        data-duration={c.slideshow.duration}
                        data-loop={c.slideshow.loop ? 'yes' : 'no'}
                        style={`--slide-fade:${c.slideshow.transitionMs}ms;` +
                          `--slide-hold:${c.slideshow.duration}ms;` +
                          `--slide-zoom-from:${c.slideshow.zoom === 'out' ? 1.15 : 1};` +
                          `--slide-zoom-to:${c.slideshow.zoom === 'out' ? 1 : 1.15}`}
                      >
                        {c.slideshow.images.map((src, i) => (
                          <div class="sec-slide" data-i={i} data-on={i === 0 ? '' : undefined} style={`background-image:url(${img(src)})`} />
                        ))}
                      </div>
                    )}
                    <Astro.self blocks={c.blocks} toc={tocEntries} primaryHeadingEid={primaryHeadingEid} categoriesLevel={categoriesLevel} cardsLevel={cardsLevel} />
                  </div>
                );
              })}
            </div>
          );
        }

        return null;
  });

  /* #ffffff is the page's own background, so declaring it changes nothing;
     skipping it keeps the emitted style attribute to the sections that
     actually sit on a colour. */
  const secStyle = [
    /* Inline where one value holds at every width. A section that changes
       its padding per breakpoint carries all three as properties instead,
       since an inline declaration would hold the desktop one everywhere. */
    section?.padding && !section.paddingT && !section.paddingM ? `padding:${section.padding}` : '',
    /* An Elementor section that declares no padding has none. The 34px in the
       stylesheet is for the port's own sections (archive listings, the
       pager), which carry no Elementor id; given to the 69 before/after pages'
       section and the location pages' unpadded rows it added 68px to each. */
    !section?.padding && !section?.paddingT && !section?.paddingM && !section?.minHeight
      && /^[0-9a-f]{6,8}$/.test(section?.id ?? '') ? 'padding:0' : '',
    section?.padding && (section.paddingT || section.paddingM) ? `--sp:${section.padding}` : '',
    section?.paddingT ? `--sp-t:${section.paddingT}` : '',
    section?.paddingM ? `--sp-m:${section.paddingM}` : '',
    section?.background && section.background.toLowerCase() !== '#ffffff'
      ? (section.background.startsWith('linear-gradient(')
          ? `background-image:${section.background}`
          : `background-color:${section.background}`)
      : '',
    section?.bgImage ? `background-image:url(${img(section.bgImage)})` : '',
    section?.bgImage ? `background-size:${section.bgSize ?? 'cover'}` : '',
    section?.bgImage ? `background-position:${section.bgPosition ?? 'center center'}` : '',
    section?.bgImage ? `background-repeat:${section.bgRepeat ?? 'no-repeat'}` : '',
    section?.border ?? '',
  ].filter(Boolean).join(';');

  return group.bare ? inner : (
    <section
      class:list={[
        'sec',
        { 'sec--pad': !!(section?.paddingT || section?.paddingM) },
        section?.contentAlign ? `sec--${section.contentAlign}` : null,
        { 'sec--overlaid': section?.overlay || section?.slideshow || section?.shapeBottom },
        { 'sec--tall': !!section?.minHeight },
        { 'sec--mhc': !!(section?.minHeight && section?.minHeightInner) },
        section?.minHeight && section?.itemsAlign && section.itemsAlign !== 'middle'
          ? `sec--items-${section.itemsAlign}` : null,
      ]}
      id={section?.anchor ?? undefined}
      data-eid={section?.id ?? undefined}
      style={[
        secStyle,
        /* As custom properties, so the stylesheet can pick the right one per
           breakpoint: inline min-height would hold the desktop value at every
           width. */
        section?.minHeight ? `--mh:${section.minHeight}` : '',
        section?.minHeight && section?.minHeightT ? `--mh-t:${section.minHeightT}` : '',
        section?.minHeight && section?.minHeightM ? `--mh-m:${section.minHeightM}` : '',
      ].filter(Boolean).join(';') || undefined}
    >
      {section?.slideshow && section.slideshow.images.length > 0 && (
        /* One layer per photograph, all stacked, cross-fading on a timer. The
           section already carries its background colour, which is what shows
           through while the first image loads -- and is exactly what the port
           used to show for the whole life of the page. */
        <div
          class:list={['sec-slides', { 'sec-slides--kb': section.slideshow.kenBurns }]}
          aria-hidden="true"
          data-slideshow
          data-duration={section.slideshow.duration}
          data-loop={section.slideshow.loop ? 'yes' : 'no'}
          style={`--slide-fade:${section.slideshow.transitionMs}ms;` +
            `--slide-hold:${section.slideshow.duration}ms;` +
            `--slide-zoom-from:${section.slideshow.zoom === 'out' ? 1.15 : 1};` +
            `--slide-zoom-to:${section.slideshow.zoom === 'out' ? 1 : 1.15}`}
        >
          {section.slideshow.images.map((src, i) => (
            <div
              class="sec-slide"
              data-i={i}
              data-on={i === 0 ? '' : undefined}
              style={`background-image:url(${img(src)})`}
            />
          ))}
        </div>
      )}
      {section?.shapeBottom && (
        /* Elementor's shape divider, as the original draws it: its own SVG
           pinned to the section's foot, centred and stretched to the width its
           rule gives (100% + 1.3px, or 200% for a wider curve), with the height
           the viewBox gives at that width unless the rule sets one. */
        <div
          class="sec-shape"
          aria-hidden="true"
          style={[
            section.shapeBottom.fill ? `--shape-fill:${section.shapeBottom.fill}` : '',
            section.shapeBottom.width ? `--shape-w:${section.shapeBottom.width}` : '',
            section.shapeBottom.height ? `--shape-h:${section.shapeBottom.height}` : '',
          ].filter(Boolean).join(';') || undefined}
          set:html={section.shapeBottom.svg}
        />
      )}
      {section?.overlay && (
        <div
          class="sec-ovl"
          aria-hidden="true"
          style={[
            section.overlay.color ? `background-color:${section.overlay.color}` : '',
            section.overlay.image ? `background-image:${section.overlay.image}` : '',
            section.overlay.opacity ? `opacity:${section.overlay.opacity}` : '',
          ].filter(Boolean).join(';') || undefined}
        />
      )}
      <div
        class:list={['container', 'stack', { 'container--full': section?.fullWidth, 'container--cw': !!(section?.maxWidthT || section?.maxWidthM), 'container--ip': !!(section?.innerPadT || section?.innerPadM), 'container--theme': !!section?.theme }]}
        style={[
          section?.maxWidth && !section.maxWidthT && !section.maxWidthM ? `max-width:${section.maxWidth}` : '',
          section?.maxWidth && (section.maxWidthT || section.maxWidthM) ? `--cw:${section.maxWidth}` : '',
          section?.maxWidthT ? `--cw-t:${section.maxWidthT}` : '',
          section?.maxWidthM ? `--cw-m:${section.maxWidthM}` : '',
          /* Elementor's inner container carries its own padding, which is not
             the port's generic 20px gutter. On the hero rows it is `10px 0`:
             no horizontal inset at all, because the columns inside provide
             it. The generic gutter was taking 40px off the columns' widths. */
          section?.innerPad && !section.innerPadT && !section.innerPadM ? `padding:${section.innerPad}` : '',
          /* Per breakpoint as properties, as the section's own padding is. */
          section?.innerPadT || section?.innerPadM ? `--ip:${section?.innerPad ?? '0px'}` : '',
          section?.innerPadT ? `--ip-t:${section.innerPadT}` : '',
          section?.innerPadM ? `--ip-m:${section.innerPadM}` : '',
        ].filter(Boolean).join(';') || undefined}
      >
        {inner}
      </div>
    </section>
  );
})}

<style>
  .sec { padding: 34px 0; }

  /* Elementor's column wrap -- `.elementor-widget-wrap.elementor-element-populated`
     under `elementor-column-gap-default` -- carries `padding: 10px`, and the
     port had nothing there. It is the same 10px twice over:

       - the posts grid measured 1180 inside a 1200 container on the original
         and 1200 on the port, so every card was 373 against 380;
       - the H1 of a `padding: 50px 0` section starts 60px into it on the
         original and 50 on the port.

     A column that declares its own padding keeps it: the value is written
     inline from the page data and outranks this. */
  .container.stack { padding: 10px; }
  /* Except where the container holds a row of columns -- then the 10px is the
     columns' own, not the container's, and applying it at both levels would
     inset the content twice. */
  .container.stack:has(> .cols) { padding: 0; }
  .cols > .col { padding: var(--col-pad, 10px); }
  .cols > .col--show { position: relative; overflow: hidden; }
  /* An inner section's own height: the row is the flex line, so its columns
     stretch to it and centre their widgets where the row says so. */
  .cols[data-rowmh] { min-height: var(--row-mh, 0); }
  @media (max-width: 1024px) { .cols[data-rowmh] { min-height: var(--row-mh-t, var(--row-mh, 0)); } }
  @media (max-width: 767px) { .cols[data-rowmh] { min-height: var(--row-mh-m, var(--row-mh-t, var(--row-mh, 0))); } }
  /* An inner section's own margin. Two inner sections in a row are flush --
     the 20px widget gap is a widget's, and a section has none -- so a row that
     follows another takes the gap back off its margin. The values are reset
     on every column so a nested row never inherits its parent row's. */
  .cols[data-rowm] { --rmt: var(--row-mt, 0px); --rmb: var(--row-mb, 0px); }
  @media (max-width: 1024px) {
    .cols[data-rowm] { --rmt: var(--row-mt-t, var(--row-mt, 0px)); --rmb: var(--row-mb-t, var(--row-mb, 0px)); }
  }
  @media (max-width: 767px) {
    .cols[data-rowm] {
      --rmt: var(--row-mt-m, var(--row-mt-t, var(--row-mt, 0px)));
      --rmb: var(--row-mb-m, var(--row-mb-t, var(--row-mb, 0px)));
    }
  }
  .cols[data-rowm] { margin-top: var(--rmt); margin-bottom: var(--rmb); }
  .cols + .cols { margin-top: calc(var(--rmt, 0px) - var(--widget-gap, 20px)); }
  .cols > .col {
    --row-mt: initial; --row-mt-t: initial; --row-mt-m: initial;
    --row-mb: initial; --row-mb-t: initial; --row-mb-m: initial;
    --rmt: initial; --rmb: initial;
    --cm-t: initial; --cm-t-t: initial; --cm-t-m: initial;
    --cm-b: initial; --cm-b-t: initial; --cm-b-m: initial;
  }
  /* A column's own vertical margin (Elementor's, on the populated box). */
  .cols > .col[data-cm] { margin-block: var(--cm-t, 0px) var(--cm-b, 0px); }
  @media (max-width: 1024px) {
    .cols > .col[data-cm] { margin-block: var(--cm-t-t, var(--cm-t, 0px)) var(--cm-b-t, var(--cm-b, 0px)); }
  }
  @media (max-width: 767px) {
    .cols > .col[data-cm] {
      margin-block: var(--cm-t-m, var(--cm-t-t, var(--cm-t, 0px))) var(--cm-b-m, var(--cm-b-t, var(--cm-b, 0px)));
    }
  }
  .cols[data-valign="middle"] > .col { justify-content: center; }
  .cols[data-valign="bottom"] > .col { justify-content: flex-end; }
  .cols > .col--mh { min-height: var(--col-mh, 0); }
  @media (max-width: 1024px) {
    .cols > .col--mh { min-height: var(--col-mh-t, var(--col-mh, 0)); }
  }
  @media (max-width: 767px) {
    .cols > .col--mh { min-height: var(--col-mh-m, var(--col-mh-t, var(--col-mh, 0))); }
  }
  @media (max-width: 1024px) {
    .cols > .col { padding: var(--col-pad-t, var(--col-pad, 10px)); }
  }
  @media (max-width: 767px) {
    .cols > .col { padding: var(--col-pad-m, var(--col-pad-t, var(--col-pad, 10px))); }
  }

  /* A section that declares its own min-height is a hero, and Elementor treats
     it as one: the height belongs to the SECTION, and the inner container is
     `display:flex; align-items:center` inside it, so the content sits in the
     middle of the photograph rather than at the top of it.

     The port had the min-height on the inner container instead, with the
     generic 34px above and below it -- so a 630px hero rendered 698px tall
     with its heading pinned to the top edge. Over the flat black panel the
     port used to draw that read as a layout choice; the moment the background
     slideshow went in, the heading landed on the bright sign in the first
     photograph. The original's own padding here is `0 10px`, not 34px. */
  .sec--tall { padding-block: 0; display: flex; min-height: var(--mh); }
  .sec--tall > .container { align-self: center; width: 100%; }
  /* A classic section's min-height is its inner container's, so its own
     padding adds to it: /thank-you/'s 71vh hero is 71vh plus 50px above and
     below on the original, 100px taller than a border-box min-height gives.
     The section sets no width, so content-box changes only the height. */
  .sec--tall.sec--mhc { box-sizing: content-box; }
  /* Column Position / justify-content -- see Section.itemsAlign. */
  .sec--items-top > .container { align-self: flex-start; }
  .sec--items-bottom > .container { align-self: flex-end; }
  /* Elementor's mobile value falls back to its tablet one, and that to the
     desktop one -- the same inheritance as the editor's own responsive fields. */
  @media (max-width: 1024px) {
    .sec--tall { min-height: var(--mh-t, var(--mh)); }
  }
  @media (max-width: 767px) {
    .sec--tall { min-height: var(--mh-m, var(--mh-t, var(--mh))); }
  }
  /* elementor-section-full_width: edge to edge, and no gutter on the inner
     wrapper — the section's own padding is the only inset. */
  .container--full { max-width: none; padding-inline: 0; }
  /* A full-width section holding only edge-to-edge images is Elementor's
     zero-padding column: the homepage banner sits flush under the header, and
     the port's flat 10px `.stack` padding put it 10px down and 10px short of
     the section's bottom (20px over production at every width). Sections with
     any other block keep the stack padding. */
  .container.container--full.stack:not(:has(> :not(.fig--full))) { padding: 0; }

  /* Elementor's background overlay sits between the section's own background
     and its content, so the content has to be lifted above it. */
  .sec--overlaid { position: relative; }
  .sec-ovl { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .sec-shape {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    direction: ltr;
    pointer-events: none;
    z-index: 0;
  }
  .sec-shape :global(svg) {
    display: block;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: var(--shape-w, calc(100% + 1.3px));
    height: var(--shape-h, auto);
  }
  .sec-shape :global(.elementor-shape-fill) { fill: var(--shape-fill, #ffffff); }

  /* The background slideshow. Behind the overlay and the content, both of which
     already sit above z-index 0, so a section can fade photographs under the
     same tint the original paints over them. */
  /* z-index 0, not -1. At -1 the layers paint behind the section's own
     background, and every section with a slideshow also carries a background
     colour -- so the photographs were there, correctly cycling, underneath an
     opaque panel. At 0 they sit above the colour and below both the overlay
     (also 0, and later in the DOM) and the content, which `sec--overlaid`
     lifts to 1. */
  .sec-slides { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .sec-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity var(--slide-fade, 500ms) ease-in-out;
  }
  .sec-slide[data-on] { opacity: 1; }
  /* Ken Burns: the zoom runs for the whole time a slide is shown, fade
     included, which is why the duration is the hold plus one transition. The
     original zooms in by default and out when its zoom_direction says so. */
  .sec-slides--kb .sec-slide[data-on] {
    animation: sec-kb calc(var(--slide-hold, 5000ms) + var(--slide-fade, 500ms)) linear forwards;
  }
  @keyframes sec-kb {
    from { transform: scale(var(--slide-zoom-from, 1)); }
    to { transform: scale(var(--slide-zoom-to, 1.15)); }
  }
  /* Reduced motion keeps the photographs and drops the movement: the first
     slide stays, nothing cycles and nothing zooms. */
  @media (prefers-reduced-motion: reduce) {
    .sec-slide { transition: none; }
    .sec-slides--kb .sec-slide[data-on] { animation: none; }
  }
  .sec--overlaid > .container { position: relative; z-index: 1; }
  .sec:first-child { padding-top: 26px; }
  /* ...but not on a hero. A section that declares its own min-height carries
     no vertical padding on the original -- the rule above outranks
     `.sec--tall` on specificity, so the first hero on a page was being pushed
     26px down inside its own fixed height. */
  .sec--tall:first-child { padding-top: 0; }

  /* Blog pagination.
     Values taken from the original's own inline Elementor CSS for this widget
     (.elementor-18950 .elementor-element-7b1f0d7f .elementor-pagination), not
     estimated: 18px Poppins 400, centred, 30px above, and 5px of margin either
     side of each entry — Elementor writes that as calc(10px/2) on
     :not(:first-child) and :not(:last-child), which is 5px everywhere except
     the two ends. The three colours are the site's own global palette tokens,
     so they follow any later change to them. */
  /* 20px on 30px leading, measured against the original's pager on /blog/.
     18px here left every page number, the ellipsis and both arrows a size
     small across the index and its 33 pagination pages. */
  .elementor-pagination {
    margin-top: 30px;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    line-height: 30px;
    font-weight: 400;
  }
  .elementor-pagination .page-numbers:not(:first-child) { margin-left: 5px; }
  .elementor-pagination .page-numbers:not(:last-child) { margin-right: 5px; }
  .elementor-pagination .page-numbers:not(.dots) {
    color: var(--e-global-color-d077a13);
    text-decoration: none;
  }
  .elementor-pagination a.page-numbers:hover { color: var(--e-global-color-8c22d81); }
  /* f32bb28 (#ff0099) on white measures 3.67:1 for this 20px/400-weight text
     (fails AA's 4.5:1 normal-text threshold -- caught scanning the middle/last
     pagination pages, not page 1, where this class also renders). Reuses the
     already-validated #d6007d pink (badge-contrast-repair-20261003, 5.05:1). */
  .elementor-pagination .page-numbers.current { color: #d6007d; }
  /* On page 1 "« Previous" and on page 34 "Next »" are spans, not links — the
     same thing the original renders. Dimming them says so without moving
     anything, which a display:none would. opacity:0.45 on the navy token
     measured at 2.57:1 on white (fails AA); this explicit muted shade keeps
     the same "disabled" look while clearing 4.5:1 (4.83:1 measured).
     Selector is `span.page-numbers.prev`/`.next` (3 classes + 1 type =
     higher specificity than the `.page-numbers:not(.dots)` rule above,
     which is 3 classes) rather than the plain `span.prev`/`span.next` this
     task started from (2 classes + 1 type) -- the plain form always lost
     that specificity contest to `:not(.dots)` since the disabled spans
     carry both classes, so the rule rendered navy, never muted, despite
     axe reporting 0 violations either way (navy-on-white already clears
     AA). Scoped to `span` only -- the enabled `<a class="page-numbers
     prev">` link intentionally keeps its normal `:not(.dots)` navy/hover
     colors; this must not repaint that active, clickable state. */
  .elementor-pagination span.page-numbers.prev,
  .elementor-pagination span.page-numbers.next { color: #607485; }

  /* "Page" before each number, for screen readers only. Same rule Elementor
     ships; the numbers alone read as a bare list of digits. */
  .elementor-screen-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Elementor rows. Columns carry their own percentage width, so the row is a
     flex line rather than a fixed grid — 50+50, 33+33+33 and 25x4 all fall out
     of the same rule. Without this the columns stacked, which made a section
     that is 440px tall on the live site render at 1642px. */
  /* Columns stretch to the row's height, which is Elementor's default:
     frontend.min.css sets `.elementor-section .elementor-container{display:flex}`
     with no align-items, and a section only opts out by carrying
     elementor-section-items-top / -middle / -bottom. Across every original page
     captured for this port — 23 sections — not one does.

     This said flex-start, so a column was only ever as tall as its content: on
     /car-wrap-faqs/ the navy panel beside the diagram stopped after its two
     lines of heading instead of filling the row. */
  .cols {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    /* A row gap, not just a column gap. It is inert for a row that fits on one
       line, which is most of them, and only shows where columns wrap: the
       69-item grid on /our-work/, and the five-across rows the Tesla pages
       declare at 30% each. Elementor gives those a gap too, so rows touching
       was the port's own doing. */
    /* One property, because the gap is also subtracted from every column's
       width below. Hardcoding 20px in both places meant a row declaring a gap
       of 0 still lost 20px per column: the hero's columns came out 786/326
       inside a 1152px row the original fills with 806/346. */
    gap: var(--cols-gap, 20px);
    width: 100%;
    /* Every per-column value is a custom property set on its own .col, and
       custom properties inherit: a row nested inside a column that goes 100%
       at tablet took that 100% for each of its own columns too, so /contact/'s
       three-across "Why Choose Us" row stacked at 900px where the original
       keeps it side by side. Reset at each row, so a column only ever reads
       what it set itself. */
    --col-w: initial;
    --col-gutter: initial;
    --col-tw: initial;
    --col-tgutter: initial;
    --col-mw: initial;
    --col-mgutter: initial;
    --col-pad: initial;
    --col-pad-t: initial;
    --col-pad-m: initial;
    --col-mh: initial;
    --col-mh-t: initial;
    --col-mh-m: initial;
  }
  /* A column is Elementor's `.elementor-widget-wrap`, which frontend.min.css
     makes display:flex, with each widget carrying margin-block-end:20px. The
     same gap the section stack uses, and for the same reason: a widget's own
     ported margin (its `box`) is merged into one inline style attribute, so a
     margin-based rule here would be overridden outright and the spacing would
     vanish. It had no rule at all, which is why the sidebar's PDF captions sat
     flush against their logos — their box sets margin:-3px, and -3px was the
     whole of the gap. */
  .cols > .col {
    flex: 1 1 calc(var(--col-w, 100%) - var(--col-gutter, var(--cols-gap, 20px)));
    max-width: calc(var(--col-w, 100%) - var(--col-gutter, var(--cols-gap, 20px)));
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--widget-gap);
  }
  /* The first widget in a column takes no gap above it, and must not re-inherit
     the section's own vertical rhythm either. */
  .cols > .col > :global(:first-child) { margin-top: 0; }

  /* Elementor's kit sets `.elementor-heading-title{margin:0}`, so a heading
     WIDGET carries no margin of its own; only headings inside rich text keep
     the reset's 16px (they are not direct children of the stack/column).
     The global `h1..h6{margin:0 0 16px}` was adding 16px under every heading
     widget on top of the 20px widget gap: the homepage's intro and each card
     row were taller than production by that much per heading. Inline `box`
     margins still win. Measured 2026-09 on / at 390/820/1440. */
  .stack > :is(h1, h2, h3, h4, h5, h6),
  .cols > .col > :is(h1, h2, h3, h4, h5, h6) { margin-bottom: 0; }
  /* A heading word wider than its column -- "Equipment/Object" at the archive
     template's 45px is 446px on a 360px phone column -- breaks rather than
     running off the page. The original lets it run and its wrapper clips it;
     nothing narrower than its column is affected. */
  :is(h1, h2, h3, h4, h5, h6) { overflow-wrap: break-word; }

  /* A column holding a before/after slider is a card, which is how the original
     draws the 69 on /our-work/: `border-width: 1px; border-color: #F3F3F3;
     padding: 15px; border-radius: 5px`, with the title and the View Pictures
     button centred inside it.
     Without the card the button had nothing to belong to -- it sat in the gap
     between two rows, reading as a stray control above the next pair rather
     than as part of its own. That is what made 52 buttons look like they were
     on the wrong items, when the count and the placement were right all along. */
  .cols > .col--card {
    border: 1px solid #f3f3f3;
    border-radius: 5px;
    padding: 15px;
  }
  /* The item's own rhythm, measured on the original: the comparison sits 5px
     above the title, the title is 18px on 1.3 with 5px clear either side, and
     the button hangs 15px below it. The port's generic 20px between widgets
     and 16px under a heading put 59px more into every item than the original
     has -- which, over six rows here and 35 on /our-work/, is the whole of
     both pages' height difference. */
  .cols > .col--card { gap: 0; }
  .cols > .col--card > .compare { margin-bottom: 5px; }
  .cols > .col--card :global(h4) {
    margin: 5px 0;
    font-size: 18px;
    line-height: 1.3em;
    font-weight: 400;
  }
  .cols > .col--card > :global(.btnrow) { margin: 15px 0 0; }

  .col--card :global(h1),
  .col--card :global(h2),
  .col--card :global(h3),
  .col--card :global(h4),
  .col--card :global(h5) { text-align: center; }
  /* The button is an inline-block, so centring it is the line box's job. */
  .col--card :global(.btn) { align-self: center; }

  /* Where the widgets sit in a column taller than they are. Elementor puts this
     on the section (elementor-section-content-middle and friends) and, in the
     bc-flex-widget mode this site runs in, it becomes align-items on each
     column's widget wrap. A column here IS that wrap and is a flex column, so
     the vertical axis is the main one and justify-content is what moves them.

     Only a section's own columns, never a nested row's — the original's rule is
     `> .elementor-container > .elementor-column > .elementor-widget-wrap`.

     Without this the FAQ hero's heading sat at the top of its navy panel
     instead of centred in it. It is not a rare setting: 4 of the 6 sections on
     that page use middle, and 2 or 3 on every other page captured. */
  .sec--middle > .container > .cols > .col { justify-content: center; }
  .sec--bottom > .container > .cols > .col { justify-content: flex-end; }

  /* An Elementor loop grid set to equal height: every row as tall as the
     tallest item in the whole grid (`grid-auto-rows: 1fr`), so a tile
     without a "View Pictures" button keeps the height of one with. Laid out
     as the grid it is rather than as wrapping flex columns, whose rows shrink
     to their own content. */
  .cols[data-eqrows] {
    display: grid;
    grid-template-columns: repeat(var(--eq-n, 2), minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--cols-gap, 20px);
  }
  .cols[data-eqrows] > .col { width: auto; max-width: none; flex: none; }
  @media (max-width: 1024px) {
    .cols[data-eqrows] { grid-template-columns: repeat(var(--eq-n-t, var(--eq-n, 2)), minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .cols[data-eqrows] { grid-template-columns: repeat(var(--eq-n-m, 1), minmax(0, 1fr)); }
  }
  /* Elementor collapses rows to full width at its tablet breakpoint. */
  /* Elementor stacks columns at its mobile breakpoint, not its tablet one:
     04-frontend.min.css puts `.elementor-column{width:100%}` inside
     @media(max-width:767px). Collapsing at 1024 here meant every multi-column
     row on the site stacked from 1024px down, where the original still shows
     them side by side — a three-across row of truck photos became one column
     of full-bleed images at 990px. */
  /* Elementor's `elementor-reverse-tablet` / `-mobile` on a section: at that
     breakpoint the row becomes a column and runs last-to-first, so the right
     hand column (the contact form) comes first. The columns take the full row
     width, as Elementor's own rule gives them. Carried as `reverse` on the
     columns block; a row that does not declare it is untouched. */
  @media (max-width: 1024px) {
    .cols[data-reverse~='tablet'] { flex-direction: column-reverse; flex-wrap: nowrap; }
    .cols[data-reverse~='tablet'] > .col { flex: 0 0 auto; width: 100%; max-width: 100%; }
  }
  @media (max-width: 767px) {
    .cols[data-reverse~='tablet']:not([data-reverse~='mobile']) { flex-direction: column; }
    /* The mobile-only case had no rule at all, so `reverse: ['mobile']` --
       Elementor's elementor-reverse-mobile, on 1,055 rows -- did nothing:
       the service rows on /commercial-vehicle-wraps/ and
       /personal-vehicle-wraps/ put the gallery above its "Lettering & Decals"
       label where the original puts the label first, and the archive pages
       put the cards above the Categories sidebar the original leads with. */
    .cols[data-reverse~='mobile'] { flex-direction: column-reverse; flex-wrap: nowrap; }
    .cols[data-reverse~='mobile'] > .col { flex: 0 0 auto; width: 100%; max-width: 100%; }
  }
  /* A row whose columns fit on one line only wraps because they stack, and a
     classic Elementor section stacks them flush -- its columns are padded, not
     spaced. The 20px row gap put 40px between stacked copy where the original
     has 20: every two-column row on a phone came out 20px taller. */
  .cols[data-stack] { row-gap: 0; }
  /* A tablet width, where the column sets one; otherwise the desktop share
     holds, as it does in Elementor. */
  @media (max-width: 1024px) {
    .cols > .col {
      flex-basis: calc(var(--col-tw, var(--col-w, 100%)) - var(--col-tgutter, var(--col-gutter, var(--cols-gap, 20px))));
      max-width: calc(var(--col-tw, var(--col-w, 100%)) - var(--col-tgutter, var(--col-gutter, var(--cols-gap, 20px))));
    }
  }
  /* Elementor stacks columns at 767px (`.elementor-column{width:100%}`) unless
     a column sets its own mobile width, and a flex container's children keep
     theirs (--width) -- either way the line wraps at the column's own share. */
  @media (max-width: 767px) {
    .cols > .col {
      flex-basis: calc(var(--col-mw, 100%) - var(--col-mgutter, 0px));
      max-width: calc(var(--col-mw, 100%) - var(--col-mgutter, 0px));
    }
  }

  /* Ported post bodies are a different type scale from the page chrome: 17px
     on 25.5px, not the 16/24 the body inherits. Headings inside them are
     smaller than the standalone heading blocks and navy rather than body ink —
     and the h3 weight is 700, which is what makes <strong> inside one resolve
     to 900 as it does on the live site. */
  /* Rich text is a second, separate type scale from the heading widgets in
     global.css, and mixing the two was wrong in both directions. Probed by
     injecting this markup into a mirrored page inside
     .elementor-widget-text-editor: the leading here is 1.2x the size (not the
     kit's 1.0), h2-h4 are weight 600 (not 500), and h3/h4 are navy while
     h1/h2 stay body ink. A text widget that declares its own size still wins —
     the extractor carries that inline. */
  /* overflow-wrap: a bare profile URL in a post body ("https://www.instagram.com/
     vinylwraptoronto/") is one 415px word; on a phone the original lets it run
     past the edge and its wrapper clips it. Breaking it keeps it readable and
     the page from scrolling sideways; ordinary words never reach the edge, so
     nothing else moves. */
  .rt {
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: break-word;
  }
  /* A comparison table in a post body is wider than a phone: the original's is
     511px at 390 and runs off the edge, hidden only because its page wrapper
     clips. Here it scrolls inside its own box instead, so every column stays
     reachable and the page itself never scrolls sideways. */
  .rt :global(figure:has(> table)) { overflow-x: auto; }
  @media (max-width: 767px) {
    .rt :global(:not(figure) > table) {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }
  }
  .rt :global(h1) {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--ink);
    text-transform: none;
  }
  .rt :global(h2),
  .rt :global(.rt-lvl2) {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink);
    text-transform: capitalize;
  }
  .rt :global(h3),
  .rt :global(.rt-lvl3) {
    font-size: 22px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--brand-navy);
    text-transform: capitalize;
  }
  /* h4 had no rule at all, so it fell through to the heading-widget default and
     took every <strong> inside it down with it: `bolder` resolves against the
     parent, so a 500 parent yielded 700 where the original yields 900. */
  .rt :global(h4),
  .rt :global(.rt-lvl4) {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--brand-navy);
    text-transform: none;
  }
  .rt :global(h5),
  .rt :global(.rt-lvl5) {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    color: #444444;
    text-transform: none;
  }
  .rt :global(h6),
  .rt :global(.rt-lvl6) {
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--ink);
    text-transform: none;
  }

  /* Structured `heading`-type widgets (not rich text, so not under `.rt`) get
     the same skip-prevention clamp as embedded rich-text headings (see
     `collectHeadings`/`tocHeadingRenderLevel` above): the rendered tag is
     only ever lowered, never raised, to avoid a level skip. `global.css`'s
     bare h1-h6 rules already give the right margin/line-height/weight/color
     for whichever tag actually renders -- only font-size and text-transform
     are keyed to the tag number there, and those must keep tracking the
     ORIGINAL authored level, not the lowered one. A class selector always
     beats the bare element selector it's paired with, regardless of source
     order, so this needs no `!important` and no reordering of global.css. */
  :global(.hlvl2) { font-size: 28px; text-transform: capitalize; }
  :global(.hlvl3) { font-size: 22px; text-transform: capitalize; }
  :global(.hlvl4),
  :global(.hlvl5),
  :global(.hlvl6) { font-size: 18px; text-transform: none; }

  /* The theme's own spacing, measured on the original's post bodies at 1440
     and 390: a paragraph keeps 0.9rem (14.4px) under it, and a list sits
     flush with no margin of its own and the browser's 40px indent. The port's
     16px and 22px made every paragraph 1.6px further from the next and let
     each list line run 18px longer, so list items wrapped a line short of the
     original's on a phone. */
  .rt :global(p) { margin: 0 0 0.9rem; }
  /* The last paragraph keeps its 0.9rem: an Elementor widget is a flex item,
     so a margin inside it cannot collapse out, and a text widget ending in a
     paragraph is 14.4px taller than its text. */
  .rt :global(ul),
  .rt :global(ol) { margin: 0; padding-inline-start: 40px; }
  /* The original puts no margin on a list item — checked on its rich-text
     lists across several pages and on the sitemap's 400-item list, all
     margin-top and margin-bottom 0. The 6px invented here added six pixels per
     item, which on /sitemap/ alone was 2,394px. */
  .rt :global(li) { margin-bottom: 0; }
  /* A WordPress gallery block inside post copy.
     The original nests its images in a figure.wp-block-gallery and lays them
     out with flex — measured on the original at 1440, the container is
     flex/wrap with a 24px gap and each child 270px, three across, with a
     trailing short row growing to fill. The sanitiser strips the classes but
     keeps the nesting, so the gallery survives as a bare <figure> holding the
     image figures, and every one of them stacked full width: eight images on
     /custom-helmet-wraps-toronto-savio/ came to a single 4,972px column.
     A figure that directly holds other figures is that gallery — no other
     construct in this copy nests figures — so it needs no class of its own and
     no change to the stored content. */
  .rt :global(figure:has(> figure)) {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0 0 16px;
  }
  .rt :global(figure:has(> figure) > figure) {
    /* A third of the row, growing to fill a short last row, which is what puts
       two on the final line at 417px where three sit at 270px above it. */
    flex: 1 1 calc(33.333% - 16px);
    min-width: 0;
    margin: 0;
  }
  .rt :global(figure:has(> figure) > figure img) { width: 100%; height: auto; display: block; }
  @media (max-width: 767px) {
    .rt :global(figure:has(> figure) > figure) { flex-basis: calc(50% - 12px); }
  }

  /* Gutenberg's columns block (div.wp-block-columns), which three posts use to
     put a pair of images side by side. The extractor kept the figures and
     dropped the wrapper, so they stacked at full width — 566px each where the
     original's pair is 278px. The wrapper is restored in the stored content as
     .wpcols; the geometry here is read off the original: flex, 24px gap, and
     each column flex: 1 1 0, which divides its 857px into two at 416.7px.

     A column can hold more than its image — one of the three has a
     "Before & After" line above it — so the child is a column, not a figure. */
  .rt :global(.wpcols) { display: flex; gap: 24px; margin: 0 0 16px; }
  .rt :global(.wpcols > .wpcol) { flex: 1 1 0; min-width: 0; }
  .rt :global(.wpcols > .wpcol > figure) { margin: 0; }
  .rt :global(.wpcols > .wpcol > figure img) { width: 100%; }
  /* WordPress stacks a columns block below 782px. */
  @media (max-width: 781px) {
    .rt :global(.wpcols) { flex-wrap: wrap; }
    .rt :global(.wpcols > .wpcol) { flex-basis: 100%; }
  }

  /* Gutenberg in-body images (figure.wp-block-image) inside post content. */
  .rt :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  /* Measured on the original's in-body figures across several posts: margin-top
     0, margin-bottom 18px. The 20px on both sides invented here added 22px to
     every figure on the page — 286px on a post carrying thirteen of them. */
  .rt :global(figure) { margin: 0 0 18px; }

  /* Gutenberg comparison tables (figure.wp-block-table). The extractor used to
     unwrap these into a run of loose words; they carry real content. */
  .rt :global(figure.wp-block-table) { overflow-x: auto; }
  /* 16px on 24px leading, measured against the original on the 114 pages that
     carry a table — one combination, no exceptions. 15px on 1.45 was invented
     and came out 15/22. */
  /* The theme's table, measured in the original's post bodies at 1440 and
     390: 0.9em of the copy (16.2px in an 18px post body), 15px under it, and
     each cell on 1.5 leading with 0.5em of padding -- 24.3 and 8.1 there. The
     16/24 and 9px 12px here held only where the copy is 16px. */
  /* `table-layout: fixed` is the original's: every column the same width
     (123/123/123 on a phone), where auto layout sized them to their words and
     let the long column run wide -- each row a line shorter than the
     original's, 75px over one table. */
  .rt :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.9em;
    margin-bottom: 15px;
  }
  .rt :global(th),
  .rt :global(td) {
    border: 1px solid #e2e2e2;
    padding: 0.5em;
    line-height: 1.5;
    text-align: start;
    vertical-align: top;
  }
  /* The header row is bold and centred there, not semibold and left: 90 pages
     agree and the one that differs is already at 700. */
  .rt :global(thead th) {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    text-align: center;
  }
  /* The theme tints the odd body rows, not the even ones, and leaves the
     header row on the page's own white. */
  .rt :global(tbody > tr:nth-child(odd) > td) { background: rgba(128, 128, 128, 0.07); }
  .rt :global(caption) {
    caption-side: bottom;
    margin-top: 6px;
    font-size: 13px;
    color: #767676;
  }
  /* The reviewer's name under a testimonial on the two landing pages. The
     extractor flattened Elementor's testimonial widget into rich text, so the
     name is a bare span with nothing to select it by; the class is added to
     the stored content instead. 14px on 21 at weight 500 in the brand navy,
     centred — identical across both pages and all ten reviews, where ours
     inherited the body's 16px/24 at 400. */
  .rt :global(.tm-name) {
    display: block;
    font-size: 14px;
    line-height: 21px;
    font-weight: 500;
    color: var(--brand-navy);
    text-align: center;
  }

  /* A standalone body figure's caption: 16px on 22px leading in #333, measured
     against the original on the 50 pages that carry one. The 13px/#767676 here
     was invented. */
  .rt :global(figcaption) {
    margin-top: 6px;
    font-size: 16px;
    line-height: 22px;
    font-weight: 400;
    color: #333333;
    text-align: center;
  }

  /* A caption inside a gallery is a different thing entirely, and sharing one
     selector with the above is why both were wrong. The original lays it over
     the bottom of its own image — absolutely positioned, white, 13px on 18.2,
     no scrim — rather than placing it in the flow underneath. 11 pages. */
  .rt :global(figure:has(> figure) > figure) { position: relative; }
  .rt :global(figure:has(> figure) > figure > figcaption) {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    padding: 8px 10px;
    font-size: 13px;
    line-height: 18.2px;
    font-weight: 400;
    color: #ffffff;
  }
  /* Measured pink and unlined on the live site, not green. Corrected here
     rather than by adding a second rule: the two had equal specificity and the
     later one simply won. */
  /* The original's links reset the weight; the surrounding copy is 300, so
     without this every in-content link came out a stop light. */
  .rt :global(a) { color: var(--brand-pink); text-decoration: none; font-weight: 400; }
  .rt :global(a:hover) { text-decoration: underline; }
  .rt :global(a:hover) { color: var(--brand-pink); }
  /* The theme's 0.5rem above a heading in copy, measured on every heading of
     the original's post bodies at 1440 and 390; the 24px here added 16px over
     each one -- 300px down a long post. */
  .rt :global(h2),
  .rt :global(h3),
  .rt :global(h4),
  .rt :global(.rt-lvl2),
  .rt :global(.rt-lvl3),
  .rt :global(.rt-lvl4) { margin-top: 0.5rem; }

  /* A link inside a heading is weight 400 on the original — 64 heading-sized
     anchors across the site, no exceptions. Ours inherited whatever the
     heading default gave it, so the same link came out 400 on some pages, 500
     on others and 600 on one. `font-weight` rather than `inherit` for exactly
     that reason. */
  .hlink { color: inherit; font-weight: 400; text-decoration: none; }
  .hlink:hover { color: var(--brand-pink); }

  /* No colour overrides here. A contrast pass once forced its own palette on
     top of the original's -- every feature title #08735a, content links
     #b8006e, text on navy panels white and on green panels #111, button labels
     on green #111 -- and every one of them is a colour the original does not
     use: it put dark green where the original has navy on the feature cards of
     30-odd service and location pages, and dark labels on its pink buttons.
     Each widget carries the original's own colour from its own rule. */

  /* The offer price — the animated-headline widget. The old price struck
     through in the brand pink, the price you pay larger underneath. Elementor
     draws the strike as a hand-drawn SVG marker path; a straight line-through
     in the same colour reads identically at this size and costs no markup.

     The widget carries none of this in the block's own `style` — it is null on
     every one of the 403 records — so all of it lives here, read off the
     original's per-page CSS and confirmed against the computed values in a
     browser on both a post (a36b238) and /tesla-vinyl-wraps/ (19b01ef):

       headline   centred, Poppins 600, 22px / 1.2, and 28px on 19b01ef
       old price  weight 200, #f3f3f3, at the headline's size
       new price  weight 600, #f7f7f7, 35px / 1.3em, and 45px on 19b01ef

     Without the colours the new price inherited the page's body text — black
     on the navy offer panel — and without the alignment both lines sat left
     against a centred original. */
  .price {
    text-align: center;
    font-family: "Poppins", Sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
  }
  .ah-was {
    font-weight: 200;
    color: #f3f3f3;
    text-decoration: line-through;
    text-decoration-color: var(--brand-pink, #ff0099);
    text-decoration-thickness: 2px;
  }
  .ah-now { font-size: 35px; line-height: 1.3em; color: #f7f7f7; }

  /* /tesla-vinyl-wraps/ is the one page that sizes the widget itself. */
  .price[data-eid="19b01ef"] { font-size: 28px; }
  .price[data-eid="19b01ef"] .ah-now { font-size: 45px; }

  /* The posts' H1 (cc1fcc1, all 402 of them) is white over the featured
     image and carries the original's `text-shadow: 0px 0px 6px #000000` to
     stay legible on it. The extractor dropped every text-shadow on the site;
     pages get theirs back as data (scripts/pull-text-shadows.py), but posts
     render from D1, so the post template's lives here. */
  h1[data-eid="cc1fcc1"] { text-shadow: 0px 0px 6px #000000; }
  /* The post-info byline (7e4e00b): pink 14px icons, text in the body ink,
     centred on a phone. */
  .ilist[data-eid='7e4e00b'] .li-ic { color: var(--e-global-color-f32bb28); font-size: 14px; width: 14px; }
  .ilist[data-eid='7e4e00b'] a { color: var(--e-global-color-text); }
  @media (max-width: 767px) {
    .ilist[data-eid='7e4e00b'] > li { justify-content: center; }
  }
  /* The byline and the sidebar's phone line (3751bb8) are icon lists with no
     item spacing: 24px a line, and the theme's 24px under the list, which
     Elementor keeps inside the widget. Ours spaced each item 5px apart and
     dropped the 24. Drawn as a block after the list, since the phone line's
     widget box writes margin:0 on the list itself. */
  .ilist:is([data-eid='7e4e00b'], [data-eid='3751bb8'])::after { content: ''; display: block; height: 24px; }
  .ilist:is([data-eid='7e4e00b'], [data-eid='3751bb8']) > li { padding-block-end: 0; }
  /* A heading widget's title has no margin whatever tag it uses: "Share This
     Post" is a <p>, and took the paragraph's 16px below it. */
  .cols > .col > p.hd { margin-bottom: 0; }

  .fig { margin: 0; }
  .fig img { display: block; border-radius: 4px; }
  /* The image widget's Width control. A breakpoint that sets none inherits the
     next larger one, as Elementor's cascade does; a widget with no desktop value keeps
     natural size. */
  .fig--iw img { width: var(--iw, auto); max-width: 100%; height: auto; margin-inline: auto; /* Elementor image widgets centre their image */ }
  /* A linked image's <a> is inline-block in Elementor, so it shrinks to the
     image's own width and the Width percentage is of that: the 300px logos on
     /car-wrap-colours-avery-dennison-3m/ stay 300 in a 370px column. The cap
     restates that without the inline-block, whose percentage-of-itself width
     is 0x0 until a lazy image loads. */
  .fig--iw > a { display: block; max-width: var(--iw-cap, none); margin-inline: auto; }
  @media (max-width: 1024px) { .fig--iw img { width: var(--iw-t, var(--iw, auto)); } }
  @media (max-width: 767px) { .fig--iw img { width: var(--iw-m, var(--iw-t, var(--iw, auto))); } }

  /* Zero-padding column on the live site: the image runs edge to edge, so it
     breaks out of the centred content container. */
  .fig--full {
    width: 100vw;
    max-width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .fig--full img { border-radius: 0; width: 100%; }
  /* A guard, so a viewport-wide breakout can never escape a column even if the
     flag is ever wrong again. */
  .col .fig--full,
  /* Nor a full-width section, which is edge to edge already -- the homepage
     banner's. There the breakout only added `100vw`, and 100vw counts a
     classic scrollbar the page itself does not have: with one (desktop
     Windows, Firefox, any browser set to always show them) the banner was
     390px inside a 375px page at a 390px window, and the document scrolled
     sideways by 8px. 100% of this container is the full width without it. */
  .container--full > .fig--full {
    width: auto;
    max-width: 100%;
    margin-left: 0;
    transform: none;
  }

  .btnrow {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: inherit;
    /* No margin of its own: an Elementor button widget has none, and one that
       sits apart from the widget above says so in its own box. */
    margin: 0;
  }
  .btnrow[style*='center'] { justify-content: center; }
  .btnrow[style*='right'] { justify-content: flex-end; }

  /* Two or more buttons on a row take an equal share of it each, centred in
     their own share -- not a huddle in the middle of the row.

     The run above is grouped onto one row because on the original these are
     separate button widgets sitting as equal-width siblings: the homepage hero
     gives each of its two a 690px half of a 1400px row and centres the button
     in it, putting them ~450px apart. Centring the pair with a 14px gap drew
     them touching, at the right vertical position and visibly wrong.
     space-around reproduces the halves: with two items their centres land at
     25% and 75% of the row, which is where the original's are. */
  .btnrow:has(.btn ~ .btn) { justify-content: space-around; gap: 0; }

  /* Button styling follows the header CTA: navy, green on hover, square. */
  /* Not `font: inherit`. That shorthand also sets line-height, to the body's
     1.5, and at 0,2,1 it out-specifies `.btn { line-height: 1 }` — so every
     popup trigger rendered 14px text on 21px leading where the original gives
     14 on 14, on 402 pages. The family and size the button needs are already
     set by .btn, and an author rule beats the user agent's button font
     without any help. */
  .btnrow button.btn { border: 0; cursor: pointer; }
  .btn {
    display: inline-block;
    background-color: var(--btn-bg, var(--e-global-color-d077a13));
    color: var(--e-global-color-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    /* .elementor-button{line-height:1}: the leading tracks the size, and
       these blocks carry their own font-size inline. */
    font-size: 15px;
    line-height: 1;
    /* Elementor's default, unless the widget sets its own (`pad`). */
    padding: var(--btn-pad, 12px 24px);
    /* Elementor's own default, which the port had as 0 -- so every button on
       the site drew square corners where the original rounds them. The widgets
       that set their own (5px on the loop grid's View Pictures, 25px on the
       pills) arrive as `radius`. */
    border-radius: var(--btn-radius, 3px);
    text-decoration: none;
    /* Buttons ease over 0.3s on the original, where the nav takes 0.4s. The
       port had every hover on the site snapping instantly. */
    transition: all 0.3s ease;
  }
  /* Each button's own hover, carried inline from the original's per-element
     rules. The fallbacks are the commonest case, so a button whose colours
     were never harvested still behaves sensibly.

     This replaced a single hard-coded hover for the whole site. #99CC33 first,
     which is the sticky bar's colour rather than a page button's, then
     #14A278, which is right for the 496 buttons that go green and wrong for
     the 49 that do not. Neither could have been right: Elementor stores the
     colour per button and the site uses thirteen different pairings. */
  @media (max-width: 1024px) {
    .btn { padding: var(--btn-pad-t, var(--btn-pad, 12px 24px)); }
  }
  @media (max-width: 767px) {
    .btn { padding: var(--btn-pad-m, var(--btn-pad-t, var(--btn-pad, 12px 24px))); }
  }
  /* The posts' "Get a Quote" button (e4d3235, all 402) sets 8px 15px; posts
     render from D1, so the template's value lives here. */
  .btnrow[data-eid="e4d3235"] .btn { --btn-pad: 8px 15px; }
  .btn:hover {
    background-color: var(--btn-hover-bg, var(--e-global-color-8c22d81));
    color: var(--btn-hover-color, var(--e-global-color-accent));
    border-color: var(--btn-hover-border, transparent);
  }

  .ilist { list-style: none; margin: 0; padding: 0; }
  /* An icon list's items are spaced only where the widget sets Space Between,
     as half of it below each item but the last and half above each item but
     the first (scripts/pull-list-space.py); Elementor's default is none. The
     port spaced every list 5px apart, which was no list's value: the blog
     byline's two lines are 24px apart on the original, and /contact/'s
     workflow lists 13px on a phone. */
  .ilist > li {
    position: relative;
    padding-inline-start: 22px;
    padding-block-end: 0;
  }
  .ilist[data-sp] { --lsp-at: var(--lsp, 0px); }
  @media (max-width: 1024px) { .ilist[data-sp] { --lsp-at: var(--lsp-t, var(--lsp, 0px)); } }
  @media (max-width: 767px) { .ilist[data-sp] { --lsp-at: var(--lsp-m, var(--lsp-t, var(--lsp, 0px))); } }
  .ilist[data-sp] > li:not(:last-child) { padding-block-end: calc(var(--lsp-at) / 2); }
  .ilist[data-sp] > li:not(:first-child) { margin-block-start: calc(var(--lsp-at) / 2); }
  /* The widget's Divider: a rule along the foot of every item but the last,
     inside its half of the Space Between -- /contact/'s phone, email and
     address rows. */
  .ilist[data-div] > li:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    border-block-start: var(--ldiv);
  }
  /* A hand-made dot stood in for the icon the original actually draws. Now
     that the real one is rendered, the dot is only for items without one. */
  .ilist > li.has-ic::before { content: none; }
  .ilist > li.has-ic { padding-inline-start: 0; }
  .li-ic {
    display: inline-block;
    width: 22px;
    margin-inline-end: 6px;
    text-align: center;
    color: var(--brand-green);
  }
  .btn-ic { margin-inline-end: 8px; }
  /* `.elementor-button-content-wrapper { flex-direction: row-reverse }` on the
     original. Scoped to the variant rather than applied to .btn, which is
     inline-block everywhere else and would reflow every other button. */
  .btn--icon-right {
    display: inline-flex;
    flex-direction: row-reverse;
    align-items: center;
  }
  .btn--icon-right .btn-ic { margin-inline-end: 0; margin-inline-start: 8px; }
  .feature-ic {
    display: block;
    /* Elementor's icon-box puts 15px between the icon and the content, not 10:
       measured on 10 of the 12 icon-boxes across five pages, the other two
       being boxes with no icon at all. */
    margin-bottom: 15px;
    /* Elementor's icon is 50px on a 1 line height unless the widget sets a
       size (icon-size.json); the port drew every one 28px on a 42px line. */
    font-size: var(--ic, 50px);
    line-height: 1;
    color: var(--ic-c, var(--brand-green));
    text-decoration: none;
  }
  @media (max-width: 1024px) { .feature-ic { font-size: var(--ic-t, var(--ic, 50px)); } }
  @media (max-width: 767px) { .feature-ic { font-size: var(--ic-m, var(--ic-t, var(--ic, 50px))); } }
  .ilist > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
  }
  .ilist a { color: inherit; text-decoration: none; }
  .ilist a:hover { color: var(--brand-pink); }

  /* Elementor icon-box. Measured on the live render: the title is 17px/20.4px
     weight 600 in brand green, the text 14px/21px in body ink, and the whole
     box is centred — not the page's default left-aligned h3 + p. */
  /* The original's icon-box draws no panel at all. Checked on every box of
     five pages -- /lp-truck-wraps/, /box-truck-wrap/, /car-wraps/, / and
     /full-car-wrap-toronto/ -- and all of them are `padding: 0`, transparent,
     radius 0. The port gave all 3,292 of them a grey #f8f8f8 card with 16px
     of padding and a 4px radius, which is 32px of height each and chrome the
     site does not have.

     `text-align` is deliberately left alone. The original varies it per
     widget -- /lp-truck-wraps/ is five `start` and five `center`, the other
     four pages all `start` -- and our page data records it for none of the
     3,292, so switching the default would be a blanket change on a guess.
     Recorded in _research/structure.md for a per-element harvest instead. */
  /* Alignment comes from the widget, where it has been measured, and falls
     back to what the port has always drawn.

     It is NOT safe to infer. Elementor writes a rule per icon box, but most
     declare only a gap and INHERIT their alignment from an ancestor, so
     reading the declarations and calling the rest "the default" gets it
     backwards: that reasoning produced `start` for 3,286 boxes, and measuring
     the computed value in a browser across all 1,074 pages that carry one
     gives 3,245 CENTRE against four `start`. The port's own default was right
     all along; only four boxes on the site differ, and only those four are
     written into the page data. */
  .feature { text-align: var(--feat-align, center); }
  /* The gap between an icon and its title, measured the same way and with the
     same result: the site sets 15px on 3,212 of its 3,249 measurable boxes,
     31 at 5px, four at 10px and two at 0. The port had no gap at all. The
     defaults here are what the measurement found; the page data carries only
     the boxes that differ. */
  .feature-ic { display: block; margin-bottom: var(--feat-gap, 15px); }
  /* Elementor's icon-box wrapper is a flex column, so the icon's 15px and the
     title's own 8px top margin add up rather than collapsing into each other
     as they did in block flow -- every icon box on the site came out 8px
     short. And the glyph sits on the top of its line box rather than its
     baseline, which left 2px of strut under every icon: a 50px icon drew a
     52px box. Together that is the 6px each box measured short against the
     original (191 to its 197 on /commercial-vehicle-wraps/). Image boxes lay
     themselves out below and are left alone. */
  .feature:not(.feature--fi) { display: flex; flex-direction: column; }
  .feature-ic :global(i) { vertical-align: top; }
  /* elementor-position-inline-start: the icon in its own column, the title
     and text beside it, the icon's top on the title's line box -- the
     wrapper's `align-items: start`. Elementor turns it back into the stacked,
     centred layout at its mobile breakpoint (elementor-mobile-position-
     block-start), so this only applies from 768px. */
  @media (min-width: 768px) {
    .feature.feature--ic-left {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--feat-gap, 15px);
      text-align: start;
    }
    /* The icon's own 1em square, as Elementor's .elementor-icon is; a wide
       glyph (the cogs) overhangs it rather than pushing the copy over. */
    .feature--ic-left > .feature-ic { flex: none; margin-bottom: 0; width: 1em; height: 1em; }
    .feature--ic-left > .feature-body { flex: 1 1 auto; min-width: 0; }
  }
  @media (max-width: 767px) {
    .feature.feature--ic-left { text-align: center; }
  }
  /* .elementor-icon-box-title / -description. The leading is 1.2 of whatever
     size the widget declares — frozen at 20.4px it was right only for the
     17px default and 6px too tall on the 12px variants. */
  /* Only what the widget itself does not decide. The 17px in brand green that
     used to be here was one page's declared value: pages whose boxes declare
     nothing render at the kit's h3 — 22px in black — and got 17px green
     instead. Size and colour now come from the kit or from the widget. */
  /* The title's own margins are the same on every icon-box on the site — 8px
     above, 16px below, on h3 and h4 alike, measured across five pages. The
     8/0 here was 16px short on each of the 1,178 boxes. */
  .feature h3,
  .feature h4 {
    margin-top: 8px;
    margin-bottom: var(--feat-tgap, 16px);
    line-height: 1.2;
    font-weight: 600;
  }
  /* A box title at any other level keeps the same 1.2 leading -- the theme's,
     not the heading widget's 1. /racing-stripes/ titles its image-boxes h2,
     and they rendered 28px on 28 where the original gives 33.6. */
  .feature :is(h1, h2, h5, h6) { line-height: 1.2; }
  /* The theme archive pager (Hello Elementor's reset.css / theme.css). */
  /* 20px under the last entry, as on the original -- where the entry's 16px
     paragraph margin collapses into the pager's 20px. In this flex column
     nothing collapses and the column's own 20px gap is added, so the pager
     takes the paragraph's 16px back. */
  nav.pagination { display: flex; justify-content: space-between; width: 100%; margin: -16px auto 20px; }
  nav.pagination .nav-next { text-align: end; }
  /* The warranty box's footnote asterisk ("3 Year Warranty<sup>*</sup>") is
     raised without opening the line: the original's title is one 19.2px line
     on a phone, and the sup's own leading made it 23. */
  .feature :is(h1, h2, h3, h4, h5, h6) :global(sup) { line-height: 0; }
  .feature p {
    margin: 0;
    /* the body's own type — 14px/21px here was invented */
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
  }
  .feature img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 320px;
    border-radius: 4px;
    margin-bottom: 12px;
  }
  /* An image-box with its own layout, as widget-image-box.min.css draws it:
     the picture's box at the widget's width, centred over the copy and
     `--fi-gap` above it, or -- from 768px up -- beside the copy, which takes
     the rest (`width:100%` on the content, shrunk by flex). Below 768px a
     side box stacks, centred, 15px over its text. */
  .feature--fi .feature-img {
    display: inline-block;
    width: var(--fi-w, 100%);
    margin: 0 auto var(--fi-gap, 15px);
    line-height: 0;
  }
  .feature--fi .feature-img img { width: 100%; max-width: 100%; height: auto; margin: 0; border-radius: 0; }
  /* A linked image-box: the title keeps its own colour and the picture its
     box, as Elementor draws them -- the link changes neither. */
  .feature-link { color: inherit; text-decoration: none; }
  .feature-img > .feature-link { display: block; line-height: 0; }
  @media (max-width: 1024px) {
    .feature--fi .feature-img { width: var(--fi-w-t, var(--fi-w, 100%)); }
  }
  @media (min-width: 768px) {
    .feature--left, .feature--right { display: flex; }
    .feature--left { flex-direction: row; text-align: start; }
    .feature--right { flex-direction: row-reverse; text-align: end; }
    .feature--left .feature-img { margin: 0 var(--fi-gap, 15px) 0 0; }
    .feature--right .feature-img { margin: 0 0 0 var(--fi-gap, 15px); }
    .feature-body { width: 100%; }
    .feature--va-top { align-items: flex-start; }
    .feature--va-middle { align-items: center; }
    .feature--va-bottom { align-items: flex-end; }
  }
  @media (max-width: 767px) {
    .feature--fi .feature-img { width: var(--fi-w-m, var(--fi-w-t, var(--fi-w, 100%))); margin-inline: auto; }
    .feature--left .feature-img, .feature--right .feature-img { margin-bottom: 15px; }
  }

  /* hello-elementor's archive template. Every value here was measured on the
     original at 1440 rather than guessed, because this layout shares nothing
     with the Elementor card grid below it: entries are stacked blocks with no
     card, no border and no gutter between them. */
  .arch { display: block; max-width: 1140px; margin-inline: auto; }
  .arch-post { display: block; }
  .arch-post h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: capitalize;
    color: #333;
    margin: 8px 0 16px;
  }
  /* The theme paints the title link pink and drops it back to regular weight,
     so the h2's own 600 never applies to the text a reader actually sees. */
  .arch-post h2 a { color: var(--brand-pink, #ff0099); font-weight: 400; text-decoration: none; }
  .arch-post h2 a:hover { text-decoration: underline; }
  /* The image runs the full content width at its own ratio — height:auto, not
     a fixed aspect box, or a portrait story image is cropped to a letterbox. */
  .arch-thumb { display: block; }
  .arch-thumb img { display: block; width: 100%; height: auto; }
  /* Plugin-converted entries keep the intrinsic size the original served. */
  /* At the width the original's markup gives it -- `width:auto` would put
     back the file's own, and the 1000px Ford Transit cover on
     /pages_type/vehicle-wraps/ is drawn 800 wide there. */
  .arch-thumb--natural img { width: var(--nw, auto); height: auto; max-width: 100%; }

  /* The story player's resting frame. */
  .arch-story { display: block; max-width: 100%; overflow: hidden; }
  .arch-story img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* The theme's archive text is NOT the site's body font — it falls back to the
     system stack, which is narrower. Inheriting the body font instead wrapped a
     56-word excerpt onto a third line and added 24px to every entry. */
  .arch-post h1,
  .arch-excerpt {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
  }
  .arch-excerpt {
    font-size: 16px;
    line-height: 1.5;
    color: #333;
    margin: 0 0 14.4px;
  }

  /* Elementor's divider as this widget declares it: a 1px rule in the kit's
     green, full width, with 15px of padding above and below — the 31px the
     original measures between the post body and the post navigation. */
  .wdivider {
    border: 0;
    border-top: 1px solid var(--e-global-color-a8178e9);
    margin: 15px 0;
    width: 100%;
  }

  /* Elementor's countdown, as this widget configures it: items padded
     10px/5px on the kit's teal, 3px radius, 2.5px of gutter each side, the
     digits Poppins 20px over a 10px label. That comes to the 50px the original
     measures. */
  /* The site has two countdowns and they are styled nothing alike. Measured on
     the original:

       402 post pages    item 61x50   pad 10px 5px  teal #14A278  20px / 10px
       /tesla-vinyl-wraps/ item 285x125 pad 25px    green #99CC33 55px / 18px

     The defaults below are the post pages' -- the instance the port was built
     from -- and the other carries its own values as data. */
  .cdown { display: flex; max-width: 100%; }
  .cdown-item {
    flex: 1 1 0;
    min-width: 0;
    padding: var(--cd-pad, 10px 5px);
    background: var(--cd-bg, var(--e-global-color-8c22d81));
    border-radius: 3px;
    text-align: center;
    color: #fff;
  }
  .cdown-item + .cdown-item { margin-left: 5px; }
  .cdown-digits,
  .cdown-label { display: block; font-family: 'Poppins', sans-serif; font-weight: 400; }
  /* Leading is 1, not 1.2: the original's digits are 20px on 20 and its labels
     10px on 10, measured on all 402 pages carrying the countdown. */
  .cdown-digits { font-size: var(--cd-digit, 20px); line-height: 1; font-variant-numeric: tabular-nums; }
  .cdown-label { font-size: var(--cd-label, 10px); line-height: 1; }
  /* Phone sizes: the original's Tesla countdown drops 55/18px to 30/13px on
     10px padding at 390 (measured on production). Kept as a cap, so the post
     pages' 20/10px digits and labels are unchanged. At the desktop label size,
     "Minutes" and "Seconds" are wider than a quarter-width box and spilled
     4px past the viewport. */
  @media (max-width: 767px) {
    .cdown-digits { font-size: min(var(--cd-digit, 20px), 30px); }
    .cdown-label { font-size: min(var(--cd-label, 10px), 13px); }
    .cdown[style*="--cd-pad"] .cdown-item { padding: 10px; }
  }

  /* Rotated category badges (commercial/personal-vehicle-wraps). The original
     turns these headings -90deg on tablet and desktop and lays them flat on
     phones (--e-transform-rotateZ on the widget). Unrotated, "PERFORATED" at
     30px was 188px in a 170px box and pushed the page 18px wide at 820. Keyed
     on the badge's unique 200px/150px margin so no other heading is touched. */
  @media (min-width: 768px) {
    .col h3[style*="margin:200px 0px 150px 0px"] { transform: rotate(-90deg); }
  }
  /* And they follow the reader down their row: each widget is Elementor
     `sticky: top` at a 100px offset, held inside its own column
     (`sticky_parent`). Elementor pins the widget, whose 200px top margin
     (80px on a tablet, none on a phone) sits inside it; here the margin is on
     the heading itself, so the offset is the two added together. Sticky
     already stops at the column's end, as sticky_parent does. These scrolled
     away with the page, leaving the long galleries unlabelled. */
  .col h3[style*="margin:200px 0px 150px 0px"] { position: sticky; top: 300px; }
  @media (max-width: 1024px) {
    .col h3[style*="margin:200px 0px 150px 0px"] { top: 180px; }
  }
  @media (max-width: 767px) {
    .col h3[style*="margin:200px 0px 150px 0px"] { top: 100px; }
  }

  /* related / looped post grids */
  /* The count comes from the widget; auto-fill gave three or more columns
     where the original gives two, and never stacked to one on a phone. The
     auto-fill remains the fallback for grids that declare nothing. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cards-d, auto-fill), minmax(0, 1fr));
    /* The widget declares its own row and column gutters and they differ by
       instance — 28/28 on a related-post grid, 30/35 on an archive listing.
       The 18px here is only the fallback for a grid that declares neither. */
    gap: var(--cards-gap-r, 18px) var(--cards-gap-c, 18px);
  }
  .cards:not([style*='--cards-d']) {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  @media (max-width: 1024px) {
    .cards { grid-template-columns: repeat(var(--cards-t, var(--cards-d, auto-fill)), minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .cards { grid-template-columns: repeat(var(--cards-m, 1), minmax(0, 1fr)); }
  }
  /* The card is the list item, not a single wrapping link: the original has
     three separate links inside it (thumbnail, title, read-more). */
  .cards > li {
    /* the term badge is absolutely placed against the card */
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    /* Measured on the original's own card: NO border, a 5px radius and a soft
       shadow it carries at rest. The port drew a 1px #e9e9e9 border with no
       shadow, which also cost every thumbnail 2px of width -- the original's
       runs the full 373 of the column. */
    border: 0;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }
  .cards > li:hover {
    border-color: var(--e-global-color-a8178e9);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  /* var(--brand-pink) is #ff0099, which measures 3.68:1 for this 16px/500
     card-title text (fails WCAG AA 4.5:1 for normal text). Using the same
     already-validated #d6007d pink as the pagination .current fix above
     (badge-contrast-repair-20261003, 5.05:1+) instead of the brand token. */
  .cards > li:hover .card-title a { color: #d6007d; }
  /* Keyboard-only parity: hover above only fires on pointer-over, so Tabbing
     to a card-title link with no prior mouse hover left no visible change.
     Matches the hover colour and reuses the site's existing :focus-visible +
     outline convention (QuoteForm.astro, Interactions.astro). */
  .card-title a:focus-visible {
    color: #d6007d;
    outline: 2px solid var(--e-global-color-a8178e9);
    outline-offset: 2px;
  }
  .cards a { text-decoration: none; color: var(--brand-navy); }
  /* Elementor's posts widget is set to `elementor-fit-height` on every grid
     checked -- /trailer-decals-lettering/, /box-truck-wrap/, /blog/,
     /car-wraps/ -- which means the thumbnail box takes the IMAGE'S OWN ratio
     and nothing is cropped. Tiles in one row are deliberately different
     heights on the original: 197 beside 211 beside 211.

     The port forced 16/10 with `object-fit: cover`, so every thumbnail on the
     site was cropped to a shape the original never asks for. */
  /* No `aspect-ratio` here. The browser's own default for an <img> with
     width/height attributes is `auto <w> / <h>`: the picture's own ratio once
     it has loaded, the attributes' ratio until then. An explicit
     `aspect-ratio: auto` kept the first half and threw away the second, so
     every lazy thumbnail below the fold was 0px tall until it arrived -- the
     /car-wraps/ blog grid measured 616px against the original's 1406 and
     grew under the reader as it loaded. */
  .cards img {
    width: 100%;
    height: auto;
    object-fit: fill;
    display: block;
  }
  /* `0 10px` on the original, with the space under the thumbnail coming from
     the thumbnail's own 20px margin rather than from padding here. The port's
     `12px 14px 14px` made the title box 343 wide against the original's 353,
     so card titles wrapped early on every listing on the site. */
  .cards .card-thumb { margin-bottom: 20px; }
  /* Elementor's own cards-skin defaults: 30px either side of the text, 20px
     under the read-more, and 15px 30px around the meta row. A widget that
     sets its own (the archive template's 15px, the service pages' 10px)
     arrives from src/data/widget-css.json and wins; the 10px that used to be
     the base here was one widget's override mistaken for the default, so the
     related posts under every blog post ran 40px wider text than the
     original's. */
  .cards .card-text { padding: 0 30px; }
  .cards .card-title {
    /* Same rendering as the span it replaced: the heading is for the document
       outline, not a change of appearance. These are the posts widget's own
       defaults — 16px on a 1.2 ratio, no capitalize — and any instance that
       sets its own arrives inline and wins. 1.4 here was one page's declared
       value mistaken for the default. */
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.2;
    text-transform: none;
    margin-bottom: 2px;
  }
  /* .elementor-post__excerpt takes the body's own type; the 14px/1.55 in
     #4a4a4a here was invented. */
  .card-desc {
    margin: 8px 0 0;
    font-size: 16px;
    line-height: 1.5;
  }
  /* `.cards a` above is 0,1,1 and beat the 0,1,0 this used to carry, so the
     pink never applied and every read-more link came out navy. Measured on
     .elementor-post__read-more: Roboto 14px, weight 500, uppercase, pink.
     The 1.4px leading is the original's own — its CSS says `1.4px` where it
     plainly meant `1.4` — and the port matches what the page renders. */
  /* `.cards a` above is 0,1,1 and beat the 0,1,0 this used to carry, so the
     read-more link never got its own colour. Everything else about it —
     family, size, leading, weight, case — differs per posts-widget instance
     and now arrives inline from the widget; only the layout is fixed here. */
  .cards .card-more {
    display: inline-block;
    margin-top: 0;
    margin-bottom: 20px;
    /* The posts widget's own defaults; an instance that sets its own family,
       size, leading, weight or colour arrives inline and wins. */
    font-size: 12px;
    text-transform: uppercase;
    color: var(--brand-pink);
  }

  /* .elementor-post__badge — a pill, not a link. Its type and colours come
     from the widget; only the pill shape is fixed here. */
  .card-badge {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    z-index: 1;
    padding: 6px 12px;
    /* the widget's own defaults; an instance that sets its own arrives inline */
    font-size: 12px;
    line-height: 1;
    text-transform: uppercase;
  }
  /* Accessibility fix: the 578 blog/post-card instances that set
     background-color: var(--e-global-color-f32bb28) [#FF0099] with inline
     color:#fff measure 3.67:1 — below WCAG AA's 4.5:1 for this 9px text.
     The instance's own background-color (inline, highest specificity short
     of !important) is overridden here for pink-badge instances only, via an
     attribute match on that same inline declaration, to a darkened pink that
     holds the brand hue at 5.03:1 with the unchanged white text. Layout,
     the navy-badge variant (--e-global-color-d077a13, already ~13:1), and
     every other --e-global-color-f32bb28 usage (nav, accents) are untouched. */
  .card-badge[style*="f32bb28"] {
    background-color: #d6007d !important;
  }
  .card-meta {
    margin-top: auto;
    /* The original rules this row off with a green hairline and pads it 10px
       all round. The port had neither the rule nor the padding. */
    border-top: 1px solid var(--e-global-color-a8178e9); /* #99CC33 */
    padding: 15px 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-family: 'Poppins', sans-serif;
    /* .elementor-post__meta-data: 12px on a 1.3 ratio in #9e9e9e, not the
       body's 1.5 in #767676. */
    font-size: 12px;
    line-height: 1.3;
    color: #9e9e9e;
  }

  /* Read off the original's own widget rather than invented. It draws a green
     chevron on each side, a navy hairline down the middle, and sits on the
     #FAFAFA panel its widget container carries -- which arrives in the block's
     own `box`, exactly as it does for the five other block types that use it.
     This drew a grey rule across the top instead, which the original has
     nowhere: the border rules in widget-post-navigation.min.css are gated on
     `.elementor-post-navigation.elementor-grid`, and this nav is not a grid. */
  .postnav {
    display: flex;
    overflow: hidden;
  }
  .postnav a {
    display: flex;
    align-items: center;
    /* gap and width are per-widget — the separator each one reserves room for
       is a different thickness. Set with the rest of the per-widget values. */
    overflow: hidden;
    text-decoration: none;
    color: var(--brand-navy);
  }
  /* The site has exactly two post-navigation widgets and they are styled
     differently throughout -- separator colour and width, arrow size, label and
     title type, the panel. The defaults here are 0144f5b, which is 402 of the
     471; b4f122c, the 69 before/after project pages, overrides below. Scoped on
     the widget's own id rather than on the section's, because that is what the
     difference actually belongs to. */
  .postnav { margin-top: 20px; padding: 5px 0; }
  .postnav a { width: calc(50% - 1px); gap: 15px; }
  .postnav-sep { width: 2px; background: var(--brand-pink); }
  .postnav-arrow { font-size: 30px; }
  .postnav .t { font-weight: 400; font-size: 13px; }
  @media (max-width: 767px) {
    .postnav-arrow { font-size: 20px; }
  }

  /* b4f122c — the before/after project pages. The panel is in CSS rather than
     left to each block's `box` because it is a property of the widget, not of
     the page: the capture missed it on 2 of the 69 (both Teslas), and the
     original serves it on those two as well. */
  .postnav[data-eid='b4f122c'] {
    margin-top: 25px;
    padding: 10px;
    background: #fafafa;
  }
  .postnav[data-eid='b4f122c'] a { width: calc(50% - 0.5px); gap: 10px; }
  .postnav[data-eid='b4f122c'] .postnav-sep { width: 1px; background: var(--brand-navy); }
  .postnav[data-eid='b4f122c'] .postnav-arrow { font-size: 50px; }
  .postnav[data-eid='b4f122c'] .dir {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    color: #818181;
  }
  .postnav[data-eid='b4f122c'] .t { font-weight: 500; font-size: 15px; }
  @media (max-width: 767px) {
    .postnav[data-eid='b4f122c'] .postnav-arrow { font-size: 23px; }
  }

  .postnav-next { justify-content: flex-end; }
  .postnav-text { display: flex; flex-direction: column; overflow: hidden; }
  .postnav-next .postnav-text { text-align: end; }
  /* One line each, cut with an ellipsis, as the original does — otherwise a
     long project title wraps and the two sides stop lining up. */
  .postnav .dir,
  .postnav .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Structure only — thickness and colour are per-widget, above. */
  .postnav-sep { align-self: stretch; flex: none; }
  /* `.post-navigation__arrow-wrapper { color: var(--e-global-color-8c22d81) }`
     — the brand green on both widgets; only the size differs. */
  .postnav-arrow {
    display: flex;
    flex: none;
    color: var(--brand-green);
  }
  .postnav-arrow i { transform: translateY(-5%); }
  .postnav a:hover .t,
  .postnav a:hover .dir,
  .postnav a:hover .postnav-arrow { color: var(--brand-pink); }
  /* .post-navigation__prev--label: 18px on the body ratio in brand green with
     no tracking — the 12px grey caps here were invented. */
  .postnav .dir {
    font-size: 18px;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--brand-green);
  }
  /* Family only — size and weight differ per widget, above. The 13px default
     is 0144f5b's own declared value; 15px here was invented. */
  .postnav .t { font-family: 'Poppins', sans-serif; }


  /* Carousel: slides-per-view and gap come from the widget's own settings. */

  /* Padding comes from the block's own `box`, inline, because Elementor sizes
     it per widget: of the nine carousels on the site only the two on the
     homepage layout carry any, and a blanket rule here was measured making
     /lp/, /lp-truck-wraps/ and the Mustang page worse while fixing the
     homepage. */
  .carou { position: relative; }
  .carou-track {
    display: flex;
    gap: var(--carou-gap, 5px);
    overflow: hidden;
    scroll-behavior: smooth;
  }
  .carou-slide {
    margin: 0;
    flex: 0 0 calc((100% - (var(--per, 3) - 1) * var(--carou-gap, 5px)) / var(--per, 3));
  }
  .carou-slide img { width: 100%; display: block; }

  /* 6px bullets, 6px of margin each side — Swiper's own geometry, and the same
     on every dotted carousel the site has. The colours are not: each widget
     names its own pair, so they arrive as custom properties and the generic
     grey and green are only the fallback. */
  .carou-dots {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-top: 12px;
  }
  /* A carousel with pagination reserves a 30px gutter at its foot and positions
     the bullets into it, rather than stacking them under the slides on a
     margin. The gutter is held whether or not bullets end up drawn: six logos
     at six per view is a single page, so Swiper renders none and the original
     still keeps the 30px. Reserving it is what stops the strip collapsing by a
     row's worth of height.

     On the track rather than the carousel, so it adds to the widget's own
     padding instead of being overridden by it -- `box` arrives as an inline
     style and would win over any padding set here. That nesting is also what
     the original does: the gutter is on the carousel wrapper, inside the
     widget container's padding. */
  /* Elementor's arrows-position-inside: 25px chevrons over the slide, 10px in
     from each edge, centred on the slide's height. */
  .carou { position: relative; }
  .carou-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    width: 25px;
    height: 25px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
    line-height: 0;
  }
  .carou-arrow svg { width: 25px; height: 25px; fill: currentColor; }
  .carou-arrow--prev { left: 10px; }
  .carou-arrow--next { right: 10px; }
  .carou--dots .carou-arrow { top: calc(50% - 15px); }
  /* Testimonial carousel, bubble skin -- values measured on /lp/ (183566e). */
  .carou--testi { padding-bottom: 40px; }
  .carou--testi .carou-track { width: 95%; margin: 0 auto; align-items: stretch; }
  .testi { display: flex; flex-direction: column; padding: 20px; text-align: center; }
  .testi-bubble {
    position: relative;
    margin: 0;
    padding: 20px;
    border-radius: 10px;
    background-color: var(--e-global-color-d077a13);
  }
  /* The bubble's tail: a 14px square squeezed and turned, 7px below. */
  .testi-bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 14px;
    height: 14px;
    background-color: inherit;
    transform: translateX(-7px) scaleX(0.75) rotate(45deg);
  }
  .testi-bubble p {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 400;
    font-style: italic;
    line-height: 24px;
    color: #ffffff;
  }
  .testi-foot { display: flex; justify-content: center; margin-top: 25px; }
  .testi-foot cite {
    display: flex;
    flex-direction: column;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-style: normal;
    line-height: 21px;
  }
  .testi-name { color: var(--e-global-color-d077a13); font-weight: 500; }
  .testi-title { color: var(--e-global-color-f32bb28); font-weight: 400; }
  .carou--testi .carou-arrow {
    width: 20px;
    height: 20px;
    top: calc((100% - 40px) / 2);
    color: var(--e-global-color-f32bb28);
  }
  .carou--testi .carou-arrow svg { width: 20px; height: 20px; }
  .carou--testi .carou-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5px;
    height: 24px;
    align-items: center;
    margin: 0;
    --dot: var(--e-global-color-a8178e9);
    --dot-on: var(--e-global-color-f32bb28);
  }
  .carou--dots .carou-track { margin-bottom: 30px; }
  .carou--dots .carou-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30px;
    align-items: center;
    margin-top: 0;
  }
  /* `:global`, because the bullets are built by script once the carousel knows
     how many steps it has — so they never carry the scope attribute Astro adds
     to the markup, and a scoped rule here matched nothing at all. That is why
     they have been rendering as the browser's own grey buttons. */
  .carou-dots :global(button) {
    /* Swiper's own 6px bullet. A contrast pass made these 24px buttons with
       the dot clipped into the middle, which kept the dot's look but made a
       row of them four times as wide -- wide enough, with a long strip's
       worth of pages, to push past a phone's screen. */
    width: 6px; height: 6px; padding: 0;
    border-radius: 50%;
    border: 0;
    background: var(--dot, var(--rule));
    cursor: pointer;
  }
  .carou-dots :global(button[aria-selected='true']) { background: var(--dot-on, var(--brand-green)); }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .gallery img { width: 100%; display: block; border-radius: 4px; }

  /* Share buttons — Elementor Pro's widget as this page configures it:
     elementor-grid-1 (one per row), view icon-text, shape square, and
     color-official, whose brand colours these are. The 10px row gap and the
     20px above the block are the widget's own values. */
  .share {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }
  .share-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    color: #ffffff;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
  }
  .share-ic { font-size: 18px; line-height: 1; width: 20px; text-align: center; }
  .share-btn:hover { filter: brightness(1.08); }

  .share-btn--facebook { background-color: #3b5998; }
  .share-btn--twitter { background-color: #1da1f2; }
  .share-btn--linkedin { background-color: #0077b5; }
  .share-btn--whatsapp { background-color: #25d366; }
  .share-btn--pinterest { background-color: #bd081c; }
  .share-btn--email { background-color: #ea4335; }

  .faq details {
    border-bottom: 1px solid var(--rule);
    padding: 12px 0;
  }
  .faq summary {
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 18px;
    color: var(--brand-navy);
  }
  .faq summary:hover { color: var(--brand-pink); }

  /* before/after pairs, shown side by side rather than as a drag slider */
  .compare { display: grid; gap: 20px; }
  /* The two-up layout is only the no-JS fallback. Once the slider script marks
     a pair with data-juxtapose it becomes one overlaid image, and these rules
     have to stop applying — scoped with :not() rather than left to fight on
     specificity, which they were winning: both selectors landed on 0,2,0 and
     Astro's scoping attribute put this file last, so the overlay never engaged
     and every before/after on the site rendered as two half-width images. */
  .compare-pair:not([data-juxtapose]) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .compare-pair figure { margin: 0; }
  .compare-pair img { width: 100%; display: block; border-radius: 4px; }
  .compare-pair:not([data-juxtapose]) figcaption {
    margin-top: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-navy);
  }

  /* #4075310 -- the share-buttons widget: a green panel, 10px in, 5px
     radius and a soft drop shadow; navy circles 4.5em across with a white
     glyph at 1.6em, the em being 7px at desktop, 7.5 at tablet and 10 on a
     phone (where the glyph is 2em); 14 / 10 / 10px apart. */
  .shareicons {
    list-style: none;
    margin: 0;
    padding: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
    background-color: var(--e-global-color-8c22d81);
    border-radius: 5px;
    box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.42);
    font-size: 7px;
  }
  .shareicons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5em;
    height: 4.5em;
    border-radius: 99.9em;
    background-color: var(--e-global-color-d077a13);
    color: var(--e-global-color-accent);
    text-decoration: none;
    transition: color 0.3s;
  }
  .shareicons a i { font-size: 1.6em; }
  .shareicons a:hover { color: var(--e-global-color-f32bb28); }
  @media (max-width: 1024px) {
    .shareicons { font-size: 7.5px; gap: 3px; }
  }
  @media (max-width: 767px) {
    .shareicons { font-size: 10px; gap: 10px; }
    .shareicons a i { font-size: 2em; }
  }

  .toc {
    background: var(--panel);
    border: 1px solid #e9e9e9;
    border-radius: 6px;
  }
  /* The widget's header and body each carry 10px: a 42px bar for the title
     and its toggle, measured on the original at 1440 and 390. */
  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px;
  }
  .toc-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 16px;
    padding: 0;
    border: 0;
    background: none;
    color: #333333;
    font-size: 16px;
    cursor: pointer;
  }
  /* The widget's list, measured on the original: no markers and no indent,
     10px in from the box and 24px under it; each entry 14px on 21px with 7px
     below, the links in the kit pink. The port's 16/24 entries, indented 30px,
     wrapped where the original's do not, and on a short post the sidebar --
     not the copy -- sets the row's height. */
  .toc > ol { padding: 0 10px 10px; margin: 0 0 24px; list-style: none; }
  .toc > .toc-none { padding: 10px; font-size: 16px; line-height: 24px; }
  .toc[data-state='closed'] > :is(ol, .toc-none) { display: none; }
  @media (max-width: 1024px) {
    .toc:not([data-state]) > :is(ol, .toc-none) { display: none; }
  }
  /* 22px leading in the kit green, measured against the original on all 402
     pages that carry a table of contents — one combination, no exceptions.
     Size and weight were already right; the colour was navy and the leading
     fell back to the font size. */
  /* A heading widget that chose a tag outside h1..h6 still leads like a
     heading: 1, not the paragraph's 1.5. */
  .hd { line-height: 1; }

  .toc-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    line-height: 22px;
    font-weight: 500;
    color: var(--e-global-color-a8178e9); /* #99CC33 */
    margin: 0;
    flex: 1;
  }
  .toc ol { margin: 0; }
  .toc li { margin-bottom: 7px; font-size: 14px; line-height: 21px; }
  .toc li.lvl3 { margin-inline-start: 16px; }
  .toc a { color: var(--brand-pink); text-decoration: none; }
  .toc a:hover { color: var(--brand-pink); text-decoration: underline; }

  .catlist { border-top: 1px solid var(--rule); padding-top: 14px; }
  /* Measured on the live sidebar: 18px on a 1.2 ratio, centred, in #444 and
     in its own case. The 17px uppercase navy here was invented. */
  .cat-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    text-transform: none;
    text-align: center;
    color: #444444;
    margin: 0 0 10px;
  }
  /* The control is a dropdown, not a list — the original's sidebar runs
     WordPress's categories widget in dropdown mode. Its appearance comes
     entirely from hello-elementor's reset, which styles every form control the
     same way; these are that rule's declarations, scoped to this one select so
     they cannot reach the quote form. */
  .catform { margin: 0; }
  .catform select {
    display: block;
    width: 100%;
    border: 1px solid #666666;
    border-radius: 3px;
    padding: 0.5rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    text-transform: none;
    transition: all 0.3s;
  }
  .catform select:focus { border-color: #333333; }

  /* Elementor filterable gallery -- #e548c3e on /vinyl-car-wrap-our-portfolio/,
     the site's only gallery with titles. Its rules, measured at 1440/900/390:

       .elementor-gallery__titles-container  flex, wrap, justify center
                                             (--titles-container-justify-content),
                                             margin-bottom 12px, no gap
                                             (--space-between: 0px)
       .elementor-gallery-title              Poppins 500 16px/24px, 7px 14px,
                                             navy; pink when active
       e--pointer-underline                  ::after, a 3px bar under the
                                             title: navy and in place on the
                                             active one, pink and dropping in
                                             from 10px below on hover
                                             (e--animation-drop-in)

     The port had a left-aligned row with a grey rule under it and a green
     active tab, and dropped the type to 14px on phones; the original keeps
     16px at every width, which is why it wraps to four rows at 390. */
  .fgal-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 12px;
  }
  .fgal-tab {
    position: relative;
    background: none;
    border: 0;
    padding: 7px 14px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    color: var(--e-global-color-d077a13); /* #15334C */
    transition: 0.3s;
  }
  .fgal-tab::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    bottom: -10px;
    opacity: 0;
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
    transition: 0.3s cubic-bezier(0.58, 0.3, 0.005, 1);
  }
  .fgal-tab:hover { color: var(--e-global-color-a8178e9); /* #99CC33 */ }
  .fgal-tab:hover::after { bottom: 0; opacity: 1; }
  .fgal-tab[aria-selected='true'] { color: var(--e-global-color-f32bb28); }
  .fgal-tab[aria-selected='true']::after {
    bottom: 0;
    opacity: 1;
    background-color: var(--e-global-color-d077a13);
  }

  /* Columns, crop and gutter come from each gallery widget as custom
     properties (see galleryStyle above). The values here are only the fallback
     for a gallery that declares none — which is why the track list travels as
     one property: the fallback is an auto-fill rule, not a column count. */
  .fgal-grid {
    --fg-track: repeat(auto-fill, minmax(260px, 1fr));
    display: grid;
    grid-template-columns: var(--fg-track);
    gap: var(--fg-gap, 14px);
  }
  .fgal-item { margin: 0; }
  .fgal-item[hidden] { display: none; }
  .fgal-item img {
    width: 100%;
    aspect-ratio: var(--fg-aspect, 4 / 3);
    object-fit: cover;
    display: block;
    /* Square-cornered: Elementor's gallery widget draws its tiles with no
       radius, and none of the original's galleries sets one. The 4px here
       was invented. */
    cursor: zoom-in;
    /* A picture that fails to arrive keeps its box -- that is what the width,
       height and aspect-ratio are for -- but the browser then draws the alt
       text inside that box and lets it spill out, which is how one failed
       image ends up lying in a line across the pictures beside it. Clipping
       keeps a failure inside its own tile, and the tint means the gap reads as
       a picture that has not loaded rather than as a hole in the page. */
    overflow: hidden;
    background-color: #f0f0f0;
    font-size: 12px;
    line-height: 1.3;
    color: #8a8a8a;
  }

  /* How a tile arrives.
   *
   * The original's gallery holds each picture invisible at half size until it
   * has loaded, then animates it up. Its own rule is
   *
   *   .e-gallery--lazyload .e-gallery-image:not(.e-gallery-image-loaded)
   *     { filter: opacity(0); transform: scale(0.5) }
   *
   * over --image-transition-duration: 250ms on filter and transform, from a
   * `center top` origin. Those are its values, not chosen ones.
   *
   * The starting state is behind a class that only script adds, exactly as the
   * original does it -- `e-gallery--lazyload` appears nowhere in its served
   * HTML. With no JavaScript the pictures simply show, rather than a gallery of
   * 341 permanently invisible tiles. */
  .fgal-item img,
  .carou-slide img {
    transform-origin: center top;
    transition: filter 250ms, transform 250ms;
  }
  .img-reveal .fgal-item img,
  .img-reveal.carou .carou-slide img {
    filter: opacity(0);
    transform: scale(0.5);
  }
  .img-reveal .fgal-item img.is-loaded,
  .img-reveal.carou .carou-slide img.is-loaded {
    filter: none;
    transform: none;
  }

  /* A before/after slider gets no reveal at all, and the reason is worth
     keeping. The pair lays its two pictures over one another and reveals the
     top one by clipping, so fading them separately lets the "before" show
     through the half-transparent "after" -- a double exposure of two different
