---
/**
 * Renders the block model produced from each live page's Elementor markup.
 *
 * Elementor's nesting is not reproduced — it is a builder artefact, not the
 * design. Each page is reduced to ordered sections of typed blocks and drawn
 * with the measured type scale and palette.
 */
import type { Section } from '../types';
import categories from '../data/categories.json';

export interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const num = (v?: string | null) => (v && /^\d+$/.test(v) ? Number(v) : undefined);

/** Stable anchor id from heading text, so the table of contents can link to it. */
const slugify = (t: string) =>
  t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);

/* The live table of contents is built client-side from the page's own h2/h3s.
   Rebuilt here from the same source so it lists the same entries. */
const tocEntries = sections
  .flatMap((s) => s.blocks)
  .filter((b): b is Extract<typeof b, { type: 'heading' }> =>
    b.type === 'heading' && (b.level === 2 || b.level === 3))
  .map((b) => ({ text: b.text, level: b.level, id: slugify(b.text) }))
  .filter((e) => e.id);
---

{sections.map((section) => (
  <section class="sec" data-eid={section.id ?? undefined}>
    <div class="container stack">
      {section.blocks.map((b) => {
        if (b.type === 'heading') {
          const Tag = `h${Math.min(Math.max(b.level, 1), 6)}` as 'h1';
          const id = b.level === 2 || b.level === 3 ? slugify(b.text) : undefined;
          return (
            <Tag id={id}>{b.href ? <a class="hlink" href={b.href}>{b.text}</a> : b.text}</Tag>
          );
        }

        if (b.type === 'toc') {
          return tocEntries.length > 0 ? (
            <nav class="toc" aria-label={b.title}>
              <h4 class="toc-title">{b.title}</h4>
              <ol>
                {tocEntries.map((e) => (
                  <li class={e.level === 3 ? 'lvl3' : 'lvl2'}>
                    <a href={`#${e.id}`}>{e.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : null;
        }

        if (b.type === 'categories') {
          return (
            <nav class="catlist" aria-label={b.title}>
              <h5 class="cat-title">{b.title}</h5>
              <ul>
                {categories.map((c) => (
                  <li>
                    <a href={c.href}>{c.name}</a> <span class="n">({c.count})</span>
                  </li>
                ))}
              </ul>
            </nav>
          );
        }

        if (b.type === 'text') return <div class="rt" set:html={b.html} />;

        if (b.type === 'image') {
          const img = (
            <img
              src={b.src}
              alt={b.alt}
              width={num(b.width)}
              height={num(b.height)}
              loading="lazy"
              decoding="async"
            />
          );
          return <figure class="fig">{b.href ? <a href={b.href}>{img}</a> : img}</figure>;
        }

        if (b.type === 'button') return <p><a class="btn" href={b.href}>{b.text}</a></p>;

        if (b.type === 'list') {
          return (
            <ul class="ilist">
              {b.items.map((i) => (
                <li>{i.href ? <a href={i.href}>{i.text}</a> : i.text}</li>
              ))}
            </ul>
          );
        }

        if (b.type === 'feature') {
          return (
            <div class="feature">
              {b.image && <img src={b.image} alt={b.alt ?? ''} loading="lazy" decoding="async" />}
              {b.title && <h3>{b.title}</h3>}
              {b.text && <p>{b.text}</p>}
            </div>
          );
        }

        if (b.type === 'cards') {
          return (
            <ul class="cards">
              {b.cards.map((c) => (
                <li>
                  <a href={c.href}>
                    {c.image && <img src={c.image} alt={c.title} loading="lazy" decoding="async" />}
                    <span>{c.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          );
        }

        if (b.type === 'postnav') {
          return (
            <nav class="postnav" aria-label="Post navigation">
              {b.prev && (
                <a class="postnav-prev" href={b.prev.href} rel="prev">
                  <span class="dir">Previous</span>
                  <span class="t">{b.prev.text}</span>
                </a>
              )}
              {b.next && (
                <a class="postnav-next" href={b.next.href} rel="next">
                  <span class="dir">Next</span>
                  <span class="t">{b.next.text}</span>
                </a>
              )}
            </nav>
          );
        }

        if (b.type === 'gallery') {
          return (
            <div class="gallery">
              {b.images.map((i) => (
                <img src={i.src} alt={i.alt} loading="lazy" decoding="async" />
              ))}
            </div>
          );
        }

        if (b.type === 'faq') {
          return (
            <div class="faq">
              {b.items.map((qa) => (
                <details>
                  <summary>{qa.q}</summary>
                  <div class="rt" set:html={qa.a} />
                </details>
              ))}
            </div>
          );
        }

        if (b.type === 'compare') {
          return (
            <div class="compare">
              {b.pairs.map((p) => (
                <div class="compare-pair">
                  <figure>
                    <img src={p.before.src} alt={p.before.alt} loading="lazy" decoding="async" />
                    <figcaption>{p.beforeLabel}</figcaption>
                  </figure>
                  <figure>
                    <img src={p.after.src} alt={p.after.alt} loading="lazy" decoding="async" />
                    <figcaption>{p.afterLabel}</figcaption>
                  </figure>
                </div>
              ))}
            </div>
          );
        }

        if (b.type === 'video') {
          return (
            <div class="video">
              <iframe
                src={b.src}
                title="Video"
                loading="lazy"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
          );
        }

        return null;
      })}
    </div>
  </section>
))}

<style>
  .sec { padding: 34px 0; }
  .sec:first-child { padding-top: 26px; }

  .rt :global(p) { margin: 0 0 16px; }
  .rt :global(p:last-child) { margin-bottom: 0; }
  .rt :global(ul),
  .rt :global(ol) { margin: 0 0 16px; padding-inline-start: 22px; }
  .rt :global(li) { margin-bottom: 6px; }
  /* Gutenberg in-body images (figure.wp-block-image) inside post content. */
  .rt :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .rt :global(figure) { margin: 20px 0; }
  .rt :global(figcaption) {
    margin-top: 6px;
    font-size: 13px;
    color: #767676;
    text-align: center;
  }
  .rt :global(a) { color: var(--brand-green); }
  .rt :global(a:hover) { color: var(--brand-pink); }
  .rt :global(h2),
  .rt :global(h3),
  .rt :global(h4) { margin-top: 24px; }

  .hlink { color: inherit; text-decoration: none; }
  .hlink:hover { color: var(--brand-pink); }

  .fig { margin: 0; }
  .fig img { display: block; border-radius: 4px; }

  /* Button styling follows the header CTA: navy, green on hover, square. */
  .btn {
    display: inline-block;
    background-color: var(--e-global-color-d077a13);
    color: var(--e-global-color-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 15px;
    line-height: 15px;
    padding: 12px 24px;
    border-radius: 0;
    text-decoration: none;
  }
  .btn:hover { background-color: var(--e-global-color-a8178e9); }

  .ilist { list-style: none; margin: 0; padding: 0; }
  .ilist > li {
    position: relative;
    padding-inline-start: 22px;
    padding-block-end: 5px;
  }
  .ilist > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
  }
  .ilist a { color: inherit; text-decoration: none; }
  .ilist a:hover { color: var(--brand-pink); }

  .feature { padding: 16px; background: var(--panel); border-radius: 4px; }
  .feature h3 { margin-bottom: 8px; }
  .feature p { margin: 0; }
  .feature img {
    display: block;
    width: 100%;
    max-width: 320px;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  /* related / looped post grids */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
  .cards > li > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--brand-navy);
    background: #fff;
    border: 1px solid #e9e9e9;
    border-radius: 6px;
    overflow: hidden;
  }
  .cards > li > a:hover {
    border-color: var(--e-global-color-a8178e9);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  .cards > li > a:hover span { color: var(--brand-pink); }
  .cards img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .cards span {
    padding: 12px 14px 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.35;
  }

  .postnav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-top: 1px solid var(--rule);
    padding-top: 18px;
  }
  .postnav a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 46%;
    text-decoration: none;
    color: var(--brand-navy);
  }
  .postnav-next { text-align: right; margin-inline-start: auto; }
  .postnav a:hover .t { color: var(--brand-pink); }
  .postnav .dir {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #767676;
  }
  .postnav .t { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 15px; }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .gallery img { width: 100%; display: block; border-radius: 4px; }

  .faq details {
    border-bottom: 1px solid var(--rule);
    padding: 12px 0;
  }
  .faq summary {
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 18px;
    color: var(--brand-navy);
  }
  .faq summary:hover { color: var(--brand-pink); }

  /* before/after pairs, shown side by side rather than as a drag slider */
  .compare { display: grid; gap: 20px; }
  .compare-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .compare-pair figure { margin: 0; }
  .compare-pair img { width: 100%; display: block; border-radius: 4px; }
  .compare-pair figcaption {
    margin-top: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-navy);
  }

  .toc {
    background: var(--panel);
    border: 1px solid #e9e9e9;
    border-radius: 6px;
    padding: 16px 20px;
  }
  .toc-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: var(--brand-navy);
    margin: 0 0 10px;
  }
  .toc ol { margin: 0; padding-inline-start: 20px; }
  .toc li { margin-bottom: 5px; }
  .toc li.lvl3 { margin-inline-start: 16px; list-style: circle; }
  .toc a { color: var(--brand-green); text-decoration: none; }
  .toc a:hover { color: var(--brand-pink); text-decoration: underline; }

  .catlist { border-top: 1px solid var(--rule); padding-top: 14px; }
  .cat-title {
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--brand-navy);
    margin: 0 0 10px;
  }
  .catlist ul { list-style: none; margin: 0; padding: 0; columns: 2; }
  .catlist li { margin-bottom: 5px; break-inside: avoid; font-size: 15px; }
  .catlist a { color: var(--brand-green); text-decoration: none; }
  .catlist a:hover { color: var(--brand-pink); }
  .catlist .n { color: #767676; font-size: 13px; }

  @media (max-width: 767px) {
    .catlist ul { columns: 1; }
  }

  .video { position: relative; padding-top: 56.25%; }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 767px) {
    .sec { padding: 24px 0; }
    .gallery { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .compare-pair { grid-template-columns: 1fr; }
  }
</style>
