---
/**
 * Renders the block model produced from each live page's Elementor markup.
 *
 * Elementor's nesting is not reproduced — it is a builder artefact, not the
 * design. Each page is reduced to ordered sections of typed blocks and drawn
 * with the measured type scale and palette.
 */
import type { Section } from '../types';
import categories from '../data/categories.json';
import QuoteForm from './QuoteForm.astro';
import { img, imgHtml } from '../lib/img';

export interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const num = (v?: string | null) => (v && /^\d+$/.test(v) ? Number(v) : undefined);

/** Stable anchor id from heading text, so the table of contents can link to it. */
const slugify = (t: string) =>
  t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);

/* The live table of contents is built client-side from the page's own h2/h3s.
   Rebuilt here from the same source so it lists the same entries. */
const tocEntries = sections
  .flatMap((s) => s.blocks)
  .filter((b): b is Extract<typeof b, { type: 'heading' }> =>
    b.type === 'heading' && (b.level === 2 || b.level === 3))
  .map((b) => ({ text: b.text, level: b.level, id: slugify(b.text) }))
  .filter((e) => e.id);
---

{sections.map((section) => (
  <section
    class="sec"
    data-eid={section.id ?? undefined}
    style={section.padding ? `padding:${section.padding}` : undefined}
  >
    <div class="container stack" style={section.maxWidth ? `max-width:${section.maxWidth}` : undefined}>
      {section.blocks.map((b, i) => {
        if (b.type === 'heading') {
          const Tag = `h${Math.min(Math.max(b.level, 1), 6)}` as 'h1';
          const id = b.level === 2 || b.level === 3 ? slugify(b.text) : undefined;
          return (
            <Tag id={id} style={b.style ?? undefined}>
              {b.href ? <a class="hlink" href={img(b.href)}>{b.text}</a> : b.text}
            </Tag>
          );
        }

        if (b.type === 'toc') {
          return tocEntries.length > 0 ? (
            <nav class="toc" aria-label={b.title}>
              <h4 class="toc-title">{b.title}</h4>
              <ol>
                {tocEntries.map((e) => (
                  <li class={e.level === 3 ? 'lvl3' : 'lvl2'}>
                    <a href={`#${e.id}`}>{e.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : null;
        }

        if (b.type === 'categories') {
          return (
            <nav class="catlist" aria-label={b.title}>
              <h5 class="cat-title">{b.title}</h5>
              <ul>
                {categories.map((c) => (
                  <li>
                    <a href={c.href}>{c.name}</a> <span class="n">({c.count})</span>
                  </li>
                ))}
              </ul>
            </nav>
          );
        }

        if (b.type === 'text')
          return <div class="rt" style={b.style ?? undefined} set:html={imgHtml(b.html)} />;

        if (b.type === 'image') {
          const pic = (
            <img
              src={img(b.src)}
              alt={b.alt}
              width={num(b.width)}
              height={num(b.height)}
              loading="lazy"
              decoding="async"
            />
          );
          return (
            <figure class={b.full ? 'fig fig--full' : 'fig'}>
              {b.href ? <a href={img(b.href)}>{pic}</a> : pic}
            </figure>
          );
        }

        if (b.type === 'button') {
          // The live buttons are 50%-width siblings, so a run of them sits on
          // one centred row rather than stacking.
          const prev = section.blocks[i - 1];
          if (prev && prev.type === 'button') return null;
          const run = [];
          for (let k = i; k < section.blocks.length; k++) {
            const nb = section.blocks[k];
            if (nb.type !== 'button') break;
            run.push(nb);
          }
          return (
            <p class="btnrow" style={b.style ?? undefined}>
              {run.map((rb) => (
                <a class="btn" href={img(rb.href)} style={rb.style ?? undefined}>{rb.text}</a>
              ))}
            </p>
          );
        }

        if (b.type === 'list') {
          return (
            <ul class="ilist">
              {b.items.map((i) => (
                <li>{i.href ? <a href={img(i.href)}>{i.text}</a> : i.text}</li>
              ))}
            </ul>
          );
        }

        if (b.type === 'feature') {
          return (
            <div class="feature">
              {b.image && <img src={img(b.image)} alt={b.alt ?? ''} loading="lazy" decoding="async" />}
              {b.title && <h3>{b.title}</h3>}
              {b.text && <p>{b.text}</p>}
            </div>
          );
        }

        if (b.type === 'cards') {
          return (
            <ul class="cards">
              {b.cards.map((c) => (
                <li>
                  {c.image && (
                    <a class="card-thumb" href={c.href} tabindex="-1">
                      <img
                        src={img(c.image)}
                        alt={c.alt ?? c.title}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div class="card-text">
                    {/* The original titles each card with
                        <h3 class="elementor-post__title">; a span instead took
                        1,223 headings out of the document outline. */}
                    <h3><a href={c.href}>{c.title}</a></h3>
                    {c.desc && <p class="card-desc">{c.desc}</p>}
                    {c.more && (
                      <a
                        class="card-more"
                        href={c.href}
                        aria-label={`Read more about ${c.title}`}
                        tabindex="-1"
                      >{c.more}</a>
                    )}
                  </div>
                  {(c.author || c.date) && (
                    <div class="card-meta">
                      {c.author && <span class="card-author">{c.author}</span>}
                      {c.date && <span class="card-date">{c.date}</span>}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          );
        }

        if (b.type === 'postnav') {
          return (
            <nav class="postnav" aria-label="Post navigation">
              {b.prev && (
                <a class="postnav-prev" href={b.prev.href} rel="prev">
                  <span class="dir">Previous</span>
                  <span class="t">{b.prev.text}</span>
                </a>
              )}
              {b.next && (
                <a class="postnav-next" href={b.next.href} rel="next">
                  <span class="dir">Next</span>
                  <span class="t">{b.next.text}</span>
                </a>
              )}
            </nav>
          );
        }

        if (b.type === 'carousel') {
          return (
            <div
              class="carou"
              data-carousel
              data-per={b.perView}
              data-per-mobile={b.perViewMobile}
              data-autoplay={b.autoplay ? 'yes' : 'no'}
              data-delay={b.delay}
              data-speed={b.speed}
              data-pause={b.pauseOnHover ? 'yes' : 'no'}
              data-infinite={b.infinite ? 'yes' : 'no'}
              style={`--carou-gap:${b.gap}px`}
            >
              <div class="carou-track">
                {b.images.map((i) => (
                  <figure class="carou-slide">
                    <img src={img(i.src)} alt={i.alt} loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
              {b.dots && <div class="carou-dots" role="tablist" aria-label="Slide"></div>}
            </div>
          );
        }

        if (b.type === 'gallery') {
          return (
            <div class="gallery">
              {b.images.map((i) => (
                <img src={img(i.src)} alt={i.alt} loading="lazy" decoding="async" />
              ))}
            </div>
          );
        }

        if (b.type === 'faq') {
          return (
            <div class="faq">
              {b.items.map((qa) => (
                <details>
                  <summary>{qa.q}</summary>
                  <div class="rt" set:html={imgHtml(qa.a)} />
                </details>
              ))}
            </div>
          );
        }

        if (b.type === 'compare') {
          return (
            <div class="compare">
              {b.pairs.map((p) => (
                <div class="compare-pair">
                  <figure>
                    <img src={img(p.before.src)} alt={p.before.alt} loading="lazy" decoding="async" />
                    <figcaption>{p.beforeLabel}</figcaption>
                  </figure>
                  <figure>
                    <img src={img(p.after.src)} alt={p.after.alt} loading="lazy" decoding="async" />
                    <figcaption>{p.afterLabel}</figcaption>
                  </figure>
                </div>
              ))}
            </div>
          );
        }

        if (b.type === 'filtergallery') {
          return (
            <div class="fgal" data-filtergallery>
              {b.filters.length > 0 && (
                <div class="fgal-tabs" role="tablist" aria-label="Gallery filter">
                  {b.filters.map((f, i) => (
                    <button
                      type="button"
                      role="tab"
                      class="fgal-tab"
                      data-index={f.index}
                      aria-selected={i === 0 ? 'true' : 'false'}
                    >
                      {f.label}
                    </button>
                  ))}
                </div>
              )}
              <div class="fgal-grid">
                {b.items.map((it) => (
                  <figure class="fgal-item" data-tag={it.tag}>
                    <img src={img(it.src)} alt={it.alt ?? it.title} loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
            </div>
          );
        }

        if (b.type === 'form') return <QuoteForm id={`f-${section.id ?? 's'}`} />;

        if (b.type === 'map') {
          return (
            <div class="mapembed">
              <iframe
                src={b.src}
                title="Map"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          );
        }

        if (b.type === 'video') {
          return (
            <div class="video">
              <iframe
                src={b.src}
                title="Video"
                loading="lazy"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
          );
        }

        return null;
      })}
    </div>
  </section>
))}

<style>
  .sec { padding: 34px 0; }
  .sec:first-child { padding-top: 26px; }

  .rt :global(p) { margin: 0 0 16px; }
  .rt :global(p:last-child) { margin-bottom: 0; }
  .rt :global(ul),
  .rt :global(ol) { margin: 0 0 16px; padding-inline-start: 22px; }
  .rt :global(li) { margin-bottom: 6px; }
  /* Gutenberg in-body images (figure.wp-block-image) inside post content. */
  .rt :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .rt :global(figure) { margin: 20px 0; }
  .rt :global(figcaption) {
    margin-top: 6px;
    font-size: 13px;
    color: #767676;
    text-align: center;
  }
  .rt :global(a) { color: var(--brand-green); }
  .rt :global(a:hover) { color: var(--brand-pink); }
  .rt :global(h2),
  .rt :global(h3),
  .rt :global(h4) { margin-top: 24px; }

  .hlink { color: inherit; text-decoration: none; }
  .hlink:hover { color: var(--brand-pink); }

  .fig { margin: 0; }
  .fig img { display: block; border-radius: 4px; }

  /* Zero-padding column on the live site: the image runs edge to edge, so it
     breaks out of the centred content container. */
  .fig--full {
    width: 100vw;
    max-width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .fig--full img { border-radius: 0; width: 100%; }

  .btnrow {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: inherit;
    margin: 30px 0 0;
  }
  .btnrow[style*='center'] { justify-content: center; }
  .btnrow[style*='right'] { justify-content: flex-end; }

  /* Button styling follows the header CTA: navy, green on hover, square. */
  .btn {
    display: inline-block;
    background-color: var(--e-global-color-d077a13);
    color: var(--e-global-color-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 15px;
    line-height: 15px;
    padding: 12px 24px;
    border-radius: 0;
    text-decoration: none;
  }
  .btn:hover { background-color: var(--e-global-color-a8178e9); }

  .ilist { list-style: none; margin: 0; padding: 0; }
  .ilist > li {
    position: relative;
    padding-inline-start: 22px;
    padding-block-end: 5px;
  }
  .ilist > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
  }
  .ilist a { color: inherit; text-decoration: none; }
  .ilist a:hover { color: var(--brand-pink); }

  .feature { padding: 16px; background: var(--panel); border-radius: 4px; }
  .feature h3 { margin-bottom: 8px; }
  .feature p { margin: 0; }
  .feature img {
    display: block;
    width: 100%;
    max-width: 320px;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  /* related / looped post grids */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
  /* The card is the list item, not a single wrapping link: the original has
     three separate links inside it (thumbnail, title, read-more). */
  .cards > li {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid #e9e9e9;
    border-radius: 6px;
    overflow: hidden;
  }
  .cards > li:hover {
    border-color: var(--e-global-color-a8178e9);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  .cards > li:hover h3 a { color: var(--brand-pink); }
  .cards a { text-decoration: none; color: var(--brand-navy); }
  .cards img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .cards .card-text { padding: 12px 14px 14px; }
  .cards h3 {
    /* Same rendering as the span it replaced: the heading is for the document
       outline, not a change of appearance. */
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.35;
  }
  .card-desc {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: #4a4a4a;
  }
  .card-more {
    display: inline-block;
    margin-top: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    color: var(--brand-pink);
  }
  .card-more:hover { text-decoration: underline; }
  .card-meta {
    margin-top: auto;
    padding: 8px 14px 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    color: #767676;
  }

  .postnav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-top: 1px solid var(--rule);
    padding-top: 18px;
  }
  .postnav a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 46%;
    text-decoration: none;
    color: var(--brand-navy);
  }
  .postnav-next { text-align: right; margin-inline-start: auto; }
  .postnav a:hover .t { color: var(--brand-pink); }
  .postnav .dir {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #767676;
  }
  .postnav .t { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 15px; }


  /* Carousel: slides-per-view and gap come from the widget's own settings. */
  .carou { position: relative; }
  .carou-track {
    display: flex;
    gap: var(--carou-gap, 5px);
    overflow: hidden;
    scroll-behavior: smooth;
  }
  .carou-slide {
    margin: 0;
    flex: 0 0 calc((100% - (var(--per, 3) - 1) * var(--carou-gap, 5px)) / var(--per, 3));
  }
  .carou-slide img { width: 100%; display: block; }

  .carou-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }
  .carou-dots button {
    width: 10px; height: 10px; padding: 0;
    border-radius: 50%;
    border: 0;
    background: var(--rule);
    cursor: pointer;
  }
  .carou-dots button[aria-selected='true'] { background: var(--brand-green); }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .gallery img { width: 100%; display: block; border-radius: 4px; }

  .faq details {
    border-bottom: 1px solid var(--rule);
    padding: 12px 0;
  }
  .faq summary {
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 18px;
    color: var(--brand-navy);
  }
  .faq summary:hover { color: var(--brand-pink); }

  /* before/after pairs, shown side by side rather than as a drag slider */
  .compare { display: grid; gap: 20px; }
  .compare-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .compare-pair figure { margin: 0; }
  .compare-pair img { width: 100%; display: block; border-radius: 4px; }
  .compare-pair figcaption {
    margin-top: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-navy);
  }

  .toc {
    background: var(--panel);
    border: 1px solid #e9e9e9;
    border-radius: 6px;
    padding: 16px 20px;
  }
  .toc-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: var(--brand-navy);
    margin: 0 0 10px;
  }
  .toc ol { margin: 0; padding-inline-start: 20px; }
  .toc li { margin-bottom: 5px; }
  .toc li.lvl3 { margin-inline-start: 16px; list-style: circle; }
  .toc a { color: var(--brand-green); text-decoration: none; }
  .toc a:hover { color: var(--brand-pink); text-decoration: underline; }

  .catlist { border-top: 1px solid var(--rule); padding-top: 14px; }
  .cat-title {
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--brand-navy);
    margin: 0 0 10px;
  }
  .catlist ul { list-style: none; margin: 0; padding: 0; columns: 2; }
  .catlist li { margin-bottom: 5px; break-inside: avoid; font-size: 15px; }
  .catlist a { color: var(--brand-green); text-decoration: none; }
  .catlist a:hover { color: var(--brand-pink); }
  .catlist .n { color: #767676; font-size: 13px; }

  @media (max-width: 767px) {
    .catlist ul { columns: 1; }
  }

  /* Elementor filterable gallery */
  .fgal-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
  }
  .fgal-tab {
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    color: var(--brand-navy);
    border-bottom: 2px solid transparent;
  }
  .fgal-tab:hover { color: var(--brand-pink); }
  .fgal-tab[aria-selected='true'] {
    color: var(--brand-green);
    border-bottom-color: var(--brand-green);
  }

  .fgal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .fgal-item { margin: 0; }
  .fgal-item[hidden] { display: none; }
  .fgal-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    cursor: zoom-in;
  }

  @media (max-width: 767px) {
    .fgal-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
    .fgal-tabs { gap: 4px 14px; }
    .fgal-tab { font-size: 14px; }
  }


  .mapembed { position: relative; padding-top: 45%; }
  .mapembed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .video { position: relative; padding-top: 56.25%; }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 767px) {
    .fgal-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .sec { padding: 24px 0; }
    .gallery { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .compare-pair { grid-template-columns: 1fr; }
  }
</style>
