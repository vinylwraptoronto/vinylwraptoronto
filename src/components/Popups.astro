---
/**
 * The two site-wide popups, ported from Elementor templates 18856 and 17564.
 *
 * Opened by any element carrying `data-popup="popup-want-to"` or
 * `data-popup="popup-quote"`. On the live site those triggers are Elementor
 * actions; the visible behaviour is the same.
 */
import QuoteForm from './QuoteForm.astro';
import { wantToPopup, quotePopup } from '../data/popups';
import { img } from '../lib/img';
---

<div class="pop" id={wantToPopup.id} hidden role="dialog" aria-modal="true" aria-label={wantToPopup.title}>
  <div class="pop-back" data-close></div>
  <div class="pop-box pop-box--wide">
    <button class="pop-x" type="button" data-close aria-label="Close">&times;</button>
    <h2 class="pop-title">{wantToPopup.title}</h2>
    <div class="pop-cols">
      {wantToPopup.columns.map((col) => (
        <div class="pop-col">
          <h3>{col.heading}</h3>
          <ul>
            {col.links.map((l) => (
              <li><a href={img(l.href)}>{l.text}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>

<div class="pop" id={quotePopup.id} hidden role="dialog" aria-modal="true" aria-label={quotePopup.title}>
  <div class="pop-back" data-close></div>
  <div class="pop-box">
    <button class="pop-x" type="button" data-close aria-label="Close">&times;</button>
    <h2 class="pop-title">{quotePopup.title}</h2>
    <QuoteForm variant="popup" id="popup-quote-form" />
    <p class="pop-or">{quotePopup.orLabel}</p>
    <ul class="pop-contacts">
      {quotePopup.contacts.map((c) => (
        <li>
          <a href={img(c.href)} rel={c.href.startsWith('http') ? 'noopener' : undefined}>{c.text}</a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .pop { position: fixed; inset: 0; z-index: 1000; display: flex; }
  .pop[hidden] { display: none; }
  .pop-back { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6); }

  .pop-box {
    position: relative;
    margin: auto;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    background: #fff;
    border-radius: 10px;
    border-bottom: 2px solid var(--e-global-color-a8178e9);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    padding: 26px 26px 30px;
    font-family: 'Poppins', sans-serif;
  }
  .pop-box--wide { width: min(940px, calc(100vw - 32px)); }

  .pop-x {
    position: absolute; top: 8px; right: 12px;
    background: none; border: 0; cursor: pointer;
    font-size: 30px; line-height: 1; color: var(--ink);
  }
  .pop-x:hover { color: var(--brand-pink); }

  .pop-title {
    font-size: 26px; font-weight: 600; margin: 0 0 18px;
    color: var(--brand-navy); text-transform: none;
  }

  .pop-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pop-col h3 {
    font-size: 18px; font-weight: 500; margin: 0 0 10px;
    color: var(--brand-green); text-transform: none;
  }
  .pop-col ul { list-style: none; margin: 0; padding: 0; }
  .pop-col li { margin-bottom: 7px; }
  .pop-col a { color: var(--brand-navy); text-decoration: none; font-size: 15px; }
  .pop-col a:hover { color: var(--brand-pink); }

  .pop-or { text-align: center; margin: 18px 0 10px; font-weight: 500; color: var(--ink); }

  .pop-contacts {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
  }
  .pop-contacts a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--e-global-color-a8178e9);
    color: var(--brand-navy);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
  }
  .pop-contacts a:hover { background: var(--e-global-color-a8178e9); color: #fff; }

  @media (max-width: 767px) {
    .pop-cols { grid-template-columns: 1fr; gap: 18px; }
    .pop-title { font-size: 22px; }
  }
</style>

<script>
  (() => {
    let lastFocus: HTMLElement | null = null;

    const open = (id: string) => {
      const pop = document.getElementById(id);
      if (!pop) return;
      lastFocus = document.activeElement as HTMLElement;
      pop.hidden = false;
      document.body.style.overflow = 'hidden';
      pop.querySelector<HTMLElement>('input,button,a')?.focus();
    };

    const close = (pop: HTMLElement) => {
      pop.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;

      const trigger = t.closest<HTMLElement>('[data-popup]');
      if (trigger) {
        e.preventDefault();
        open(trigger.dataset.popup!);
        return;
      }

      if (t.closest('[data-close]')) {
        const pop = t.closest<HTMLElement>('.pop');
        if (pop) close(pop);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('.pop:not([hidden])').forEach(close);
    });
  })();
</script>
