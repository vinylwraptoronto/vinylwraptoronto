---
/**
 * The three site-wide popups, ported from Elementor templates 18856, 17564
 * and 22055.
 *
 * Opened by any element carrying `data-popup="popup-want-to"` or
 * `data-popup="popup-quote"`. On the live site those triggers are Elementor
 * actions; the visible behaviour is the same.
 */
import QuoteForm from './QuoteForm.astro';
import { wantToPopup, quotePopup, offerPopup } from '../data/popups';
import { img } from '../lib/img';

export interface Props {
  /** The offer popup rides on the page only where a button opens it, which is
      what the original does — 402 posts and one page, not all 676 addresses.
      The other two are triggered from the header, sticky bar and footer, so
      they belong on every page. */
  offer?: boolean;
}
const { offer = false } = Astro.props;
---

<div class="pop" id={wantToPopup.id} hidden role="dialog" aria-modal="true" aria-label={wantToPopup.title}>
  <div class="pop-back" data-close></div>
  <div class="pop-box pop-box--wide">
    <button class="pop-x" type="button" data-close aria-label="Close">&times;</button>
    <h2 class="pop-title">{wantToPopup.title}</h2>
    <div class="pop-cols">
      {wantToPopup.columns.map((col) => (
        <div class="pop-col">
          <h3>{col.heading}</h3>
          <ul>
            {col.links.map((l) => (
              <li>
                <i class="fas fa-chevron-circle-right" aria-hidden="true"></i>
                <a href={img(l.href)}>{l.text}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>

<div class="pop pop--sheet" id={quotePopup.id} hidden role="dialog" aria-modal="true" aria-label={quotePopup.title}>
  <div class="pop-back" data-close></div>
  <div class="pop-box pop-box--sheet">
    <button class="pop-x pop-x--filled" type="button" data-close aria-label="Close">&times;</button>
    <h4 class="pop-title">{quotePopup.title}</h4>
    <QuoteForm variant="popup" id="popup-quote-form" />
    <h4 class="pop-or">{quotePopup.orLabel}</h4>
    <ul class="pop-contacts">
      {quotePopup.contacts.map((c) => (
        <li>
          <a
            class="ic-icon"
            href={img(c.href)}
            tabindex="-1"
            aria-hidden="true"
            rel={c.href.startsWith('http') ? 'noopener' : undefined}
          >
            <i class={c.icon} aria-hidden="true"></i>
          </a>
          <h4 class="ic-title">
            <a href={img(c.href)} rel={c.href.startsWith('http') ? 'noopener' : undefined}>{c.text}</a>
          </h4>
        </li>
      ))}
    </ul>
  </div>
</div>

{offer && (
  <div class="pop" id={offerPopup.id} hidden role="dialog" aria-modal="true" aria-label={offerPopup.title}>
    <div class="pop-back" data-close></div>
    <div class="pop-box">
      <button class="pop-x" type="button" data-close aria-label="Close">&times;</button>
      <h2 class="pop-title">{offerPopup.title}</h2>
      <ul class="offer-tiers">
        {offerPopup.tiers.map((t) => (
          <li>
            <h3>{t.name}</h3>
            <p class="offer-price">
              <s>{t.was}</s> <strong>{t.now}</strong>
            </p>
          </li>
        ))}
      </ul>
      <QuoteForm variant="popup" id="offer-form" products={offerPopup.products} />
    </div>
  </div>
)}

<style>
  .offer-tiers { list-style: none; margin: 0 0 18px; padding: 0; }
  .offer-tiers li { margin-bottom: 12px; }
  .offer-tiers h3 { margin: 0 0 4px; font-size: 16px; }
  .offer-price { margin: 0; font-size: 22px; }
  .offer-price s { color: #9e9e9e; margin-inline-end: 8px; }
  .offer-price strong { color: var(--brand-pink); }

  .pop { position: fixed; inset: 0; z-index: 1000; display: flex; }
  .pop[hidden] { display: none; }
  .pop-back { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6); }

  /* Popup 17564, "Request a Quote". It is not a centred modal on a dimmed page,
     which is what the port built. The live template is a bottom sheet:

       #elementor-popup-modal-17564 { background-color:#F6C10000;
                                      justify-content:center;
                                      align-items:flex-end }
       .dialog-widget-content { background:#FFFFFF; border-radius:5px 5px 0 0;
                                box-shadow:2px 8px 23px 3px rgba(0,0,0,.2) }
       .dialog-message { width:380px }   (100vw below 768px)
       #47c1777 { flex column; gap:10px; padding:35px 10px 10px }

     The overlay colour ends in 00 — it is fully transparent, so the page behind
     is never dimmed. The top-only corner radius is what makes it read as a
     sheet rising from the bottom edge. */
  .pop--sheet { justify-content: center; align-items: flex-end; }
  .pop--sheet .pop-back { background: transparent; }

  .pop-box--sheet {
    margin: 0;
    width: min(380px, 100vw);
    max-height: calc(100vh - 24px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 35px 10px 10px;
    border-radius: 5px 5px 0 0;
    border-bottom: 0;
    box-shadow: 2px 8px 23px 3px rgba(0, 0, 0, 0.2);
  }

  .pop-box {
    position: relative;
    margin: auto;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    background: #fff;
    border-radius: 10px;
    border-bottom: 2px solid var(--e-global-color-a8178e9);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    padding: 26px 26px 30px;
    font-family: 'Poppins', sans-serif;
  }
  /* Popup 18856, "I want to". Every value below is read off the live
     template's own CSS rather than approximated:

       #elementor-popup-modal-18856 .dialog-message { width: 830px }
       .dialog-widget-content { border-radius:10px;
                                box-shadow:2px 8px 23px 3px rgba(0,0,0,.2) }
       #elementor-popup-modal-18856 { background-color: rgba(0,0,0,.8) }
       #5708039 { padding:25px }  (25px 0 0 0 below 768px)

     The 2px green bottom border this used to carry is not in the template at
     all; it was invented. The quote popup (17564) is a different template with
     its own width, radius and placement, so none of this is shared with it. */
  .pop-box--wide {
    width: min(830px, calc(100vw - 32px));
    padding: 25px;
    border-bottom: 0;
    box-shadow: 2px 8px 23px 3px rgba(0, 0, 0, 0.2);
  }
  #popup-want-to .pop-back { background: rgba(0, 0, 0, 0.8); }

  /* Both templates set the close button to 25px; 18856 paints the glyph
     #353535 and leaves it bare. Elementor's own dialog CSS gives it no padding
     — the background, where one is set, hugs the glyph box. */
  .pop-x {
    position: absolute; top: 8px; right: 12px;
    background: none; border: 0; cursor: pointer; padding: 0;
    font-size: 25px; line-height: 1;
    color: var(--e-global-color-f4d2693); /* #353535 */
  }
  .pop-x:hover { color: var(--brand-pink); }

  /* 17564 puts it on a #14A278 ground with a white glyph, inset from the
     panel by 3% / 4% rather than a fixed pixel offset. */
  .pop-x--filled {
    top: 3%; right: 4%;
    display: flex; align-items: center; justify-content: center;
    width: 1em; height: 1em;
    background-color: var(--e-global-color-8c22d81); /* #14A278 */
    color: var(--e-global-color-accent); /* #FFFFFF */
  }
  .pop-x--filled:hover { color: var(--e-global-color-accent); opacity: 0.85; }

  .pop-title {
    font-size: 26px; font-weight: 600; margin: 0 0 18px;
    color: var(--brand-navy); text-transform: none;
  }

  /* #d7bfa34 — centred, uppercase, weight 600, #353535, at the kit's h4 size
     of 18px. The port had it left-aligned, sentence case and navy. */
  .pop-box--sheet .pop-title {
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    font-size: 18px;
    font-weight: 600;
    color: var(--e-global-color-f4d2693); /* #353535 */
  }

  /* #d996c21 — the title is centred, uppercase, weight 500 and pink. Ours was
     left-aligned, sentence case, weight 600 and navy: wrong on all four. */
  .pop-box--wide .pop-title {
    text-align: center;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--e-global-color-f32bb28); /* #FF0099 */
  }

  .pop-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  /* #1a62ace / #ec3a5ba / #a9f6467 — all three column headings are 20px,
     weight 600, navy. Ours were 18px, 500 and green. */
  .pop-col h3 {
    font-size: 20px; font-weight: 600; margin: 0 0 10px;
    color: var(--e-global-color-d077a13); /* #15334C */
    /* Not "none": .elementor-kit-25 h3 capitalizes every h3 site-wide, and
       these headings inherit it — which is why "Get a wrap" reads as
       "Get A Wrap" on the live site. */
    text-transform: capitalize;
  }

  /* #3b3eae4 / #b63873f / #44aa9a7 — identical icon lists: a 14px icon in
     #353535, 15px/400 body-ink text that turns pink on hover, and 5px between
     rows, which Elementor splits either side as calc(5px/2). The icon was
     missing here entirely. */
  .pop-col ul { list-style: none; margin: 0; padding: 0; }
  .pop-col li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 0;
  }
  .pop-col li:not(:last-child) { padding-block-end: calc(5px / 2); }
  .pop-col li:not(:first-child) { margin-block-start: calc(5px / 2); }
  .pop-col li i {
    flex: 0 0 auto;
    font-size: 14px;
    color: var(--e-global-color-f4d2693); /* #353535 */
    transition: color 0.3s;
  }
  .pop-col a {
    color: var(--e-global-color-text); /* #444444 */
    text-decoration: none;
    font-size: 15px;
    font-weight: 400;
    transition: color 0.3s;
  }
  .pop-col li:hover a { color: var(--e-global-color-f32bb28); }

  /* #e76c4aa — an h4 at 14px/600 in #353535, centred, with 10px above it.
     It was a 500-weight body-ink paragraph. */
  .pop-or {
    margin: 10px 0 0;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--e-global-color-f4d2693); /* #353535 */
    text-transform: none;
  }

  /* #2aaba06 — a flex row of three equal icon-boxes, each one a 35px green
     icon stacked above a 10px label, with no gap between them (#34d86b6,
     #089b01c, #e922e17 are identical). The port rendered them as a wrapped row
     of bordered 15px pills with a shared chevron icon. */
  .pop-contacts {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: row;
  }
  .pop-contacts li {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }
  .pop-contacts .ic-icon {
    display: block;
    font-size: 35px;
    line-height: 1;
    color: var(--e-global-color-a8178e9); /* #99CC33 */
    text-decoration: none;
    transition: color 0.3s;
  }
  .pop-contacts .ic-title {
    margin: 0;
    font-size: 10px;
    font-weight: 500;
    text-transform: none;
    color: #000000;
  }
  .pop-contacts .ic-title a { color: inherit; text-decoration: none; }
  /* The live rule is :has(:hover) on the whole box, so hovering the label
     recolours the icon too. */
  .pop-contacts li:hover .ic-icon,
  .pop-contacts li:focus-within .ic-icon {
    color: var(--e-global-color-d077a13); /* #15334C */
  }

  /* #7b930b2 — the form inside this popup is styled by the template, not by
     the site-wide form CSS: 25px pills with a heavier bottom border and no
     left border, and a navy submit that turns pink rather than green. */
  .pop-box--sheet :global(.qform) { gap: 0; }
  .pop-box--sheet :global(.qform .row),
  .pop-box--sheet :global(.qform .checks) { margin-bottom: 12px; padding-inline: 5px; }
  .pop-box--sheet :global(.qform input[type='text']),
  .pop-box--sheet :global(.qform input[type='email']),
  .pop-box--sheet :global(.qform input[type='tel']),
  .pop-box--sheet :global(.qform select),
  .pop-box--sheet :global(.qform textarea) {
    font-size: 14px;
    color: #000000;
    background-color: #ffffff;
    border-color: #c7c7c7;
    border-width: 1px 1px 2px 0;
    border-style: solid;
    border-radius: 25px;
  }
  .pop-box--sheet :global(.qform .qbtn) {
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    border-radius: 25px;
    background-color: var(--e-global-color-d077a13); /* #15334C */
    color: #ffffff;
  }
  .pop-box--sheet :global(.qform .qbtn:hover) {
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .pop-cols { grid-template-columns: 1fr; gap: 18px; }
    .pop-title { font-size: 22px; }
    /* #5708039 drops its side and bottom padding on mobile. */
    .pop-box--wide { padding: 25px 0 0; }
    /* Both templates restate .dialog-message below 768px: 18856 narrows to a
       fixed 300px, 17564 goes edge to edge. */
    .pop-box--wide { width: min(300px, calc(100vw - 32px)); }
    .pop-box--sheet { width: 100vw; }
  }
</style>

<script>
  (() => {
    let lastFocus: HTMLElement | null = null;

    const open = (id: string) => {
      const pop = document.getElementById(id);
      if (!pop) return;
      lastFocus = document.activeElement as HTMLElement;
      pop.hidden = false;
      document.body.style.overflow = 'hidden';
      pop.querySelector<HTMLElement>('input,button,a')?.focus();
    };

    const close = (pop: HTMLElement) => {
      pop.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;

      const trigger = t.closest<HTMLElement>('[data-popup]');
      if (trigger) {
        e.preventDefault();
        open(trigger.dataset.popup!);
        return;
      }

      if (t.closest('[data-close]')) {
        const pop = t.closest<HTMLElement>('.pop');
        if (pop) close(pop);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('.pop:not([hidden])').forEach(close);
    });
  })();
</script>
