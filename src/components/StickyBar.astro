---
/**
 * Floating bottom CTA bar — the `sticky: "bottom"` element in footer template
 * 18407. It fades up (fadeInUp) 1000ms after load on the live site and carries two
 * actions: call for an estimate, and open the Request a Quote popup.
 *
 * Every value below is read off the template's own CSS rather than eyeballed.
 * The shape is a pill, not a full-width strip: an inner container (#1bf9457)
 * on a 49deg navy-to-green gradient, rounded at the top corners only, with a
 * drop shadow, sitting inside a wrapper (#b853c7a) that is 30% of the viewport
 * on desktop and 70% on tablet. The port had it as a full-bleed bar with two
 * square buttons, which is why it read as a different component entirely.
 */
import { site } from '../data/site';
---

<div class="sb-wrap" data-sticky-bar role="region" aria-label="Quick contact">
  <div class="sb-pill">
    <!-- #556696d — transparent over the gradient, so it reads navy at the
         left end; the label sits above the number at 10px. -->
    <a class="sb-btn sb-btn--call" href={site.phoneHref}>
      <i class="sb-ic fas fa-phone-alt" aria-hidden="true"></i>
      <span class="sb-txt">
        <span class="sb-lead">Get an Estimate</span><br />{site.phone}
      </span>
    </a>
    <!-- #89ec862 — filled navy. -->
    <button class="sb-btn sb-btn--msg" type="button" data-popup="popup-quote">
      <i class="sb-ic far fa-paper-plane" aria-hidden="true"></i>
      <span class="sb-txt">Send a Message</span>
    </button>
  </div>
</div>

<style>
  /* #b853c7a — the wrapper is only as wide as its content width, centred, and
     transparent: the white background it carries on the live site is the page
     behind it, not part of the bar. */
  /* sticky, not fixed. The live bar is not pinned for the whole page: it has a
     home at the footer's top edge and settles into it once the page scrolls
     that far, which is why the original never covers the footer. Measured on
     the homepage: pinned at viewport bottom through scroll 5490, in flow at
     its own 6387 by 5690, and scrolled off the top like any other element by
     the end of the page.

     `sticky` with `bottom: 0` is that behaviour natively -- held at the
     viewport bottom while its own place in the flow is still below, released
     the moment the flow catches up. It needs the element to be IN the flow, so
     the centring is `margin-inline: auto` rather than the left/translateX pair
     a fixed box needs, and it needs no ancestor to be a scroll container (see
     the note on body's overflow in global.css). */
  .sb-wrap {
    position: sticky;
    bottom: 0;
    /* Below the header's 100, which is how the original keeps the two apart.
       It does it with two elements: a fixed clone at z-index 99 -- the same as
       its header -- while the bar is pinned, and an in-flow original at
       z-index auto once it comes to rest above the footer. Those never
       conflict, because the pinned copy sits on the viewport floor, below
       anything the menu panel can reach, and the resting copy is at 0 so the
       header and the open menu paint straight over it.

       This is one sticky element rather than two, so it needs one number that
       holds in both states, and below the header is that number: pinned it
       still floats over the page, and at rest the open menu covers it as the
       original's does. At 900 it was above the header, so the menu opened
       underneath it and the bar drew across the middle of the menu. */
    z-index: 99;
    width: 30%;
    margin-inline: auto;
    /* fadeInUp, 1000ms delay — matches the live animation. Revealed via
       clip-path rather than opacity: fading the whole wrap's opacity blends
       the pill's white text AND navy background together against the page
       behind it, which measured as low as ~1.03:1 composited contrast on
       .sb-btn--msg partway through the 450ms transition (below the 4.5:1 AA
       minimum for normal text) before recovering at full opacity. A clip
       reveal shows progressively more of the already fully-opaque pill
       instead of a partially-transparent blend, so every visible pixel is
       always at final (passing) contrast — same slide-up motion and the
       same settled look, without the transient dip. */
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
  }
  /* Then Elementor's own entrance: `fadeInUp` from animate.css, which rises
     the bar by its full height while fading it in, over the 1.25s Elementor
     gives every `.animated` element. A keyframe animation rather than a
     transition, so it plays once when the attribute lands and nothing that
     happens afterwards -- scrolling, the bar settling above the footer --
     can set it off again. Transform and opacity only, so nothing around the
     bar moves while it plays. Before this it was a 14px, 0.45s transition,
     too slight to read as the original's entrance at all. */
  .sb-wrap[data-shown] {
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
    animation: sb-fade-in-up 1.25s both;
  }
  /* Stood aside while it would paint over a control that opted in with
     `data-sb-avoid` (the dark /contact/ form's submit button; see the script
     below). `opacity` plus `inert`, not display: the bar keeps its box, so nothing
     around it moves and its sticky release point is untouched. */
  .sb-wrap[data-sb-yield] { opacity: 0; pointer-events: none; }
  @keyframes sb-fade-in-up {
    /* No opacity ramp: see the clip-path note above -- a partially
       transparent pill measured below 4.5:1 contrast mid-fade. */
    from { transform: translate3d(0, 100%, 0); }
    to { transform: none; }
  }

  /* #1bf9457 */
  .sb-pill {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 5px 20px;
    padding: 8px 10px 5px;
    border-radius: 25px 25px 0 0;
    box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.5);
    background-image: linear-gradient(
      49deg,
      var(--e-global-color-d077a13) 0%,
      var(--e-global-color-8c22d81) 100%
    );
  }

  /* Both buttons are "align: justify" widgets at 47% of the pill, so the
     anchor fills its share and centres its own content. */
  .sb-btn {
    width: 47%;
    max-width: 47%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1em;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    border-style: solid;
    border-color: var(--e-global-color-a8178e9); /* #99CC33 */
    border-radius: 25px;
    cursor: pointer;
    /* 0.3s, as every button on the original has. */
    transition: all 0.3s ease;
  }
  .sb-ic { margin-inline-end: 8px; }

  /* #556696d — no top border, and the text carries a shadow so it stays
     legible against the gradient it lets through. */
  .sb-btn--call {
    background-color: transparent;
    border-width: 0 3px 3px 0;
    padding: 0 15px 5px;
    text-shadow: 0 0 10px #020101;
  }
  .sb-lead { font-size: 10px; }

  /* #89ec862 */
  .sb-btn--msg {
    background-color: var(--e-global-color-d077a13);
    border-width: 1px 3px 3px 0;
    padding: 8px 15px;
  }

  .sb-btn:hover,
  .sb-btn:focus-visible {
    background-color: var(--e-global-color-a8178e9);
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .sb-wrap { width: 70%; }
  }
  @media (max-width: 767px) {
    .sb-wrap { width: 100%; }
    .sb-pill { gap: 5px 10px; border-radius: 10px 10px 0 0; }
    .sb-btn { width: 48%; max-width: 48%; font-size: 14px; }
    .sb-btn--call { padding: 5px 10px; }
    .sb-btn--msg { padding: 10px; }
  }

  /* Elementor's own frontend drops `.animated` to `animation: none` for this
     preference too; the bar simply appears. */
  @media (prefers-reduced-motion: reduce) {
    .sb-wrap[data-shown] { animation: none; }
  }
</style>

{/* The mobile /blog/ target-size collision (axe 2.5.8) first looked like a
    sticky-positioning overlap -- `.sb-wrap` is `position: sticky; bottom: 0`,
    so at scroll 0 its 56px pill paints fixed over the viewport's bottom 56px
    regardless of flow space further down the document, and padding/margin
    added after the colliding card can't move that card's already-rendered
    rect, so that class of fix was rejected. The actual root cause was a
    pre-load layout collapse of the colliding card's own thumbnail image
    (`.cards img { aspect-ratio: auto }` in Blocks.astro, fixed there) that
    had nothing to do with this component.

    A second, distinct collision surfaced under real keyboard traversal
    (sticky-keyboard-closeout-20261003): once the thumbnail-collapse bug
    above was fixed, axe's static scroll=0 snapshot was clean, but a real
    Tab to the 3rd /blog/ card's title still ended with the browser's own
    native focus-scroll settling that card's rect (bottom 810.88) 22.88px
    into the pill's own band (top 788, mobile 390x844) -- the UA scrolls a
    newly-focused element to the edge of what it believes is the visible
    viewport, and it has no way to know this sticky pill paints over the
    bottom of that viewport once pinned, since the pill is laid out in-flow
    and only visually pinned via `position: sticky`.

    `scroll-padding-bottom` on the scrolling box is the platform's own
    answer to exactly this: it is read by the browser's native
    scroll-into-view/focus-scroll algorithm (not just CSS scroll-snap) as
    extra inset to keep clear at that edge, so a focused element is settled
    above the reserved band instead of under it -- no bottom padding is
    added to any card, list, or the document's static layout, and nothing
    about already-rendered card rects changes; only where the browser
    chooses to park a focused element changes. Measured pill heights at the
    two viewports actually tested: 56px (390x844 mobile), 55px (1440x900
    desktop). 72px covers both measured cases with a small buffer for
    sub-pixel layout rounding across browsers; kept as one native value
    rather than threaded through the component's own width breakpoints since
    scroll-padding only affects where native scrolling parks a focused
    element, not any paintable geometry, so slight over-reservation is
    inert. Verified by `scripts/keyboard-sticky-blog-check.mjs` (real
    Tab/Shift+Tab, not `.focus()`) across mobile 390x844 and desktop
    1440x900 only; untested breakpoints are not claimed. */}
<style is:global>
  html { scroll-padding-bottom: 72px; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  if (bar) {
    window.setTimeout(() => bar.setAttribute('data-shown', ''), 1000);

    // Contextual accommodation: the pill is pinned over the viewport's bottom
    // band, so at some viewport heights a control parks under it at scroll 0
    // (the /contact/ dark form's submit does, on roughly 750-840px tall
    // phones). No fixed margin avoids that at every height, so a control that
    // sets `data-sb-avoid` is measured against the pill's real rect and the
    // pill steps aside only while the two actually overlap. Pages without such
    // a control never run any of this.
    const guarded = Array.from(document.querySelectorAll<HTMLElement>('[data-sb-avoid]'));
    const pill = bar.querySelector<HTMLElement>('.sb-pill');
    if (guarded.length && pill) {
      let frame = 0;
      const update = () => {
        frame = 0;
        if (!bar.hasAttribute('data-shown')) return;
        const p = pill.getBoundingClientRect();
        const hit = guarded.some((el) => {
          const r = el.getBoundingClientRect();
          return r.bottom > p.top + 0.5 && r.top < p.bottom - 0.5 &&
                 r.right > p.left + 0.5 && r.left < p.right - 0.5 &&
                 r.bottom > 0 && r.top < innerHeight;
        });
        bar.toggleAttribute('data-sb-yield', hit);
        bar.toggleAttribute('inert', hit);
      };
      const queue = () => { if (!frame) frame = requestAnimationFrame(update); };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      window.visualViewport?.addEventListener('resize', queue);
      // Late layout shifts (fonts, images) move the control without a scroll.
      if ('ResizeObserver' in window) new ResizeObserver(queue).observe(document.body);
      // The pill's rect is only final once its entrance animation has ended.
      bar.addEventListener('animationend', queue);
      window.setTimeout(queue, 2400);
    }
  }
</script>
