---
/**
 * Floating bottom CTA bar — the `sticky: "bottom"` element in footer template
 * 18407. It fades up 1000ms after load on the live site and carries two
 * actions: call for an estimate, and open the Request a Quote popup.
 *
 * Every value below is read off the template's own CSS rather than eyeballed.
 * The shape is a pill, not a full-width strip: an inner container (#1bf9457)
 * on a 49deg navy-to-green gradient, rounded at the top corners only, with a
 * drop shadow, sitting inside a wrapper (#b853c7a) that is 30% of the viewport
 * on desktop and 70% on tablet. The port had it as a full-bleed bar with two
 * square buttons, which is why it read as a different component entirely.
 */
import { site } from '../data/site';
---

<div class="sb-wrap" data-sticky-bar role="region" aria-label="Quick contact">
  <div class="sb-pill">
    <!-- #556696d — transparent over the gradient, so it reads navy at the
         left end; the label sits above the number at 10px. -->
    <a class="sb-btn sb-btn--call" href={site.phoneHref}>
      <i class="sb-ic fas fa-phone-alt" aria-hidden="true"></i>
      <span class="sb-txt">
        <span class="sb-lead">Get an Estimate</span><br />{site.phone}
      </span>
    </a>
    <!-- #89ec862 — filled navy. -->
    <button class="sb-btn sb-btn--msg" type="button" data-popup="popup-quote">
      <i class="sb-ic far fa-paper-plane" aria-hidden="true"></i>
      <span class="sb-txt">Send a Message</span>
    </button>
  </div>
</div>

<style>
  /* #b853c7a — the wrapper is only as wide as its content width, centred, and
     transparent: the white background it carries on the live site is the page
     behind it, not part of the bar. */
  /* sticky, not fixed. The live bar is not pinned for the whole page: it has a
     home at the footer's top edge and settles into it once the page scrolls
     that far, which is why the original never covers the footer. Measured on
     the homepage: pinned at viewport bottom through scroll 5490, in flow at
     its own 6387 by 5690, and scrolled off the top like any other element by
     the end of the page.

     `sticky` with `bottom: 0` is that behaviour natively -- held at the
     viewport bottom while its own place in the flow is still below, released
     the moment the flow catches up. It needs the element to be IN the flow, so
     the centring is `margin-inline: auto` rather than the left/translateX pair
     a fixed box needs, and it needs no ancestor to be a scroll container (see
     the note on body's overflow in global.css). */
  .sb-wrap {
    position: sticky;
    bottom: 0;
    /* Below the header's 100, which is how the original keeps the two apart.
       It does it with two elements: a fixed clone at z-index 99 -- the same as
       its header -- while the bar is pinned, and an in-flow original at
       z-index auto once it comes to rest above the footer. Those never
       conflict, because the pinned copy sits on the viewport floor, below
       anything the menu panel can reach, and the resting copy is at 0 so the
       header and the open menu paint straight over it.

       This is one sticky element rather than two, so it needs one number that
       holds in both states, and below the header is that number: pinned it
       still floats over the page, and at rest the open menu covers it as the
       original's does. At 900 it was above the header, so the menu opened
       underneath it and the bar drew across the middle of the menu. */
    z-index: 99;
    width: 30%;
    margin-inline: auto;
    /* fadeInUp, 1000ms delay — matches the live animation. Revealed via
       clip-path rather than opacity: fading the whole wrap's opacity blends
       the pill's white text AND navy background together against the page
       behind it, which measured as low as ~1.03:1 composited contrast on
       .sb-btn--msg partway through the 450ms transition (below the 4.5:1 AA
       minimum for normal text) before recovering at full opacity. A clip
       reveal shows progressively more of the already fully-opaque pill
       instead of a partially-transparent blend, so every visible pixel is
       always at final (passing) contrast — same slide-up motion and the
       same settled look, without the transient dip. */
    transform: translateY(14px);
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    transition: clip-path 0.45s ease, transform 0.45s ease;
  }
  .sb-wrap[data-shown] {
    clip-path: inset(0 0 0 0);
    transform: none;
    pointer-events: auto;
  }

  /* #1bf9457 */
  .sb-pill {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 5px 20px;
    padding: 8px 10px 5px;
    border-radius: 25px 25px 0 0;
    box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.5);
    background-image: linear-gradient(
      49deg,
      var(--e-global-color-d077a13) 0%,
      var(--e-global-color-8c22d81) 100%
    );
  }

  /* Both buttons are "align: justify" widgets at 47% of the pill, so the
     anchor fills its share and centres its own content. */
  .sb-btn {
    width: 47%;
    max-width: 47%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1em;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    border-style: solid;
    border-color: var(--e-global-color-a8178e9); /* #99CC33 */
    border-radius: 25px;
    cursor: pointer;
    /* 0.3s, as every button on the original has. */
    transition: all 0.3s ease;
  }
  .sb-ic { margin-inline-end: 8px; }

  /* #556696d — no top border, and the text carries a shadow so it stays
     legible against the gradient it lets through. */
  .sb-btn--call {
    background-color: transparent;
    border-width: 0 3px 3px 0;
    padding: 0 15px 5px;
    text-shadow: 0 0 10px #020101;
  }
  .sb-lead { font-size: 10px; }

  /* #89ec862 */
  .sb-btn--msg {
    background-color: var(--e-global-color-d077a13);
    border-width: 1px 3px 3px 0;
    padding: 8px 15px;
  }

  .sb-btn:hover,
  .sb-btn:focus-visible {
    background-color: var(--e-global-color-a8178e9);
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .sb-wrap { width: 70%; }
  }
  @media (max-width: 767px) {
    .sb-wrap { width: 100%; }
    .sb-pill { gap: 5px 10px; border-radius: 10px 10px 0 0; }
    .sb-btn { width: 48%; max-width: 48%; font-size: 14px; }
    .sb-btn--call { padding: 5px 10px; }
    .sb-btn--msg { padding: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-wrap { transition: none; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  if (bar) window.setTimeout(() => bar.setAttribute('data-shown', ''), 1000);
</script>
