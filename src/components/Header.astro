---
/**
 * Header — port of Elementor template 18399.
 *
 * Two distinct layouts, as on the live site:
 *
 *  > 1024px  horizontal bar with hover dropdowns
 *  <= 1024px burger toggle opening a full-width vertical panel whose
 *            sub-levels expand inline
 *
 * The breakpoint is not a guess: the live nav widget carries
 * `elementor-nav-menu--dropdown-tablet`, which is Elementor for "use the
 * dropdown from the tablet breakpoint down" — 1024px. Getting this wrong is
 * what left the staging header showing a wrapped horizontal bar at widths
 * where the original shows the panel.
 *
 * The menu is three levels deep (Vehicle Wraps > Car Wraps > Full Wrap), so
 * both layouts render it recursively rather than flattening it.
 */
import navData from '../data/nav.json';
import { site, type NavItem } from '../data/site';
import { img } from '../lib/img';

const nav = navData as NavItem[];
const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href !== '#' &&
  // "/" must match only the homepage itself, never every page by prefix — but
  // it does have to match it, or Home never shows as the current row.
  (href === '/' ? pathname === '/' : pathname.startsWith(href));
/** A branch counts as current when it or anything beneath it is the page. */
const branchCurrent = (item: NavItem): boolean =>
  isCurrent(item.href) || item.children.some(branchCurrent);
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <img
        src={img(site.logo.src)}
        alt={site.logo.alt}
        width={site.logo.width}
        height={site.logo.height}
        fetchpriority="high"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li class={item.children.length > 0 ? 'has-sub' : ''}>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              aria-haspopup={item.children.length > 0 ? 'true' : undefined}
            >
              {item.text}
              {item.children.length > 0 && <i class="caret fas fa-caret-down" aria-hidden="true"></i>}
            </a>
            {item.children.length > 0 && (
              <ul class={`sub${item.children.length > 12 ? ' sub--wide' : ''}`}>
                {item.children.map((c) => (
                  <li class={c.children.length > 0 ? 'has-sub2' : ''}>
                    <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                      {c.text}
                      {c.children.length > 0 && <i class="caret caret--right fas fa-caret-down" aria-hidden="true"></i>}
                    </a>
                    {c.children.length > 0 && (
                      <ul class="sub2">
                        {c.children.map((g) => (
                          <li>
                            <a href={g.href} aria-current={isCurrent(g.href) ? 'page' : undefined}>
                              {g.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- #676171b1 .elementor-menu-toggle — pink, green on hover; becomes an X -->
    <button class="toggle" type="button" aria-expanded="false" aria-controls="panel-nav" aria-label="Menu Toggle">
      <span class="toggle-bars" aria-hidden="true"></span>
    </button>

    <!-- #6ebf65a — the third and last header column: navy, green on hover,
         holding the #76c5194 button that opens popup 18856. This column is the
         "I want to" control; the live header carries no phone CTA at all. -->
    <div class="wantto-col">
      <button class="wantto" type="button" data-popup="popup-want-to">I want to</button>
    </div>
  </div>

  <!-- The panel menu: full-width rows, sub-levels expand inline. -->
  <nav id="panel-nav" class="panel" hidden aria-label="Menu">
    <ul>
      {nav.map((item) => (
        <li class={branchCurrent(item) ? 'open' : ''}>
          <div class="prow">
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.text}</a>
            {item.children.length > 0 && (
              <button class="pexp" type="button" aria-expanded={branchCurrent(item) ? 'true' : 'false'} aria-label={`Toggle ${item.text}`}></button>
            )}
          </div>
          {item.children.length > 0 && (
            <ul class="plevel2">
              {item.children.map((c) => (
                <li class={branchCurrent(c) ? 'open' : ''}>
                  <div class="prow">
                    <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.text}</a>
                    {c.children.length > 0 && (
                      <button class="pexp" type="button" aria-expanded={branchCurrent(c) ? 'true' : 'false'} aria-label={`Toggle ${c.text}`}></button>
                    )}
                  </div>
                  {c.children.length > 0 && (
                    <ul class="plevel3">
                      {c.children.map((g) => (
                        <li>
                          <div class="prow">
                            <a href={g.href} aria-current={isCurrent(g.href) ? 'page' : undefined}>{g.text}</a>
                          </div>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* #9a5dc73 — the header bar, sticky:top at every breakpoint. */
  .site-header {
    background-color: #ffffff;
    border-style: solid;
    border-width: 0 0 2px 0;
    border-color: var(--e-global-color-a8178e9); /* #99CC33 */
    box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.5);
    position: sticky;
    top: 0;
    z-index: 100;
    /* Goes away on the way down, comes back on the way up. The original
       animates its own `top` between 0 and -200px over 0.4s; done here as a
       transform so the sticky positioning underneath is left alone.

       -200 rather than the header's own 68px because that is the original's
       value, and the extra clears the box shadow along with the bar. */
    transition: transform 0.4s;
  }
  .site-header[data-hidden] { transform: translateY(-200px); }
  /* The header still gets out of the way, it just does not slide there. */
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }

  /* Stretched full width on the live site, not clamped to the content column.

     10px top and bottom: the original's header is 68px tall with a 66px
     container around 46px nav links, and this had no vertical padding at all,
     so the bar came out 48px. 20px short on every one of the 678 addresses,
     and the most-multiplied single difference on the site. */
  .bar { width: 100%; display: flex; align-items: center; gap: 0; padding: 10px 0; }

  /* The column is 12% — 173px at 1440, which is what the original's logo
     column measures — but the logo inside it renders at 153px there, not the
     full width of its column. Ours filled the column and came out 169x37
     against the original's 153x33. */
  .brand { width: 12%; display: block; text-align: start; }
  .brand img { width: 100%; max-width: 153px; height: auto; display: block; }

  .nav { width: 78%; margin: 0 35px 0 0; }

  /* Child combinators throughout: `.nav ul` would also match ul.sub inside it,
     out-specify the rule that hides the submenu, and the dropdown would never
     close. */
  .nav > ul {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav > ul > li { position: relative; }

  .nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    /* 10px, measured. The original wraps its caret in a `.sub-arrow` span that
       carries the spacing itself; the port has no such span, so the gap lives
       here instead. It was 6px, which with the undersized caret below made
       every top-level item ~6.5px narrower than the original's. */
    gap: 10px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--e-global-color-d077a13); /* #15334C */
    padding: 13px 10px;
  }
  .nav > ul > li > a:hover,
  .nav > ul > li > a[aria-current='page'] { color: var(--e-global-color-f32bb28); }

  /* Was a border-drawn triangle, because the port shipped no icon font. The
     original uses fa-caret-down / fa-caret-right.

     No font-size: the original's caret inherits the nav link's 16px and draws
     10px wide. The 12px here was left over from the triangle era, when the size
     was chosen rather than measured, and it survived the switch to the real
     glyph -- so every caret on the site rendered a quarter under size. */
  .caret { line-height: 1; }
  .caret--right {
    margin-left: auto;
  }

  /* The submenu sits 14px below its trigger; ::before bridges that gap so the
     pointer does not leave the chain on the way down. */
  .sub, .sub2 {
    position: absolute;
    display: none;
    min-width: 260px;
    list-style: none;
    padding: 0;
    background: #ffffff;
    border-style: solid;
    border-width: 0 0 2px 0;
    border-color: var(--e-global-color-a8178e9);
    border-radius: 10px;
    box-shadow: 5px 5px 5px 0 rgba(0, 0, 0, 0.36);
    z-index: 10;
  }
  .sub { top: 100%; left: 0; margin-top: 14px; }
  .sub::before { content: ''; position: absolute; top: -14px; left: 0; right: 0; height: 14px; }
  .sub2 { top: 0; left: 100%; }

  /* :has(a:focus-visible) rather than :focus-within — :focus-within also
     matches a mouse click on the trigger and latches the menu open. */
  .nav > ul > li.has-sub:hover > .sub,
  .nav > ul > li.has-sub:has(a:focus-visible) > .sub { display: block; }
  .sub > li.has-sub2:hover > .sub2,
  .sub > li.has-sub2:has(a:focus-visible) > .sub2 { display: block; }

  .sub--wide { column-count: 3; column-gap: 0; min-width: 720px; }
  .sub--wide > li { break-inside: avoid; }
  /* A flyout cannot be laid out inside a CSS column, so those rows open inline. */
  .sub--wide > li.has-sub2 > .sub2 {
    position: static;
    display: block;
    box-shadow: none;
    border: 0;
    border-radius: 0;
    min-width: 0;
    padding-inline-start: 14px;
  }
  .sub--wide > li.has-sub2 > .sub2 > li > a { font-size: 14px; color: var(--ink); }
  .sub--wide .caret--right { display: none; }

  .nav > ul > li > .sub > li:not(:last-child) { border-bottom: 1px solid #f2f2f2; }

  .sub li > a {
    display: flex;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    text-transform: none;
    text-decoration: none;
    color: var(--e-global-color-f4d2693); /* #353535 */
    padding: 10px 16px;
  }
  .sub li > a:hover { color: #fff; background-color: var(--e-global-color-f32bb28); }
  .sub li > a[aria-current='page'] { color: #fff; background-color: var(--e-global-color-8c22d81); }

  .sub > li:first-child > a { border-top-left-radius: 10px; border-top-right-radius: 10px; }
  .sub > li:last-child > a { border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; }

  /* #6ebf65a — navy column, green on hover, padding 0 */
  .wantto-col {
    width: 9.664%;
    background-color: var(--e-global-color-d077a13); /* #15334C */
    align-self: stretch;
    display: flex;
    padding: 0;
  }
  .wantto-col:hover { background-color: var(--e-global-color-a8178e9); /* #99CC33 */ }

  /* #76c5194 — transparent button so the column colour shows through */
  .wantto {
    width: 100%;
    background-color: #ff009900;
    border: 0;
    border-radius: 0;
    color: var(--e-global-color-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    /* .elementor-button{line-height:1}, not 16px on a 1.3 ratio */
    font-size: 15px;
    line-height: 1;
    padding: 12px 10px;
    text-align: center;
    cursor: pointer;
    white-space: nowrap;
  }
  .wantto:hover { background-color: #99cc3300; }

  /* burger toggle — pink, green on hover, becomes an X when open */
  .toggle {
    display: none;
    margin-left: auto;
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
    color: #fff;
    border: 0;
    cursor: pointer;
    /* 51x51 with a 3px radius in the tablet band, 45x45 with 5px below 768 —
       both measured off the original, which changes them at its own mobile
       breakpoint. The port had one 56px square with square corners. */
    width: 51px;
    height: 51px;
    border-radius: 3px;
    position: relative;
  }
  /* Pink at rest, green on hover AND focus. Clicking to open the panel leaves
     focus on the button, which is why the original shows a green burger for as
     long as the menu is open. */
  .toggle:hover,
  .toggle:focus { background-color: var(--e-global-color-a8178e9); }
  .toggle-bars,
  .toggle-bars::before,
  .toggle-bars::after {
    position: absolute;
    left: 50%;
    width: 26px;
    height: 3px;
    margin-left: -13px;
    background: currentColor;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .toggle-bars { top: 50%; margin-top: -1.5px; }
  .toggle-bars::before { content: ''; margin-top: -9px; }
  .toggle-bars::after { content: ''; margin-top: 9px; }
  .toggle[aria-expanded='true'] .toggle-bars { background: transparent; }
  .toggle[aria-expanded='true'] .toggle-bars::before { margin-top: 0; transform: rotate(45deg); }
  .toggle[aria-expanded='true'] .toggle-bars::after { margin-top: 0; transform: rotate(-45deg); }

  /* --- panel menu ------------------------------------------------------- */
  .panel { display: none; }
  .panel ul { list-style: none; margin: 0; padding: 0; }

  /* One row, label and caret centred together as a pair.

     The original's row is a single full-width anchor, `display: flex`, with its
     caret as the last child inside it -- so the two read as one centred group
     and any background covers the whole row. The port had the caret in a
     separate 52px cell divided off by a rule down the right-hand side, which
     is the most visible difference between the two panels. */
  .prow {
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #f2f2f2;
  }
  /* Sized to its text rather than filling the row, so the caret sits against
     the label instead of being pushed to the far edge. The row's states are on
     .prow below, which is what keeps them full-width. */
  .prow > a {
    flex: 0 1 auto;
    padding: 10px 16px;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    /* A flat 20px, which is what the original's nav items compute to at both
       of its sizes — so the row is exactly 40px here and 30px below 768. The
       inherited body 1.5 made it 33px and 24px, and the whole panel a fifth
       taller than the original's. */
    line-height: 20px;
    text-align: center;
    text-decoration: none;
    color: var(--e-global-color-f4d2693); /* #353535 */
  }
  /* The original's `.sub-arrow` is 20px wide, transparent, and carries no
     border of its own. Kept as a button rather than folded into the anchor:
     the original makes a parent item a non-link that only expands, and a
     separate control keeps the child pages reachable by keyboard. */
  .pexp {
    width: 20px;
    align-self: stretch;
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
    color: inherit;
  }
  .pexp::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    margin: -3px 0 0 -5px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid currentColor;
    transition: transform 0.18s ease;
  }
  .pexp[aria-expanded='true']::after { transform: rotate(180deg); }

  /* Current page reads green; an opened branch reads pink — as on the live
     panel, where HOME sits green and an expanded VEHICLE WRAPS sits pink.

     On the row, not the anchor. The anchor is only as wide as its label now, so
     a background there would paint a stripe behind the words instead of the
     full-width band the original draws. */
  .panel li.open > .prow,
  .prow:hover {
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
  }
  .panel li.open > .prow > a,
  .panel li.open > .prow > .pexp,
  .prow:hover > a,
  .prow:hover > .pexp { color: #fff; }

  /* The current page stays green through both of those — last, and outweighing
     them. It has to be: the branch holding the current page is marked `open` so
     it comes already expanded, which on the home page means HOME itself, and
     the pink then painted over its green. The original resolves it the same
     way round, its active rule following its hover rule at equal weight, so
     hovering the page you are on leaves it green. */
  .panel li > .prow:has(> a[aria-current='page']) {
    background-color: var(--e-global-color-8c22d81); /* #14A278 */
  }
  .panel li > .prow:has(> a[aria-current='page']) > a,
  .panel li > .prow:has(> a[aria-current='page']) > .pexp { color: #fff; }

  /* Top-level panel rows are uppercase on the live site; the two nested levels
     stay in title case. */
  .panel > ul > li > .prow > a { text-transform: uppercase; }

  .plevel2, .plevel3 { display: none; }
  .panel li.open > .plevel2,
  .panel li.open > .plevel3 { display: block; }
  .plevel2 .prow > a { font-weight: 400; }
  .plevel3 .prow > a { font-weight: 400; font-size: 15px; color: var(--ink); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* Elementor's tablet breakpoint: the widget is dropdown-tablet, so the panel
     takes over from 1024px down. */
  /* Column widths at the tablet breakpoint come from the live template:
     logo 30%, nav 50%, "I want to" 20%. The burger takes the nav column's
     place and sits at its right edge, which is where the original puts it. */
  @media (max-width: 1024px) {
    .nav { display: none; }
    /* The live nav widget keeps `margin: 0 35px 0 0` at this breakpoint, which
       is the gap between the burger and the navy "I want to" column. Without it
       the two sit flush against each other. */
    .toggle { display: block; margin-left: auto; margin-right: 35px; }
    /* Viewport units, not a pixel cap. Below 1024 the original's logo tracks
       the viewport: 210px at 768, 250 at 900, 287 at 1024 -- a flat 28vw. The
       port had a 153px ceiling on the image and a 260px one on its column, so
       it held one size across the whole band and drew 153 where the original
       draws 287.

       This is the trap the clone procedure warns about in as many words: a
       rebuild reaches for px, Elementor emits vw, and the two agree at exactly
       the one width somebody checked. */
    /* No vertical padding: the space above and below the logo is the header
       row's, not the logo column's. The 6px a side here was making every
       collapsed header 12px taller than the original's. */
    .brand { width: auto; max-width: none; padding: 0 0 0 14px; }
    .brand img { width: 28vw; max-width: none; }
    .wantto-col { width: 20%; }
    .panel { display: block; background: #fff; }
    .panel[hidden] { display: none; }
  }

  /* The live template drops that margin to 0 at the mobile breakpoint, where
     the space is needed for the logo. */
  @media (max-width: 767px) {
    .toggle { margin-right: 0; width: 45px; height: 45px; border-radius: 5px; }
    /* The panel tightens with it: the original's rows go from 40px to 30px
       here, on 5px of padding and 15px text. */
    .prow > a { padding: 5px 16px; font-size: 15px; }
    /* The column carries elementor-hidden-mobile, so below 768px the original
       shows logo + burger only. The port kept it visible, pushing the burger
       ~145px inward and squeezing the logo. */
    .wantto-col { display: none; }
    /* With the "I want to" column gone the logo takes the room, as it does on
       the original: 245px at 390 and 306 at 480, which is 63vw. */
    .brand { padding-left: 10px; }
    .brand img { width: 63vw; }
  }

</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const panel = document.querySelector<HTMLElement>('#panel-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  /* Hide on the way down, show on the way up — the original's sticky header
     effect. Measured on it: no threshold in either direction, so the first
     40px of downward scroll takes it away and the first upward movement
     brings it straight back, and it is always shown at the very top.

     The open menu is deliberately not a special case. On the original the
     panel lives inside the header and slides with it, staying open the whole
     time, and it comes back the moment you scroll up. */
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    let last = window.scrollY;
    let queued = false;
    const apply = () => {
      queued = false;
      const y = window.scrollY;
      if (y <= 0 || y < last) header.removeAttribute('data-hidden');
      else if (y > last) header.setAttribute('data-hidden', '');
      last = y;
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(apply);
    }, { passive: true });
  }

  // Sub-levels expand in place, as on the live panel.
  document.querySelectorAll<HTMLButtonElement>('.pexp').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.closest('li');
      if (!li) return;
      const open = li.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
