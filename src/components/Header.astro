---
/**
 * Header — port of Elementor template 18399.
 *
 * Every rule below is traceable to an element id in that template; the ids are
 * cited in comments so a re-port after a redesign is a diff, not a rediscovery.
 */
import navData from '../data/nav.json';
import { site, type NavItem } from '../data/site';

const nav = navData as NavItem[];
const { pathname } = Astro.url;
const isCurrent = (href: string) => href !== '#' && href !== '/' && pathname.startsWith(href);
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <img
        src={site.logo.src}
        alt={site.logo.alt}
        width={site.logo.width}
        height={site.logo.height}
      />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li class={item.sub.length > 0 ? 'has-sub' : ''}>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              aria-haspopup={item.sub.length > 0 ? 'true' : undefined}
            >
              {item.text}
              {item.sub.length > 0 && <span class="caret" aria-hidden="true"></span>}
            </a>
            {item.sub.length > 0 && (
              <ul class={`sub${item.sub.length > 12 ? ' sub--wide' : ''}`}>
                {item.sub.map((s) => (
                  <li>
                    <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
                      {s.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- #6ebf65a — CTA column: navy, turns green on hover -->
    <div class="cta">
      <a class="cta-link" href={site.phoneHref}>
        Get an Estimate<span class="cta-phone">{site.phone}</span>
      </a>
    </div>

    <!-- #676171b1 .elementor-menu-toggle — pink, green on hover -->
    <button class="toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="toggle-bars" aria-hidden="true"></span>
      <span class="sr-only">Menu</span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden aria-label="Mobile">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.text}</a>
          {item.sub.length > 0 && (
            <ul>
              {item.sub.map((s) => (
                <li><a href={s.href}>{s.text}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* #9a5dc73 — the header bar */
  .site-header {
    background-color: #ffffff;
    border-style: solid;
    border-width: 0 0 2px 0;
    border-color: var(--e-global-color-a8178e9); /* #99CC33 */
    box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 100;
  }

  /* The header section is stretched on the live site: measured 1440px wide at a
     1440px viewport, not clamped to the 1200px content container. Clamping it
     squeezes the nav below the 952px its nine items need and wraps "Contact"
     onto a second row. */
  .bar {
    width: 100%;
    display: flex;
    align-items: center;   /* align-content:center; align-items:center */
    gap: 0;
    padding: 0;
  }

  /* #5b7a0d2a — logo column: 12% desktop, 30% ≤1024, 75% ≤767 */
  .brand { width: 12%; display: block; text-align: start; }
  /* #6f3f7a8f img{width:100%} */
  .brand img { width: 100%; height: auto; display: block; }

  /* #3088a032 — nav column: 78% desktop, 50% ≤1024 */
  .nav { width: 78%; margin: 0 35px 0 0; }

  /* Top-level rules use `>` throughout: a descendant selector such as
     `.nav ul` would also match ul.sub inside it and out-specify the rule that
     hides the submenu, so the dropdown would never close. */
  .nav > ul {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav > ul > li { position: relative; }

  /* #676171b1 .elementor-nav-menu--main .elementor-item */
  .nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--e-global-color-d077a13); /* #15334C */
    fill: var(--e-global-color-d077a13);
    padding: 13px 10px; /* measured on the live nav item */
  }

  .nav > ul > li > a:hover,
  .nav > ul > li > a[aria-current='page'] {
    color: var(--e-global-color-f32bb28); /* #FF0099 */
    fill: var(--e-global-color-f32bb28);
  }

  .caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
  }

  /* --- dropdown ---------------------------------------------------------
     The original sets margin-top:14px on the submenu, which leaves a gap the
     pointer must cross. Without a bridge the menu closes on the way down, so
     ::before spans the gap and keeps the hover chain intact. */
  .sub {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 14px;
    display: none;
    min-width: 260px;
    list-style: none;
    padding: 0;
    background: #ffffff;
    border-style: solid;
    border-width: 0 0 2px 0;
    border-color: var(--e-global-color-a8178e9); /* #99CC33 */
    border-radius: 10px;
    box-shadow: 5px 5px 5px 0 rgba(0, 0, 0, 0.36);
    z-index: 10;
  }

  .sub::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;   /* bridges the 14px gap */
  }

  /* Opens on hover, and on keyboard focus. `:has(a:focus-visible)` rather than
     `:focus-within`: :focus-within also matches a mouse click on the trigger,
     which latches the menu open after the pointer has left. */
  .nav > ul > li.has-sub:hover > .sub,
  .nav > ul > li.has-sub:has(a:focus-visible) > .sub {
    display: block;
  }

  /* The 32-item Vehicle Wraps menu goes multi-column rather than off-screen. */
  .sub--wide {
    column-count: 3;
    column-gap: 0;
    min-width: 720px;
  }
  .sub--wide > li { break-inside: avoid; }

  .nav > ul > li > .sub > li:not(:last-child) {
    border-style: solid;
    border-color: #f2f2f2;
    border-bottom-width: 1px;
  }

  /* Depth matched to the top-level rule so it is not out-specified. */
  .nav > ul > li > .sub > li > a {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    text-transform: none;
    text-decoration: none;
    color: var(--e-global-color-f4d2693); /* #353535 */
    fill: var(--e-global-color-f4d2693);
    padding: 10px 16px;
  }

  .nav > ul > li > .sub > li > a:hover {
    color: var(--e-global-color-accent);
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
  }

  .nav > ul > li > .sub > li > a[aria-current='page'] {
    color: var(--e-global-color-accent);
    background-color: var(--e-global-color-8c22d81); /* #14A278 */
  }

  .sub > li:first-child > a { border-top-left-radius: 10px; border-top-right-radius: 10px; }
  .sub > li:last-child > a { border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; }

  /* #6ebf65a / #76c5194 — CTA column and its button */
  .cta {
    width: 9.664%;
    background-color: var(--e-global-color-d077a13); /* #15334C */
    align-self: stretch;
    display: flex;
    padding: 0;
  }
  .cta:hover { background-color: var(--e-global-color-a8178e9); /* #99CC33 */ }

  .cta-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2px;
    width: 100%;
    padding: 12px 10px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 13px;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    color: var(--e-global-color-accent);
    border-radius: 0;
  }
  .cta-phone { font-size: 15px; white-space: nowrap; }

  /* menu toggle — pink, green on hover */
  .toggle {
    display: none;
    margin-left: auto;
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
    color: var(--e-global-color-accent);
    border: 0;
    cursor: pointer;
    padding: 12px 14px;
  }
  .toggle:hover { background-color: var(--e-global-color-a8178e9); }
  .toggle-bars,
  .toggle-bars::before,
  .toggle-bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    content: '';
  }
  .toggle-bars { position: relative; }
  .toggle-bars::before { position: absolute; top: -7px; }
  .toggle-bars::after { position: absolute; top: 7px; }

  .mobile-nav { display: none; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* Elementor's own two breakpoints, 1024 and 767. */
  @media (max-width: 1024px) {
    .brand { width: 30%; }
    .nav { width: 50%; }
    .cta { width: 20%; }
    .sub--wide { column-count: 2; min-width: 480px; }
    .nav > ul > li > a { padding: 16px 6px; font-size: 14px; }
  }

  @media (max-width: 900px) {
    .bar { padding: 8px 16px; }
    .brand { width: 75%; max-width: 260px; }
    .nav, .cta { display: none; }
    .toggle { display: block; }
    .mobile-nav { display: block; background: #fff; border-top: 1px solid #f2f2f2; }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
    .mobile-nav a {
      display: block;
      padding: 12px 20px;
      font-family: 'Poppins', sans-serif;
      font-size: 15px;
      text-decoration: none;
      color: var(--e-global-color-d077a13);
      border-bottom: 1px solid #f2f2f2;
    }
    .mobile-nav ul ul a {
      padding-left: 38px;
      font-weight: 400;
      color: var(--e-global-color-f4d2693);
      font-size: 14px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
