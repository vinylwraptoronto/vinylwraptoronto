---
/**
 * Listing for a category, brand or index address.
 *
 * These listings are NOT ported from markup: on the live site they are rendered
 * client-side and appear in no served HTML. They are regenerated from the real
 * post-to-term mapping returned by the site's own REST API, so the membership
 * is correct rather than guessed from titles.
 */
import summaries from '../data/summaries.json';
import { imageUrl } from '../data/images';
import type { Summary } from '../types';

export interface Props {
  members: string[];
  heading?: string;
}

const { members, heading } = Astro.props;
const all = summaries as Record<string, Summary>;
const items = members.map((s) => all[s]).filter(Boolean);

const fmt = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' }) : null;
---

{items.length > 0 && (
  <section class="listing">
    <div class="container">
      {heading && <h2>{heading}</h2>}
      <p class="count">{`${items.length} ${items.length === 1 ? 'entry' : 'entries'}`}</p>
      <ul class="cards">
        {items.map((it) => (
          <li class="card">
            <a href={`/${it.slug}/`}>
              {it.image ? (
                <img src={imageUrl(it.image)} alt={it.title} loading="lazy" decoding="async" />
              ) : (
                <span class="noimg" aria-hidden="true"></span>
              )}
              <span class="body">
                <span class="title">{it.title}</span>
                {it.published && <time datetime={it.published}>{fmt(it.published)}</time>}
                {it.description && <span class="desc">{it.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .listing { padding: 30px 0 50px; }
  .count {
    font-size: 14px;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }

  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #e9e9e9;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card a:hover {
    border-color: var(--e-global-color-a8178e9); /* #99CC33 */
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .card img,
  .noimg {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--panel);
  }

  .body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 6px; }

  .title {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 17px;
    line-height: 1.35;
    color: var(--brand-navy);
  }
  .card a:hover .title { color: var(--brand-pink); }

  time { font-size: 12px; color: #767676; }

  .desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .cards { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
