---
/**
 * The measurement tags, as the original loads them.
 *
 * Five separate systems, in the original's own order: GA4, Google Tag Manager,
 * the Meta Pixel, Google Ads (with call-conversion number substitution), and
 * Microsoft Clarity. The clone loaded none of them, so nothing the client's
 * marketing depends on was being recorded from it.
 *
 * `is:inline` on every one of these is not optional. Without it Astro treats an
 * inline <script> as a module to bundle: it is hoisted out of the head and
 * deferred past parse, and the config blocks below — which call a bare gtag()
 * defined by an earlier sibling — silently stop working. The failure looks
 * exactly like success in "view source".
 */
import { analyticsFor, attributionKeys } from '../../seo.config.mjs';

export interface Props {
  pathname: string;
}
const a = analyticsFor(Astro.props.pathname);

/*
 * Consent Mode v2, prepared and switched off.
 *
 * The original has no consent banner and fires every tag unconditionally, and
 * the port reproduces that. There is no consent platform to wire to yet, and
 * denying storage by default with nothing to grant it again would silently
 * zero every conversion the client's campaigns are measured on.
 *
 * So the default is emitted only when PUBLIC_CONSENT_DEFAULT=denied is set at
 * build time. When it is, every Google tag starts with ad and analytics
 * storage denied, the Meta Pixel starts revoked, and a consent platform (or a
 * banner) calls window.vwtConsent(true) to grant both. Until a platform is
 * chosen, leave it unset and the site measures exactly as the original does.
 */
const consentDenied = import.meta.env.PUBLIC_CONSENT_DEFAULT === 'denied';
---

{a && (
  <>
    {consentDenied && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted', security_storage: 'granted',
          wait_for_update: 500
        });
        window.vwtConsent = function (granted) {
          var s = granted ? 'granted' : 'denied';
          gtag('consent', 'update', { ad_storage: s, ad_user_data: s, ad_personalization: s, analytics_storage: s });
          if (window.fbq) fbq('consent', granted ? 'grant' : 'revoke');
          window.dataLayer.push({ event: granted ? 'consent_granted' : 'consent_denied' });
        };
      `} />
    )}

    {/* Google tag (gtag.js) — GA4 */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${a.ga4}`}></script>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${a.ga4}');
    `} />

    {/* Google Tag Manager */}
    <script is:inline set:html={`
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${a.gtm}');
    `} />

    {/* Meta Pixel */}
    <script is:inline set:html={`
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      ${consentDenied ? "fbq('consent', 'revoke');" : ''}
      fbq('init', '${a.metaPixel}');
      fbq('track', 'PageView');
    `} />
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src={`https://www.facebook.com/tr?id=${a.metaPixel}&ev=PageView&noscript=1`}
      />
    </noscript>

    {/* Google Ads, and the call conversion that substitutes the displayed
        phone number with a Google forwarding number. */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${a.googleAds}`}></script>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${a.googleAds}');
      gtag('config', '${a.adsCallConversion}', {'phone_conversion_number': '${a.phoneConversionNumber}'});
    `} />

    {/* The lead conversion, on the thank-you page only, exactly as the
        original does it. The quote form fires the same label from its own
        success handler, because it answers in place and never comes here —
        this copy is for anyone who arrives at the address directly. */}
    {Astro.props.pathname === '/thank-you/' && (
      <script is:inline set:html={`gtag('event', 'conversion', {'send_to': '${a.leadConversion}'});`} />
    )}

    {/* Microsoft Clarity */}
    <script is:inline set:html={`
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "${a.clarity}");
    `} />

    {/* Attribution and the contact-action events. First party only: the
        click ids and UTMs a paid visit arrives with are kept in a cookie for
        90 days (last click wins) so the quote form can name its campaign, and
        a tap on the phone, WhatsApp or email link is pushed to the dataLayer
        once for GTM and GA4 to record. No personal data is read or sent. */}
    <script is:inline set:html={`
      (function () {
        var keys = ${JSON.stringify(attributionKeys)};
        var q = new URLSearchParams(location.search), got = {}, any = false;
        keys.forEach(function (k) { var v = q.get(k); if (v) { got[k] = v.slice(0, 200); any = true; } });
        if (any) {
          got.landing = location.pathname; got.at = new Date().toISOString();
          try {
            document.cookie = 'vwt_attr=' + encodeURIComponent(JSON.stringify(got)) +
              ';path=/;max-age=7776000;SameSite=Lax' + (location.protocol === 'https:' ? ';Secure' : '');
          } catch (e) {}
        }
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var h = a.getAttribute('href') || '';
          var ev = h.indexOf('tel:') === 0 ? 'phone_click'
                 : /whatsapp\\.com|wa\\.me/.test(h) ? 'whatsapp_click'
                 : h.indexOf('mailto:') === 0 ? 'email_click' : null;
          if (!ev) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: ev, link_url: h, page_path: location.pathname });
        });
      })();
    `} />
  </>
)}
