---
/**
 * Footer — port of Elementor template 18407.
 *
 * Columns sit on the navy (#15334C, --e-global-color-d077a13) with 15px padding;
 * headings are 20px/500 uppercase white; icon-list text is 16px/400 white.
 * The bottom credit bar (#b853c7a) is white.
 */
import QuoteForm from './QuoteForm.astro';
import { site, social, legalLinks } from '../data/site';
import {
  workflow, fasterProcess, warranty, credit, hours, addressFull,
  contactIcons, warrantyIcon, vinylBrands,
} from '../data/footer';
---

{/* Three columns, matching the live template's own structure: the four we had
    split Areas/Contact apart and stranded Warranty at the top of the quote
    column. Widths are the template's — 25% / 41.332% / the remainder — not an
    even split. */}
<footer class="site-footer">
  {/* #3f2a4d85 — 50px of breathing room above and below, and the row is boxed
      at 1400px rather than running to the viewport edges. Without the box the
      first column started hard against the left of the screen. */}
  <div class="cols">
    <!-- #70aa3a51 — 25%, navy -->
    <section class="col col--areas">
      <h4>Areas We Serve</h4>
      {/* The original serves two heading widgets here and nothing else. The
          seven city links and the /locations-served/ link that used to be in
          this column were invented — the live footer contains no location
          link at all, and "and more..." is plain text, not a link. */}
      <p class="areas-more">and more...</p>

      <h4>Contact Us</h4>
      <ul class="list list--pink">
        <li><i class={contactIcons.phone} aria-hidden="true"></i><a href={site.phoneHref}>{site.phone}</a></li>
        <li><i class={contactIcons.email} aria-hidden="true"></i><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><i class={contactIcons.address} aria-hidden="true"></i><a href={site.mapUrl} rel="noopener">{addressFull}</a></li>
        <li>
          <i class={contactIcons.hours} aria-hidden="true"></i>
          <span>
            <strong>{hours.label}</strong><br />
            {hours.lines[0]}<br />
            {hours.lines[1]}
          </span>
        </li>
      </ul>
    </section>

    <!-- #6ef5e811 — 41.332%, navy -->
    <section class="col col--process">
      <h4>Workflow</h4>
      <ul class="list">
        {workflow.map((w) => <li><i class={w.icon} aria-hidden="true"></i>{w.text}</li>)}
      </ul>
      <h4>Things that make the process Faster</h4>
      <ul class="list">
        {fasterProcess.map((w) => <li><i class={w.icon} aria-hidden="true"></i>{w.text}</li>)}
      </ul>
      <h4>Warranty</h4>
      <ul class="list"><li><i class={warrantyIcon} aria-hidden="true"></i>{warranty}</li></ul>

      <!-- #e8fc75d — icon-box, 30px pink ellipsis, both parts linking to /vinyl/ -->
      <p class="brands">
        <a class="brands-icon" href={vinylBrands.href} tabindex="-1" aria-hidden="true">
          <i class={vinylBrands.icon}></i>
        </a>
        <a class="brands-text" href={vinylBrands.href}>{vinylBrands.text}</a>
      </p>
    </section>

    <!-- #53f81f9 — the remainder; a white card, 25px padding, 5px radius -->
    <section class="col col--quote">
      <div class="card">
        <h4>Get a Quote</h4>
        <!-- The live footer template (18407) carries the quote form itself,
             which is why a form appears on every page of the site. -->
        <QuoteForm id="footer-quote" />

        {/* The "Get an Estimate / Send a Message" pair that used to sit here is
            not in the live footer at all — it is the sticky bar, which
            StickyBar.astro already renders. Two copies were showing. */}
        <ul class="social">
          {social.map((s) => (
            <li>
              <a href={s.href} rel="noopener" aria-label={s.name}>
                <i class={s.icon} aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <!-- #b853c7a — white credit bar. #3aaf8a14 40% / #3ca93c3b 60%. The white
       bleeds full width; its contents are boxed to match the row above. -->
  <div class="creditbar">
  <div class="credit">
    <ul class="legal">
      {legalLinks.map((l) => (
        <li><a href={l.href}>{l.text}</a></li>
      ))}
    </ul>
    <div class="by">
      <p class="copyright">{credit.copyright}</p>
      <p>
        {credit.byPrefix}{' '}
        <a class="byname" href={credit.byHref} target="_blank" rel="noopener">{credit.byName}</a>
      </p>
    </div>
  </div>
  </div>
</footer>

<style>
  .site-footer { font-family: 'Poppins', sans-serif; }

  /* Three columns at the template's own widths, not an even split:
     #70aa3a51 is 25%, #6ef5e811 is 41.332%, and #53f81f9 takes the remainder.
     Below 1025px the template drops to 50/50 with the quote card full width,
     and below 768px everything stacks. */
  /* #3f2a4d85 — the section pads 50px top and bottom and boxes its row at
     1400px. The navy is on the section so it still bleeds full width. */
  .site-footer { background: var(--e-global-color-d077a13); /* #15334C */ }
  .cols {
    display: flex;
    flex-wrap: wrap;
    max-width: 1400px;
    margin-inline: auto;
    padding: 50px 0;
  }

  /* #70aa3a51 > .elementor-element-populated{padding:15px} */
  .col { padding: 15px; color: #ffffff; }
  .col--areas { width: 25%; }
  /* #6ef5e811 overrides the 15px with 20px */
  .col--process { width: 41.332%; padding: 20px; }
  /* The white card carries #53f81f9's own 25px, so the column adds none. */
  .col--quote { width: 33.668%; padding: 0; }

  /* Elementor's default gap between widgets in a column is 20px; #70aa3a51
     overrides it to 10px. Without either, "and more..." sat directly on top of
     the CONTACT US heading. */
  .col > * + * { margin-block-start: 20px; }
  .col--areas > * + * { margin-block-start: 10px; }
  /* #e935660 — CONTACT US adds 20px of its own on top of that. */
  .col--areas > .areas-more + h4 { margin-block-start: 30px; }

  /* #51a60bc8 / #e935660 / #71701d39 .elementor-heading-title */
  .col h4 {
    font-size: 20px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--e-global-color-accent); /* #FFFFFF */
    margin: 0 0 12px;
    /* measured 20px on the live render, not the 1.3 ratio */
    line-height: 20px;
  }
  .col h4 + ul + h4 { margin-top: 22px; }

  /* #441ba18 icon-list: 16px/400 white, 10px/2 spacing between items */
  .list {
    list-style: none;
    margin: 0 0 4px;
    padding: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }
  /* Elementor splits an icon-list's spacing in half either side of each item,
     so the gap between two rows is the full value. The two lists are set
     differently and were both rendering at the contact list's half-value: the
     contact list is 10px, and the three process lists are 3px, opening to 8px
     under 1025px and 13px under 768px. */
  .list > li {
    color: #ffffff;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .list > li:not(:last-child) { padding-block-end: calc(10px / 2); }
  .list > li:not(:first-child) { margin-block-start: calc(10px / 2); }
  .col--process .list > li:not(:last-child) { padding-block-end: calc(3px / 2); }
  .col--process .list > li:not(:first-child) { margin-block-start: calc(3px / 2); }
  /* These were CSS dots standing in for the icons the original actually
     draws — a phone, an envelope, a map pin, a clock, and so on. */
  .list > li > i {
    flex: 0 0 auto;
    width: 14px;
    text-align: center;
    color: var(--e-global-color-8c22d81); /* #14A278 */
  }
  .list--pink > li > i { color: var(--e-global-color-f32bb28); /* #FF0099 */ }

  /* measured on the live column: Poppins 400, 16px/16px, white */
  .areas-more {
    margin: 0;
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    color: #ffffff;
  }

  .list a { color: #ffffff; text-decoration: none; }
  .list a:hover { text-decoration: underline; }

  /* #e8fc75d — 30px pink ellipsis, 15px from the title, both linking to
     /vinyl/; the title turns pink when either half is hovered. */
  .brands {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 14px 0 0;
  }
  .brands-icon {
    font-size: 30px;
    line-height: 1;
    color: var(--e-global-color-f32bb28); /* #FF0099 */
    text-decoration: none;
  }
  .brands-text {
    font-size: 16px;
    font-weight: 400;
    color: #ffffff;
    text-decoration: none;
  }
  .brands:hover .brands-text { color: var(--e-global-color-f32bb28); }

  /* #53f81f9 — the quote column is a white card, so the form keeps its own
     colours; the overrides that used to paint its labels white were there
     because it had been sitting straight on the navy. */
  .card {
    background: #ffffff;
    border-radius: 5px;
    padding: 25px;
  }
  .card h4 { color: var(--e-global-color-d077a13); }

  /* #4b3afc2 — the footer form's own submit button: green, white, and the
     full width of the card, because its field group is elementor-col-100.
     Hover goes pink, not lighter.

     This had been removed when the quote column became a white card, on the
     reading that the overrides beside it existed only to make dark labels
     legible on navy. Two of them did; this one is the button's actual styling,
     and dropping it left a narrow navy button where the original has a green
     bar. The form's own .qbtn is navy and auto-width because that is right in
     the popup and on /contact/ — this is the footer instance only. */
  .card :global(.qbtn) {
    align-self: stretch;
    width: 100%;
    text-align: center;
    background-color: var(--e-global-color-a8178e9); /* #99CC33 */
    color: #ffffff;
  }
  .card :global(.qbtn:hover) {
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
    color: #ffffff;
  }

  /* #3a97c8c6 — the heading is left-aligned at 20px on desktop, and centred at
     24px once the card goes full width below 1025px. */
  @media (max-width: 1024px) {
    .card h4 { text-align: center; font-size: 24px; }
  }

  /* #491c6798 — 20px navy glyphs on white, 12px apart, centred; hovering
     fills the badge green with a white glyph. */
  .social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 12px;
    margin: 15px 0 0;
    padding: 0 0 14px;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    padding: 0.3em;
    border-radius: 50%;
    color: var(--e-global-color-d077a13);
    background-color: #ffffff;
    text-decoration: none;
  }
  .social a:hover {
    background-color: var(--e-global-color-8c22d81); /* #14A278 */
    color: var(--e-global-color-accent); /* #FFFFFF */
  }

  /* #b853c7a — white credit bar. The legal menu (#3aaf8a14) takes 40% and the
     copyright and credit (#3ca93c3b) the other 60%, boxed to the same 1400px
     as the row above so the two line up. */
  .credit {
    background-color: #ffffff;
    max-width: 1400px;
    margin-inline: auto;
    padding: 12px 15px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    color: var(--e-global-color-text);
  }
  .creditbar { background: #ffffff; }
  .credit p { margin: 0; }
  /* #23c23594 is 15px, #36dbd408 12px, both 25px leading and weight 300. */
  .credit .copyright { font-size: 15px; }
  .by {
    width: 60%;
    text-align: end;
    font-size: 12px;
    line-height: 25px;
    font-weight: 300;
    color: var(--brand-navy);
  }
  .byname { text-decoration: underline; }
  .credit a { color: var(--e-global-color-d077a13); text-decoration: none; }
  .credit a:hover { color: var(--e-global-color-f32bb28); }

  /* #37ceb7c is a nav menu with align-justify — the three links spread across
     their column rather than sitting in a tight cluster at its left edge. */
  .legal {
    width: 40%;
    display: flex;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    line-height: 20px;
  }

  /* The template's own breakpoints: 50/50 with the quote card full width on
     tablet, everything stacked below that. */
  @media (max-width: 1024px) {
    .cols { padding: 10px; }
    .col--areas,
    .col--process { width: 50%; }
    .col--quote { width: 100%; }
    /* The process lists open up as the columns narrow. */
    .col--process .list > li:not(:last-child) { padding-block-end: calc(8px / 2); }
    .col--process .list > li:not(:first-child) { margin-block-start: calc(8px / 2); }
  }
  @media (max-width: 767px) {
    .col--areas,
    .col--process,
    .col--quote { width: 100%; }
    .col--areas { padding: 20px 10px; margin: 35px 0; }
    .col--areas > .areas-more + h4 { margin-block-start: 40px; }
    .col--quote { margin: 30px 0; }
    .col--process .list > li:not(:last-child) { padding-block-end: calc(13px / 2); }
    .col--process .list > li:not(:first-child) { margin-block-start: calc(13px / 2); }
    .legal,
    .by { width: 100%; text-align: start; }
    .legal { justify-content: flex-start; gap: 20px; flex-wrap: wrap; }
  }
</style>
