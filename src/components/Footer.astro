---
/**
 * Footer — port of Elementor template 18407.
 *
 * Columns sit on the navy (#15334C, --e-global-color-d077a13) with 15px padding;
 * headings are 20px/500 uppercase white; icon-list text is 16px/400 white.
 * The bottom credit bar (#b853c7a) is white.
 */
import QuoteForm from './QuoteForm.astro';
import { site, social, legalLinks } from '../data/site';
import {
  workflow, fasterProcess, credit, hours, addressFull,
  contactIcons, vinylBrands,
} from '../data/footer';
---

{/* Three columns, matching the live template's own structure: the four we had
    split Areas/Contact apart and stranded Warranty at the top of the quote
    column. Widths are the template's — 25% / 41.332% / the remainder — not an
    even split. */}
<footer class="site-footer">
  {/* #3f2a4d85 — 50px of breathing room above and below, and the row is boxed
      at 1400px rather than running to the viewport edges. Without the box the
      first column started hard against the left of the screen. */}
  <div class="cols">
    <!-- #70aa3a51 — 25%, navy -->
    <section class="col col--areas">
      <h2>Areas We Serve</h2>
      {/* The live footer's own markup has no location link in this column —
          "and more..." is plain text there too, and an earlier port that
          added 7 invented city names here was correctly reverted. These are
          not that: the 7 links below point to the site's own real,
          indexable /locations-served/ archive pages (North York,
          Scarborough, Oakville, Markham, Toronto, Brampton, Mississauga),
          each carried verbatim from the live site with its own real title
          and content — genuine service-area pages the original site
          publishes, just not from this footer slot. Linking to a site's own
          existing indexable pages from its footer is standard internal
          linking, not a fabricated claim, so they are added here as
          worthwhile naturally-occurring improvement over the port while
          keeping the original's own "and more..." text intact beneath
          them. */}
      <ul class="list areas-list">
        <li><a href="/locations-served/custom-wraps-toronto/">Toronto</a></li>
        <li><a href="/locations-served/custom-wraps-mississauga/">Mississauga</a></li>
        <li><a href="/locations-served/custom-wraps-north-york/">North York</a></li>
        <li><a href="/locations-served/custom-wraps-scarborough/">Scarborough</a></li>
        <li><a href="/locations-served/vehicle-graphics-brampton/">Brampton</a></li>
        <li><a href="/locations-served/custom-vinyl-wraps-markham/">Markham</a></li>
        <li><a href="/locations-served/custom-decals-oakville/">Oakville</a></li>
      </ul>
      <p class="areas-more">and more...</p>

      <h2>Contact Us</h2>
      <ul class="list list--pink">
        {/* The icon goes INSIDE the link, which is where the original puts it
            -- `<a><span class="icon"><i></i></span><span>text</span></a>` --
            so the whole 320px row is the click target. The port had the icon
            as a sibling, which left the link starting 22px in and only as
            wide as its own text. */}
        <li><a href={site.phoneHref}><i class={contactIcons.phone} aria-hidden="true"></i>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}><i class={contactIcons.email} aria-hidden="true"></i>{site.email}</a></li>
        <li><a href={site.mapUrl} rel="noopener"><i class={contactIcons.address} aria-hidden="true"></i>{addressFull}</a></li>
        <li>
          <i class={contactIcons.hours} aria-hidden="true"></i>
          <span>
            <strong>{hours.label}</strong><br />
            {hours.lines[0]}<br />
            {hours.lines[1]}
          </span>
        </li>
      </ul>
    </section>

    <!-- #6ef5e811 — 41.332%, navy -->
    <section class="col col--process">
      <h2>Workflow</h2>
      <ul class="list">
        {workflow.map((w) => <li><i class={w.icon} aria-hidden="true"></i>{w.text}</li>)}
      </ul>
      <h2>Things that make the process Faster</h2>
      <ul class="list">
        {fasterProcess.map((w) => <li><i class={w.icon} aria-hidden="true"></i>{w.text}</li>)}
      </ul>

      <!-- #e8fc75d — icon-box, 30px pink ellipsis, both parts linking to /vinyl/.
           The icon half used to carry no text at all (icon glyph only, via
           CSS content) — a real empty-link gap for both the SEO link-text
           audit (reads crawler-visible textContent, not aria-label) and
           screen-reader users (an announced link with nothing to say). The
           fix adds the same, true destination text the adjacent link already
           carries, visually hidden with .sr-only so the 30px icon's look is
           unchanged; aria-hidden/tabindex=-1 are removed since the link is no
           longer empty and should be reachable like any other. -->
      <p class="brands">
        <a class="brands-icon" href={vinylBrands.href}>
          <i class={vinylBrands.icon} aria-hidden="true"></i>
          <span class="sr-only">{vinylBrands.text}</span>
        </a>
        <a class="brands-text" href={vinylBrands.href}>{vinylBrands.text}</a>
      </p>
    </section>

    <!-- #53f81f9 — the remainder; a white card, 25px padding, 5px radius -->
    <section class="col col--quote">
      <div class="card">
        <h2>Get a Quote</h2>
        <!-- The live footer template (18407) carries the quote form itself,
             which is why a form appears on every page of the site. -->
        <QuoteForm id="footer-quote" rows={3} />

        {/* The "Get an Estimate / Send a Message" pair that used to sit here is
            not in the live footer at all — it is the sticky bar, which
            StickyBar.astro already renders. Two copies were showing. */}
        <ul class="social">
          {social.map((s) => (
            <li>
              <a href={s.href} rel="noopener" aria-label={s.name}>
                <i class={s.icon} aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <!-- #b853c7a — white credit bar. #3aaf8a14 40% / #3ca93c3b 60%. The white
       bleeds full width; its contents are boxed to match the row above. -->
  <div class="creditbar">
  <div class="credit">
    <ul class="legal">
      {legalLinks.map((l) => (
        <li><a href={l.href}>{l.text}</a></li>
      ))}
    </ul>
    {/* Both lines are heading widgets on the live site (#23c23594, #36dbd408)
        and render as h5, not paragraphs. They carry no visual weight of their
        own — the styling below restates what the two element rules set — but
        the tags are part of the page's outline, so they match the original
        hierarchically: one level below the five h2 column groups above, as
        the credit bar is the footer's own subordinate closing row rather
        than another top-level group. Rendered as h3, not the original's
        literal h5, because the outline only has one level between the
        column h2s and here (nothing on the page uses h3/h4 in between) —
        h5 would reopen the same 2->4-style skip the h3-to-h2 promotion
        just closed, on every page whose own content never reaches h3. */}
    <div class="by">
      <h3 class="copyright">{credit.copyright}</h3>
      <h3>
        {credit.byPrefix}{' '}
        <a class="byname" href={credit.byHref} target="_blank" rel="noopener">{credit.byName}</a>
      </h3>
    </div>
  </div>
  </div>
</footer>

<style>
  .site-footer { font-family: 'Poppins', sans-serif; }

  /* Three columns at the template's own widths, not an even split:
     #70aa3a51 is 25%, #6ef5e811 is 41.332%, and #53f81f9 takes the remainder.
     Below 1025px the template drops to 50/50 with the quote card full width,
     and below 768px everything stacks. */
  /* #3f2a4d85 — the section pads 50px top and bottom and boxes its row at
     1400px. The navy is on the section so it still bleeds full width. */
  .site-footer { background: var(--e-global-color-d077a13); /* #15334C */ }
  .cols {
    display: flex;
    flex-wrap: wrap;
    max-width: 1400px;
    margin-inline: auto;
    padding: 50px 0;
  }

  /* #70aa3a51 > .elementor-element-populated{padding:15px} */
  .col { padding: 15px; color: #ffffff; }
  .col--areas { width: 25%; }
  /* #6ef5e811 is 15px on desktop like its neighbour; its 20px is the tablet
     value (measured: Workflow sits 15px into the column at 1440, 20 at 900). */
  .col--process { width: 41.332%; }
  /* The white card carries #53f81f9's own 25px, so the column adds none. */
  .col--quote { width: 33.668%; padding: 0; }

  /* Elementor's default gap between widgets in a column is 20px; #70aa3a51
     overrides it to 10px. Without either, "and more..." sat directly on top of
     the CONTACT US heading. */
  .col > * + * { margin-block-start: 20px; }
  .col--areas > * + * { margin-block-start: 10px; }
  /* #e935660 — CONTACT US adds 20px of its own on top of that. */
  .col--areas > .areas-more + h2 { margin-block-start: 30px; }

  /* #51a60bc8 / #e935660 / #71701d39 .elementor-heading-title
     Promoted from h3 to h2: these five are the footer's own top-level
     semantic groups (Areas We Serve / Contact Us / Workflow / Things that
     make the process Faster / Get a Quote) with no heading
     above them inside <footer> and no nested subheading inside any of
     them, so h2 is the correct outline level -- h3 here (with no h2
     anywhere in the footer) was the cause of a 1->3 heading-level skip on
     every page whose own content tops out at h1 before the footer. The
     tag changed in the markup above; every property below is still set
     explicitly by this scoped rule, so the rendered size/weight/case/
     colour/spacing are unchanged. */
  .col h2 {
    font-size: 20px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--e-global-color-accent); /* #FFFFFF */
    /* No margin of its own: a heading widget's is 0, and the space under it is
       the column's widget gap -- 10px in the first column, 20 elsewhere. The
       12px here collapsed with that gap and pushed every list 2px down. */
    margin: 0;
    /* measured 20px on the live render, not the 1.3 ratio */
    line-height: 20px;
  }
  .col h2 + ul + h2 { margin-top: 22px; }

  /* #441ba18 icon-list: 16px/400 white, 10px/2 spacing between items */
  .list {
    list-style: none;
    margin: 0 0 4px;
    padding: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }
  .col > .list { margin-bottom: 0; }
  /* Elementor splits an icon-list's spacing in half either side of each item,
     so the gap between two rows is the full value. The two lists are set
     differently and were both rendering at the contact list's half-value: the
     contact list is 10px, and the three process lists are 3px, opening to 8px
     under 1025px and 13px under 768px. */
  .list > li {
    color: #ffffff;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .list > li:not(:last-child) { padding-block-end: calc(10px / 2); }
  .list > li:not(:first-child) { margin-block-start: calc(10px / 2); }
  .col--process .list > li:not(:last-child) { padding-block-end: calc(3px / 2); }
  .col--process .list > li:not(:first-child) { margin-block-start: calc(3px / 2); }
  /* These were CSS dots standing in for the icons the original actually
     draws — a phone, an envelope, a map pin, a clock, and so on. */
  /* The two lists' icon colours were the wrong way round. Measured on the
     original's own footer: the Workflow / Faster icons are PINK
     and the Contact Us icons are GREEN, and the port had green on the first
     three and pink on Contact. Both at 14px, which is also what the original
     sets -- the port's were 16. */
  .list > li > i,
  .list > li > a > i {
    flex: 0 0 auto;
    width: 14px;
    font-size: 14px;
    text-align: center;
    color: var(--e-global-color-f32bb28); /* #FF0099 */
  }
  .list--pink > li > i,
  .list--pink > li > a > i { color: var(--e-global-color-8c22d81); /* #14A278 */ }
  /* The three process lists draw a larger glyph than the contact list, in a
     wider box: 15px in a 19px slot at desktop, then 8px of the icon's own
     padding and 5 of the text's before the words start -- 32px in all, where
     the port's 22 let each line run 10px longer and wrap differently. The
     glyph grows to 16 at tablet and 18 on a phone (#32151746, #5e0da4c1,
     #1a2d9479). */
  .col--process .list > li { gap: 13px; }
  .col--process .list > li > i { font-size: 15px; width: 19px; }
  @media (max-width: 1024px) {
    .col--process .list > li > i { font-size: 16px; width: 20px; }
  }
  @media (max-width: 767px) {
    .col--process .list > li > i { font-size: 18px; width: 23px; }
  }
  /* The Contact Us links fill the column rather than shrinking to their text:
     the original's are 320 wide and display flex, the port's were 102 / 228 /
     298. Their TEXT is white. The original's anchor computes pink, but every
     word in it sits in an .elementor-icon-list-text span set to #FFFFFF, so the
     pink is never painted -- measured on the live footer, all four rows. */
  .list--pink > li > a {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: #ffffff;
  }

  /* Added service-area links use the same icon-list typography as the rest
     of the footer (16px/400 white) but without the icon gutter, since this
     list has no icon column. */
  .areas-list { margin: 0 0 8px; }
  .areas-list > li:not(:last-child) { padding-block-end: 0; margin-block-end: 5px; }

  /* measured on the live column: Poppins 400, 16px/16px, white */
  .areas-more {
    margin: 0;
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    color: #ffffff;
  }

  /* Footer links ease over 0.3s on the original, like its buttons. */
  .list a { color: #ffffff; text-decoration: none; transition: all 0.3s ease; }
  .list a:hover { text-decoration: underline; }

  /* #e8fc75d — 30px pink ellipsis, 15px from the title, both linking to
     /vinyl/; the title turns pink when either half is hovered. */
  /* Elementor's icon-box: the icon sits beside the title with a 15px gap, the
     two align to the TOP, and the title takes the rest of the row. The port
     centred them and let the title shrink to its own text, so it measured
     100px wide where the original's is 504. */
  .brands {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin: 0;
  }
  .brands-icon {
    font-size: 30px;
    line-height: 1;
    color: var(--e-global-color-f32bb28); /* #FF0099 */
    text-decoration: none;
  }
  /* 500 on the original, not 400 — checked against the live footer on every
     page it appears, which is all 678. */
  /* The title is the icon-box's <p>, which keeps the theme's 0.9em under it:
     that 14.4px is what makes the box 38px tall rather than the icon's 30. */
  .brands-text {
    flex: 1;
    margin-bottom: 14.4px;
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
  }
  .brands:hover .brands-text { color: var(--e-global-color-f32bb28); }
  /* Same visually-hidden technique as Blocks.astro's .elementor-screen-only
     (scoped styles mean that class doesn't reach this component) — text
     stays in the DOM for crawlers/screen readers, off-screen for sighted
     users. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* #53f81f9 — the quote column is a white card, so the form keeps its own
     colours; the overrides that used to paint its labels white were there
     because it had been sitting straight on the navy. */
  .card {
    background: #ffffff;
    border-radius: 5px;
    padding: 25px;
  }
  .card h2 { color: var(--e-global-color-d077a13); }
  /* The card is a column: 20px between its heading, form and icons. */
  .card > :global(* + *) { margin-block-start: 20px; }

  /* #4f7a1c7 -- the footer's own form widget. The field box is the site-wide
     one; these are this instance's: 12px between fields, 14px type, a
     three-row message box, and the checkbox pair on a 24px row. Measured on
     the original field by field: name 0, email 52, phone 104, checkboxes 156,
     select 192, upload note 244, file 304, message 343. */
  /* Prefixed with .site-footer: QuoteForm's own rules carry the same
     specificity as `.card .qform …` and load after this file, so without the
     extra class the footer values silently lost. */
  .site-footer .card :global(.qform) { gap: 12px; }
  .site-footer .card :global(.qform input[type='text']),
  .site-footer .card :global(.qform input[type='email']),
  .site-footer .card :global(.qform input[type='tel']),
  .site-footer .card :global(.qform select),
  .site-footer .card :global(.qform textarea) { font-size: 14px; }
  .site-footer .card :global(.qform select) { height: 40px; padding-block: 5px; }
  .site-footer .card :global(.qform textarea) { line-height: 19.6px; }
  .site-footer .card :global(.qform .checks) { min-height: 24px; padding: 0; align-items: center; }
  .site-footer .card :global(.qform .uploadnote) { margin-bottom: 12px; }
  .site-footer .card :global(.qform input[type='file']) { height: 27px; }

  /* #4b3afc2 — the footer form's own submit button: green, white, and the
     full width of the card, because its field group is elementor-col-100.
     Hover goes pink, not lighter.

     This had been removed when the quote column became a white card, on the
     reading that the overrides beside it existed only to make dark labels
     legible on navy. Two of them did; this one is the button's actual styling,
     and dropping it left a narrow navy button where the original has a green
     bar. The form's own .qbtn is navy and auto-width because that is right in
     the popup and on /contact/ — this is the footer instance only. */
  .card :global(.qbtn) {
    align-self: stretch;
    width: 100%;
    text-align: center;
    background-color: var(--e-global-color-a8178e9); /* #99CC33 */
    color: #ffffff;
  }
  /* Measured on the live footer: green with a white label at rest, pink with
     a white label on hover. */
  .card :global(.qbtn:hover) {
    background-color: var(--e-global-color-f32bb28); /* #FF0099 */
    color: #ffffff;
  }

  /* #3a97c8c6 — the heading is left-aligned at 20px on desktop, and centred at
     24px once the card goes full width below 1025px. */
  @media (max-width: 1024px) {
    .card h2 { text-align: center; font-size: 24px; line-height: 24px; }
  }

  /* #491c6798 — 20px navy glyphs on white, 12px apart, centred; hovering
     fills the badge green with a white glyph. */
  .social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 12px;
    padding: 0;
  }
  /* Elementor's social-icon widget draws a rounded SQUARE, not a circle: 32px
     across with a 10% radius and no padding of its own -- the 20px glyph sets
     the size from the inside. The port used `0.3em` of padding and a 50%
     radius, which gave circles that were also 30px rather than 32 and, on the
     narrower glyphs, not square at all (Tumblr came out 25 wide). */
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 10%;
    color: var(--e-global-color-d077a13);
    background-color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .social a:hover {
    background-color: var(--e-global-color-8c22d81); /* #14A278 */
    color: var(--e-global-color-accent); /* #FFFFFF */
  }

  /* #b853c7a — white credit bar. The legal menu (#3aaf8a14) takes 40% and the
     copyright and credit (#3ca93c3b) the other 60%, boxed to the same 1400px
     as the row above so the two line up. */
  /* The 10px belongs to the full-width white strip, not to the boxed row
     inside it: that is what makes the inner row exactly 1400 wide at x=20 on
     a 1440 viewport, which is where the original puts it. The port had
     `12px 15px` on the inner row instead, so it started at 35 and ran 1370. */
  .credit {
    background-color: #ffffff;
    max-width: 1400px;
    margin-inline: auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    color: var(--e-global-color-text);
  }
  .creditbar { background: #ffffff; padding: 10px; }
  .credit p,
  .credit h3 { margin: 0; }
  /* The credit line, re-measured against the original element by element:
     12px on 18px leading, weight 400, in the brand navy. What was here — 15px
     on 25px at weight 300 — was wrong on every one of the 678 addresses.

     `color: inherit` is the load-bearing one. global.css sets a colour on
     h1..h6 directly, and a direct rule beats an inherited one however specific
     the ancestor, so .by's navy never reached these two headings (h5 on the
     live site, h3 here — see the heading-skip note above) and the credit
     rendered black. */
  .credit h3 {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
    /* global.css's h3 rule (unlike its h4 rule) adds text-transform:
       capitalize; cancelled here so promoting the tag doesn't also
       capitalize every word of the copyright/credit line. */
    text-transform: none;
  }
  .by {
    /* The other half. 60/40 put the copyright 122px wider than the original's
       and the legal menu 152px narrower. */
    width: 50%;
    text-align: end;
    font-size: 12px;
    line-height: 18px;
    font-weight: 300;
    color: var(--brand-navy);
  }
  /* The two are not the same weight on the original: the credit lines are 300
     and the link inside them is 400. Setting the whole block to 400 fixed the
     link and broke both h5s, which is how the difference showed up. */
  .byname { text-decoration: underline; font-weight: 400; }
  .credit a { color: var(--e-global-color-d077a13); text-decoration: none; transition: all 0.3s ease; }
  .credit a:hover { color: var(--e-global-color-f32bb28); }

  /* #37ceb7c is a nav menu with align-justify — the three links spread across
     their column rather than sitting in a tight cluster at its left edge. */
  .legal {
    /* Half the row, not 40%: the original's legal menu and its copyright
       column are 700 and 700 inside a 1400 box. */
    width: 50%;
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    /* 16px on the original at every width; the port's 14 was not its value. */
    font-size: 16px;
    line-height: 20px;
  }
  /* Elementor's align-justify nav menu grows every item to fill the row and
     centres its label, each with `13px 20px` of its own. The port rendered
     bare inline links, so "Privacy Policy" was a 95x20 target where the
     original gives 252x46, and the whole white bar was 46px tall instead of
     the port's 20. */
  /* `flex: 1` is `1 1 0%`, which makes all three the same width. Elementor
     grows them from their content, so the original's are 252 / 231 / 216 --
     proportional to their labels -- where equal thirds give 233 each. */
  .legal li { flex: 1 1 auto; display: flex; }
  .legal a {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
  }

  /* The template's own breakpoints: 50/50 with the quote card full width on
     tablet, everything stacked below that. */
  @media (max-width: 1024px) {
    .cols { padding: 10px; }
    .col--areas,
    .col--process { width: 50%; padding: 20px; }
    .col--quote { width: 100%; }
    /* #53f81f9 at tablet: 35px above and below the card, 20 inside it. */
    .col--quote { margin: 35px 0; }
    .card { padding: 20px; }
    /* The three process headings take 1.3em leading and centre from 1024 down
       (#71701d39, #5c96fcd4, #4a07070d); the phone rule puts them back left. */
    .col--process h4 { line-height: 1.3em; text-align: center; }
    /* #491c6798 at tablet: 10px either way between the icons. */
    .social { gap: 10px; }
    /* The legal menu and the credit split 40/60 at tablet, and the menu's
       links lose their side padding (#37ceb7c). */
