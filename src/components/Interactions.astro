---
/**
 * Interactive behaviours the live site gets from Elementor Pro and JetElements,
 * rebuilt without those runtimes:
 *
 *  - Lightbox on gallery and content images (Elementor lightbox).
 *  - Draggable before/after comparison sliders (jet-image-comparison
 *    "juxtapose"), progressively enhanced from the static side-by-side pair so
 *    the images still both show with JS off.
 *
 * Both are delegated from the document, so they apply to any matching markup on
 * any page without per-page wiring.
 */
---

<div class="lb" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lb-x" type="button" data-lb-close aria-label="Close">&times;</button>
  <button class="lb-prev" type="button" data-lb-prev aria-label="Previous image">&#8249;</button>
  <img class="lb-img" alt="" />
  <button class="lb-next" type="button" data-lb-next aria-label="Next image">&#8250;</button>
  <p class="lb-cap"></p>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: rgba(0, 0, 0, 0.92);
    display: grid;
    /* minmax(0, 1fr), not 1fr: a bare 1fr track will not shrink below the
       picture's own width, and at 390 the 94vw cap made the picture 367px
       wide, which pushed the Next button off the right of the screen. */
    grid-template-columns: 60px minmax(0, 1fr) 60px;
    grid-template-rows: 1fr auto;
    align-items: center;
    justify-items: center;
  }
  .lb[hidden] { display: none; }

  .lb-img {
    grid-column: 2;
    grid-row: 1;
    max-width: min(1400px, 100%);
    max-height: 84vh;
    object-fit: contain;
  }
  .lb-cap {
    grid-column: 1 / -1;
    grid-row: 2;
    color: #ddd;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    margin: 10px 16px 18px;
    text-align: center;
  }

  .lb button {
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    font-size: 44px;
    line-height: 1;
    padding: 10px;
    opacity: 0.75;
  }
  .lb button:hover { opacity: 1; }
  .lb-prev { grid-column: 1; grid-row: 1; }
  .lb-next { grid-column: 3; grid-row: 1; }
  .lb-x {
    position: absolute;
    top: 6px;
    right: 14px;
    font-size: 38px;
  }

  @media (max-width: 767px) {
    .lb { grid-template-columns: 40px minmax(0, 1fr) 40px; }
    .lb button { font-size: 32px; }
  }

  /* --- before/after comparison slider -------------------------------------
     Enhanced from .compare-pair. The static two-up layout stays as the no-JS
     fallback; with JS the pair becomes one overlaid, draggable image. */
  :global(.compare-pair[data-juxtapose]) {
    position: relative;
    display: block;
    grid-template-columns: none;
    user-select: none;
    touch-action: pan-y;
    overflow: hidden;
    border-radius: 4px;
    cursor: ew-resize;
  }
  :global(.compare-pair[data-juxtapose] figure) { margin: 0; }
  :global(.compare-pair[data-juxtapose] figure:nth-of-type(1)) { position: relative; }
  :global(.compare-pair[data-juxtapose] figure:nth-of-type(2)) {
    position: absolute;
    inset: 0;
    width: 100%;
    /* clipped to the handle position */
    clip-path: inset(0 0 0 var(--split, 50%));
  }
  :global(.compare-pair[data-juxtapose] img) {
    display: block;
    width: 100%;
    -webkit-user-drag: none;
  }
  :global(.compare-pair[data-juxtapose] figcaption) {
    position: absolute;
    /* Top, not bottom. The original's rule is `.jx-left { align-items:
       flex-start }`, which puts both labels at the top of the picture. */
    top: 10px;
    padding: 4px 9px;
    /* The original's own value: `.jx-label { background-color:
       var(--e-global-color-d077a13); color: #FFFFFF }`. The translucent black
       here was invented. */
    background: var(--e-global-color-d077a13, #15334c);
    color: #fff;
    /* 16px on 18px leading at weight 500, with no extra tracking — measured
       against the original's Before/After labels on all 68 pages that carry a
       slider. 12px with 0.04em was invented. */
    font-size: 16px;
    line-height: 18px;
    font-weight: 500;
    letter-spacing: normal;
    border-radius: 3px;
    margin: 0;
    pointer-events: none;
  }
  :global(.compare-pair[data-juxtapose] figure:nth-of-type(1) figcaption) { left: 10px; }
  /* The two labels are not the same colour. The original gives Before
     `.jx-left .jx-label { background-color: var(--e-global-color-d077a13) }`
     and After `.jx-right .jx-label { background-color:
     var(--e-global-color-f32bb28) }` -- navy and the brand pink. Both were
     navy here. */
  :global(.compare-pair[data-juxtapose] figure:nth-of-type(2) figcaption) {
    right: 10px;
    background: var(--e-global-color-f32bb28, #ff0099);
  }

  /* The gallery link must not change how the grid lays out. */
  :global(a.lb-link) {
    display: block;
    line-height: 0;
  }

  :global(.jx-handle) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split, 50%);
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  /* The controller, as the original draws it. Its widget sets
     `.jx-controller { background-color: var(--e-global-color-8c22d81) }` with
     `border-radius: 5px`, and hands the handle a left and a right chevron
     through data-prev-icon / data-next-icon. So it is a rounded green tab with
     two arrows, not the plain white disc this had. */
  :global(.jx-controller) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 10px;
    border-radius: 5px;
    background: var(--e-global-color-8c22d81, #14a278);
    transition: background-color 150ms;
  }
  /* Its own rule: the colour follows a hover of the whole slider, not of the
     handle, which is what makes it respond while the pointer is anywhere over
     the picture. */
  :global(.compare-pair[data-juxtapose]:hover .jx-controller) {
    background: var(--e-global-color-secondary, #232323);
  }
  /* The controller is the focusable slider. A white ring inside a dark one
     reads on both the light and the dark photographs it can sit over. */
  :global(.jx-controller:focus) { outline: none; }
  :global(.jx-controller:focus-visible) {
    outline: 3px solid var(--e-global-color-a8178e9, #99cc33);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #fff, 0 0 0 7px rgba(15, 23, 42, 0.55);
  }
  /* Chevrons drawn from a rotated corner rather than fetched as an image. */
  /* The handle is pointer-events:none so it never blocks a drag across the
     picture; the controller opts back in so its chevrons can be pressed. */
  :global(.jx-controller) { pointer-events: auto; cursor: ew-resize; }
  :global(.jx-arrow) {
    /* A 7px chevron is far too small to hit. The drawn mark stays 7px; the
       span around it is padded out to a real target. */
    padding: 7px 5px;
    cursor: pointer;
    display: block;
    line-height: 0;
  }
  :global(.jx-arrow::before) {
    content: '';
    display: block;
    width: 7px;
    height: 7px;
    border-top: 2px solid #0f172a;
    border-right: 2px solid #0f172a;
  }
  /* On hover the controller turns near-black (above), where the dark
     chevrons disappeared into it; they go white with it. */
  :global(.compare-pair[data-juxtapose]:hover .jx-arrow::before) { border-color: #fff; }
  :global(.jx-arrow--prev::before) { transform: rotate(-135deg); }
  :global(.jx-arrow--next::before) { transform: rotate(45deg); }
</style>

<script>
  (() => {
    // ---------- a picture that failed gets another go ----------------------
    //
    // Reported twice: a picture showing broken on the page while the file
    // itself is provably fine -- 200, valid bytes, served from the edge cache
    // on every one of forty consecutive requests, and 139 of 139 fetched
    // successfully at eighty at once. The file is not the problem; that
    // browser's copy of that moment is. A dropped connection, a proxy hiccup
    // or an error response the browser has since cached all look identical
    // from here and none of them can be fixed by checking the file again.
    //
    // So rather than keep diagnosing, the page retries. The query string is
    // what makes it worth doing: the host serves the file with any query
    // (checked), so a retry also steps around a bad response already sitting
    // in the browser cache, which a plain re-request would just hit again.
    //
    // Twice, backing off, then it gives up and the alt text stands.
    const retries = new WeakMap<HTMLImageElement, number>();
    const retry = (im: HTMLImageElement) => {
      const n = (retries.get(im) ?? 0) + 1;
      if (n > 2) return;
      retries.set(im, n);
      const base = im.dataset.src0 ?? (im.dataset.src0 = im.src.split('?')[0]);
      setTimeout(() => {
        im.src = `${base}?retry=${n}`;
      }, 250 * n);
    };
    document.querySelectorAll<HTMLImageElement>('img').forEach((im) => {
      im.addEventListener('error', () => retry(im));
      // It may already have failed before this script ran -- the header logo
      // is fetched at high priority long before this line. An <img> with no
      // src at all is the lightbox's placeholder, not a failure.
      if (im.complete && im.naturalWidth === 0 && im.getAttribute('src')) retry(im);
    });

    // ---------- lightbox ---------------------------------------------------
    const box = document.getElementById('lightbox') as HTMLElement | null;
    if (!box) return;
    const img = box.querySelector('.lb-img') as HTMLImageElement;
    const cap = box.querySelector('.lb-cap') as HTMLElement;

    // Elementor opens its lightbox on gallery and content images.
    // .fgal-item is the filterable portfolio gallery — its 341 images are
    // lightbox links on the live site, and omitting the class here meant
    // clicking one did nothing at all.
    const SEL =
      '.gallery img, .fgal-item img, .fig img, .rt img, .compare-pair img, .cards img, .carou-slide img';
    let group: HTMLImageElement[] = [];
    let index = 0;

    const show = (i: number) => {
      if (!group.length) return;
      index = (i + group.length) % group.length;
      const el = group[index];
      /* The viewer opens the upload, not the thumbnail on the page. Gallery
         tiles request a 300 or 768 wide resize and before/after pairs a 768,
         so reading the tile's own src put a thumbnail in a full-screen viewer.
         The full file is on the tile's link, or on data-full where there is no
         link -- the pairs are not linked, because clicking one drags. */
      const full =
        el.dataset.full || el.closest<HTMLAnchorElement>('a.lb-link')?.href;
      img.src = full || el.currentSrc || el.src;
      img.alt = el.alt || '';
      cap.textContent = el.alt || '';
    };

    const open = (el: HTMLImageElement) => {
      // Group by the closest container so prev/next walks that gallery only.
      const scope = el.closest('.gallery, .compare, section, main') || document;
      group = [...scope.querySelectorAll<HTMLImageElement>(SEL)];
      if (!group.includes(el)) group = [el];
      show(group.indexOf(el));
      box.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      box.hidden = true;
      img.removeAttribute('src');
      document.body.style.overflow = '';
    };

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-lb-close]')) return close();
      if (t.closest('[data-lb-prev]')) return show(index - 1);
      if (t.closest('[data-lb-next]')) return show(index + 1);
      if (t === box) return close();

      // Gallery items are links to the full-size file, exactly as on the live
      // site, so the picture is still reachable with JS off. With JS the link
      // is intercepted and opens the viewer instead of navigating.
      const lbLink = t.closest<HTMLAnchorElement>('a.lb-link');
      if (lbLink) {
        const inner = lbLink.querySelector('img');
        if (inner) {
          e.preventDefault();
          open(inner);
          return;
        }
      }

      const hit = t.closest<HTMLImageElement>(SEL);
      // Any other linked image keeps its link; only unlinked images open the
      // viewer.
      if (hit && hit.tagName === 'IMG' && !hit.closest('a')) {
        e.preventDefault();
        open(hit);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // ---------- carousels --------------------------------------------------
    // Elementor's image carousel. Slides-per-view, timing and pause-on-hover
    // all come from the widget's own settings, carried on data attributes.
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => {
      const track = el.querySelector<HTMLElement>('.carou-track');
      const dots = el.querySelector<HTMLElement>('.carou-dots');
      if (!track) return;

      const slides = [...track.querySelectorAll<HTMLElement>('.carou-slide')];
      const perDesktop = Number(el.dataset.per || 3);
      /* Elementor's defaults for a breakpoint the widget leaves unset: one
         slide on a phone, two on a tablet (one if the desktop shows one). */
      const perTablet = Number(el.dataset.perTablet || (perDesktop === 1 ? 1 : 2));
      const perMobile = Number(el.dataset.perMobile || 1);
      const delay = Number(el.dataset.delay || 5000);
      const speed = Number(el.dataset.speed || 500);
      const infinite = el.dataset.infinite === 'yes';
      const autoplay = el.dataset.autoplay === 'yes';
      const pauseOnHover = el.dataset.pause === 'yes';

      const per = () => (window.matchMedia('(max-width: 767px)').matches ? perMobile
        : window.matchMedia('(max-width: 1024px)').matches ? perTablet : perDesktop);

      /* Elementor moves the strip by its "Slides to Scroll" -- one slide unless
         the widget says otherwise -- and draws one bullet per step, not one per
         screenful. Paging a screenful at a time drew three bullets under the
         Tesla carousel where the original has eight, and jumped the photographs
         three at a time where the original walks them one by one. */
      /* Per breakpoint, as Elementor hands it to Swiper: the widget's own value
         on desktop, and `slides_to_scroll_tablet` / `_mobile` below that --
         which default to ONE, not to the desktop value, when the widget leaves
         them unset. The homepage logos scroll 6 at a time on desktop and one at
         a time on a phone; scrolling 6 there gave the strip two pages, so
         autoplay moved once and had nowhere left to go. */
      const scrollD = Math.max(1, Number(el.dataset.scroll || 1));
      const scrollAt = () => (window.matchMedia('(max-width: 767px)').matches
        ? Math.max(1, Number(el.dataset.scrollMobile || 1))
        : window.matchMedia('(max-width: 1024px)').matches
          ? Math.max(1, Number(el.dataset.scrollTablet || 1)) : scrollD);
      let scroll = scrollAt();
      const loop = infinite && slides.length > per();
      const pages = () => (loop
        ? Math.max(1, Math.ceil(slides.length / scroll))
        : Math.max(1, Math.ceil((slides.length - per()) / scroll) + 1));

      /* A looping carousel needs a screenful of clones after the last slide, or
         the final steps have nothing left to scroll into and the strip stalls
         with the last photograph pinned to the left. Swiper does the same. */
      if (loop) {
        for (let i = 0; i < Math.max(perDesktop, perTablet, perMobile); i++) {
          const c = slides[i % slides.length].cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          c.dataset.clone = '';
          track.appendChild(c);
        }
      }

      /* One slide plus the gutter. Measured rather than derived from the track,
         because the slide's flex basis is a calc over both. */
      const step = () => {
        const w = slides[0]?.getBoundingClientRect().width ?? 0;
        return w + (parseFloat(getComputedStyle(track).columnGap) || 0);
      };

      let page = 0;
      let rewind = 0;
      const applyPer = () => {
        el.style.setProperty('--per', String(per()));
        scroll = scrollAt();
      };
      const mark = () => dots?.querySelectorAll('button').forEach((d, i) =>
        d.setAttribute('aria-selected', String(i === page)));

      const go = (p: number) => {
        const total = pages();
        window.clearTimeout(rewind);
        if (loop && p >= total) {
          /* Into the clones, which look exactly like the first screenful, then
             back to the real start with the animation off -- so the loop reads
             as continuous rather than as a rewind across the whole strip. */
          track.scrollTo({ left: total * scroll * step(), behavior: 'smooth' });
          page = 0;
          rewind = window.setTimeout(() => {
            track.style.scrollBehavior = 'auto';
            track.scrollLeft = 0;
            track.style.scrollBehavior = '';
          }, Math.max(speed, 500) + 120);
        } else {
          page = p < 0 ? total - 1 : Math.min(p, total - 1);
          track.scrollTo({ left: page * scroll * step(), behavior: 'smooth' });
        }
        mark();
      };

      applyPer();
      window.addEventListener('resize', () => { applyPer(); buildDots(); go(0); });

      function buildDots() {
        if (!dots) return;
        dots.innerHTML = '';
        const total = pages();
        // A carousel that shows every slide at once has nothing to page through.
        if (total < 2) return;
        for (let i = 0; i < total; i++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('role', 'tab');
          b.setAttribute('aria-label', `Slide ${i + 1}`);
          b.setAttribute('aria-selected', String(i === page));
          b.addEventListener('click', () => { stop(); go(i); });
          dots.appendChild(b);
        }
      }

      let timer = 0;
      const start = () => {
        if (!autoplay || pages() < 2) return;
        stop();
        /* A strip that does not loop goes back to its first slide after the
           last, as Swiper's autoplay does unless told to stop there -- rather
           than sitting on the last page for good. */
        timer = window.setInterval(() => go(!loop && page >= pages() - 1 ? 0 : page + 1), delay);
      };
      const stop = () => { if (timer) { window.clearInterval(timer); timer = 0; } };

      if (pauseOnHover) {
        el.addEventListener('mouseenter', stop);
        el.addEventListener('mouseleave', start);
      }

      el.querySelector('.carou-arrow--prev')?.addEventListener('click', () => {
        go(page - 1 < 0 ? pages() - 1 : page - 1);
        start();
      });
      el.querySelector('.carou-arrow--next')?.addEventListener('click', () => {
        go(page + 1);
        start();
      });

      buildDots();
      start();
    });

    // ---------- filterable gallery -----------------------------------------
    document.querySelectorAll<HTMLElement>('[data-filtergallery]').forEach((gal) => {
      const tabs = [...gal.querySelectorAll<HTMLButtonElement>('.fgal-tab')];
      const items = [...gal.querySelectorAll<HTMLElement>('.fgal-item')];

      const apply = (index: string) => {
        items.forEach((it) => {
          it.hidden = index !== 'all' && it.dataset.tag !== index;
        });
        layoutMasonry(gal.querySelector<HTMLElement>('.fgal-grid--masonry'));
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          apply(tab.dataset.index || 'all');
        });
      });
    });

    // ---------- masonry placement -------------------------------------------
    // The original's e-gallery masonry walks the tiles in order and drops each
    // into the SHORTEST column, the leftmost on a tie -- measured off the first
    // twelve tiles of /vinyl-car-wrap-our-portfolio/ at 1440. The CSS columns
    // the stylesheet falls back to fill top-to-bottom one column at a time, so
    // every picture landed somewhere else and the columns finished at
    // different heights. This places them the original's way; with no script
    // the CSS columns still give a sound gallery.
    //
    // Heights come from each picture's own width/height attributes, so the
    // layout is final before a single image has loaded.
    function layoutMasonry(grid: HTMLElement | null) {
      if (!grid) return;
      // Column count and gutter as the stylesheet resolves them at this width,
      // read with the absolute layout switched off.
      grid.classList.remove('fgal-grid--placed');
      grid.style.height = '';
      const cs = getComputedStyle(grid);
      const cols = Math.max(1, parseInt(cs.columnCount, 10) || 1);
      const gap = parseFloat(cs.columnGap) || 0;
      const width = grid.clientWidth;
      const colW = (width - gap * (cols - 1)) / cols;
      const heights = new Array(cols).fill(0);
      const tiles = [...grid.querySelectorAll<HTMLElement>('.fgal-item')].filter((t) => !t.hidden);
      for (const tile of tiles) {
        const img = tile.querySelector('img');
        /* The attributes first, so the layout is final before anything has
           loaded; a picture that arrived without them uses its own size once
           it is in (see the load listener below), and only an unloaded one
           with neither falls back to 4:3. */
        const w = Number(img?.getAttribute('width')) || img?.naturalWidth || 4;
        const h = Number(img?.getAttribute('height')) || img?.naturalHeight || 3;
        let c = 0;
        for (let i = 1; i < cols; i++) if (heights[i] < heights[c]) c = i;
        tile.style.left = `${c * (colW + gap)}px`;
        tile.style.top = `${heights[c]}px`;
        tile.style.width = `${colW}px`;
        heights[c] += (colW * h) / w + gap;
      }
      grid.style.height = `${Math.max(0, Math.max(...heights) - gap)}px`;
      grid.classList.add('fgal-grid--placed');
    }
    // ---------- justified rows ----------------------------------------------
    // Elementor's `justified` gallery, measured on /racing-stripes/: tiles go
    // into a row while adding one keeps the row's height nearer the ideal than
    // stopping would; the row is then scaled to fill the width exactly. The
    // last row keeps the ideal height rather than being stretched. With a
    // 550px column and a 200px ideal that gives two 16:9 tiles at 152px, at
    // 390px with a 100px ideal two at 101px -- the original's numbers.
    function layoutJustified(grid: HTMLElement) {
      const vw = window.innerWidth;
      const ideal = Number(
        (vw <= 767 && grid.dataset.rhM) || (vw <= 1024 && grid.dataset.rhT) || grid.dataset.rh,
      ) || 200;
      grid.classList.remove('fgal-grid--placed');
      grid.style.height = '';
      const gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
      const width = grid.clientWidth;
      const tiles = [...grid.querySelectorAll<HTMLElement>('.fgal-item')].filter((t) => !t.hidden);
      const ratio = (t: HTMLElement) => {
        const img = t.querySelector('img');
        return (Number(img?.getAttribute('width')) || 4) / (Number(img?.getAttribute('height')) || 3);
      };
      const heightOf = (row: number[]) =>
        (width - gap * (row.length - 1)) / row.reduce((a, r) => a + r, 0);
      let y = 0;
      let i = 0;
      while (i < tiles.length) {
        const row = [ratio(tiles[i])];
        let j = i + 1;
        while (j < tiles.length) {
          const next = [...row, ratio(tiles[j])];
          if (Math.abs(heightOf(next) - ideal) > Math.abs(heightOf(row) - ideal)) break;
          row.push(ratio(tiles[j]));
          j++;
        }
        const last = j >= tiles.length;
        const h = last ? Math.min(ideal, heightOf(row)) : heightOf(row);
        let x = 0;
        for (let k = i; k < j; k++) {
          const w = row[k - i] * h;
          tiles[k].style.left = `${x}px`;
          tiles[k].style.top = `${y}px`;
          tiles[k].style.width = `${w}px`;
          tiles[k].style.height = `${h}px`;
          x += w + gap;
        }
        y += h + gap;
        i = j;
      }
      grid.style.height = `${Math.max(0, y - gap)}px`;
      grid.classList.add('fgal-grid--placed');
    }

    const masonries = [...document.querySelectorAll<HTMLElement>('.fgal-grid--masonry')];
    const justified = [...document.querySelectorAll<HTMLElement>('.fgal-grid--justified')];
    const layoutAll = () => {
      masonries.forEach(layoutMasonry);
      justified.forEach(layoutJustified);
    };
    layoutAll();
    // A tile with no width/height can only be placed properly once its
    // picture is in; re-place that gallery when it arrives, once per frame.
    masonries.forEach((grid) => {
      let queued = 0;
      grid.querySelectorAll<HTMLImageElement>('img:not([width])').forEach((im) => {
        if (im.complete) return;
        im.addEventListener('load', () => {
          cancelAnimationFrame(queued);
          queued = requestAnimationFrame(() => layoutMasonry(grid));
        }, { once: true });
      });
      if (grid.querySelector('img:not([width])')) layoutMasonry(grid);
    });
    if (masonries.length || justified.length) {
      let raf = 0;
      let lastW = window.innerWidth;
      window.addEventListener('resize', () => {
        if (window.innerWidth === lastW) return;   // a phone's toolbar, not a reflow
        lastW = window.innerWidth;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(layoutAll);
      });
    }

    // ---------- gallery tiles arriving -------------------------------------
    // The original fades and scales each picture in as it loads. The starting
    // state (invisible, half size) lives behind .fgal-grid--lazy, and the class
    // is added HERE rather than in the markup for the same reason the original
    // adds its own from script: if this never runs, the pictures are simply
    // visible instead of a gallery of 341 invisible tiles.
    // The galleries and the carousels. Deliberately NOT the before/after
    // sliders: those overlay two pictures and reveal the top one by clipping,
    // so fading them separately shows the lower picture through the upper one.
    // See the note beside .compare-pair in Blocks.astro for why fading the pair
    // as a unit was not the answer either.
    document.querySelectorAll<HTMLElement>('.fgal-grid, .carou').forEach((grid) => {
      const shots = [...grid.querySelectorAll<HTMLImageElement>('img')];
      if (!shots.length) return;
      grid.classList.add('img-reveal');

      const arrived = (img: HTMLImageElement) => img.classList.add('is-loaded');

      shots.forEach((img) => {
        // Cached images can already be done before this runs; without the
        // complete check those tiles would wait for a load event that never
        // fires and stay invisible.
        if (img.complete) {
          arrived(img);
          return;
        }
        img.addEventListener('load', () => arrived(img), { once: true });
        // A picture that fails is revealed too, so its reserved box and alt
        // text show. Leaving it hidden would turn a broken image into a blank
        // gap with no indication anything was meant to be there.
        img.addEventListener('error', () => arrived(img), { once: true });
      });
    });

    // ---------- before/after sliders ---------------------------------------
    document.querySelectorAll<HTMLElement>('.compare-pair').forEach((pair) => {
      const figs = pair.querySelectorAll('figure');
      if (figs.length !== 2) return;

      pair.dataset.juxtapose = '';
      const handle = document.createElement('span');
      handle.className = 'jx-handle';
      // The controller carries a left and a right chevron, as the original's
      // does through its data-prev-icon / data-next-icon attributes.
      /* The controller is the slider itself, as on the original: juxtapose
         gives its .jx-controller role="slider", tabindex="0" and the three
         aria-value* attributes. It was a plain span here, so nothing on the
         page could take keyboard focus and the comparison could not be moved
         without a pointer. */
      const controller = document.createElement('span');
      controller.className = 'jx-controller';
      controller.tabIndex = 0;
      controller.setAttribute('role', 'slider');
      controller.setAttribute('aria-label', 'Before and after image comparison');
      controller.setAttribute('aria-valuemin', '0');
      controller.setAttribute('aria-valuemax', '100');
      controller.setAttribute('aria-orientation', 'horizontal');
      /* The chevrons stay pressable with a pointer, but they are not buttons:
         a focusable control nested inside a slider is a second, redundant tab
         stop that a screen reader announces as part of the slider. The
         keyboard path is the slider's own arrow keys. */
      const arrows: Record<string, HTMLElement> = {};
      for (const dir of ['prev', 'next']) {
        const arrow = document.createElement('span');
        arrow.className = `jx-arrow jx-arrow--${dir}`;
        arrow.setAttribute('aria-hidden', 'true');
        controller.appendChild(arrow);
        arrows[dir] = arrow;
      }
      handle.appendChild(controller);
      pair.appendChild(handle);

      /* The original starts at data-startingposition="50%", which is also the
         CSS fallback; it is set explicitly so the value is always readable. */
      let pct = 50;
      /* Every movement -- pointer, touch, chevron or key -- goes through here,
         so the clip, the handle and aria-valuenow can never disagree. */
      const apply = () => {
        pair.style.setProperty('--split', `${pct}%`);
        const now = String(Math.round(pct));
        controller.setAttribute('aria-valuenow', now);
        controller.setAttribute('aria-valuetext', `${now}% after photo shown`);
      };
      const setSplit = (clientX: number) => {
        const r = pair.getBoundingClientRect();
        pct = Math.min(100, Math.max(0, ((clientX - r.left) / r.width) * 100));
        apply();
      };

      pair.setAttribute('role', 'group');
      pair.setAttribute('aria-label', 'Before and after comparison');
      apply();
      /* The original's juxtapose moves 1% per arrow press. PageUp/PageDown and
         Shift+arrow take bigger steps, as the ARIA slider pattern expects. */
      controller.addEventListener('keydown', (e: KeyboardEvent) => {
        const big = 10;
        const small = e.shiftKey ? big : 1;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') pct = Math.max(0, pct - small);
        else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') pct = Math.min(100, pct + small);
        else if (e.key === 'PageDown') pct = Math.max(0, pct - big);
        else if (e.key === 'PageUp') pct = Math.min(100, pct + big);
        else if (e.key === 'Home') pct = 0;
        else if (e.key === 'End') pct = 100;
        else return;
        e.preventDefault();
        apply();
      });

      let dragging = false;
      let movedWhileDown = false;
      let downX = 0;
      let fromController = false;
      const start = (e: PointerEvent) => {
        dragging = true;
        movedWhileDown = false;
        downX = e.clientX;
        /* The pointer is captured on the first real movement, NOT here.
           Capturing on pointerdown retargets every later pointer event to the
           pair, and the browser then fires the click on the pair rather than on
           the chevron -- so the buttons never heard a click and stayed dead,
           which is the whole reason they did not work. */
        fromController = controller.contains(e.target as Node);
        /* A press on the controller must not jump the split to the pointer:
           that is where the handle already is, and on a chevron it would undo
           the step the click is about to make. */
        if (!fromController) setSplit(e.clientX);
      };
      const move = (e: PointerEvent) => {
        if (!dragging) return;
        if (!movedWhileDown && Math.abs(e.clientX - downX) > 3) {
          movedWhileDown = true;
          try {
            pair.setPointerCapture(e.pointerId);
          } catch {
            /* Capture is a convenience for dragging past the edge, not a
               requirement; without it the drag simply ends at the boundary. */
          }
        }
        if (movedWhileDown || !fromController) setSplit(e.clientX);
      };
      const end = () => { dragging = false; };

      /* Stepped by the same amount whichever way it is driven. */
      const step = (delta: number) => {
        pct = Math.min(100, Math.max(0, pct + delta));
        apply();
      };
      for (const [dir, sign] of [['prev', -1], ['next', 1]] as const) {
        arrows[dir].addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          // A drag that finished on the chevron is not a click on it.
          if (movedWhileDown) return;
          step(sign * 10);
        });
      }

      /* A press on a photograph followed by a move is, to the browser, the
         start of dragging the image out of the page. It takes the gesture
         over and fires pointercancel, so a mouse drag moved the split by the
         first few pixels and then stopped dead. Touch never showed it, which
         is why it went unnoticed. The pictures are not meant to be dragged
         anywhere; refusing that hands the gesture back to the slider. */
      pair.querySelectorAll('img').forEach((im) => { im.draggable = false; });
      pair.addEventListener('dragstart', (e) => e.preventDefault());

      pair.addEventListener('pointerdown', start);
      pair.addEventListener('pointermove', move);
      pair.addEventListener('pointerup', end);
      pair.addEventListener('pointercancel', end);
    });
  })();
</script>

<script>
  /* In-page links glide to their target, as Elementor's do, rather than
     jumping -- `#partial_wraps` and the other service links on the vehicle-wrap
     pages. Scoped to the click rather than set as `html { scroll-behavior:
     smooth }`, which would also slow every script's own window.scrollTo().
     A reader who asks for reduced motion gets the plain jump. The target's
     scroll-margin-top keeps it clear of the sticky header either way. */
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="#"]');
    const hash = a?.getAttribute('href') ?? '';
    if (!a || hash.length < 2 || a.hasAttribute('data-popup')) return;
    let target: HTMLElement | null = null;
    try { target = document.getElementById(decodeURIComponent(hash.slice(1))); } catch { return; }
    if (!target) return;
    e.preventDefault();
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
    if (location.hash !== hash) history.pushState(null, '', hash);
    /* Keyboard and screen-reader users land where the link said. A section
       is not focusable on its own, so it is made programmatically focusable,
       and focusing it must not cut the glide short with a jump. */
    if (!target.matches('a[href], button, input, select, textarea, [tabindex]')) target.tabIndex = -1;
    target.focus({ preventScroll: true });
  });
</script>

<script>
  /* The Limited Time Offer countdown on the post pages.

     Elementor runs this one in "evergreen" mode: the widget carries no date,
     only an interval (132 hours), which starts the first time a given visitor
     sees it and hides the widget when it runs out. So the deadline is per
     visitor and kept in localStorage — there is no fixed date to go stale, and
     nothing to reproduce wrongly by baking one in.

     Its own IIFE: the block above returns early when a page has no lightbox,
     which would otherwise take this with it. */
  (() => {
    const els = document.querySelectorAll<HTMLElement>('[data-countdown]');
    if (!els.length) return;

    const pad = (n: number) => String(n).padStart(2, '0');

    els.forEach((el) => {
      const seconds = Number(el.dataset.countdown);
      if (!Number.isFinite(seconds) || seconds <= 0) return;

      /* Keyed by the widget so two countdowns on a page keep their own clocks.
         Storage can throw outright (private mode, blocked site data), in which
         case the countdown simply starts fresh on each page view. */
      const key = `vwt:cd:${el.dataset.eid ?? 'default'}`;
      let start = 0;
      try { start = Number(window.localStorage.getItem(key)) || 0; } catch { /* no storage */ }
      if (!start || !Number.isFinite(start) || start > Date.now()) {
        start = Date.now();
        try { window.localStorage.setItem(key, String(start)); } catch { /* no storage */ }
      }
      const end = start + seconds * 1000;

      const units = {
        days: el.querySelector<HTMLElement>('[data-unit="days"]'),
        hours: el.querySelector<HTMLElement>('[data-unit="hours"]'),
        minutes: el.querySelector<HTMLElement>('[data-unit="minutes"]'),
        seconds: el.querySelector<HTMLElement>('[data-unit="seconds"]'),
      };

      let timer = 0;
      const tick = () => {
        const left = end - Date.now();
        if (left <= 0) {
          /* The widget's own expire action is "hide". */
          el.hidden = true;
          window.clearInterval(timer);
          return;
        }
        const s = Math.floor(left / 1000);
        if (units.days) units.days.textContent = pad(Math.floor(s / 86400));
        if (units.hours) units.hours.textContent = pad(Math.floor(s / 3600) % 24);
        if (units.minutes) units.minutes.textContent = pad(Math.floor(s / 60) % 60);
        if (units.seconds) units.seconds.textContent = pad(s % 60);
        el.hidden = false;
      };

      tick();
      timer = window.setInterval(tick, 1000);
    });
  })();
</script>

<script>
  /* Elementor's scrolling progress tracker, on the post pages that carry the
     Limited Time Offer panel. Its own IIFE, for the same reason as above. */
  (() => {
    const fill = document.querySelector<HTMLElement>('.readbar-fill');
    if (!fill) return;

    let queued = false;
    const paint = () => {
      queued = false;
      const doc = document.documentElement;
      /* How far the reader can actually travel; a page shorter than the
         viewport has nowhere to go and stays at zero rather than dividing by it. */
      const travel = doc.scrollHeight - window.innerHeight;
      const pct = travel > 0 ? Math.min(100, Math.max(0, (window.scrollY / travel) * 100)) : 0;
      fill.style.width = `${pct}%`;
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>

<script>
  /* Background slideshows: cycle the layers a section stacked behind its
     content. The photographs, the timings and the Ken Burns zoom all come from
     the section's own data, harvested off the original's `data-settings` --
     none of it is in a stylesheet, which is why the port shipped these
     sections as flat colour.

     Paused while the section is off screen, so a hero at the top of a long
     page is not repainting behind the reader all the way down it. */
  (() => {
    const shows = document.querySelectorAll<HTMLElement>('[data-slideshow]');
    if (!shows.length) return;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    shows.forEach((show) => {
      const slides = [...show.querySelectorAll<HTMLElement>('.sec-slide')];
      if (slides.length < 2 || still) return;

      const hold = Number(show.dataset.duration) || 5000;
      const loop = show.dataset.loop !== 'no';
      let at = 0;
      let timer: number | undefined;

      const step = () => {
        const next = at + 1;
        if (next >= slides.length && !loop) return;
        slides[at].removeAttribute('data-on');
        at = next % slides.length;
        /* Re-adding the attribute restarts the Ken Burns animation; without
           the reflow between, the browser coalesces the two changes and the
           zoom only ever runs on the first slide. */
        void slides[at].offsetWidth;
        slides[at].setAttribute('data-on', '');
      };

      const start = () => { timer ??= window.setInterval(step, hold); };
      const stop = () => { window.clearInterval(timer); timer = undefined; };

      new IntersectionObserver(
        ([e]) => (e.isIntersecting ? start() : stop()),
        { rootMargin: '0px' },
      ).observe(show);
    });
  })();
</script>

<script>
  /* Single-open FAQs (Blocks.astro): the <details> share a `name`, which makes
     the browser close the others itself. Where it does not support that, close
     them here. `toggle` does not bubble, so it is caught on the way down. */
  document.addEventListener(
    'toggle',
    (e) => {
      const d = e.target;
      if (!(d instanceof HTMLDetailsElement) || !d.open) return;
      const faq = d.closest('.faq[data-single]');
      if (!faq) return;
      faq.querySelectorAll<HTMLDetailsElement>(':scope > details[open]').forEach((o) => {
        if (o !== d) o.open = false;
      });
    },
    true,
  );
</script>
