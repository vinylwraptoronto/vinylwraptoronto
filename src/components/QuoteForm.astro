---
/**
 * Quote form — port of the Elementor Pro form used on the live site.
 *
 * Field set, labels, placeholders and required flags are taken from the live
 * markup verbatim: name, email, phone, a Business/Personal pair, a vehicle-type
 * select, a multi-file photo upload and a message.
 *
 * The live form posts to WordPress admin-ajax (Elementor Pro Forms). There is no
 * WordPress here, so it posts to /api/quote instead — see that route for how
 * delivery is wired.
 */
export interface Props {
  /** `popup` is the compact variant used inside the Request a Quote popup. */
  variant?: 'inline' | 'popup';
  id?: string;
  /** The Limited Time Offer form asks which wrap, where the site-wide form
      asks the vehicle type. Passing the list swaps that one field. */
  products?: readonly string[];
  /** The landing pages carry a *different* Elementor form from the site-wide
      one: name, phone, email and a requirements box, and nothing else. The
      port rendered the site-wide field set everywhere, which made that
      section 311px taller than the original's and asked for a vehicle type
      the original never asks for here. Naming the fields renders only those,
      in the order given. */
  fields?: readonly string[];
  /** The upload field's visible note. The live forms differ on this: the one
      further down each landing page carries "Upload Photos (If any. Allowed
      file formats: ...)" as a field of its own, and the hero form has a bare
      file input with nothing above it. The port printed the note on every
      form that takes a file. */
  photoNote?: boolean;
  /** The same form also writes its own placeholders and submit label. */
  placeholders?: Readonly<Record<string, string>>;
  submit?: string;
  /** Per-form Elementor values. The BOX of a field is site-wide -- every form
      on the original is 40px tall with `8px 16px` of padding and a 40px
      button -- but these three are set per form and differ between them: the
      landing pages' forms are pill-shaped with a 15px button, the service
      pages' are nearly square with an 18px one. Left unset, the form renders
      exactly as it did before. */
  radius?: string;
  submitSize?: string;
  rows?: number;
  /** Where the submit sits in its form. Measured on the original: it fills the
      form's width on every service and contact page checked, and is centred at
      its own width on the two landing pages. The port left-aligned it
      everywhere, which matched neither. */
  submitAlign?: 'stretch' | 'center' | 'start';
}
const { variant = 'inline', id = 'quote', products, fields, placeholders, submit,
        photoNote = true, radius, submitSize, rows,
        submitAlign = 'stretch' } = Astro.props;
/* Custom properties rather than direct declarations: an inline
   `border-radius` would outrank the stylesheet's own focus and error rules. */
const formVars = [
  radius ? `--q-radius:${radius}` : '',
  submitSize ? `--q-submit-size:${submitSize}` : '',
  `--q-submit-align:${submitAlign}`,
].filter(Boolean).join(';') || undefined;
const vehicleTypes = ['Van', 'Truck', 'Car', 'SUV', 'Trailer', 'Boat',
  'Motorcycle', 'Jet Ski', 'Windows', 'Walls', 'Object', 'Other'];

/** The site-wide form's own order. With no field list this is what renders,
    which keeps every existing instance byte-for-byte as it was. */
const SITE_ORDER = ['name', 'email', 'phone', 'wrap_type', 'vehicle', 'photos', 'message'] as const;
/* A given list also sets the order: the landing pages ask name, phone, email —
   not the site-wide name, email, phone. */
const order: readonly string[] = fields ?? SITE_ORDER;
const ph = (f: string, fallback: string) => placeholders?.[f] ?? fallback;
---

{/* The trailing slash matters: the site is trailingSlash: 'always', so
    /api/quote answers 308 to /api/quote/. A 308 keeps the method and body, so
    submissions did go through, but every one paid an extra round trip and
    re-uploaded its photographs to follow the redirect. */}
<form class={`qform qform--${variant}`} method="post" action="/api/quote/" enctype="multipart/form-data" novalidate style={formVars}>
  {order.map((f) => (
    <>
      {f === 'name' && (
        <div class="row">
          <label class="sr-only" for={`${id}-name`}>Name</label>
          <input id={`${id}-name`} name="name" type="text" placeholder={ph('name', 'Name*')} required autocomplete="name" />
        </div>
      )}

      {f === 'email' && (
        <div class="row">
          <label class="sr-only" for={`${id}-email`}>Email</label>
          <input id={`${id}-email`} name="email" type="email" placeholder={ph('email', 'Email*')} required autocomplete="email" />
        </div>
      )}

      {f === 'phone' && (
        <div class="row">
          <label class="sr-only" for={`${id}-phone`}>Phone</label>
          <input id={`${id}-phone`} name="phone" type="tel" placeholder={ph('phone', 'Phone*')} required autocomplete="tel" />
        </div>
      )}

      {f === 'wrap_type' && (
        <fieldset class="row checks">
          <legend class="sr-only">It is for</legend>
          <label><input type="checkbox" name="wrap_type" value="Business (Commercial)" /> Business (Commercial)</label>
          <label><input type="checkbox" name="wrap_type" value="Personal" /> Personal</label>
        </fieldset>
      )}

      {f === 'vehicle' && (
        <div class="row">
          {products ? (
            <>
              <label class="sr-only" for={`${id}-product`}>Product</label>
              <select id={`${id}-product`} name="product" required>
                {products.map((v, i) => <option value={i === 0 ? '' : v}>{v}</option>)}
              </select>
            </>
          ) : (
            <>
              <label class="sr-only" for={`${id}-vehicle`}>Vehicle Type</label>
              <select id={`${id}-vehicle`} name="vehicle_type">
                <option value="">Select Vehicle Type</option>
                {vehicleTypes.map((v) => <option value={v}>{v}</option>)}
              </select>
            </>
          )}
        </div>
      )}

      {/* The visible text above the file input is its own field on the live form,
          not the input's label — that one ("Photos") is screen-only, as every
          other label here is. The accepted formats are the ones it names, so
          accept="image/*" was both wider (any image type) and narrower (no PDF)
          than what the copy promises. */}
      {f === 'photos' && (
        <div class="row">
          {photoNote && (
            <p class="uploadnote">
              Upload Photos (<span>If any. Allowed file formats: jpg, jpeg, png, heic &amp; pdf</span>)
            </p>
          )}
          <label class="sr-only" for={`${id}-photos`}>Photos</label>
          <input
            id={`${id}-photos`}
            name="photos"
            type="file"
            multiple
            accept=".jpg,.jpeg,.png,.heic,.pdf,image/jpeg,image/png,image/heic,application/pdf"
          />
        </div>
      )}

      {f === 'message' && (
        <div class="row">
          <label class="sr-only" for={`${id}-message`}>Message</label>
          <textarea id={`${id}-message`} name="message" rows={rows ?? 4} placeholder={ph('message', 'Message')}></textarea>
        </div>
      )}
    </>
  ))}

  <button type="submit" class="qbtn">{submit ?? 'Send Message'}</button>
  <p class="qstatus" role="status" aria-live="polite"></p>
</form>

<style>
  .qform { display: flex; flex-direction: column; gap: 10px; font-family: 'Poppins', sans-serif; }
  .row { display: flex; flex-direction: column; }

  /* Measured on the original, on every form on every page checked: a text
     field is 40px tall with `8px 16px` of padding and a textarea takes
     `5px 14px`. The port used 11px/14px throughout, which made each field
     47px and each row pitch 57px instead of 50 -- so a five-field form ran
     ~95px taller than the original's and pushed the hero's content out of
     the middle of the photograph behind it. */
  .qform input[type='text'],
  .qform input[type='email'],
  .qform input[type='tel'],
  .qform select,
  .qform textarea {
    width: 100%;
    padding: 8px 16px;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    /* Explicit, so the box arithmetic is the original's rather than the
       browser's `normal`: 8 + 21.5 + 8 + 2px border = 40px, and a two-row
       textarea is 5 + 43 + 5 + 2 = 55. Both are what the original measures. */
    line-height: 21.5px;
    color: var(--ink-strong);
    background: #fff;
    border: 1px solid #d8d8d8;
    /* per-form on the original: 25px on the landing pages, 3px on the service
       pages. 4px is what the port used everywhere and stays the fallback. */
    border-radius: var(--q-radius, 4px);
  }
  .qform textarea { padding: 5px 14px; }
  .qform input:focus-visible,
  .qform select:focus-visible,
  .qform textarea:focus-visible {
    outline: 2px solid var(--e-global-color-a8178e9);
    outline-offset: 1px;
  }
  .qform input[aria-invalid='true'],
  .qform textarea[aria-invalid='true'] { border-color: #d33; }

  .checks {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 16px;
    border: 0;
    margin: 0;
    padding: 2px 0;
  }
  /* measured 14px/14px on the live form, not 15px on the inherited 24px */
  /* The live form's option labels are #000, not the body ink; the footer
     instance overrides to white against its navy column. */
  .checks label {
    display: flex; align-items: center; gap: 7px;
    font-size: 14px; line-height: 1; color: #000000;
  }

  /* The live form sets only the parenthetical smaller, at 12px, and leaves the
     rest at the form's own size. */
  /* #000 on the original, not the body ink — checked on all 270 pages that
     carry the upload field. */
  .uploadnote { margin: 0 0 4px; font-size: 16px; line-height: 24px; color: #000000; }
  .uploadnote span { font-size: 12px; }
  .qform input[type='file'] { font-size: 14px; }

  .qbtn {
    align-self: var(--q-submit-align, stretch);
    background-color: var(--e-global-color-d077a13);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    /* .elementor-button{line-height:1}, uppercase */
    font-size: var(--q-submit-size, 18px);
    line-height: 1;
    text-transform: uppercase;
    /* The original's submit is 40px tall with no vertical padding at all --
       the height comes from the button box, not from the text. Reproduced as
       a flex box with a min-height so it stays 40px whatever size the label
       is set to; the port's 13px/26px made it 44px and grew with the font. */
    padding: 0 24px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--q-radius, 0);
    cursor: pointer;
  }
  .qbtn:hover { background-color: var(--e-global-color-a8178e9); }
  .qbtn[disabled] { opacity: 0.6; cursor: default; }

  .qstatus { margin: 0; font-size: 14px; min-height: 1.2em; }
  .qstatus[data-state='ok'] { color: var(--brand-green); }
  .qstatus[data-state='err'] { color: #d33; }

  .qform--popup .qbtn { align-self: stretch; text-align: center; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  // Progressive enhancement: the form is a real POST target, so it still works
  // without JS. With JS it submits in place and reports status inline, which is
  // how the Elementor form behaves.
  document.querySelectorAll<HTMLFormElement>('form.qform').forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.qstatus')!;
    const button = form.querySelector<HTMLButtonElement>('.qbtn')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Native validation, but reported without the browser's default bubbles
      // so required fields flag consistently across browsers.
      let firstBad: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
        const bad = !el.checkValidity();
        el.setAttribute('aria-invalid', String(bad));
        if (bad && !firstBad) firstBad = el;
      });
      if (firstBad) {
        status.dataset.state = 'err';
        status.textContent = 'Please complete the required fields.';
        (firstBad as HTMLElement).focus();
        return;
      }

      button.disabled = true;
      status.dataset.state = '';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}) as Record<string, unknown>);
        if (res.ok) {
          status.dataset.state = 'ok';
          status.textContent = 'Thanks — your message has been sent. We will be in touch shortly.';
          form.reset();
          /* The Google Ads lead conversion.
           *
           * The original's form navigates to /thank-you/, and that page fires
           * this event. This form answers in place and never leaves the page,
           * which is better for the person filling it in -- but it meant the
           * conversion never fired, so Ads would have recorded zero form leads
           * from the whole site while still being charged for the clicks.
           *
           * Fired here with the same conversion label the original uses, so
           * nothing has to change in the Ads account. /thank-you/ still carries
           * its own copy for anyone who arrives there directly. */
          (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.(
            'event',
            'conversion',
            { send_to: 'AW-11342080648/Hac5CN7WneMYEIjVqaAq' },
          );
        } else {
          status.dataset.state = 'err';
          status.textContent =
            (data as { error?: string }).error ||
            'Sorry, that did not send. Please call 416-746-1381 instead.';
        }
      } catch {
        status.dataset.state = 'err';
        status.textContent = 'Sorry, that did not send. Please call 416-746-1381 instead.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
