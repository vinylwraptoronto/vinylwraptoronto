# build output
dist/
.astro/

# dependencies
node_modules/

# cloudflare
.wrangler/
.dev.vars

# review artefacts (generated by scripts/flat-copy.mjs)
review/

# environment
.env
.env.production

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS / editors
.DS_Store
.vscode/
.idea/

# generated by scripts/sweep.mjs for scripts/img-check.mjs
dist-img-keys.json

# untrusted live-web evidence generated by Firecrawl
.firecrawl/

# D1 seed SQL, regenerated from db/*.py (blog_render.sql alone is 5.8MB)
db/*.sql
!db/migrations/*.sql
db/blog_rows.json

# Comparison captures. Regenerated per page by the screenshot pass and ~1.5MB
# each at 1440; the whole site's worth would be gigabytes in history. The
# durable record of what they showed is _research/structure.md.
_research/screenshots/


# Probe files written by scripts/pull-iconbox-align.py while it runs.
scripts/.iconbox-align-*

# Scratch QA/Lighthouse/accessibility evidence generated by ad-hoc audit runs
# under _evidence/<task>-<date>/ (e.g. scripts/accessibility.mjs, Lighthouse
# CLI output). These accumulate as untracked bloat on every run. Does not
# affect the handful of _evidence/ subfolders already committed as a durable
# record (e.g. _evidence/audit-fixes-20261002/, _evidence/lighthouse-20261001/,
# _evidence/pr7-mobile-font-subset-20261001/) — ignore rules never untrack
# already-tracked files, and new evidence worth keeping can still be
# `git add -f`'d deliberately.
_evidence/*/
